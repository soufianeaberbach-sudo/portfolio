---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profiles } from '../components/SocialLinks.astro';
import { getLocale, localeMeta, localizePath, locales, stripLocale } from '../i18n/locales';
import { ui } from '../i18n/ui';
import '../styles/global.css';
import '../styles/rtl.css';

interface Props {
  title: string;
  description: string;
  marker: string;
  page: string;
  footer?: boolean;
  /* Opt a single route out of the footer's contact callout without removing
     the footer. Expertise uses it because that page hands off to Portfolio,
     not to Contact. Defaults to true, so every other route is unchanged. */
  footerCallout?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  marker,
  page,
  footer = true,
  footerCallout = true,
  noindex = false,
} = Astro.props;
const locale = getLocale(Astro.url);
const meta = localeMeta[locale];
const t = ui[locale];
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageURL = new URL('/soufiane-drawing.png', Astro.site ?? Astro.url.origin);
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
/* Every language version is its own canonical page. The alternates are
   reciprocal by construction: each one is built from the same unprefixed path,
   so /fr/process/ and /ar/process/ list exactly the same set. A noindex flow
   page (the no-JavaScript confirmation, 404) declares no alternates. */
const basePath = stripLocale(Astro.url.pathname);
const alternates = noindex
  ? []
  : [
      ...locales.map((code) => ({ hreflang: code, href: new URL(localizePath(basePath, code), origin).href })),
      { hreflang: 'x-default', href: new URL(basePath, origin).href },
    ];
const localeHome = new URL(localizePath('/', locale), origin).href;

/* Structured data, emitted once on the home page. Every value here is already
   stated somewhere on the site: the name, the current job title, the city, the
   four public profile links. Deliberately absent: registration or tax numbers,
   any street address, client or brand relationships, and the working languages
   — that last one is published but not yet verified, and structured data is a
   machine-readable claim, so it stays out until it is. areaServed is absent
   for the same reason — no geographic reach is claimed until a precise one is
   intentionally approved. */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: localeHome,
      name: 'Soufiane Aberbach',
      inLanguage: locale,
      publisher: { '@id': `${origin}/#soufiane` },
    },
    {
      '@type': 'Person',
      '@id': `${origin}/#soufiane`,
      name: 'Soufiane Aberbach',
      url: localeHome,
      image: socialImageURL.href,
      jobTitle: t.schema.jobTitle,
      address: { '@type': 'PostalAddress', addressLocality: 'Tangier', addressCountry: 'MA' },
      sameAs: profiles.map((profile) => profile.href),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${origin}/#service`,
      name: t.schema.serviceName,
      url: localeHome,
      description: t.schema.serviceDescription,
      provider: { '@id': `${origin}/#soufiane` },
      address: { '@type': 'PostalAddress', addressLocality: 'Tangier', addressCountry: 'MA' },
    },
  ],
};
---

<!doctype html>
<html lang={locale} dir={meta.dir} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="build-marker" content={marker} />
    <meta name="theme-color" content="#11110f" />
    {/* The site implements one light theme only. Advertising "light dark"
        let browser-native controls assume a dark theme exists. */}
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soufiane Aberbach" />
    <meta property="og:locale" content={meta.og} />
    {!noindex && locales.filter((code) => code !== locale).map((code) => <meta property="og:locale:alternate" content={localeMeta[code].og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    {/* The real intrinsic size of /soufiane-drawing.png, measured from the
        file. The previously declared values matched neither the file nor any
        crop of it. */}
    <meta property="og:image:width" content="1127" />
    <meta property="og:image:height" content="1396" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    {/* "summary", not "summary_large_image": the only social asset available is
        the 1127x1396 portrait, and declaring a large-image card with a
        portrait crops it badly. A dedicated 1200x630 asset is still outstanding — it
        could not be produced here because Archivo is served from Google Fonts
        and is not available locally, and a wordmark set in a fallback face
        would misrepresent the identity. Switch this back to
        summary_large_image when that asset lands. */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={t.twitterImageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {/* Arabic is set in IBM Plex Sans Arabic: a contemporary grotesque drawn
        for real Arabic shaping, close in temper to Inter and Archivo. Loaded
        only on Arabic pages, from the same font provider the site already
        declares on Privacy & Confidentiality. */}
    {locale === 'ar' && (
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
    )}
    {page === 'home' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <div class="scroll-progress" aria-hidden="true"><i data-scroll-progress></i></div>
    <div class="page-wipe" aria-hidden="true" data-page-wipe></div>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    {footer && <SiteFooter page={page} showCallout={footerCallout && page !== 'contact'} />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const header = document.querySelector('[data-site-header]');
        const toggle = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-mobile-menu]');
        const main = document.querySelector('main');
        const footer = document.querySelector('.site-footer');
        const wipe = document.querySelector('[data-page-wipe]');
        const progress = document.querySelector('[data-scroll-progress]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const setMenu = (open) => {
          if (!toggle || !menu) return;
          toggle.setAttribute('aria-expanded', String(open));
          menu.setAttribute('aria-hidden', String(!open));
          root.classList.toggle('menu-open', open);
          document.body.classList.toggle('no-scroll', open);
          toggle.querySelector('.sr-only').textContent = open ? toggle.dataset.closeLabel : toggle.dataset.openLabel;
          main?.toggleAttribute('inert', open);
          footer?.toggleAttribute('inert', open);
          if (open) {
            requestAnimationFrame(() => menu.querySelector('a')?.focus());
          } else if (menu.contains(document.activeElement)) {
            toggle.focus();
          }
        };

        toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
        menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
          if (event.key === 'Tab' && root.classList.contains('menu-open') && toggle && menu) {
            const focusable = [toggle, ...menu.querySelectorAll('a')];
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        let lastY = window.scrollY;
        const updateChrome = () => {
          const y = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (progress) progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
          header?.classList.toggle('is-scrolled', y > 24);
          header?.classList.toggle('is-hidden', y > lastY && y > 180 && !root.classList.contains('menu-open'));
          lastY = y;
        };
        updateChrome();
        window.addEventListener('scroll', updateChrome, { passive: true });

        const revealItems = document.querySelectorAll('[data-reveal]');
        if (!reduceMotion && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          revealItems.forEach((item) => observer.observe(item));
        } else {
          revealItems.forEach((item) => item.classList.add('is-visible'));
        }

        /* LANGUAGE SWITCHING KEEPS YOUR PLACE. The switcher's links are plain
           hrefs to the equivalent page, so they work without JavaScript. With
           it, the current fragment rides along — a Portfolio chapter or garment
           address is the same immutable id in every language. Read at click
           time because the Portfolio router updates the address with
           history.replaceState, which fires no event. */
        document.querySelectorAll('[data-lang-link]').forEach((link) => {
          link.addEventListener('click', () => {
            const target = new URL(link.href, window.location.origin);
            target.hash = window.location.hash;
            link.href = target.href;
          });
        });

        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (reduceMotion || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const url = new URL(link.href, window.location.origin);
            if (url.pathname === window.location.pathname || link.target === '_blank') return;
            event.preventDefault();
            wipe?.classList.add('is-active');
            window.setTimeout(() => { window.location.href = url.href; }, 180);
          });
        });

        requestAnimationFrame(() => wipe?.classList.remove('is-active'));
      })();
    </script>
  </body>
</html>
