---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profiles } from '../components/SocialLinks.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  marker: string;
  page: string;
  footer?: boolean;
  /* Opt a single route out of the footer's contact callout without removing
     the footer. Expertise uses it because that page hands off to Portfolio,
     not to Contact. Defaults to true, so every other route is unchanged. */
  footerCallout?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  marker,
  page,
  footer = true,
  footerCallout = true,
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImageURL = new URL('/soufiane-drawing.png', Astro.site ?? Astro.url.origin);
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;

/* Structured data, emitted once on the home page. Every value here is already
   stated somewhere on the site: the name, the current job title, the city, the
   four public profile links. Deliberately absent: registration or tax numbers,
   any street address, client or brand relationships, and the working languages
   — that last one is published but not yet verified, and structured data is a
   machine-readable claim, so it stays out until it is. areaServed is absent
   for the same reason — no geographic reach is claimed until a precise one is
   intentionally approved. */
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}/#soufiane`,
      name: 'Soufiane Aberbach',
      url: origin + '/',
      image: socialImageURL.href,
      jobTitle: 'Senior Fashion Designer & Product Developer',
      address: { '@type': 'PostalAddress', addressLocality: 'Tangier', addressCountry: 'MA' },
      sameAs: profiles.map((profile) => profile.href),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${origin}/#service`,
      name: 'Soufiane Aberbach — Fashion Product Development',
      url: origin + '/',
      description:
        'Fashion product development: pattern construction, fit validation, grading, technical documentation and pre-production handoff.',
      provider: { '@id': `${origin}/#soufiane` },
      address: { '@type': 'PostalAddress', addressLocality: 'Tangier', addressCountry: 'MA' },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="build-marker" content={marker} />
    <meta name="theme-color" content="#11110f" />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Soufiane Aberbach" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="680" />
    <meta property="og:image:height" content="846" />
    <meta property="og:image:alt" content="Soufiane Aberbach seated and drawing on a tablet" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    {page === 'home' && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"><i data-scroll-progress></i></div>
    <div class="page-wipe" aria-hidden="true" data-page-wipe></div>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    {footer && <SiteFooter page={page} showCallout={footerCallout && page !== 'contact'} />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const header = document.querySelector('[data-site-header]');
        const toggle = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-mobile-menu]');
        const main = document.querySelector('main');
        const footer = document.querySelector('.site-footer');
        const wipe = document.querySelector('[data-page-wipe]');
        const progress = document.querySelector('[data-scroll-progress]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const setMenu = (open) => {
          if (!toggle || !menu) return;
          toggle.setAttribute('aria-expanded', String(open));
          menu.setAttribute('aria-hidden', String(!open));
          root.classList.toggle('menu-open', open);
          document.body.classList.toggle('no-scroll', open);
          toggle.querySelector('.sr-only').textContent = open ? 'Close menu' : 'Open menu';
          main?.toggleAttribute('inert', open);
          footer?.toggleAttribute('inert', open);
          if (open) {
            requestAnimationFrame(() => menu.querySelector('a')?.focus());
          } else if (menu.contains(document.activeElement)) {
            toggle.focus();
          }
        };

        toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
        menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
        window.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenu(false);
          if (event.key === 'Tab' && root.classList.contains('menu-open') && toggle && menu) {
            const focusable = [toggle, ...menu.querySelectorAll('a')];
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        let lastY = window.scrollY;
        const updateChrome = () => {
          const y = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          if (progress) progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
          header?.classList.toggle('is-scrolled', y > 24);
          header?.classList.toggle('is-hidden', y > lastY && y > 180 && !root.classList.contains('menu-open'));
          lastY = y;
        };
        updateChrome();
        window.addEventListener('scroll', updateChrome, { passive: true });

        const revealItems = document.querySelectorAll('[data-reveal]');
        if (!reduceMotion && 'IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
          revealItems.forEach((item) => observer.observe(item));
        } else {
          revealItems.forEach((item) => item.classList.add('is-visible'));
        }

        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (reduceMotion || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const url = new URL(link.href, window.location.origin);
            if (url.pathname === window.location.pathname || link.target === '_blank') return;
            event.preventDefault();
            wipe?.classList.add('is-active');
            window.setTimeout(() => { window.location.href = url.href; }, 180);
          });
        });

        requestAnimationFrame(() => wipe?.classList.remove('is-active'));
      })();
    </script>
  </body>
</html>
