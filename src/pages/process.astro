---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const stages = [
  { number: '01', title: 'Sketch', subtitle: 'Concept locked before cost', body: 'Silhouette, fabric direction and production constraints are agreed in writing before anything is cut.', output: 'Development direction' },
  { number: '02', title: '2D Pattern', subtitle: 'Geometry, not guesswork', body: 'Drafted in Gerber, Lectra or Optitex to the block, tolerances and seam allowances the garment needs.', output: 'Production pattern' },
  { number: '03', title: 'Gradation', subtitle: 'A size run that holds', body: 'The full nest is checked against the measurement chart at every size, with repeatable grade rules.', output: 'Graded size set' },
  { number: '04', title: '3D Simulation', subtitle: 'Fit resolved before sampling', body: 'Drape, balance and tension are reviewed on screen so costly physical rounds are reduced.', output: 'Fit resolution' },
  { number: '05', title: 'Final Garment', subtitle: 'A specification the floor can follow', body: 'Construction, trims, stitch types, marker and consumption are documented for consistent execution.', output: 'Factory-ready pack' },
];
---

<SiteLayout title="Process — Soufiane Aberbach" description="A five-stage fashion development process from sketch and pattern through gradation, 3D simulation and final garment." marker="SA-PROCESS-V1" page="process">
  <!-- BUILD-MARKER: SA-PROCESS-V1 -->
  <section class="page-intro process-intro">
    <div data-reveal>
      <p class="eyebrow">Process / 03</p>
      <h1 class="display page-intro__title">Five stages.<br />No blind spots.</h1>
    </div>
    <aside class="page-intro__aside" data-reveal>
      <p class="label">The production protocol</p>
      <p>A written output closes each stage. Everyone knows what was decided, what comes next and where responsibility sits.</p>
    </aside>
  </section>

  <section class="protocol section-shell">
    <div class="protocol__rail" aria-hidden="true"><span>01</span><i></i><span>05</span></div>
    <ol class="protocol__list">
      {stages.map((stage) => (
        <li data-reveal>
          <div class="protocol__number">{stage.number}</div>
          <div class="protocol__title">
            <p class="label">{stage.subtitle}</p>
            <h2>{stage.title}</h2>
          </div>
          <p class="protocol__body">{stage.body}</p>
          <div class="protocol__output"><span class="label">Output</span><strong>{stage.output}</strong></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="process-principle">
    <div class="section-shell process-principle__grid">
      <div data-reveal>
        <p class="eyebrow">Why the sequence matters</p>
        <h2 class="display">A sewing line cannot correct an unresolved pattern.</h2>
      </div>
      <div data-reveal>
        <p>Production quality is decided upstream. The five stages make those decisions visible, testable and repeatable before they become factory problems.</p>
        <a class="button button--signal" href="/contact/">Start at stage one <span><Arrow /></span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .process-intro { background: var(--acid); }
  .protocol { position: relative; display: grid; grid-template-columns: 5rem 1fr; gap: 4vw; padding-block: clamp(6rem, 10vw, 10rem); }
  .protocol__rail { position: sticky; top: 8rem; align-self: start; height: 22rem; display: flex; flex-direction: column; align-items: center; justify-content: space-between; font-family: var(--mono); font-size: .62rem; }
  .protocol__rail i { width: 1px; flex: 1; margin: 1rem 0; background: linear-gradient(var(--signal), var(--line)); }
  .protocol__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .protocol__list li { display: grid; grid-template-columns: .18fr 1fr 1fr .6fr; gap: 2.5rem; align-items: start; min-height: 19rem; padding: 3rem 0; border-bottom: 1px solid var(--line-strong); }
  .protocol__number { font-family: var(--mono); font-size: .72rem; color: var(--signal); }
  .protocol__title h2 { margin: .8rem 0 0; font-family: var(--display); font-size: clamp(3.2rem, 6vw, 7rem); font-weight: 850; letter-spacing: -.07em; line-height: .88; }
  .protocol__body { max-width: 31rem; margin: 0; color: var(--ink-soft); line-height: 1.75; }
  .protocol__output { display: grid; gap: .6rem; padding: 1rem; border: 1px solid var(--line); }
  .protocol__output span { color: var(--muted); }
  .protocol__output strong { font-size: .85rem; }
  .process-principle { padding-block: clamp(7rem, 13vw, 13rem); background: var(--ink); color: var(--paper); }
  .process-principle__grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 8vw; }
  .process-principle h2 { margin-top: 2rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .process-principle__grid > div:last-child { align-self: end; }
  .process-principle__grid > div:last-child p { margin: 0 0 2.5rem; color: #aaa89f; font-size: 1.1rem; line-height: 1.75; }
  @media (max-width: 1000px) { .protocol__list li { grid-template-columns: 3rem 1fr 1fr; } .protocol__output { grid-column: 2 / -1; } .process-principle__grid { grid-template-columns: minmax(0, 1fr); } .process-principle__grid > * { min-width: 0; } }
  @media (max-width: 650px) { .protocol { grid-template-columns: 1fr; } .protocol__rail { display: none; } .protocol__list li { grid-template-columns: 2rem 1fr; gap: 1.25rem; min-height: 0; } .protocol__body, .protocol__output { grid-column: 2; } .protocol__title h2 { font-size: 3.2rem; } .process-principle h2 { font-size: 3.5rem; } }
</style>
