---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const stages = [
  { number: '01', title: 'Sketch', subtitle: 'Concept locked before cost', body: 'Silhouette, fabric direction and production constraints are agreed in writing before anything is cut.', output: 'Development direction' },
  { number: '02', title: '2D Pattern', subtitle: 'Geometry, not guesswork', body: 'Drafted in Gerber, Lectra or Optitex to the block, tolerances and seam allowances the garment needs.', output: 'Production pattern' },
  { number: '03', title: 'Gradation', subtitle: 'A size run that holds', body: 'The full nest is checked against the measurement chart at every size, with repeatable grade rules.', output: 'Graded size set' },
  { number: '04', title: '3D Simulation', subtitle: 'Fit resolved before sampling', body: 'Drape, balance and tension are reviewed on screen so costly physical rounds are reduced.', output: 'Fit resolution' },
  { number: '05', title: 'Final Garment', subtitle: 'A specification the floor can follow', body: 'Construction, trims, stitch types, marker and consumption are documented for consistent execution.', output: 'Factory-ready pack' },
];
---

<SiteLayout title="Process — Soufiane Aberbach" description="A five-stage fashion development process from sketch and pattern through gradation, 3D simulation and final garment." marker="SA-PROCESS-V1" page="process">
  <!-- BUILD-MARKER: SA-PROCESS-V1 -->
  <section class="page-intro process-intro">
    <div data-reveal>
      <p class="eyebrow">Process / 03</p>
      <h1 class="display page-intro__title">Five stages.<br />No blind spots.</h1>
    </div>
    <aside class="page-intro__aside" data-reveal>
      <p class="label">The production protocol</p>
      <p>A written output closes each stage. Everyone knows what was decided, what comes next and where responsibility sits.</p>
    </aside>
  </section>

  <section class="protocol section-shell">
    <div class="protocol__map" aria-label="Five-stage production sequence">
      <span class="label">Sequence / decision flow</span>
      <ol>
        {stages.map((stage) => <li><span>{stage.number}</span><strong>{stage.title}</strong></li>)}
      </ol>
    </div>
    <ol class="protocol__list">
      {stages.map((stage, stageIndex) => (
        <li data-reveal style={`--stage:${stageIndex + 1}`}>
          <div class="protocol__number">{stage.number}</div>
          <div class="protocol__title">
            <p class="label">{stage.subtitle}</p>
            <h2>{stage.title}</h2>
          </div>
          <p class="protocol__body">{stage.body}</p>
          <div class="protocol__decision" aria-label={`Stage ${stage.number} of 05`}>
            <div aria-hidden="true">
              {stages.map((_, index) => <i class={index <= stageIndex ? 'is-resolved' : ''}></i>)}
            </div>
            <span class="label">Decision {stage.number} / 05</span>
          </div>
          <div class="protocol__output"><span class="label">Production output / {stage.number}</span><strong>{stage.output}</strong><i aria-hidden="true"></i></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="process-principle">
    <div class="section-shell process-principle__grid">
      <div data-reveal>
        <p class="eyebrow">Why the sequence matters</p>
        <h2 class="display">A sewing line cannot correct an unresolved pattern.</h2>
      </div>
      <div data-reveal>
        <p>Production quality is decided upstream. The five stages make those decisions visible, testable and repeatable before they become factory problems.</p>
        <a class="button button--signal" href="/contact/">Start a development brief <span><Arrow /></span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .process-intro {
    background:
      linear-gradient(90deg, transparent 0 68%, var(--line) 68% calc(68% + 1px), transparent calc(68% + 1px)),
      var(--paper-bright);
  }
  .protocol { position: relative; padding-block: clamp(6rem, 10vw, 10rem); }
  .protocol__map { display: grid; grid-template-columns: .35fr 1.65fr; gap: 5vw; align-items: end; margin-bottom: clamp(4rem, 7vw, 7rem); }
  .protocol__map > .label { color: var(--muted); }
  .protocol__map ol { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0 0 1rem; border-bottom: 1px solid var(--line-strong); list-style: none; }
  .protocol__map ol::after { content: ''; position: absolute; left: 0; bottom: -1px; width: 20%; height: 2px; background: var(--signal); }
  .protocol__map li { position: relative; display: grid; gap: .7rem; padding-right: 1rem; }
  .protocol__map li::after { content: ''; position: absolute; left: 0; bottom: -1.33rem; width: .45rem; height: .45rem; border: 1px solid var(--signal); border-radius: 50%; background: var(--paper); }
  .protocol__map li span { color: var(--signal); font-family: var(--mono); font-size: .62rem; }
  .protocol__map li strong { max-width: 8rem; font-family: var(--display); font-size: clamp(1rem, 1.4vw, 1.35rem); line-height: 1; }
  .protocol__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .protocol__list > li { position: relative; display: grid; grid-template-columns: 4rem minmax(18rem, .8fr) minmax(17rem, .72fr) minmax(14rem, .55fr); gap: 2.5rem; align-items: start; min-height: 22rem; padding: clamp(3rem, 5vw, 5rem) 0; overflow: hidden; border-bottom: 1px solid var(--line-strong); }
  .protocol__list > li::before { content: ''; position: absolute; left: 0; top: 0; width: calc(var(--stage) * 20%); height: 2px; background: var(--signal); transform: scaleX(0); transform-origin: left; transition: transform .8s var(--ease); }
  .protocol__list > li.is-visible::before { transform: scaleX(1); }
  .protocol__number { font-family: var(--mono); font-size: .72rem; color: var(--signal); }
  .protocol__title h2 { margin: .8rem 0 0; font-family: var(--display); font-size: clamp(3.2rem, 6vw, 7rem); font-weight: 850; letter-spacing: -.07em; line-height: .88; }
  .protocol__body { max-width: 31rem; margin: 0; color: var(--ink-soft); line-height: 1.75; }
  .protocol__decision { grid-column: 3; align-self: end; display: grid; gap: .8rem; }
  .protocol__decision > div { display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; }
  .protocol__decision i { display: block; height: 2px; background: var(--line); transform: scaleX(0); transform-origin: left; transition: transform .45s var(--ease); }
  .protocol__decision i.is-resolved { background: var(--signal); }
  .protocol__decision span { color: var(--muted); }
  .protocol__list > li.is-visible .protocol__decision i { transform: scaleX(1); }
  .protocol__list > li.is-visible .protocol__decision i:nth-child(2) { transition-delay: .08s; }
  .protocol__list > li.is-visible .protocol__decision i:nth-child(3) { transition-delay: .16s; }
  .protocol__list > li.is-visible .protocol__decision i:nth-child(4) { transition-delay: .24s; }
  .protocol__list > li.is-visible .protocol__decision i:nth-child(5) { transition-delay: .32s; }
  .protocol__output { position: relative; grid-column: 4; grid-row: 1 / 3; align-self: end; display: grid; gap: .75rem; min-height: 7.5rem; padding: 1.1rem 1.1rem 1.75rem; overflow: hidden; border: 1px solid var(--line); background: var(--paper-bright); }
  .protocol__output::before { content: ''; position: absolute; top: -.1rem; right: -.1rem; width: 1.2rem; height: 1.2rem; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--paper); }
  .protocol__output span { color: var(--muted); }
  .protocol__output strong { align-self: end; font-family: var(--display); font-size: clamp(1.05rem, 1.5vw, 1.35rem); line-height: 1; clip-path: inset(0 100% 0 0); transition: clip-path .65s var(--ease) .18s; }
  .protocol__output i { position: absolute; left: 1rem; right: 1rem; bottom: .72rem; height: 1px; background: var(--line-strong); transform: scaleX(0); transform-origin: left; transition: transform .72s var(--ease) .34s; }
  .protocol__output i::before { content: ''; position: absolute; right: 0; bottom: -.24rem; width: 1px; height: .5rem; background: var(--signal); }
  .protocol__output i::after { content: ''; position: absolute; right: 0; top: 0; width: 28%; height: 1px; background: var(--signal); transform: scaleX(0); transform-origin: right; transition: transform .42s var(--ease) .88s; }
  .protocol__list > li.is-visible .protocol__output strong { clip-path: inset(0); }
  .protocol__list > li.is-visible .protocol__output i, .protocol__list > li.is-visible .protocol__output i::after { transform: scaleX(1); }
  .process-principle { padding-block: clamp(7rem, 13vw, 13rem); background: var(--ink); color: var(--paper); }
  .process-principle__grid { display: grid; grid-template-columns: 1.3fr .7fr; gap: 8vw; }
  .process-principle h2 { margin-top: 2rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .process-principle__grid > div:last-child { align-self: end; }
  .process-principle__grid > div:last-child p { margin: 0 0 2.5rem; color: #aaa89f; font-size: 1.1rem; line-height: 1.75; }
  @media (max-width: 1100px) { .protocol__list > li { grid-template-columns: 3rem minmax(0, 1fr) minmax(15rem, .7fr); } .protocol__body { grid-column: 2; } .protocol__decision { grid-column: 2; } .protocol__output { grid-column: 3; grid-row: 1 / 4; } .process-principle__grid { grid-template-columns: minmax(0, 1fr); } .process-principle__grid > * { min-width: 0; } }
  @media (max-width: 760px) { .protocol__map { grid-template-columns: 1fr; } .protocol__map ol { overflow-x: auto; grid-template-columns: repeat(5, minmax(7rem, 1fr)); padding-bottom: 1rem; } .protocol__list > li { grid-template-columns: 2rem minmax(0, 1fr); gap: 1.25rem; min-height: 0; } .protocol__body, .protocol__decision, .protocol__output { grid-column: 2; } .protocol__output { grid-row: auto; } .protocol__title h2 { font-size: 3.2rem; } .process-principle h2 { font-size: 3.5rem; } }
</style>
