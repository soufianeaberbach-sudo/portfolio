---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import { getLocale, localizePath } from '../i18n/locales';
import { misc } from '../i18n/pages/misc';
import { ui } from '../i18n/ui';
const locale = getLocale(Astro.url);
const t = misc[locale].notFound;
---

<SiteLayout
  title={t.title}
  description={t.description}
  marker="SA-404-V1"
  page="404"
  noindex
>
  <section class="page-intro section-shell not-found">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="display page-intro__title" set:html={t.heading} />
    </div>
    <div class="page-intro__aside">
      <p>{t.line}</p>
      <div class="not-found__actions">
        <a class="button button--signal" href={localizePath('/', locale)}>{t.home} <span aria-hidden="true"><Arrow /></span></a>
        <a class="button" href={localizePath('/contact/', locale)}>{ui[locale].startBrief} <span aria-hidden="true"><Arrow /></span></a>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .not-found { min-height: 78svh; }
  .not-found__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  @media (max-width: 540px) {
    .not-found__actions { align-items: stretch; flex-direction: column; }
    .not-found__actions .button { justify-content: space-between; width: 100%; }
  }
</style>
