---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

/* Privacy — deliberately short, plain and specific.
 *
 * Everything here describes what the code actually does. The retention period
 * is RETENTION_DAYS in worker/index.ts; change both together. No compliance
 * claims are made, because a page cannot make them on the implementation's
 * behalf.
 */
const RETENTION_DAYS = 90;
const email = 'soufianeaberbach@gmail.com';

const collected = [
  ['Your name', 'So a reply can address you.'],
  ['Company or brand', 'Optional. Only if you provide it.'],
  ['Email address', 'The only way a reply can reach you.'],
  ['Where the product is now', 'One of five stages, so the first answer is useful.'],
  ['Your message', 'What needs solving.'],
  ['An uploaded reference file', 'Optional. Only if you attach one — a sketch, image, PDF or document.'],
  ['A reference link', 'Optional. Only if you paste one.'],
];

const processors = [
  ['Site hosting and storage', 'Cloudflare. The brief is stored there first so nothing is lost in transit. An uploaded file is stored separately in Cloudflare R2, in a private bucket.'],
  ['Email delivery', 'Resend passes the brief to Soufiane’s inbox.'],
  ['Spam check', 'Cloudflare Turnstile, when enabled. It loads a script from Cloudflare and is the only third-party script on this site.'],
];
---

<SiteLayout
  title="Privacy — Soufiane Aberbach"
  description="What the development brief form collects, why, who processes it, and how long it is kept."
  marker="SA-PRIVACY-V1"
  page="contact"
  footerCallout={false}
>
  <!-- BUILD-MARKER: SA-PRIVACY-V1 -->
  <section class="pv section-shell">
    <div class="pv__head" data-reveal>
      <p class="eyebrow">Privacy</p>
      <h1 class="display pv__title">What happens to<br />what you <em>send</em>.</h1>
      <p class="pv__lede">
        This page describes what the brief form on the contact page actually does.
        It makes no compliance claims — only statements the implementation supports.
      </p>
    </div>

    <div class="pv__body">
      <section class="pv__block" data-reveal>
        <h2 class="pv__h">What the form collects</h2>
        <dl class="pv__list">
          {collected.map(([term, note]) => (
            <div><dt>{term}</dt><dd>{note}</dd></div>
          ))}
        </dl>
      </section>

      <section class="pv__block" data-reveal>
        <h2 class="pv__h">Why it is collected</h2>
        <p>
          Only to receive, assess and respond to development enquiries. It is not used
          for marketing and it is not sold. No advertising trackers or analytics scripts
          are implemented in the site code.
        </p>
      </section>

      <section class="pv__block" data-reveal>
        <h2 class="pv__h">Who processes it</h2>
        <dl class="pv__list">
          {processors.map(([term, note]) => (
            <div><dt>{term}</dt><dd>{note}</dd></div>
          ))}
        </dl>
      </section>

      <section class="pv__block" data-reveal>
        <h2 class="pv__h">How long it is kept</h2>
        <p>
          A submitted brief is kept for <strong>{RETENTION_DAYS} days</strong> and then
          expires automatically from storage. If a brief could not be emailed on, a short
          record noting that expires on the same schedule. The stored brief record does not
          include the sender&rsquo;s IP address, location or browser details. For rate
          limiting, the Worker keeps a truncated hash derived from the IP address for up to
          one hour.
        </p>
        <p>
          A file you attach is kept on the same {RETENTION_DAYS}-day schedule and is stored
          only so the enquiry can be answered. It is held in a private Cloudflare bucket
          with a random name, is not placed on any public address, and there is no link to
          it anywhere on this site &mdash; it is reachable only from Soufiane&rsquo;s own
          Cloudflare account. That is access control, not encryption: Cloudflare operates
          the storage and can technically reach what is in it.
        </p>
      </section>

      <section class="pv__block" data-reveal>
        <h2 class="pv__h">Your project material</h2>
        <p>
          Sketches, references, patterns and anything else you send are yours. They are not
          published and not used as portfolio material without your written permission.
        </p>
        <p class="pv__note">
          One limit worth stating plainly: a Google Drive, Dropbox or WeTransfer link you
          paste is only as private as that link. Anyone holding it can open it, so share
          links you are comfortable sharing.
        </p>
      </section>

      <section class="pv__block" data-reveal>
        <h2 class="pv__h">Deletion and questions</h2>
        <p>
          To have a submitted brief deleted before it expires, or to ask anything about the
          above, write to <a href={`mailto:${email}`}>{email}</a>.
        </p>
        <a class="button pv__back" href="/contact/">Back to contact <span><Arrow /></span></a>
      </section>
    </div>
  </section>
</SiteLayout>

<style>
  .pv { padding-block: calc(var(--header-h) + clamp(3rem, 6vw, 6rem)) clamp(4rem, 8vw, 8rem); }
  .pv__head { max-width: 46rem; }
  .pv .eyebrow { color: var(--muted); }
  .pv__title { margin: clamp(1.5rem, 3vw, 2.25rem) 0 0; font-size: clamp(2.3rem, 6vw, 5rem); }
  .pv__lede { max-width: 34rem; margin: clamp(1.5rem, 3vw, 2.25rem) 0 0; color: var(--ink-soft); font-size: 1.05rem; line-height: 1.75; }

  .pv__body { display: grid; gap: clamp(2.5rem, 4.5vw, 4rem); margin-top: clamp(3rem, 6vw, 5.5rem); max-width: 46rem; }
  .pv__block { padding-top: clamp(1.5rem, 2.5vw, 2rem); border-top: 1px solid var(--line-strong); }
  .pv__h { margin: 0 0 1.1rem; font-family: var(--display); font-weight: 850; letter-spacing: -.035em; font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.15; }
  .pv__block p { max-width: 40rem; margin: 0 0 1rem; color: var(--ink-soft); line-height: 1.75; }
  .pv__block p:last-of-type { margin-bottom: 0; }
  .pv__note { color: var(--muted) !important; font-size: .95rem; }
  .pv__block a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .pv__block a:hover { color: var(--ink); text-decoration-color: var(--signal); text-decoration-thickness: 2px; }

  .pv__list { display: grid; gap: 0; margin: 0; }
  .pv__list > div { display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr); gap: .35rem 1.5rem; padding: .8rem 0; border-bottom: 1px solid var(--line); }
  .pv__list dt { margin: 0; font-weight: 600; }
  .pv__list dd { margin: 0; color: var(--muted); line-height: 1.6; }
  .pv__back { margin-top: 1.75rem; text-decoration: none; }
  .pv__back:hover { color: var(--paper); }

  @media (max-width: 640px) {
    .pv__list > div { grid-template-columns: minmax(0, 1fr); }
  }
</style>
