---
import TrustLayout from '../layouts/TrustLayout.astro';
import TrustSections from '../components/TrustSections.astro';
import { getLocale } from '../i18n/locales';
import { trust } from '../i18n/pages/trust';
/* Every word of this page is in src/i18n/pages/trust.ts, in all three
   languages; section ids are shared, so #anchors survive a language switch. */
const page = trust[getLocale(Astro.url)].privacy;
---

<TrustLayout
  title={page.title}
  description={page.description}
  heading={page.heading}
  intro={page.intro}
  marker="SA-PRIVACY-V2"
  contents={page.sections.map(({ id, toc }) => ({ id, label: toc }))}
>
  <TrustSections sections={page.sections} />
</TrustLayout>
