/* =====================================================
   MECHANICAL STACK
===================================================== */

function initializeMechanicalStack(
    section,
    cards,
    details,
    looks
) {


    const total =
    cards.length;


    const slots = [

        {
            x: 0,
            scale: 1,
            blur: 0,
            opacity: 1,
            z: 10
        },

        {
            x: -20,
            scale: .90,
            blur: 1.5,
            opacity: .92,
            z: 9
        },

        {
            x: -40,
            scale: .80,
            blur: 3,
            opacity: .70,
            z: 8
        },

        {
            x: -60,
            scale: .70,
            blur: 6,
            opacity: .45,
            z: 7
        },

        {
            x: -80,
            scale: .60,
            blur: 13,
            opacity: .20,
            z: 6
        }

    ];


    const outgoing = {

        x: 115,

        scale: .92,

        blur: 5,

        opacity: 0,

        z: 20

    };


    cards.forEach(
        (card, index) => {

            const slot =
            slots[index];


            setCard(
                card,
                slot
            );

        }
    );


    details.forEach(
        (detail, index) => {

            gsap.set(
                detail,
                {

                    opacity:
                        index === 0
                            ? 1
                            : 0,

                    y:
                        index === 0
                            ? "-50%"
                            : "-45%"

                }
            );

        }
    );


    const timeline =
    gsap.timeline({

        scrollTrigger: {

            trigger: section,

            scroller: collection,

            start: "top top",

            end: "bottom bottom",

            scrub: true,

            invalidateOnRefresh: true

        }

    });


    for (
        let transition = 0;
        transition < total - 1;
        transition++
    ) {


        timeline.add(
            createTransition(
                cards,
                details,
                transition,
                slots,
                outgoing,
                total
            )
        );

    }

}


/* =====================================================
   TRANSITION
===================================================== */

function createTransition(
    cards,
    details,
    active,
    slots,
    outgoing,
    total
) {


    const tl =
    gsap.timeline();


    const currentCard =
    cards[active];


    tl.to(
        currentCard,
        {

            xPercent:
                outgoing.x,

            scale:
                outgoing.scale,

            filter:
                `blur(${outgoing.blur}px)`,

            opacity:
                outgoing.opacity,

            duration: 1,

            ease:
                "none"

        },
        0
    );


    for (
        let i = active + 1;
        i < total;
        i++
    ) {


        const card =
        cards[i];


        const relative =
        i - active;


        const from =
        slots[relative];


        const to =
        slots[relative - 1];


        if (
            !from ||
            !to
        ) {
            continue;
        }


        tl.to(
            card,
            {

                xPercent:
                    to.x,

                scale:
                    to.scale,

                filter:
                    `blur(${to.blur}px)`,

                opacity:
                    to.opacity,

                duration: 1,

                ease:
                    "none"

            },
            0
        );

    }


    const nextCard =
    cards[active + 1];


    tl.to(
        nextCard,
        {

            xPercent:
                slots[0].x,

            scale:
                slots[0].scale,

            filter:
                `blur(${slots[0].blur}px)`,

            opacity:
                slots[0].opacity,

            duration: 1,

            ease:
                "none"

        },
        0
    );


    tl.set(
        currentCard,
        {

            xPercent:
                slots[total - 1].x,

            scale:
                slots[total - 1].scale,

            filter:
                `blur(${slots[total - 1].blur}px)`,

            opacity:
                slots[total - 1].opacity,

            zIndex:
                slots[total - 1].z

        },
        .65
    );


    tl.to(
        currentCard,
        {

            xPercent:
                slots[total - 1].x,

            scale:
                slots[total - 1].scale,

            filter:
                `blur(${slots[total - 1].blur}px)`,

            opacity:
                slots[total - 1].opacity,

            duration: .35,

            ease:
                "none"

        },
        .65
    );


    const currentText =
    details[active];


    const nextText =
    details[active + 1];


    if (currentText) {

        tl.to(
            currentText,
            {

                opacity: 0,

                y: "-55%",

                duration: .45,

                ease: "none"

            },
            0
        );

    }


    if (nextText) {

        tl.to(
            nextText,
            {

                opacity: 1,

                y: "-50%",

                duration: .55,

                ease: "none"

            },
            .25
        );

    }


    return tl;

}


/* =====================================================
   SET CARD
===================================================== */

function setCard(
    card,
    state
) {


    gsap.set(
        card,
        {

            xPercent:
                state.x,

            x:
                0,

            yPercent:
                -50,

            y:
                0,

            scale:
                state.scale,

            filter:
                `blur(${state.blur}px)`,

            opacity:
                state.opacity,

            zIndex:
                state.z

        }
    );

}


