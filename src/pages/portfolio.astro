       .pf-docs/.pf-dossier/.pf-sheet, .pf-motion/.pf-sessionlink) are gone
       from the stylesheet entirely rather than overridden — there are no dead
       selectors left behind them.
       ====================================================================== */

    /* One white, not two.
       The derived renditions used to carry grounds from #eeeeee to #ffffff, so
       the studio had to sit at a compromise value and every deck seam showed as
       a change of white. .devtools/normalise-ground.mjs resolves every frame's
       studio ground to 255 — edge-connected flood fill, tight tolerance,
       feathered mask, masters untouched — so the studio is simply white and the
       photographs meet it exactly. */
    .pf { --pf-stage: #ffffff; --pf-paper: #ffffff; }

    .pf-sr {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* ======================================================================
       INTRO
       Says the proposition and stops. The first cover has to start inside the
       fold; a screen and a half of beige before the first chapter is what made
       the old landing read as a document index.
       ====================================================================== */
    .pf-intro {
      max-width: var(--max);
      margin: 0 auto;
      padding: calc(var(--header-h) + clamp(.9rem, 1.8vw, 1.5rem)) var(--gutter) clamp(1.1rem, 2vw, 1.75rem);
    }
    .pf-intro__title {
      max-width: 20ch;
      margin: 1rem 0 0;
      font-size: clamp(2.1rem, 4.4vw, 3.7rem);
      line-height: .94;
      letter-spacing: -.045em;
    }
    .pf-intro__lede {
      max-width: 34rem;
      margin: .9rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(.98rem, 1.35vw, 1.08rem);
      line-height: 1.6;
    }

    /* ======================================================================
       FOUR SEQUENTIAL CHAPTER COVERS

       One after another down the page. Each is the better part of a screen and
       each is composed from what that chapter actually holds, so the four do
       not rhyme: a garment in a studio, a page of type, a physical folio, a
       frame of film. No columns, no cards, no radius, nothing floating.
       ====================================================================== */
    .pf-covers { border-top: 1px solid var(--line-strong); }

    .pf-cover {
      position: relative;
      display: grid;
      align-items: center;
      min-height: clamp(28rem, 78vh, 46rem);
      color: inherit;
      text-decoration: none;
      overflow: hidden;
    }
    .pf-cover + .pf-cover { border-top: 1px solid var(--line-strong); }
    .pf-cover:focus-visible { outline: 2px solid var(--signal); outline-offset: -4px; }

    /* The type block carries the page gutter, so the art can run to the edge
       of the viewport without fighting the cover's own padding. */
    .pf-cover__type {
