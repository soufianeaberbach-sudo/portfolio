    .pf-project__profile dd { margin: 0; font-size: .92rem; line-height: 1.55; }
    .pf-project__description { margin: 1.1rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-project__tags { margin: .9rem 0 0; color: var(--muted); }
    .pf-project__tags i { font-style: normal; opacity: .5; }

    .pf-dev { margin-top: clamp(.5rem, 1vw, 1rem); }
    .pf-project .pf-dev { margin-top: clamp(1.5rem, 2.4vw, 2rem); }
    .pf-dev__head {
