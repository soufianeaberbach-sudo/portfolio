      background: rgba(251, 250, 246, .32);
    }
    .pf-foliomark__print {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(.55rem, 1.1vw, .9rem);
      padding: clamp(1rem, 2.2vw, 1.9rem);
    }
    .pf-foliomark__print i:not(.pf-foliomark__stamp) { display: block; height: 1px; background: var(--line); }
    .pf-foliomark__print i:not(.pf-foliomark__stamp):nth-child(2) { width: 78%; background: var(--line-strong); }
    .pf-foliomark__print i:not(.pf-foliomark__stamp):nth-child(3) { width: 54%; }
    .pf-foliomark__print i:not(.pf-foliomark__stamp):nth-child(4) { width: 70%; }
    .pf-foliomark__print i:not(.pf-foliomark__stamp):nth-child(5) { width: 40%; }
    .pf-foliomark__stamp {
      align-self: flex-start;
      height: auto;
      margin-bottom: clamp(.6rem, 1.2vw, 1rem);
      padding: .3rem .55rem;
      border: 1px solid var(--signal);
      background: none;
      color: var(--signal);
      font-family: var(--mono);
      font-size: .62rem;
      font-style: normal;
      letter-spacing: .2em;
      text-transform: uppercase;
    }

    /* ---------- 04 3D SIMULATION: a frame of the real recording ---------- */
    .pf-cover[data-chapter='3d-simulation'] {
      grid-template-columns: minmax(0, 1fr);
      background: var(--ink);
      color: var(--paper-bright);
    }
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__art {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .pf-cover__still { width: 100%; height: 100%; object-fit: cover; object-position: center 34%; }
    /* The scrim is what makes the type legible over a photograph. It is a
       gradient on the ink, not a translucent card. */
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__art::after {
      content: '';
      position: absolute;
