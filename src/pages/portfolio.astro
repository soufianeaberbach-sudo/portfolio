  background: rgba(255,255,255,.9);
  backdrop-filter: blur(14px);
  border-bottom-color: var(--line);
}
#siteNav .logo{
  font-family: Archivo, sans-serif;
  font-variation-settings: 'wdth' 125;
  font-weight: 900; font-size:19px; letter-spacing:-.05em;
  color: var(--ink); text-decoration:none;
}
#siteNav .logo b{ color: var(--accent); }
#siteNav .links{ display:none; gap:28px; }
@media(min-width:900px){
  #siteNav .links{ display:flex; }
  #siteNav .links a{
    color:var(--ink); text-decoration:none;
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:.15em; text-transform:uppercase;
    padding-bottom:4px; border-bottom:1px solid transparent; transition:.3s;
  }
  #siteNav .links a:hover, #siteNav .links a.on{ border-bottom-color:var(--accent); }
}
#siteNav .burger{
  width:40px;height:40px;display:flex;flex-direction:column;justify-content:center;
  gap:5px;align-items:flex-end;background:none;border:0;
}
#siteNav .burger i{height:1.6px;background:var(--ink)}
#siteNav .burger i:first-child{width:21px}
#siteNav .burger i:last-child{width:13px}
@media(min-width:900px){#siteNav .burger{display:none}}

#siteFooter{
