       empty administrative rectangle. */
    .pf-plate__blank {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding: clamp(.5rem, .8vw, .75rem);
