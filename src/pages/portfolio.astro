<style is:inline>

/* =====================================================
   RESET
===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: auto;
}


body {
    overflow-x: hidden;
}


/* =====================================================
   PORTFOLIO INTRO
===================================================== */

.hero {

    height: 100vh;

    display: flex;

    align-items: center;

    justify-content: center;

}


.hero h1 {

    font-size: clamp(60px, 10vw, 150px);

    font-weight: 400;

}


/* =====================================================
   CATEGORY SECTIONS
===================================================== */

.category {

    min-height: 100vh;

    display: grid;

    grid-template-columns: 60% 40%;

    align-items: center;

    padding: 8vw;

    border-top: 1px solid #ddd;

    cursor: pointer;

}


.category:nth-child(even) {

    direction: rtl;

}


.category-image {

    width: 100%;

    height: 75vh;

    overflow: hidden;

}


.category-image img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    transition: transform 1.2s
        cubic-bezier(.16,1,.3,1);

}


.category:hover
.category-image img {

    transform: scale(1.04);

}


.category-content {

    direction: ltr;

    padding: 5vw;

}


.category-number {

    font-size: 10px;

    margin-bottom: 30px;

}


.category-title {

    font-size: clamp(45px, 6vw, 90px);

    font-weight: 400;

    line-height: .9;

    margin-bottom: 30px;

}


.category-description {

    max-width: 380px;

    font-size: 13px;

    line-height: 1.8;

}


/* =====================================================
   COLLECTION
===================================================== */

.collection {

    position: fixed;

    inset: 0;

    background: white;

    z-index: 1000;

    overflow-y: auto;

    overflow-x: hidden;

    opacity: 0;

    visibility: hidden;

}


.collection.active {

    visibility: visible;

}


/* =====================================================
   COLLECTION HEADER
===================================================== */

.collection-header {

    position: fixed;

    left: 0;

    top: 0;

    width: 100%;

    height: 80px;

    z-index: 100;

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 0 5vw;

    background: rgba(255,255,255,.85);

    backdrop-filter: blur(10px);

}


.collection-name {

    font-size: 12px;

    letter-spacing: .12em;

    text-transform: uppercase;

}


.collection-close {

    font-size: 10px;

    letter-spacing: .15em;

    text-transform: uppercase;

    cursor: pointer;

}


/* =====================================================
   LOOK EXPERIENCE
===================================================== */

.looks {

    width: 100%;

}


.look-section {

    position: relative;

    height: 560vh;

}


/* =====================================================
   PINNED VIEW
===================================================== */

.look-stage {

    position: sticky;

    top: 0;

    height: 100vh;

    width: 100%;

    overflow: hidden;

}


/* =====================================================
   IMAGE VIEWPORT
===================================================== */

.look-visual {

    position: absolute;

    top: 0;

    left: 0;

    width: 62%;

    height: 100%;

    overflow: hidden;

}


/* =====================================================
   IMAGE CARDS
===================================================== */

.look-card {

    position: absolute;

    top: 50%;

    left: 50%;

    width: 42%;

    height: 76%;

    transform-origin: center center;

    overflow: hidden;

    will-change:
        transform,
        filter,
        opacity;

}


.look-card img {

    width: 100%;

    height: 100%;

    object-fit: cover;

    display: block;

}


/* =====================================================
   CARD LABEL
===================================================== */

.current-label {

    position: absolute;

    left: 5vw;

    bottom: 8vh;

    z-index: 30;

    font-size: 10px;

    letter-spacing: .15em;

}


/* =====================================================
   RIGHT DETAILS
===================================================== */

.look-details {

    position: absolute;

    top: 0;

    right: 0;

    width: 38%;

    height: 100%;

    display: flex;

    align-items: center;

    padding: 7vw;

}


.details-item {

    position: absolute;

    left: 7vw;

    right: 5vw;

    top: 50%;

    transform: translateY(-50%);

    opacity: 0;

    will-change:
        opacity,
        transform;

}


.details-item.active {

    opacity: 1;

}


.details-index {

    font-size: 10px;

    margin-bottom: 25px;

    color: #777;

}


.details-title {

    font-size: clamp(40px, 5vw, 75px);

    font-weight: 400;

    line-height: .9;

    margin-bottom: 30px;

}


.details-description {

    max-width: 400px;

    font-size: 12px;

    line-height: 1.8;

    color: #666;

}


/* =====================================================
   PROGRESS
===================================================== */

.look-progress {

    position: absolute;

    right: 5vw;

    bottom: 6vh;

    font-size: 9px;

    letter-spacing: .15em;

    color: #777;

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width: 900px) {


    .category {

        display: block;

        padding: 15vw 6vw;

    }


    .category-image {

        height: 60vh;

    }


    .category-content {

        padding: 40px 0;

    }


    .look-visual {

        width: 100%;

    }


    .look-details {

        width: 100%;

        height: auto;

        bottom: 0;

        top: auto;

        padding: 0 6vw 8vh;

        align-items: flex-end;

        pointer-events: none;

    }


    .details-item {

        left: 6vw;

        right: 6vw;

        top: auto;

        bottom: 8vh;

        transform: translateY(20px);

    }


    .details-title {

        font-size: 45px;

    }


    .look-card {

        width: 58%;

        height: 65%;

    }

}



