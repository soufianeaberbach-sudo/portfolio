      border: 1px solid var(--line);
    }
    .pf-plate__blank::before,
    .pf-plate__blank::after {
      content: '';
      position: absolute;
      width: .7rem;
      height: .7rem;
      border: 1px solid var(--ink);
      opacity: .22;
