        section.innerHTML = `

            <div class="category-image">

                <img
                    src="${category.cover}"
                    alt=""
                >

            </div>


            <div class="category-content">

                <div class="category-number">

                    ${String(index + 1).padStart(2,"0")}
                    /
                    05

