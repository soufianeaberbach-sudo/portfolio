    .pf--js .pf-slot__figure { position: relative; width: 100%; height: 100%; }
    .pf-slot[hidden] { display: none; }
    /* contain, never cover: a head, a hem or a train is never cut off. The
       image backgrounds are white and so is the stage, so the individual
       frames dissolve into one studio instead of reading as tiles. */
    /* pointer-events: none is load-bearing. Without it the first pointermove
       over a slot started a native image drag, the browser fired
       pointercancel, and the gesture died about twelve pixels in. The stage
       owns the whole interaction; the images are not targets. */
    .pf-slot__figure img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      pointer-events: none;
      -webkit-user-drag: none;
    }
    /* The number is stated in the information panel, so on screen this would
       be the same fact twice. It stays in the document for assistive tech,
       which has no panel to read it from. */
    .pf-slot__caption {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Depth: scale and position do the work. The farthest one or two take a
       very restrained blur — enough to sit back, never enough to stop the
       garment being evaluated. */
    .pf-slot[data-depth='3'] { opacity: .96; }
    .pf-slot[data-depth='4'] { opacity: .92; }

