           translated by for a given pointer delta. */
        dragProbe(deltaX: number) {
          const queue = queues.find((q) => !q.panel.hidden) ?? queues[0];
          const before = queue.index;
          queue.stack.style.setProperty('--drag', `${deltaX}px`);
          const applied = getComputedStyle(queue.stack).getPropertyValue('--drag').trim();
          queue.stack.style.setProperty('--drag', '0px');
          return { applied, before };
        },
        goTo(i: number) {
          const queue = queues.find((q) => !q.panel.hidden) ?? queues[0];
          goTo(queue, i);
          return queue.index;
