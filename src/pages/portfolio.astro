---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const image = (id: string, width = 1800) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=${width}&q=84`;

const categories = [
  { key: 'evening', number: '01', title: 'Evening Dresses', image: image('photo-1567631643547-67a2dd59f266'), description: 'Structured bodices, complex drape and fit decisions that only become visible in motion.' },
  { key: 'jersey', number: '02', title: 'Jersey & Knit', image: image('photo-1588497883177-f82b883ad0af'), description: 'Negative ease, recovery and grade rules designed around stretch rather than imposed on it.' },
  { key: 'woven', number: '03', title: 'Woven', image: image('photo-1601597565151-70c4020dc0e1'), description: 'Tailoring, outerwear and shirting resolved for repeatable construction at production scale.' },
  { key: 'sport', number: '04', title: 'Sport', image: image('photo-1574015974293-817f0ebebb74'), description: 'Performance panelling and four-way stretch tested for bodies in motion.' },
  { key: 'swim', number: '05', title: 'Swimwear', image: image('photo-1578353022142-09264fd64295'), description: 'A category where balance, recovery and millimetre-level tolerances leave nowhere to hide.' },
];
---

<SiteLayout title="Portfolio — Soufiane Aberbach" description="A mechanical, scroll-driven fashion development portfolio across evening, jersey, woven, sport and swimwear." marker="SA-PORTFOLIO-V5" page="portfolio">
  <!-- BUILD-MARKER: SA-PORTFOLIO-V5 -->
  <section class="portfolio-hero">
    <div class="portfolio-hero__meta label">Portfolio / 02 <span>Scroll to operate</span></div>
    <div class="portfolio-hero__title" data-reveal>
      <h1 class="display"><span>Port</span><span>folio</span></h1>
    </div>
    <div class="portfolio-hero__copy" data-reveal>
      <p class="eyebrow">Five production categories</p>
      <p>This is not a gallery wall. Each category behaves like a development stack: one layer advances while the last stays visible underneath.</p>
      <div class="portfolio-hero__instruction label"><i aria-hidden="true"><Arrow dir="down" /></i> Scroll / click a category</div>
    </div>
  </section>

  <section class="portfolio-stack-shell section-shell">
    <div class="stack-heading" data-reveal>
      <p class="eyebrow">Mechanical index</p>
      <p class="label">05 categories / fullscreen studies</p>
    </div>
    <div class="stack-stage" data-stack-stage>
      {categories.map((category, index) => (
        <button class="collection-card" type="button" data-category={category.key} style={`--card-index:${index}`} aria-label={`Open ${category.title} collection`}>
          <img src={category.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
          <span class="collection-card__shade"></span>
          <span class="collection-card__top label"><b>{category.number} / 05</b><i>Open collection <Arrow /></i></span>
          <span class="collection-card__copy">
            <strong>{category.title}</strong>
            <small>{category.description}</small>
          </span>
        </button>
      ))}
    </div>
  </section>

  <section class="portfolio-context section-shell section-rule">
    <div data-reveal>
      <p class="eyebrow">What the work represents</p>
      <h2 class="display">Pattern logic.<br /><em>Fit</em> resolution.<br />Production intent.</h2>
    </div>
    <div data-reveal>
      <p>These categories show the kinds of construction and development problems addressed across manufacturing programmes.</p>
      <p>Project exposure through manufacturing contracts at Ava Marie—not direct employment or endorsement. Images are temporary visual references and do not claim authorship of the photographed garments.</p>
      <a class="button" href="/process/">See the working process <span><Arrow /></span></a>
    </div>
  </section>

  <div class="collection-overlay" data-collection-overlay aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="collection-title">
    <div class="collection-overlay__bar">
      <a class="brand" href="/" aria-label="Home"><span>SA</span><i></i></a>
      <p class="label">Collection study <span data-collection-count>01 / 05</span></p>
      <button type="button" data-close-collection>Close <span aria-hidden="true">×</span></button>
    </div>
    <header class="collection-overlay__header">
      <p class="eyebrow" data-collection-kicker>Category</p>
      <h2 class="display" id="collection-title" data-collection-title></h2>
      <p data-collection-description></p>
      <span class="label">Scroll for the look cascade <Arrow dir="down" /></span>
    </header>
    <div class="look-cascade" data-look-cascade></div>
    <div class="collection-overlay__end">
      <p class="label">End of study</p>
      <button class="button button--signal" type="button" data-close-collection>Return to categories <span><Arrow dir="up" /></span></button>
    </div>
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    const collectionData = {
      evening: {
        number: '01 / 05', title: 'Evening Dresses', description: 'Structure and drape are negotiated together: the internal architecture must hold without making the dress feel engineered.',
        looks: [
          ['Look 01', 'Drape / balance', 'photo-1509631179647-0177331693ae'],
          ['Look 02', 'Bodice / support', 'photo-1515886657613-9f3515b0c78f'],
          ['Look 03', 'Volume / movement', 'photo-1721578006568-17901600cff3'],
        ],
      },
      jersey: {
        number: '02 / 05', title: 'Jersey & Knit', description: 'Stretch changes every assumption. Ease, recovery, seam choice and grade rules are designed as a connected system.',
        looks: [
          ['Look 01', 'Recovery / shape', 'photo-1586079615844-c0abfb04dc79'],
          ['Look 02', 'Ease / movement', 'photo-1613915617430-8ab0fd7c6baf'],
          ['Look 03', 'Grade / consistency', 'photo-1731589802397-6a1088d63630'],
        ],
      },
      woven: {
        number: '03 / 05', title: 'Woven', description: 'Repeatable tailoring depends on construction order, controlled volume and a pattern that holds its balance through production.',
        looks: [
          ['Look 01', 'Tailoring / line', 'photo-1662532577856-e8ee8b138a8b'],
          ['Look 02', 'Construction / repeat', 'photo-1457972657980-4c9fddebec8d'],
          ['Look 03', 'Volume / control', 'photo-1612731486606-2614b4d74921'],
        ],
      },
      sport: {
        number: '04 / 05', title: 'Sport', description: 'Performance product is tested against movement: panel lines, stretch direction and recovery have to work on the body.',
        looks: [
          ['Look 01', 'Panel / articulation', 'photo-1574015974293-817f0ebebb74'],
          ['Look 02', 'Stretch / direction', 'photo-1588497883177-f82b883ad0af'],
          ['Look 03', 'Movement / fit', 'photo-1586079615844-c0abfb04dc79'],
        ],
      },
      swim: {
        number: '05 / 05', title: 'Swimwear', description: 'Swimwear exposes imbalance immediately. Recovery, edge tension and coverage are resolved within very small tolerances.',
        looks: [
          ['Look 01', 'Tension / edge', 'photo-1578353022142-09264fd64295'],
          ['Look 02', 'Coverage / balance', 'photo-1601597565151-70c4020dc0e1'],
          ['Look 03', 'Recovery / hold', 'photo-1567631643547-67a2dd59f266'],
        ],
      },
    };

    const portfolioState = { stackTimeline: null, lookTriggers: [], lastFocus: null };
    const imageUrl = (id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1900&q=84`;

    function setCard(card, index, total) {
      card.style.setProperty('--card-index', index);
      card.style.zIndex = String(total + index);
      gsap.set(card, { yPercent: index === 0 ? 0 : 108, rotate: index % 2 ? 1.2 : -1.2 });
    }

    function createTransition(timeline, card, previousCards, index) {
      const position = index - 1;
      timeline.to(previousCards, {
        scale: (itemIndex) => 1 - ((previousCards.length - itemIndex) * .025),
        y: (itemIndex) => -10 * (previousCards.length - itemIndex),
        filter: 'brightness(.72)',
        duration: 1,
        ease: 'none',
      }, position);
      timeline.to(card, { yPercent: 0, rotate: 0, duration: 1, ease: 'none' }, position);
    }

    function initializeMechanicalStack() {
      const stage = document.querySelector('[data-stack-stage]');
      const cards = Array.from(document.querySelectorAll('.collection-card'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!stage || !cards.length || reduce || window.innerWidth < 900) return;

      gsap.registerPlugin(ScrollTrigger);
      stage.classList.add('is-mechanical');
      cards.forEach((card, index) => setCard(card, index, cards.length));

      portfolioState.stackTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: stage,
          start: 'top top+=90',
          end: () => `+=${Math.max(2400, cards.length * window.innerHeight * .72)}`,
          pin: true,
          scrub: .75,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      cards.forEach((card, index) => {
        if (index === 0) return;
        createTransition(portfolioState.stackTimeline, card, cards.slice(0, index), index);
      });
    }

    function createLook(look, index) {
      const article = document.createElement('article');
      article.className = 'look-panel';
      article.innerHTML = `
        <img src="${imageUrl(look[2])}" alt="" loading="lazy">
        <span class="look-panel__shade"></span>
        <div class="look-panel__meta">
          <span class="label">${String(index + 1).padStart(2, '0')} / 03</span>
          <h3>${look[0]}</h3>
          <p>${look[1]}</p>
        </div>`;
      return article;
    }

    function createLookAnimations() {
      portfolioState.lookTriggers.forEach((trigger) => trigger.kill?.());
      portfolioState.lookTriggers = [];
      const overlay = document.querySelector('[data-collection-overlay]');
      const panels = Array.from(document.querySelectorAll('.look-panel'));
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      panels.forEach((panel, index) => {
        const animation = gsap.fromTo(panel.querySelector('img'),
          { scale: 1.12, yPercent: 5 },
          { scale: 1, yPercent: -5, ease: 'none', scrollTrigger: { trigger: panel, scroller: overlay, start: 'top bottom', end: 'bottom top', scrub: true } }
        );
        const reveal = gsap.fromTo(panel.querySelector('.look-panel__meta'),
          { y: 80, opacity: 0 },
          { y: 0, opacity: 1, scrollTrigger: { trigger: panel, scroller: overlay, start: 'top 72%', end: 'top 38%', scrub: .7 } }
        );
        portfolioState.lookTriggers.push(animation.scrollTrigger, reveal.scrollTrigger);
        panel.style.zIndex = String(index + 1);
      });
    }

    function openCollection(category) {
      const data = collectionData[category];
      const overlay = document.querySelector('[data-collection-overlay]');
      if (!data || !overlay) return;
      portfolioState.lastFocus = document.activeElement;
      overlay.querySelector('[data-collection-count]').textContent = data.number;
      overlay.querySelector('[data-collection-kicker]').textContent = `Category ${data.number}`;
      overlay.querySelector('[data-collection-title]').textContent = data.title;
      overlay.querySelector('[data-collection-description]').textContent = data.description;
      const cascade = overlay.querySelector('[data-look-cascade]');
      cascade.replaceChildren(...data.looks.map(createLook));
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-open');
      document.body.classList.add('no-scroll');
      overlay.scrollTop = 0;

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.fromTo(overlay, { clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0% 0 0 0)', duration: .8, ease: 'power4.inOut', onComplete: createLookAnimations });
        gsap.fromTo(overlay.querySelector('.collection-overlay__header h2'), { yPercent: 100 }, { yPercent: 0, duration: .9, delay: .25, ease: 'power4.out' });
      } else {
        overlay.style.clipPath = 'inset(0% 0 0 0)';
      }
      overlay.querySelector('[data-close-collection]')?.focus();
    }

    function closeCollection() {
      const overlay = document.querySelector('[data-collection-overlay]');
      if (!overlay || overlay.getAttribute('aria-hidden') === 'true') return;
      portfolioState.lookTriggers.forEach((trigger) => trigger.kill?.());
      portfolioState.lookTriggers = [];
      const finish = () => {
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        overlay.style.clipPath = '';
        document.body.classList.remove('no-scroll');
        portfolioState.lastFocus?.focus?.();
      };
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.to(overlay, { clipPath: 'inset(0 0 100% 0)', duration: .65, ease: 'power4.inOut', onComplete: finish });
      } else finish();
    }

    document.querySelectorAll('[data-category]').forEach((card) => card.addEventListener('click', () => openCollection(card.dataset.category)));
    document.querySelectorAll('[data-close-collection]').forEach((button) => button.addEventListener('click', closeCollection));
    window.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCollection(); });
    window.addEventListener('load', initializeMechanicalStack, { once: true });

  </script>
</SiteLayout>

<style>
  .portfolio-hero { min-height: 100svh; display: grid; grid-template-columns: 1.35fr .65fr; grid-template-rows: auto 1fr; gap: 3rem 7vw; align-items: end; padding: calc(var(--header-h) + 2rem) var(--gutter) 4rem; background: var(--ink); color: var(--paper); }
  .portfolio-hero__meta { grid-column: 1 / -1; align-self: start; display: flex; justify-content: space-between; color: #8f8e86; }
  .portfolio-hero__title h1 { font-size: clamp(7rem, 17vw, 17rem); }
  .portfolio-hero__title h1 span { display: block; }
  .portfolio-hero__title h1 span:last-child { color: transparent; -webkit-text-stroke: 1.5px var(--paper); }
  .portfolio-hero__copy { padding-bottom: 1rem; }
  .portfolio-hero__copy > p:nth-child(2) { max-width: 31rem; margin: 1.5rem 0 3rem; color: #aaa89f; font-size: 1.1rem; line-height: 1.75; }
  .portfolio-hero__instruction { display: flex; align-items: center; gap: 1rem; }
  .portfolio-hero__instruction i { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid #4b4a44; border-radius: 50%; color: var(--signal); font-style: normal; }
  .portfolio-stack-shell { padding-block: clamp(6rem, 10vw, 10rem); }
  .stack-heading { display: flex; justify-content: space-between; align-items: center; padding-bottom: 2rem; border-bottom: 1px solid var(--line-strong); }
  .stack-stage { display: grid; gap: 1.25rem; padding-top: 2rem; }
  .collection-card { position: relative; min-height: min(76vh, 52rem); width: 100%; padding: 0; overflow: hidden; border: 0; background: #222; color: white; text-align: left; cursor: pointer; isolation: isolate; }
  .collection-card img { position: absolute; z-index: -2; inset: 0; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .collection-card:hover img { transform: scale(1.035); }
  .collection-card__shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.15), rgba(0,0,0,.1) 45%, rgba(0,0,0,.88)); }
  .collection-card__top { position: absolute; top: 0; left: 0; right: 0; display: flex; justify-content: space-between; padding: 1.5rem; }
  .collection-card__top i { color: var(--acid); font-style: normal; }
  .collection-card__copy { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; align-items: end; padding: clamp(1.5rem, 4vw, 4rem); }
  .collection-card__copy strong { font-family: var(--display); font-size: clamp(4rem, 10vw, 10rem); font-weight: 850; letter-spacing: -.07em; line-height: .82; }
  .collection-card__copy small { max-width: 29rem; font-size: .9rem; line-height: 1.65; color: #d4d2ca; }
  .stack-stage.is-mechanical { position: relative; height: calc(100svh - 7rem); min-height: 42rem; padding-top: 0; }
  .stack-stage.is-mechanical .collection-card { position: absolute; inset: 0; min-height: 0; height: 100%; will-change: transform, filter; }
  .portfolio-context { display: grid; grid-template-columns: 1.25fr .75fr; gap: 8vw; padding-block: clamp(7rem, 12vw, 12rem); }
  .portfolio-context h2 { margin-top: 2rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .portfolio-context > div:last-child { align-self: end; }
  .portfolio-context > div:last-child p { color: var(--muted); line-height: 1.75; }
  .portfolio-context .button { margin-top: 2rem; }

  .collection-overlay { position: fixed; z-index: 500; inset: 0; overflow-x: clip; overflow-y: auto; overscroll-behavior: contain; background: var(--ink); color: var(--paper); visibility: hidden; pointer-events: none; clip-path: inset(100% 0 0 0); }
  .collection-overlay.is-open { visibility: visible; pointer-events: auto; }
  .collection-overlay__bar { position: sticky; z-index: 10; top: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 5rem; padding-inline: var(--gutter); border-bottom: 1px solid #3d3d37; background: rgba(17,17,15,.88); backdrop-filter: blur(18px); }
  .collection-overlay__bar > p { color: #96958d; }
  .collection-overlay__bar > p span { color: var(--paper); margin-left: 1rem; }
  .collection-overlay__bar button { justify-self: end; padding: .65rem 0; border: 0; background: transparent; color: white; font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .collection-overlay__bar button span { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; margin-left: .7rem; border: 1px solid #55544d; border-radius: 50%; color: var(--signal); font-size: 1.1rem; }
  .collection-overlay__header { min-height: 90svh; display: grid; grid-template-columns: 1fr .55fr; grid-template-rows: 1fr auto; gap: 3rem 8vw; align-items: end; padding: 8rem var(--gutter) 4rem; overflow: hidden; }
  .collection-overlay__header .eyebrow { grid-column: 1 / -1; align-self: start; }
  .collection-overlay__header h2 { font-size: clamp(6rem, 14vw, 14rem); }
  .collection-overlay__header > p:not(.eyebrow) { max-width: 32rem; color: #aaa89f; font-size: 1.1rem; line-height: 1.75; }
  .collection-overlay__header > span { grid-column: 2; }
  .look-cascade { padding-inline: var(--gutter); }
  .look-panel { position: sticky; top: 5rem; height: calc(100svh - 5rem); overflow: hidden; margin-bottom: 16vh; background: #222; isolation: isolate; }
  .look-panel img { position: absolute; z-index: -2; inset: 0; height: 110%; object-fit: cover; }
  .look-panel__shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.75)); }
  .look-panel__meta { position: absolute; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 3rem; padding: clamp(1.5rem, 4vw, 4rem); }
  .look-panel__meta h3 { margin: 0; font-family: var(--display); font-size: clamp(4.5rem, 10vw, 10rem); letter-spacing: -.07em; line-height: .85; }
  .look-panel__meta p { margin: 0; font-family: var(--mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  .collection-overlay__end { display: flex; justify-content: space-between; align-items: end; gap: 2rem; padding: 8rem var(--gutter); }

  @media (max-width: 900px) {
    .portfolio-hero { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; min-height: 92svh; }
    .portfolio-hero__title h1 { font-size: clamp(6rem, 25vw, 11rem); }
    .collection-card { min-height: 70svh; }
    .collection-card__copy { grid-template-columns: 1fr; gap: 1.5rem; }
    .collection-card__copy strong { font-size: clamp(3.6rem, 15vw, 7rem); }
    .portfolio-context { grid-template-columns: minmax(0, 1fr); }
    .portfolio-context > * { min-width: 0; }
    .collection-overlay__header { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto auto; }
    .collection-overlay__header > span { grid-column: 1; }
    .look-panel__meta { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 600px) {
    .stack-heading { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .collection-card { min-height: 33rem; }
    .collection-card__copy { padding: 1.25rem; }
    .collection-card__copy small { font-size: .78rem; }
    .portfolio-context h2 { font-size: 3.5rem; }
    .collection-overlay__bar { grid-template-columns: 1fr auto; }
    .collection-overlay__bar > p { display: none; }
    .collection-overlay__header { min-height: 80svh; padding-top: 6rem; }
    .collection-overlay__header h2 { font-size: clamp(4.5rem, 20vw, 7rem); }
    .look-cascade { padding-inline: 0; }
    .look-panel { top: 4.5rem; height: calc(100svh - 4.5rem); margin-bottom: 7vh; }
    .collection-overlay__end { align-items: stretch; flex-direction: column; }
  }
</style>
