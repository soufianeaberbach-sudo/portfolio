    .pf-step:hover:not(:disabled) { color: var(--signal); }
    .pf-step[data-step='-1']:hover:not(:disabled) { transform: translateX(-2px); }
    .pf-step[data-step='1']:hover:not(:disabled) { transform: translateX(2px); }
    .pf-step:disabled { opacity: .22; cursor: default; }
    .pf-step:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; }
    .pf-info__counter { margin: 0; letter-spacing: .16em; }
    .pf-info__counter i { color: var(--muted); font-style: normal; }

    .pf-project[hidden] { display: none; }
    .pf-project__number { margin: 1.5rem 0 0; color: var(--signal); }
    .pf-project__title {
      margin: .5rem 0 0;
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(1.35rem, 2.1vw, 1.75rem);
      line-height: 1.1;
      letter-spacing: -.025em;
    }
    .pf-project__profile { margin: 1.5rem 0 0; }
    .pf-project__profile > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
    .pf-project__profile dt {
      margin: 0;
      color: var(--muted);
      font-family: var(--mono);
      font-size: .64rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      line-height: 1.6;
    }
    .pf-project__profile dd { margin: 0; font-size: .92rem; line-height: 1.55; }
    .pf-project__description { margin: 1.25rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-project__tags { margin: 1rem 0 0; color: var(--muted); }
    .pf-project__tags i { font-style: normal; opacity: .5; }

    /* ---------- development evidence ---------- */
    .pf-evidence { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--line-strong); }
    .pf-evidence__head { margin: 0 0 .9rem; color: var(--muted); }
    .pf-evidence__strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; margin: 0; padding: 0; list-style: none; }
    .pf-evidence__item { position: relative; display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
    .pf-evidence__arrow {
      position: absolute;
      left: -.5rem;
      top: .1rem;
      display: inline-flex;
      color: var(--signal);
      transform: translateX(-50%);
    }
    .pf-evidence__arrow .arrow { width: .72rem; height: .72rem; }
    .pf-evidence__plate { display: block; aspect-ratio: 4 / 5; background: var(--pf-paper); border: 1px solid var(--line); }
    .pf-evidence__plate img { width: 100%; height: 100%; object-fit: contain; }
    .pf-evidence__step { color: var(--muted); font-size: .6rem; font-weight: 400; }
    .pf-evidence__name { font-family: var(--display); font-size: .82rem; line-height: 1.2; letter-spacing: -.01em; }
    /* No asset for any stage yet: the strip becomes the same three stages as
       type on a rule. Nothing stands in for work that has not been made. */
    .pf-evidence--type .pf-evidence__strip { border-top: 1px solid var(--line); padding-top: .8rem; }
    .pf-evidence__result { display: flex; align-items: center; gap: .4rem; margin: .9rem 0 0; color: var(--muted); font-family: var(--mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
    .pf-evidence__result .arrow { width: .8rem; height: .8rem; color: var(--signal); }

    /* ---------- menswear / empty worlds ---------- */
    .pf-empty { max-width: var(--max); margin: 0 auto; padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0; }
    .pf-empty__lead { max-width: 34rem; margin: 0; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }
    .pf-empty__list { max-width: 46rem; margin: 2rem 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
    .pf-empty__list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .35rem 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
    .pf-empty__list i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-empty__list span { font-family: var(--display); font-size: 1.1rem; letter-spacing: -.015em; }
    .pf-empty__list small { color: var(--muted); font-size: .88rem; line-height: 1.5; }

    /* ---------- tech packs ---------- */
    .pf-docs {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
      gap: clamp(1.5rem, 3.5vw, 3.5rem);
      align-items: start;
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0;
    }
    /* Sized as a sheet of paper, not as a full-width panel: at column width
       the empty dossier read as a void rather than as a document. */
    .pf-sheet {
      display: flex;
      flex-direction: column;
      max-width: 32rem;
      aspect-ratio: 297 / 210;
      padding: clamp(1.25rem, 2.5vw, 2.25rem);
      border: 1px solid var(--line-strong);
      background: var(--pf-paper);
    }
    .pf-sheet__head, .pf-sheet__foot { display: flex; justify-content: space-between; color: var(--muted); }
    .pf-sheet__head { padding-bottom: .9rem; border-bottom: 1px solid var(--line-strong); }
    .pf-sheet__foot { padding-top: .9rem; border-top: 1px solid var(--line); }
    .pf-sheet__body { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: .5rem; padding: clamp(.75rem, 2vw, 1.4rem) 0; }
    .pf-sheet__body i { display: block; height: 1px; background: var(--line); }
    .pf-sheet__body i:nth-child(1) { width: 34%; background: var(--line-strong); }
    .pf-sheet__body i:nth-child(4) { width: 78%; }
    .pf-sheet__body i:nth-child(6) { width: 61%; }
    .pf-sheet__body i:nth-child(8) { width: 43%; }
    .pf-dossier { margin: 0; }
    .pf-dossier[hidden] { display: none; }
    .pf-dossier img { width: 100%; height: auto; border: 1px solid var(--line); background: var(--pf-paper); }
    .pf-dossier__blank { display: block; aspect-ratio: 297 / 210; border: 1px solid var(--line); background: var(--pf-paper); }
    .pf-dossier figcaption h3 { margin: .4rem 0 1rem; font-family: var(--display); font-size: 1.4rem; letter-spacing: -.02em; }
    .pf-docs__head { margin: 0 0 1rem; color: var(--muted); }
    .pf-docs__head--split { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-strong); }
    .pf-docs__note { margin: 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-docs__list, .pf-contents { margin: 0; padding: 0; list-style: none; }
    .pf-contents li { display: grid; grid-template-columns: 2.1rem minmax(0, 1fr); gap: .25rem .75rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
    .pf-contents li:first-child { border-top: 1px solid var(--line); }
    .pf-contents i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-contents span { font-family: var(--display); font-size: .98rem; letter-spacing: -.01em; }
    .pf-contents small { color: var(--muted); font-size: .84rem; line-height: 1.5; }
    .pf-docs__index .button { margin-top: 1.75rem; }

    /* ---------- 3d simulation ---------- */
    .pf-motion {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      gap: clamp(1.5rem, 3.5vw, 3.5rem);
      align-items: start;
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0;
    }
    .pf-session[hidden] { display: none; }
    /* The children are positioned, not grid-placed. Inside a grid the
       poster's `height: 100%` was cyclic against a content-sized row, so the
       512x910 still kept its intrinsic height, the row grew to 1709px and the
       centred play control was pushed out of the clipped frame. An absolute
       inset resolves against the frame's own border box, which aspect-ratio
       has already made definite. */
    .pf-session__frame {
      position: relative;
      aspect-ratio: 16 / 10;
      background: var(--ink);
      overflow: hidden;
    }
    .pf-session__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .pf-play {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      padding: .75rem 1.1rem;
      border: 1px solid rgba(243, 240, 233, .45);
      background: rgba(17, 17, 15, .58);
      color: var(--paper);
      cursor: pointer;
      transition: background .3s var(--ease), border-color .3s var(--ease);
    }
    .pf-play:hover { background: var(--signal); border-color: var(--signal); color: var(--ink); }
    .pf-play:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-play__mark { width: 0; height: 0; border-left: .6rem solid currentColor; border-top: .38rem solid transparent; border-bottom: .38rem solid transparent; }
    .pf-session__player { position: absolute; inset: 0; z-index: 3; }
    .pf-session__player[hidden] { display: none; }
    .pf-session__player iframe, .pf-session__player video { width: 100%; height: 100%; border: 0; background: var(--ink); }
    .pf-session[data-playing] .pf-session__poster { opacity: 0; }
    .pf-session__meta h3 { margin: 1.25rem 0 0; font-family: var(--display); font-size: clamp(1.3rem, 2.2vw, 1.75rem); letter-spacing: -.025em; }
    .pf-session__meta p { margin: .75rem 0 0; max-width: 40rem; color: var(--ink-soft); line-height: 1.65; }
    .pf-session__labels { color: var(--muted); }
    .pf-session__labels i { font-style: normal; opacity: .5; }
    .pf-session__privacy { color: var(--muted); font-size: .85rem; }
    .pf-motion__head { margin: 0 0 1rem; color: var(--muted); }
    .pf-motion__list { margin: 0; padding: 0; list-style: none; }
    .pf-sessionlink {
      display: grid;
      grid-template-columns: 2.1rem minmax(0, 1fr) auto;
      gap: .75rem;
      align-items: baseline;
      width: 100%;
      padding: .9rem 0;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: none;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      text-align: left;
    }
    .pf-sessionlink:first-child { border-top: 1px solid var(--line); }
    .pf-sessionlink span { font-family: var(--display); font-size: 1rem; letter-spacing: -.01em; }
    .pf-sessionlink small { font-family: var(--mono); font-size: .64rem; }
    .pf-sessionlink[aria-pressed='true'] { color: var(--ink); }
    .pf-sessionlink[aria-pressed='true'] i { color: var(--signal); }
    .pf-sessionlink:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
    .pf-motion__note { margin: 1.5rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }
    .pf-motion__index .button { margin-top: 1.5rem; }

    /* ======================================================================
       RESPONSIVE
       ====================================================================== */

    /* The stage keeps the whole content width from here down, so five complete
       garments still fit at 1024. Above it there is room for the panel beside
       the queue. */
    @media (max-width: 1199px) {
      .pf-viewer, .pf-docs, .pf-motion { grid-template-columns: minmax(0, 1fr); }
    }

    /* ======================================================================
       MOBILE LANDING

       There is no hover to drive an expanding row, and four 95px columns would
       be unreadable. The gates become four full-width horizontal bands, each
       substantial enough to carry its own visual language: number, large
       horizontal title, one line, and a glimpse of what is inside. Not a menu.
       ====================================================================== */
    @media (max-width: 900px) {
      /* There is no hover to drive an expanding row, and four 95px columns
         would be unreadable. The gates become four full-width bands, each a
         stacked composition: number and name, then the band's own visual
         language at full width, then the line and its state. Nothing is
         absolutely positioned over the type — that is what made the first
         attempt print images across the titles. */
      .pf-gates { display: block; height: auto; border-bottom: 0; }
      .pf-gate {
        display: flex;
        flex-direction: column;
        gap: .95rem;
        padding: clamp(1.5rem, 5vw, 2.2rem) var(--gutter) clamp(1.6rem, 5vw, 2.4rem);
        border-left: 0;
        border-bottom: 1px solid var(--line-strong);
      }
      .pf-gate + .pf-gate { border-left: 0; }
      .pf-gate[data-active] { flex-grow: 1; }
      .pf-gate[data-chapter='womenswear'][data-active] { background: none; }

      .pf-gate__mark { width: 0; height: 2px; transition: width .5s var(--ease); }
      .pf-gate[data-active] .pf-gate__mark { width: 4rem; height: 2px; }

      .pf-gate__head { flex-direction: row; align-items: baseline; gap: .8rem; }
      .pf-gate__name { font-size: clamp(2rem, 8.6vw, 2.8rem); }

      /* A band has no hover state, so its cover is always at full presence. */
      .pf-gate__field {
        flex: none;
        height: clamp(9.5rem, 32vw, 13rem);
        opacity: 1;
      }
      .pf-gate__desc { max-width: none; }
      .pf-gate__state,
      .pf-gate__go { opacity: 1; transform: none; }
      .pf-gate__state { max-width: none; }

      .pf-gatetype__row { font-size: clamp(.85rem, 3.4vw, 1.05rem); padding: .3rem 0; }
      .pf-gatesheets__sheet { width: 40%; max-width: 11rem; padding: .55rem; }
      .pf-gatesheets__sheet i { margin-bottom: .3rem; }
      .pf-gatedeck__card:nth-child(3) { right: 2%; max-width: 42%; }
      .pf-gatedeck__card:nth-child(2) { right: 30%; max-width: 36%; }
      .pf-gatedeck__card:nth-child(1) { right: 56%; max-width: 31%; }
    }

    @media (max-width: 1023px) {
      .pf-world__head { grid-template-columns: minmax(0, 1fr); align-items: start; }
      .pf-prov { padding-left: .9rem; }
    }

    @media (max-width: 760px) {
      .pf-session__frame { aspect-ratio: 4 / 5; }
      .pf-viewer { gap: 1.75rem; }
      .pf-info__nav { position: sticky; top: 3.4rem; z-index: 3; background: var(--paper); padding-top: .75rem; }
      /* Three across, still, and sized deliberately rather than shrunk: at
         390px each stage is ~30vw wide, which keeps the label legible. */
      .pf-evidence__strip { gap: .4rem; }
      .pf-evidence__name { font-size: .74rem; }
      .pf-evidence__arrow { left: -.25rem; }
      /* One editorial rail that scrolls, instead of a block of text wrapping
         onto four rows like an old menu. Numbers, type, one signal — no pills,
         no tabs. The rail is edge-to-edge so it reads as a rail, and each
         entry snaps. */
      .pf-cats { padding: 0; }
      .pf-cats ul {
        flex-wrap: nowrap;
        gap: 0 1.4rem;
        padding: 0 var(--gutter);
        overflow-x: auto;
        scroll-snap-type: x proximity;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }
      .pf-cats ul::-webkit-scrollbar { display: none; }
      .pf-cats li { scroll-snap-align: start; flex: none; }
      .pf-cat { padding: .85rem 0; white-space: nowrap; }
      .pf-cat__label { font-size: .95rem; }
      .pf-project__profile > div { grid-template-columns: 6.5rem minmax(0, 1fr); gap: .75rem; }
    }

    @media (max-width: 430px) {
      .pf-cat__label { font-size: .78rem; }
      .pf-evidence__name { font-size: .7rem; }
      .pf-project__profile > div { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
    }

    /* ======================================================================
       REDUCED MOTION — everything still works, nothing moves decoratively.
       ====================================================================== */
    @media (prefers-reduced-motion: reduce) {
      .pf-chapter,
      .pf-chapter::before,
      .pf-chapter__go,
      .pf-preview,
      .pf-slot,
      .pf-stack,
      .pf-world { transition: none !important; }
      .pf--js .pf-world { transform: none; }
      .pf-slot[data-depth='3'],
      .pf-slot[data-depth='4'] { filter: none; }
    }
  </style>
</SiteLayout>
