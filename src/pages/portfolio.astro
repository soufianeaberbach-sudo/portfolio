    .pf-cover__play i {
      width: 0;
      height: 0;
      margin-left: .2rem;
      border-left: .62rem solid var(--paper-bright);
      border-top: .4rem solid transparent;
      border-bottom: .4rem solid transparent;
    }

    /* ======================================================================
       WORLDS
       ====================================================================== */

    /* Fallback (no script): four ordinary sections. Everything is readable,
       scrollable and reachable by the chapter anchors. The section itself is
       not width-capped — the inner blocks are — so the white studio band can
       run edge to edge in both modes. */
    .pf-world {
      padding: clamp(2.5rem, 5vw, 4rem) 0;
      border-top: 1px solid var(--line-strong);
      scroll-margin-top: var(--header-h);
    }
    .pf-world__bar { display: none; }

    /* Enhanced: a full-screen layer. */
    .pf--js .pf-worlds { display: contents; }
    .pf--js .pf-world {
      position: fixed;
      inset: 0;
      z-index: 150;
      padding: 0 0 clamp(3rem, 6vw, 5rem);
      border-top: 0;
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      visibility: hidden;
      transform: translateY(1.25rem);
      /* visibility is stepped, not eased. Transitioning it over .4s meant the
         computed value was still `hidden` for the first frame after data-open
         was set, and focus() is a no-op on a hidden element — which is why
         opening a world left activeElement on <body> and broke the focus trap.
         Opening switches it at 0s; closing delays it until the fade is done so
         the layer does not disappear before it has finished leaving. */
