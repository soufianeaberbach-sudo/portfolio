      .pf-plate { width: 100%; }
    }
    .pf-plate__art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    /* The arrow between one step and the next, drawn in the gap. */
    .pf-plate__link {
      position: absolute;
      left: 50%;
      top: calc(clamp(1.4rem, 2.2vw, 1.9rem) * -1);
      width: 1px;
      height: clamp(1.4rem, 2.2vw, 1.9rem);
      background: var(--line-strong);
