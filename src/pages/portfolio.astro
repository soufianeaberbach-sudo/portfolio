---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

/* Real photography, replacing the Unsplash placeholders.
   Sources live in assets/source/<CATEGORY>/N.png at ~1792x2390 and ~6 MB each
   (297 MB across all 49) — outside public/, so they are versioned but never
   deployed. .devtools/gen-portfolio.sh derives two WebP renditions per source
   into public/portfolio/<key>/N-{900,1400}.webp (7.2 MB in total) and the page
   only ever references those. Regenerate after adding or replacing a source. */
const RENDITIONS = [900, 1400] as const;
const look = (key: string, n: number, width: 900 | 1400 = 1400) => `/portfolio/${key}/${n}-${width}.webp`;
const lookSrcSet = (key: string, n: number) => RENDITIONS.map((w) => `${look(key, n, w)} ${w}w`).join(', ');

const categories = [
  { key: 'evening', number: '01', title: 'Evening Dresses', cover: 1, description: 'Structured bodices, complex drape and fit decisions that only become visible in motion.' },
  { key: 'jersey', number: '02', title: 'Jersey & Knit', cover: 1, description: 'Negative ease, recovery and grade rules designed around stretch rather than imposed on it.' },
  { key: 'woven', number: '03', title: 'Woven', cover: 1, description: 'Tailoring, outerwear and shirting resolved for repeatable construction at production scale.' },
  { key: 'sport', number: '04', title: 'Sport', cover: 1, description: 'Performance panelling and four-way stretch tested for bodies in motion.' },
  { key: 'swim', number: '05', title: 'Swimwear', cover: 1, description: 'A category where balance, recovery and millimetre-level tolerances leave nowhere to hide.' },
];
---

<SiteLayout title="Portfolio — Soufiane Aberbach" description="A mechanical, scroll-driven fashion development portfolio across evening, jersey, woven, sport and swimwear." marker="SA-PORTFOLIO-V5" page="portfolio">
  <!-- BUILD-MARKER: SA-PORTFOLIO-V5 -->
  <section class="portfolio-hero">
    <div class="portfolio-hero__meta label">Portfolio / 02 <span>Scroll to operate</span></div>
    <div class="portfolio-hero__title" data-reveal>
      <h1 class="display"><span>Port</span><span>folio</span></h1>
    </div>
    <div class="portfolio-hero__copy" data-reveal>
      <p class="eyebrow">Five production categories</p>
      <p>This is not a gallery wall. Each category behaves like a development stack: one layer advances while the last stays visible underneath.</p>
      <div class="portfolio-hero__instruction label"><i aria-hidden="true"><Arrow dir="down" /></i> Scroll / click a category</div>
    </div>
  </section>

  <section class="portfolio-stack-shell section-shell">
    <div class="stack-heading" data-reveal>
      <p class="eyebrow">Mechanical index</p>
      <p class="label">05 categories / fullscreen studies</p>
    </div>
    <div class="stack-stage" data-stack-stage>
      {categories.map((category, index) => (
        <button class="collection-card" type="button" data-category={category.key} style={`--card-index:${index}`} aria-label={`Open ${category.title} collection`}>
          <img
            src={look(category.key, category.cover)}
            srcset={lookSrcSet(category.key, category.cover)}
            sizes="(max-width: 768px) 100vw, 60vw"
            alt=""
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="collection-card__shade"></span>
          <span class="collection-card__top label"><b>{category.number} / 05</b><i>Open collection <Arrow /></i></span>
          <span class="collection-card__copy">
            <strong>{category.title}</strong>
            <small>{category.description}</small>
          </span>
        </button>
      ))}
    </div>
  </section>

  <section class="portfolio-context section-shell section-rule">
    <div data-reveal>
      <p class="eyebrow">What the work represents</p>
      <h2 class="display">Pattern logic.<br /><em>Fit</em> resolution.<br />Production intent.</h2>
    </div>
    <div data-reveal>
      <p>These categories show the kinds of construction and development problems addressed across manufacturing programmes.</p>
      <p>Project exposure through manufacturing contracts at Ava Marie—not direct employment or endorsement. Images are temporary visual references and do not claim authorship of the photographed garments.</p>
      <a class="button" href="/process/">See the working process <span><Arrow /></span></a>
    </div>
  </section>

  <div class="collection-overlay" data-collection-overlay aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="collection-title">
    <div class="collection-overlay__bar">
      <a class="brand" href="/" aria-label="Home"><span>SA</span><i></i></a>
      <p class="label">Collection study <span data-collection-count>01 / 05</span></p>
      <button type="button" data-close-collection>Close <span aria-hidden="true">×</span></button>
    </div>
    <header class="collection-overlay__header">
      <p class="eyebrow" data-collection-kicker>Category</p>
      <h2 class="display" id="collection-title" data-collection-title></h2>
      <p data-collection-description></p>
      <span class="label">Drag or scroll through the runway <Arrow dir="down" /></span>
    </header>
    <section class="look-runway" aria-label="Collection looks">
      <div class="look-runway__layout">
        <div class="look-runway__stage" data-runway-stage tabindex="0" aria-label="Drag, swipe or scroll to explore collection looks">
          <div class="look-runway__cards" data-runway-cards></div>
          <p class="look-runway__hint label" aria-hidden="true">Drag to explore ↔</p>
        </div>
        <aside class="look-runway__details" data-runway-details aria-live="polite"></aside>
      </div>
      <div class="look-runway__scrubber" data-runway-scrubber>
        <label class="label" for="collection-scrubber">Scrub collection</label>
        <input id="collection-scrubber" type="range" min="0" max="1" step="0.001" value="0" aria-label="Scrub through collection looks" />
        <span class="label" data-runway-total>03 looks</span>
      </div>
    </section>
    <div class="collection-overlay__end">
      <p class="label">End of study</p>
      <button class="button button--signal" type="button" data-close-collection>Return to categories <span><Arrow dir="up" /></span></button>
    </div>
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    /* Read live rather than once at load: the setting can change mid-session. */
    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const collectionData = {
      evening: {
        number: '01 / 05', title: 'Evening Dresses', description: 'Structure and drape are negotiated together: the internal architecture must hold without making the dress feel engineered.',
        looks: [
          { title: 'Look 01', description: 'Drape / balance', image: 'evening/1' },
          { title: 'Look 02', description: 'Bodice / support', image: 'evening/2' },
          { title: 'Look 03', description: 'Volume / movement', image: 'evening/3' },
          { title: 'Look 04', description: 'Seam / structure', image: 'evening/4' },
          { title: 'Look 05', description: 'Hem / weight', image: 'evening/5' },
          { title: 'Look 06', description: 'Drape / balance', image: 'evening/6' },
          { title: 'Look 07', description: 'Bodice / support', image: 'evening/7' },
          { title: 'Look 08', description: 'Volume / movement', image: 'evening/8' },
          { title: 'Look 09', description: 'Seam / structure', image: 'evening/9' },
          { title: 'Look 10', description: 'Hem / weight', image: 'evening/10' },
        ],
      },
      jersey: {
        number: '02 / 05', title: 'Jersey & Knit', description: 'Stretch changes every assumption. Ease, recovery, seam choice and grade rules are designed as a connected system.',
        looks: [
          { title: 'Look 01', description: 'Recovery / shape', image: 'jersey/1' },
          { title: 'Look 02', description: 'Ease / movement', image: 'jersey/2' },
          { title: 'Look 03', description: 'Grade / consistency', image: 'jersey/3' },
          { title: 'Look 04', description: 'Rib / tension', image: 'jersey/4' },
          { title: 'Look 05', description: 'Neckline / hold', image: 'jersey/5' },
          { title: 'Look 06', description: 'Recovery / shape', image: 'jersey/6' },
          { title: 'Look 07', description: 'Ease / movement', image: 'jersey/7' },
          { title: 'Look 08', description: 'Grade / consistency', image: 'jersey/8' },
          { title: 'Look 09', description: 'Rib / tension', image: 'jersey/9' },
          { title: 'Look 10', description: 'Neckline / hold', image: 'jersey/10' },
        ],
      },
      woven: {
        number: '03 / 05', title: 'Woven', description: 'Repeatable tailoring depends on construction order, controlled volume and a pattern that holds its balance through production.',
        looks: [
          { title: 'Look 01', description: 'Tailoring / line', image: 'woven/1' },
          { title: 'Look 02', description: 'Construction / repeat', image: 'woven/2' },
          { title: 'Look 03', description: 'Volume / control', image: 'woven/3' },
          { title: 'Look 04', description: 'Collar / roll', image: 'woven/4' },
          { title: 'Look 05', description: 'Grain / balance', image: 'woven/5' },
          { title: 'Look 06', description: 'Tailoring / line', image: 'woven/6' },
          { title: 'Look 07', description: 'Construction / repeat', image: 'woven/7' },
          { title: 'Look 08', description: 'Volume / control', image: 'woven/8' },
          { title: 'Look 09', description: 'Collar / roll', image: 'woven/9' },
          { title: 'Look 10', description: 'Grain / balance', image: 'woven/10' },
        ],
      },
      sport: {
        number: '04 / 05', title: 'Sport', description: 'Performance product is tested against movement: panel lines, stretch direction and recovery have to work on the body.',
        looks: [
          { title: 'Look 01', description: 'Panel / articulation', image: 'sport/1' },
          { title: 'Look 02', description: 'Stretch / direction', image: 'sport/2' },
          { title: 'Look 03', description: 'Movement / fit', image: 'sport/3' },
          { title: 'Look 04', description: 'Seam / abrasion', image: 'sport/4' },
          { title: 'Look 05', description: 'Coverage / support', image: 'sport/5' },
          { title: 'Look 06', description: 'Panel / articulation', image: 'sport/6' },
          { title: 'Look 07', description: 'Stretch / direction', image: 'sport/7' },
          { title: 'Look 08', description: 'Movement / fit', image: 'sport/8' },
          { title: 'Look 09', description: 'Seam / abrasion', image: 'sport/9' },
          { title: 'Look 10', description: 'Coverage / support', image: 'sport/10' },
        ],
      },
      swim: {
        number: '05 / 05', title: 'Swimwear', description: 'Swimwear exposes imbalance immediately. Recovery, edge tension and coverage are resolved within very small tolerances.',
        looks: [
          { title: 'Look 01', description: 'Tension / edge', image: 'swim/1' },
          { title: 'Look 02', description: 'Coverage / balance', image: 'swim/2' },
          { title: 'Look 03', description: 'Recovery / hold', image: 'swim/3' },
          { title: 'Look 04', description: 'Elastic / gather', image: 'swim/4' },
          { title: 'Look 05', description: 'Lining / grade', image: 'swim/5' },
          { title: 'Look 06', description: 'Tension / edge', image: 'swim/6' },
          { title: 'Look 07', description: 'Coverage / balance', image: 'swim/7' },
          { title: 'Look 08', description: 'Recovery / hold', image: 'swim/8' },
          { title: 'Look 09', description: 'Elastic / gather', image: 'swim/9' },
        ],
      },
    };

    const portfolioState = { stackTimeline: null, runway: null, lastFocus: null };
    /* One rendition is chosen per session from the viewport, so a phone never
       pulls the 1400w file. The carousel still receives a plain URL string and
       assigns it to img.src exactly as before — no mechanics changed. */
    const RUNWAY_WIDTH = window.matchMedia('(max-width: 768px)').matches ? 900 : 1400;
    const imageUrl = (id) => `/portfolio/${id}-${RUNWAY_WIDTH}.webp`;

    function setCard(card, index, total) {
      card.style.setProperty('--card-index', index);
      card.style.zIndex = String(total + index);
      gsap.set(card, { yPercent: index === 0 ? 0 : 108, rotate: index % 2 ? 1.2 : -1.2 });
    }

    function createTransition(timeline, card, previousCards, index) {
      const position = index - 1;
      timeline.to(previousCards, {
        scale: (itemIndex) => 1 - ((previousCards.length - itemIndex) * .025),
        y: (itemIndex) => -10 * (previousCards.length - itemIndex),
        filter: 'brightness(.72)',
        duration: 1,
        ease: 'none',
      }, position);
      timeline.to(card, { yPercent: 0, rotate: 0, duration: 1, ease: 'none' }, position);
    }

    function initializeMechanicalStack() {
      const stage = document.querySelector('[data-stack-stage]');
      const cards = Array.from(document.querySelectorAll('.collection-card'));
      const reduce = prefersReducedMotion();
      if (!stage || !cards.length || reduce || window.innerWidth < 900) return;

      gsap.registerPlugin(ScrollTrigger);
      stage.classList.add('is-mechanical');
      cards.forEach((card, index) => setCard(card, index, cards.length));

      portfolioState.stackTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: stage,
          start: 'top top+=90',
          end: () => `+=${Math.max(2400, cards.length * window.innerHeight * .72)}`,
          pin: true,
          scrub: .75,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      cards.forEach((card, index) => {
        if (index === 0) return;
        createTransition(portfolioState.stackTimeline, card, cards.slice(0, index), index);
      });
    }

    const modulo = (value, length) => ((value % length) + length) % length;
    const mix = (from, to, progress) => from + ((to - from) * progress);

    function createRunway(initialItems) {
      const stage = document.querySelector('[data-runway-stage]');
      const cardsRoot = document.querySelector('[data-runway-cards]');
      const detailsRoot = document.querySelector('[data-runway-details]');
      const scrubber = document.querySelector('[data-runway-scrubber] input');
      const total = document.querySelector('[data-runway-total]');
      if (!stage || !cardsRoot || !detailsRoot || !scrubber || !total || !initialItems.length) return null;

      const cardNodes = Array.from({ length: 6 }, () => {
        const card = document.createElement('article');
        card.className = 'runway-card';
        const image = document.createElement('img');
        image.alt = '';
        image.draggable = false;
        const shade = document.createElement('span');
        shade.className = 'runway-card__shade';
        card.append(image, shade);
        return card;
      });
      cardsRoot.replaceChildren(...cardNodes);

      const detailNodes = Array.from({ length: 2 }, () => {
        const detail = document.createElement('article');
        detail.className = 'runway-detail';
        const count = document.createElement('span');
        count.className = 'label';
        const title = document.createElement('h3');
        const description = document.createElement('p');
        detail.append(count, title, description);
        return detail;
      });
      detailsRoot.replaceChildren(...detailNodes);

      const state = {
        items: [...initialItems],
        position: 0,
        width: stage.clientWidth,
        frame: 0,
        base: Number.NaN,
        pointerId: null,
        pointerStartX: 0,
        pointerStartPosition: 0,
        scrubbing: false,
        wheelTimer: 0,
        tween: null,
      };

      const slotSet = () => {
        const mobile = window.innerWidth < 700;
        return mobile ? [
          { x: .14, scale: 1, blur: 0, opacity: 1, z: 50 },
          { x: -.13, scale: .79, blur: 0, opacity: .94, z: 40 },
          { x: -.34, scale: .63, blur: 2.5, opacity: .78, z: 30 },
          { x: -.49, scale: .50, blur: 7, opacity: .5, z: 20 },
          { x: -.59, scale: .39, blur: 14, opacity: .22, z: 10 },
          { x: -.67, scale: .32, blur: 21, opacity: 0, z: 5 },
        ] : [
          { x: .20, scale: 1, blur: 0, opacity: 1, z: 50 },
          { x: -.06, scale: .83, blur: 0, opacity: .96, z: 40 },
          { x: -.26, scale: .68, blur: 2.5, opacity: .82, z: 30 },
          { x: -.41, scale: .55, blur: 7, opacity: .56, z: 20 },
          { x: -.52, scale: .44, blur: 15, opacity: .25, z: 10 },
          { x: -.60, scale: .36, blur: 22, opacity: 0, z: 5 },
        ];
      };

      const outgoingState = () => ({ x: window.innerWidth < 700 ? .55 : .62, scale: 1.06, blur: 3.5, opacity: 0, z: 60 });

      function fillDetail(node, item, virtualIndex) {
        node.querySelector('span').textContent = `${String(modulo(virtualIndex, state.items.length) + 1).padStart(2, '0')} / ${String(state.items.length).padStart(2, '0')}`;
        node.querySelector('h3').textContent = item.title;
        node.querySelector('p').textContent = item.description;
      }

      function syncContent(base) {
        if (state.base === base) return;
        state.base = base;
        cardNodes.forEach((card, offset) => {
          const itemIndex = modulo(base + offset, state.items.length);
          const item = state.items[itemIndex];
          const image = card.querySelector('img');
          const source = imageUrl(item.image);
          if (image.src !== source) image.src = source;
          card.dataset.itemIndex = String(itemIndex);
        });
        fillDetail(detailNodes[0], state.items[modulo(base, state.items.length)], base);
        fillDetail(detailNodes[1], state.items[modulo(base + 1, state.items.length)], base + 1);
        /* Nearby only. The six visible cards fetch themselves through their own
           <img> elements; this just warms what is immediately either side. */
        for (let offset = -2; offset <= 2; offset += 1) {
          const nearby = state.items[modulo(base + offset, state.items.length)];
          const preload = new Image();
          preload.src = imageUrl(nearby.image);
        }
      }

      function draw() {
        state.frame = 0;
        const base = Math.floor(state.position);
        const progress = state.position - base;
        const slots = slotSet();
        syncContent(base);

        cardNodes.forEach((card, offset) => {
          const from = offset === 0 ? slots[0] : slots[offset];
          const to = offset === 0 ? outgoingState() : slots[offset - 1];
          const x = mix(from.x, to.x, progress) * state.width;
          const scale = mix(from.scale, to.scale, progress);
          const blur = mix(from.blur, to.blur, progress);
          const opacity = mix(from.opacity, to.opacity, progress);
          card.style.transform = `translate3d(calc(-50% + ${x}px), -50%, 0) scale(${scale})`;
          card.style.filter = `blur(${blur}px)`;
          card.style.opacity = String(opacity);
          card.style.zIndex = String(Math.round(mix(from.z, to.z, progress)));
          card.setAttribute('aria-hidden', opacity < .08 ? 'true' : 'false');
        });

        detailNodes[0].style.opacity = String(1 - progress);
        detailNodes[0].style.transform = `translate3d(0, ${-1.2 * progress}rem, 0)`;
        detailNodes[0].setAttribute('aria-hidden', progress > .55 ? 'true' : 'false');
        detailNodes[1].style.opacity = String(progress);
        detailNodes[1].style.transform = `translate3d(0, ${(1 - progress) * 1.2}rem, 0)`;
        detailNodes[1].setAttribute('aria-hidden', progress < .45 ? 'true' : 'false');

        if (!state.scrubbing) scrubber.value = String(modulo(state.position, state.items.length));
      }

      function scheduleDraw() {
        if (!state.frame) state.frame = requestAnimationFrame(draw);
      }

      function setPosition(value) {
        state.position = Number(value);
        scheduleDraw();
      }

      function snap(origin = null) {
        state.tween?.kill?.();
        const delta = origin === null ? 1 : state.position - origin;
        let target;
        if (origin !== null && Math.abs(delta) < .48) target = origin;
        else if (origin !== null) target = delta > 0 ? Math.ceil(state.position) : Math.floor(state.position);
        else target = Math.round(state.position);
        /* Only the opening wipe used to check this, which left the runway's own
           snapping animated after motion had been disabled. Jump instead. */
        if (prefersReducedMotion()) {
          setPosition(target);
          return;
        }
        state.tween = gsap.to(state, {
          position: target,
          duration: Math.min(.7, .32 + (Math.abs(target - state.position) * .32)),
          ease: 'power3.out',
          onUpdate: scheduleDraw,
        });
      }

      const onPointerDown = (event) => {
        if (event.button !== undefined && event.button !== 0) return;
        state.tween?.kill?.();
        state.pointerId = event.pointerId;
        state.pointerStartX = event.clientX;
        state.pointerStartPosition = state.position;
        stage.setPointerCapture?.(event.pointerId);
        stage.classList.add('is-dragging');
      };
      const onPointerMove = (event) => {
        if (event.pointerId !== state.pointerId) return;
        const distance = Math.max(150, state.width * (window.innerWidth < 700 ? .42 : .30));
        setPosition(state.pointerStartPosition + ((state.pointerStartX - event.clientX) / distance));
      };
      const finishPointer = (event) => {
        if (event.pointerId !== state.pointerId) return;
        stage.releasePointerCapture?.(event.pointerId);
        state.pointerId = null;
        stage.classList.remove('is-dragging');
        snap(state.pointerStartPosition);
      };
      const onWheel = (event) => {
        event.preventDefault();
        state.tween?.kill?.();
        const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
        setPosition(state.position + (delta / 420));
        window.clearTimeout(state.wheelTimer);
        state.wheelTimer = window.setTimeout(() => snap(), 150);
      };
      const onKeyDown = (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        state.tween?.kill?.();
        setPosition(Math.round(state.position) + (event.key === 'ArrowRight' ? 1 : -1));
        snap();
      };
      const onScrubStart = () => { state.scrubbing = true; state.tween?.kill?.(); };
      const onScrub = () => {
        const desired = Number(scrubber.value);
        const nearest = desired + (Math.round((state.position - desired) / state.items.length) * state.items.length);
        setPosition(nearest);
      };
      const onScrubEnd = () => { state.scrubbing = false; snap(); };

      stage.addEventListener('pointerdown', onPointerDown);
      stage.addEventListener('pointermove', onPointerMove);
      stage.addEventListener('pointerup', finishPointer);
      stage.addEventListener('pointercancel', finishPointer);
      stage.addEventListener('wheel', onWheel, { passive: false });
      stage.addEventListener('keydown', onKeyDown);
      scrubber.addEventListener('pointerdown', onScrubStart);
      scrubber.addEventListener('input', onScrub);
      scrubber.addEventListener('change', onScrubEnd);
      scrubber.addEventListener('pointerup', onScrubEnd);

      const resizeObserver = new ResizeObserver(() => { state.width = stage.clientWidth; scheduleDraw(); });
      resizeObserver.observe(stage);

      function replaceItems(items) {
        if (!Array.isArray(items) || items.length < 2) return;
        state.items = [...items];
        state.position = 0;
        state.base = Number.NaN;
        /* length - 1, not length: the old maximum allowed a phantom position
           one past the end that wrapped straight back to Look 01. */
        scrubber.max = String(state.items.length - 1);
        total.textContent = `${String(state.items.length).padStart(2, '0')} looks`;
        scheduleDraw();
      }

      function destroy() {
        state.tween?.kill?.();
        window.clearTimeout(state.wheelTimer);
        if (state.frame) cancelAnimationFrame(state.frame);
        resizeObserver.disconnect();
        stage.removeEventListener('pointerdown', onPointerDown);
        stage.removeEventListener('pointermove', onPointerMove);
        stage.removeEventListener('pointerup', finishPointer);
        stage.removeEventListener('pointercancel', finishPointer);
        stage.removeEventListener('wheel', onWheel);
        stage.removeEventListener('keydown', onKeyDown);
        scrubber.removeEventListener('pointerdown', onScrubStart);
        scrubber.removeEventListener('input', onScrub);
        scrubber.removeEventListener('change', onScrubEnd);
        scrubber.removeEventListener('pointerup', onScrubEnd);
      }

      const controller = {
        destroy,
        replaceItems,
        setPosition,
        snap,
        getItems: () => [...state.items],
        getState: () => ({ position: state.position, activeIndex: modulo(Math.round(state.position), state.items.length), count: state.items.length }),
      };
      replaceItems(initialItems);
      return controller;
    }

    /* Real modal behaviour, no dependency.
     *
     * Two layers, deliberately. `inert` on every ancestor-sibling of the
     * overlay removes the whole background from focus, pointer and assistive
     * tech in one attribute — the correct primitive, supported everywhere
     * current. The Tab cycle below is the fallback for anything that does not
     * honour it, so focus is contained either way. */
    const FOCUSABLE = [
      'a[href]', 'button:not([disabled])', 'input:not([disabled])',
      'select:not([disabled])', 'textarea:not([disabled])', '[tabindex]:not([tabindex="-1"])',
    ].join(',');

    let inertedNodes = [];

    function setBackgroundInert(overlay, on) {
      if (!on) {
        inertedNodes.forEach((el) => el.removeAttribute('inert'));
        inertedNodes = [];
        return;
      }
      inertedNodes = [];
      let node = overlay;
      while (node && node !== document.body) {
        const parent = node.parentElement;
        if (!parent) break;
        for (const sibling of parent.children) {
          if (sibling !== node) inertedNodes.push(sibling);
        }
        node = parent;
      }
      inertedNodes.forEach((el) => el.setAttribute('inert', ''));
    }

    function visibleFocusable(overlay) {
      return [...overlay.querySelectorAll(FOCUSABLE)].filter((el) => {
        if (el.hasAttribute('inert') || el.getAttribute('aria-hidden') === 'true') return false;
        const rect = el.getBoundingClientRect();
        return rect.width > 0 || rect.height > 0;
      });
    }

    function trapTab(event) {
      if (event.key !== 'Tab') return;
      const overlay = document.querySelector('[data-collection-overlay]');
      if (!overlay || overlay.getAttribute('aria-hidden') === 'true') return;
      const items = visibleFocusable(overlay);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (!overlay.contains(active)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
        return;
      }
      if (event.shiftKey && active === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && active === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function openCollection(category, trigger = null) {
      const data = collectionData[category];
      const overlay = document.querySelector('[data-collection-overlay]');
      if (!data || !overlay) return;
      /* The button that opened it, not whatever happened to be focused: a
         mouse click may not focus the card at all. */
      portfolioState.lastFocus = trigger ?? document.activeElement;
      overlay.querySelector('[data-collection-count]').textContent = data.number;
      overlay.querySelector('[data-collection-kicker]').textContent = `Category ${data.number}`;
      overlay.querySelector('[data-collection-title]').textContent = data.title;
      overlay.querySelector('[data-collection-description]').textContent = data.description;
      overlay.setAttribute('aria-hidden', 'false');
      overlay.classList.add('is-open');
      document.body.classList.add('no-scroll');
      setBackgroundInert(overlay, true);
      document.addEventListener('keydown', trapTab, true);
      overlay.scrollTop = 0;
      portfolioState.runway?.destroy?.();
      portfolioState.runway = createRunway(data.looks);
      window.__portfolioRunway = portfolioState.runway;

      if (!prefersReducedMotion()) {
        gsap.fromTo(overlay, { clipPath: 'inset(100% 0 0 0)' }, { clipPath: 'inset(0% 0 0 0)', duration: .8, ease: 'power4.inOut' });
        gsap.fromTo(overlay.querySelector('.collection-overlay__header h2'), { yPercent: 100 }, { yPercent: 0, duration: .9, delay: .25, ease: 'power4.out' });
      } else {
        overlay.style.clipPath = 'inset(0% 0 0 0)';
      }
      overlay.querySelector('[data-close-collection]')?.focus();
    }

    function closeCollection() {
      const overlay = document.querySelector('[data-collection-overlay]');
      if (!overlay || overlay.getAttribute('aria-hidden') === 'true') return;
      const finish = () => {
        portfolioState.runway?.destroy?.();
        portfolioState.runway = null;
        window.__portfolioRunway = null;
        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        overlay.style.clipPath = '';
        document.body.classList.remove('no-scroll');
        /* Inert comes off before the focus call, or the restore target is
           still unfocusable. */
        setBackgroundInert(overlay, false);
        document.removeEventListener('keydown', trapTab, true);
        portfolioState.lastFocus?.focus?.();
        portfolioState.lastFocus = null;
      };
      if (!prefersReducedMotion()) {
        gsap.to(overlay, { clipPath: 'inset(0 0 100% 0)', duration: .65, ease: 'power4.inOut', onComplete: finish });
      } else finish();
    }

    document.querySelectorAll('[data-category]').forEach((card) => card.addEventListener('click', () => openCollection(card.dataset.category, card)));
    document.querySelectorAll('[data-close-collection]').forEach((button) => button.addEventListener('click', closeCollection));
    window.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCollection(); });
    window.addEventListener('load', initializeMechanicalStack, { once: true });

  </script>
</SiteLayout>

