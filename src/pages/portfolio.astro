---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import GarmentWorld from '../components/portfolio/GarmentWorld.astro';
import TechPackWorld from '../components/portfolio/TechPackWorld.astro';
import SimulationWorld from '../components/portfolio/SimulationWorld.astro';
import { chapters, garmentWorlds, techPacks, simulationSessions, womenswear } from '../data/portfolio';

/* ONE garment, not a deck in miniature. The Womenswear cover is a single hero
   composition; a row of three thumbnails turned the landing into a card grid,
   which is exactly what this rebuild removes. The black sequinned column reads
   hardest against the white studio ground. */
const heroGarment = womenswear.categories[3].references[3].image;

const menswearCategories = garmentWorlds[1].categories;
const firstSession = simulationSessions[0];
const openable = (state: string) => state !== 'unpublished';
---

<SiteLayout
  title="Portfolio — Soufiane Aberbach"
  description="Womenswear and menswear product development, production-ready tech packs and CLO3D garment simulation — shown as development evidence, not decoration."
  marker="SA-PORTFOLIO-V7"
  page="portfolio"
>
  <!-- BUILD-MARKER: SA-PORTFOLIO-V7 -->
  <div class="pf" data-pf-root>
    {/* Set before first paint so the enhanced layout never flashes the
        stacked fallback. parentElement is the .pf root, so the flag cannot
        reach any other page. */}
    <script is:inline>
      document.currentScript.parentElement.classList.add('pf--js');
    </script>

    {/* The intro states the proposition and gets out of the way. It used to
        hold most of a screen of beige before the first chapter appeared; the
        first cover now starts within the fold. */}
    <section class="pf-intro" id="portfolio-index">
      <p class="eyebrow">Portfolio / 02</p>
      <h1 class="display pf-intro__title">Four ways to read the work.</h1>
      <p class="pf-intro__lede">
        Product development, technical documentation and digital validation shown as evidence — not decoration.
      </p>
    </section>

    {/* ------------------------------------------------------------------
        FOUR SEQUENTIAL CHAPTER COVERS

        One after another down the page, each the better part of a screen,
        each with its own composition. Not four columns, not a dashboard, not
        a card grid: four covers, the way four chapters of a book have four
        covers.

        Each cover is built from what that chapter actually has:
          01  one hero garment, standing in a white studio
          02  type only — there is no menswear photography here to show, and
              borrowing a womenswear frame would be a false claim
          03  a physical folio: stacked sheets, a bound edge, a demo stamp
          04  a frame from the real CLO3D recording

        Unpublished chapters are <div>, not <a>: the cover is still composed
        and still legible, but there is no empty world to walk into.
       ------------------------------------------------------------------ */}
    <section class="pf-covers" aria-labelledby="pf-covers-title" data-covers>
      <h2 class="pf-sr" id="pf-covers-title">Portfolio chapters</h2>

      {chapters.map((chapter) => {
        const Tag = openable(chapter.publication) ? 'a' : 'div';
        return (
          <Tag
            class="pf-cover"
            href={openable(chapter.publication) ? `#${chapter.id}` : undefined}
            data-chapter={chapter.id}
            data-publication={chapter.publication}
          >
            <span class="pf-cover__art" aria-hidden="true">
              {chapter.id === 'womenswear' && (
                /* One garment. No frame, no shadow, no card — it stands on
                   the studio ground the way it does inside the chapter. */
                <img
                  class="pf-cover__garment"
                  src={heroGarment.src}
                  srcset={heroGarment.srcset}
                  sizes="(max-width: 900px) 92vw, 56vw"
                  width={heroGarment.width}
                  height={heroGarment.height}
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              )}

              {chapter.id === 'menswear' && (
                <span class="pf-covertype">
                  {menswearCategories.map((category) => (
                    <span class="pf-covertype__row">
                      <i>{category.number}</i>
                      <b>{category.label}</b>
                    </span>
                  ))}
                </span>
              )}

              {chapter.id === 'tech-packs' && (
                /* A physical object: three page edges, a bound spine and a
                   printed cover. Drawn entirely from hairlines and offsets —
                   no gloss, no page curl, no blur. */
                <span class="pf-foliomark">
                  <span class="pf-foliomark__leaf"></span>
                  <span class="pf-foliomark__leaf"></span>
                  <span class="pf-foliomark__cover">
                    <span class="pf-foliomark__spine"></span>
                    <span class="pf-foliomark__print">
                      <i class="pf-foliomark__stamp">Demo</i>
                      <i></i><i></i><i></i><i></i>
                    </span>
                  </span>
                </span>
              )}

              {chapter.id === '3d-simulation' && firstSession?.poster && (
                <img
                  class="pf-cover__still"
                  src={firstSession.poster}
                  width="512"
                  height="910"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              )}
            </span>

            <span class="pf-cover__type">
              <i class="pf-cover__num">{chapter.number}</i>
              {chapter.id === '3d-simulation' && (
                <span class="pf-cover__play" aria-hidden="true"><i></i></span>
              )}
              <b class="pf-cover__name">{chapter.title}</b>
              <span class="pf-cover__desc">{chapter.descriptor}</span>
              {chapter.stateNote && <span class="pf-cover__state">{chapter.stateNote}</span>}
              {openable(chapter.publication) && (
                <span class="pf-cover__go label" aria-hidden="true">Open chapter <Arrow /></span>
              )}
            </span>
          </Tag>
        );
      })}
    </section>

    {/* ------------------------------------------------------------------
        THE FOUR WORLDS

        Present in the document, always. With the script running these become
        full-screen layers opened from a cover; without it they are four
        ordinary sections the chapter anchors jump to, carrying every
        category, document and session as real HTML.
       ------------------------------------------------------------------ */}
    <div class="pf-worlds" data-worlds>
      {garmentWorlds.map((world) => <GarmentWorld world={world} />)}
      <TechPackWorld packs={techPacks} />
      <SimulationWorld sessions={simulationSessions} />
    </div>
  </div>

  <script>
    /* --------------------------------------------------------------------
       Portfolio V7 runtime.

       Three independent pieces, each degrading to something readable:
         1. world opening + closing, driven entirely by location.hash
         2. the garment deck: windowing, direct-manipulation drag, keyboard
         3. documents and sessions — nothing is fetched until it is asked for

       The V6 gate-expansion logic is gone, not disabled: the landing is four
       sequential covers now, and a cover has no open state to drive.
       -------------------------------------------------------------------- */
    const root = document.querySelector<HTMLElement>('[data-pf-root]');
    if (root) {
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const chapterLinks = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];

      /* ---- 1. worlds --------------------------------------------------- */
      const worlds = new Map<string, HTMLElement>(
        [...root.querySelectorAll<HTMLElement>('[data-world]')].map((el) => [el.dataset.world!, el]),
      );
      const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
      let openWorld: HTMLElement | null = null;
      let restoreFocusTo: HTMLElement | null = null;

      const setInert = (on: boolean) => {
        for (const el of [document.querySelector('.site-header'), document.querySelector('.site-footer')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
        const index = root.querySelector<HTMLElement>('.pf-covers');
        const intro = root.querySelector<HTMLElement>('.pf-intro');
        for (const el of [index, intro]) if (el) el.toggleAttribute('inert', on);
      };

      const closeWorld = () => {
        if (!openWorld) return;
        openWorld.removeAttribute('data-open');
        openWorld = null;
        document.body.classList.remove('no-scroll');
        setInert(false);
        const target = restoreFocusTo;
        restoreFocusTo = null;
        /* Focus has to land after the layer is gone, or the browser scrolls
           the still-fixed panel instead of the page. */
        if (target && document.contains(target)) target.focus({ preventScroll: true });
      };

      const openWorldById = (id: string) => {
        const next = worlds.get(id);
        if (!next) { closeWorld(); return; }
        if (openWorld === next) return;
        if (openWorld) openWorld.removeAttribute('data-open');
        if (!restoreFocusTo) {
          restoreFocusTo = chapterLinks.find((link) => link.dataset.chapter === id)
            ?? (document.activeElement as HTMLElement | null);
        }
        openWorld = next;
        next.setAttribute('data-open', '');
        document.body.classList.add('no-scroll');
        next.scrollTop = 0;
        /* Order matters twice over here.
           focus() is a no-op on a visibility:hidden element and data-open has
           not been through style recalc yet, so force that first.
           And the focus has to move BEFORE the index is marked inert: the
           chapter cover the visitor just activated lives inside it, and the
           blur the UA performs when a focused element's container becomes
           inert lands after a focus call made on the same tick — which is
           exactly what kept putting activeElement back on <body>. */
        void next.offsetHeight;
        const first = next.querySelector<HTMLElement>(FOCUSABLE);
        (first ?? next).focus({ preventScroll: true });
        setInert(true);
        layoutAll();
      };

      const syncFromHash = () => {
        const id = window.location.hash.replace('#', '');
        if (worlds.has(id)) openWorldById(id);
        else closeWorld();
      };

      /* The chapter covers are real anchors so that the worlds are reachable
         with the script gone. With the script running we take the click over:
         letting the browser perform the fragment navigation meant it also ran
         its own focus handling afterwards, which threw away the focus we had
         just moved into the layer and left activeElement on <body>. pushState
         puts the same URL in the bar without that side effect, and popstate
         below keeps the Back button behaving exactly as before. */
      for (const link of chapterLinks) {
        if (link.tagName !== 'A') continue;
        link.addEventListener('click', (event) => {
          const id = link.dataset.chapter!;
          if (!worlds.has(id)) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || (event as MouseEvent).button !== 0) return;
          event.preventDefault();
          if (window.location.hash !== `#${id}`) window.history.pushState({ world: id }, '', `#${id}`);
          openWorldById(id);
        });
      }

      window.addEventListener('popstate', syncFromHash);

      /* Close returns through history so the browser Back button and the
         in-page control agree about what "back" means. */
      for (const button of root.querySelectorAll<HTMLElement>('[data-world-close]')) {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          if (window.history.length > 1 && window.location.hash) window.history.back();
          else { window.location.hash = ''; syncFromHash(); }
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !openWorld) return;
        event.preventDefault();
        if (window.history.length > 1 && window.location.hash) window.history.back();
        else { window.location.hash = ''; syncFromHash(); }
      });

      /* Focus trap. Only ever active while a layer is open. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab' || !openWorld) return;
        const items = [...openWorld.querySelectorAll<HTMLElement>(FOCUSABLE)]
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        else if (!openWorld.contains(document.activeElement)) { event.preventDefault(); first.focus(); }
      });

      window.addEventListener('hashchange', syncFromHash);

      /* ---- 2. the garment deck ----------------------------------------- */
      /* Geometry, by width. `visible` is the number of garments on screen at
         once; `scales` runs from the furthest card to the leading one, so the
         last entry is always the active card at full size. Nothing is a fixed
         pixel offset — every number below is derived from the measured stage
         width, so the composition breathes instead of being a desktop layout
         shrunk down.

         The rhythm is deliberately shallow: the furthest garment is still 82%
         of the leading one, not a postage stamp. */
      const geometry = () => {
        const w = window.innerWidth;
        if (w >= 1024) return { visible: 5, scales: [0.82, 0.87, 0.91, 0.95, 1] };
        return { visible: 3, scales: [0.90, 0.95, 1] };
      };

      /* 3:4. Measured from the renditions: 39 of 49 are exactly 0.749, and the
         rest letterbox into this canvas rather than being cropped. */
      const CANVAS = 0.75;

      interface Queue {
        panel: HTMLElement;
        stage: HTMLElement;
        stack: HTMLElement;
        slots: HTMLElement[];
        infos: HTMLElement[];
        fronts: number[];
        counter: HTMLElement | null;
        prev: HTMLElement | null;
        next: HTMLElement | null;
        index: number;
        drag: number;
        width: number;
      }

      const queues: Queue[] = [...root.querySelectorAll<HTMLElement>('.pf-panel')].map((panel) => ({
        panel,
        stage: panel.querySelector<HTMLElement>('[data-stage]')!,
        stack: panel.querySelector<HTMLElement>('[data-stack]')!,
        slots: [...panel.querySelectorAll<HTMLElement>('.pf-slot')],
        infos: [...panel.querySelectorAll<HTMLElement>('[data-project-info]')],
        /* How much of each image, from its left edge, must stay uncovered for
           the front view to read completely. Measured per image; see FRONT in
           the data module. */
        fronts: [...panel.querySelectorAll<HTMLElement>('.pf-slot')]
          .map((slot) => Number(slot.dataset.front) || 0.55),
        counter: panel.querySelector<HTMLElement>('[data-counter-current]'),
        prev: panel.querySelector<HTMLElement>('[data-step="-1"]'),
        next: panel.querySelector<HTMLElement>('[data-step="1"]'),
        index: 0,
        drag: 0,
        width: 0,
      }));

      const layout = (queue: Queue) => {
        const { visible, scales } = geometry();
        const stageWidth = queue.stage.clientWidth;
        if (stageWidth === 0) return;

        const nominal = Math.min(visible, queue.slots.length);
        const scale = scales.slice(-nominal);

        /* THE DECK.
           Visual order runs left to right: the furthest upcoming garment on
           the left, the active one flush against the right end. Each card is
           overlapped on its RIGHT by the card in front of it, and the amount
           left showing is that image's own measured front fraction — so what
           stays visible is a complete front view, never half a model. The
           active card has nothing in front of it, so it shows the whole
           photograph: front and back together.

           The leading card's width is solved from the WORST CASE arrangement
           of front fractions in this category rather than from the current
           window. If it were solved per window the active garment would
           resize every time you stepped, because a swimwear frame exposes far
           more of itself than a front-and-back frame does. */
        const widest = [...queue.fronts].sort((a, b) => b - a);
        let span = 1;
        for (let k = 0; k < nominal - 1; k += 1) span += scale[k] * (widest[k] ?? 0.6);
        const width0 = stageWidth / span;
        const height0 = width0 / CANVAS;
        queue.width = width0;
        queue.stage.style.setProperty('--stage-h', `${Math.round(height0 + (nominal - 1) * 6)}px`);

        /* Position k holds the image (index + nominal - 1 - k), so the active
           one lands at the right-hand end. Near the end of a category the
           left-hand positions simply have no image to hold. */
        const placed: Array<{ slot: HTMLElement; k: number; w: number; h: number; x: number }> = [];
        let x = 0;
        for (let k = 0; k < nominal; k += 1) {
          const itemIndex = queue.index + (nominal - 1 - k);
          if (itemIndex >= queue.slots.length) continue;
          const slot = queue.slots[itemIndex];
          const s = scale[k];
          const w = width0 * s;
          const h = height0 * s;
          placed.push({ slot, k, w, h, x });
          const leading = k === nominal - 1;
          x += leading ? w : w * (queue.fronts[itemIndex] ?? 0.6);
        }

        const used = placed.length ? placed[placed.length - 1].x + placed[placed.length - 1].w : 0;
        const offset = Math.max(0, (stageWidth - used) / 2);

        const shown = new Set(placed.map((item) => item.slot));
        for (const slot of queue.slots) if (!shown.has(slot)) slot.hidden = true;

        for (const item of placed) {
          item.slot.hidden = false;
          item.slot.style.setProperty('--x', `${Math.round(offset + item.x)}px`);
          item.slot.style.setProperty('--w', `${Math.round(item.w)}px`);
          item.slot.style.setProperty('--h', `${Math.round(item.h)}px`);
          const depth = nominal - 1 - item.k;
          item.slot.style.setProperty('--lift', `${depth * 6}px`);
          item.slot.dataset.depth = String(depth);
          item.slot.style.zIndex = String(10 + item.k);
        }
      };

      const layoutAll = () => { for (const queue of queues) if (!queue.panel.hidden) layout(queue); };

      const render = (queue: Queue) => {
        queue.infos.forEach((info, i) => { info.hidden = i !== queue.index; });
        queue.slots.forEach((slot, i) => slot.toggleAttribute('data-active', i === queue.index));
        if (queue.counter) {
          const noun = queue.counter.dataset.noun ?? 'Project';
          queue.counter.textContent = `${noun} ${String(queue.index + 1).padStart(2, '0')}`;
        }
        if (queue.prev) (queue.prev as HTMLButtonElement).disabled = queue.index === 0;
        if (queue.next) (queue.next as HTMLButtonElement).disabled = queue.index >= queue.slots.length - 1;
        layout(queue);
      };

      const goTo = (queue: Queue, next: number) => {
        const clamped = Math.max(0, Math.min(queue.slots.length - 1, next));
        if (clamped === queue.index) return;
        queue.index = clamped;
        render(queue);
      };

      for (const queue of queues) {
        if (queue.slots.length === 0) continue;

        queue.prev?.addEventListener('click', () => goTo(queue, queue.index - 1));
        queue.next?.addEventListener('click', () => goTo(queue, queue.index + 1));

        /* Keyboard: the stage is focusable and the arrows drive it. Nothing
           here needs a pointer. */
        queue.stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(queue, queue.index + 1); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(queue, queue.index - 1); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(queue, 0); }
          else if (event.key === 'End') { event.preventDefault(); goTo(queue, queue.slots.length - 1); }
        });

        /* Direct manipulation.
           During the gesture the stack is translated by the SAME SIGN as the
           pointer delta — hand right, cards right. On release, a leftward drag
           past the threshold advances, because dragging left is what pulls the
           next garment into the leading position. */
        let dragging = false;
        let startX = 0;
        let pointerId = -1;

        const resistance = (dx: number) => {
          const atStart = queue.index === 0 && dx > 0;
          const atEnd = queue.index >= queue.slots.length - 1 && dx < 0;
          return (atStart || atEnd) ? dx * 0.3 : dx;
        };

        queue.stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || queue.slots.length < 2) return;
          const target = event.target as HTMLElement;
          if (target.closest('button, a')) return;
          event.preventDefault();
          dragging = true;
          startX = event.clientX;
          pointerId = event.pointerId;
          queue.stage.setPointerCapture(pointerId);
          queue.stack.setAttribute('data-dragging', '');
        });

        queue.stage.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          queue.drag = resistance(event.clientX - startX);
          queue.stack.style.setProperty('--drag', `${queue.drag}px`);
        });

        const endDrag = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          try { queue.stage.releasePointerCapture(pointerId); } catch { /* already released */ }
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
          /* One step of the deck is roughly one card's exposed strip, not a
             whole card, so the commit threshold is a fraction of that rather
             than of the full width. 18% of the leading card is a short,
             deliberate swipe. */
          const threshold = Math.max(44, queue.width * 0.18);
          const travelled = queue.drag;
          queue.drag = 0;
          if (travelled <= -threshold) goTo(queue, queue.index + 1);
          else if (travelled >= threshold) goTo(queue, queue.index - 1);
        };

        queue.stage.addEventListener('pointerup', endDrag);
        /* A cancel is an abort, not a release — it snaps back and changes
           nothing. */
        queue.stage.addEventListener('pointercancel', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          queue.drag = 0;
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
        });

        render(queue);
      }

      /* ---- subchapter index -------------------------------------------- */
      /* The five categories are the first thing inside a garment chapter, as
         large numbered bands. Selecting one swaps the panel below. */
      for (const world of worlds.values()) {
        const buttons = [...world.querySelectorAll<HTMLElement>('[data-category]')];
        const panels = [...world.querySelectorAll<HTMLElement>('[data-panel]')];
        for (const button of buttons) {
          button.addEventListener('click', () => {
            const id = button.dataset.category!;
            for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
            for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
            layoutAll();
          });
        }
      }

      /* ---- 3. documents: one dossier on the table at a time ------------- */
      for (const world of worlds.values()) {
        const books = [...world.querySelectorAll<HTMLElement>('[data-dossier]')];
        if (books.length === 0) continue;
        for (const link of world.querySelectorAll<HTMLElement>('[data-doc]')) {
          link.addEventListener('click', () => {
            const id = link.dataset.doc!;
            for (const other of world.querySelectorAll<HTMLElement>('[data-doc]')) {
              other.setAttribute('aria-pressed', String(other === link));
            }
            for (const book of books) book.hidden = book.dataset.dossier !== id;
          });
        }
      }

      /* ---- 4. sessions: nothing is fetched until play is pressed -------- */
      for (const world of worlds.values()) {
        const sessions = [...world.querySelectorAll<HTMLElement>('[data-session]')];
        for (const link of world.querySelectorAll<HTMLElement>('[data-session-link]')) {
          link.addEventListener('click', () => {
            const id = link.dataset.sessionLink!;
            for (const other of world.querySelectorAll<HTMLElement>('[data-session-link]')) {
              other.setAttribute('aria-pressed', String(other === link));
            }
            for (const session of sessions) session.hidden = session.dataset.session !== id;
          });
        }

        for (const session of sessions) {
          const play = session.querySelector<HTMLElement>('[data-play]');
          const mount = session.querySelector<HTMLElement>('[data-player]');
          if (!play || !mount) continue;
          play.addEventListener('click', () => {
            const youtubeId = session.dataset.youtube;
            const videoSrc = session.dataset.video;
            if (youtubeId) {
              /* Created here and nowhere else. Before this click no request
                 has been made to any Google domain. nocookie is the
                 privacy-enhanced host; autoplay applies to the click that
                 just happened, not to page load. */
              const frame = document.createElement('iframe');
              frame.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
              frame.title = session.querySelector('h3')?.textContent ?? 'Simulation session';
              frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
              frame.setAttribute('allowfullscreen', '');
              frame.setAttribute('loading', 'lazy');
              mount.replaceChildren(frame);
            } else if (videoSrc) {
              /* Same contract for a self-hosted session: no src on the
                 element until now, so the bytes are not fetched on load. */
              const video = document.createElement('video');
              video.src = videoSrc;
              video.controls = true;
              video.autoplay = true;
              video.playsInline = true;
              video.setAttribute('preload', 'auto');
              mount.replaceChildren(video);
            } else {
              return;
            }
            mount.hidden = false;
            session.setAttribute('data-playing', '');
            play.hidden = true;
          });
        }
      }

      /* ---- relayout ---------------------------------------------------- */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutAll, 120);
      });
      window.addEventListener('orientationchange', () => window.setTimeout(layoutAll, 200));
      /* Late webfonts and image decode both change the stage box. */
      window.addEventListener('load', layoutAll);

      layoutAll();
      syncFromHash();

      /* Debug surface for the smoke tests. Mirrors the old
         window.__portfolioRunway contract so the overlay assertions that
         predate V6 keep running, and adds what the deck needs to prove. */
      (window as unknown as Record<string, unknown>).__portfolioRunway = {
        getState() {
