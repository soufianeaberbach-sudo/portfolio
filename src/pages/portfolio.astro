    }
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__type { max-width: 44rem; }
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__num { color: rgba(251, 250, 246, .62); }
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__desc { color: rgba(251, 250, 246, .8); }
    .pf-cover[data-chapter='3d-simulation'] .pf-cover__state { color: rgba(251, 250, 246, .68); }
    .pf-cover__play {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: clamp(2.6rem, 4.4vw, 3.6rem);
      height: clamp(2.6rem, 4.4vw, 3.6rem);
