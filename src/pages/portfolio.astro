    @media (min-width: 1024px) {
      .pf-plate__link { top: calc(clamp(.8rem, 1.1vw, 1rem) * -1); height: clamp(.8rem, 1.1vw, 1rem); }
      .pf-plate__link::after { width: .38rem; height: .38rem; left: -.18rem; }
    }
    .pf-plate__link::after {
      content: '';
      position: absolute;
      left: -.24rem;
      bottom: .1rem;
      width: .5rem;
      height: .5rem;
      border-right: 1px solid var(--signal);
      border-bottom: 1px solid var(--signal);
      transform: rotate(45deg);
    }

    /* A blank plate is a drawing sheet waiting for content: a hairline frame,
       registration ticks at two corners, and its own technical ground. Not an
       empty administrative rectangle. */
    .pf-plate__blank {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding: clamp(.5rem, .8vw, .75rem);
      /* Quiet. This is supporting proof beside a photograph of a garment, and
         a heavy frame around an empty plate competes with the thing it is
         evidence for. */
      border: 1px solid var(--line);
    }
    .pf-plate__blank::before,
    .pf-plate__blank::after {
      content: '';
      position: absolute;
      width: .7rem;
      height: .7rem;
      border: 1px solid var(--ink);
      opacity: .22;
      pointer-events: none;
    }
    .pf-plate__blank::before { left: -1px; top: -1px; border-width: 1px 0 0 1px; }
    .pf-plate__blank::after { right: -1px; bottom: -1px; border-width: 0 1px 1px 0; }
    .pf-plate[data-plate='sketch'] .pf-plate__blank {
      background: repeating-linear-gradient(45deg, transparent 0 9px, rgba(17, 17, 15, .032) 9px 10px);
    }
    .pf-plate[data-plate='pattern'] .pf-plate__blank {
      background:
        repeating-linear-gradient(to right, rgba(17, 17, 15, .045) 0 1px, transparent 1px 26px),
        repeating-linear-gradient(to bottom, rgba(17, 17, 15, .045) 0 1px, transparent 1px 26px);
    }
    .pf-plate[data-plate='simulation'] .pf-plate__blank {
      background-image:
        linear-gradient(to bottom, transparent, rgba(17, 17, 15, .07) 24%, rgba(17, 17, 15, .07) 76%, transparent),
        linear-gradient(to bottom, rgba(17, 17, 15, .035), rgba(17, 17, 15, 0) 62%);
      background-size: 1px 100%, 100% 100%;
      background-position: 50% 0, 0 0;
      background-repeat: no-repeat;
    }
    /* Microtype, not illegible type: the smallest thing on this page is still
       set at about eleven pixels. */
    .pf-plate__stamp {
      padding: .2rem .4rem;
      border: 1px solid var(--line-strong);
      color: var(--muted);
      font-size: .66rem;
      letter-spacing: .18em;
    }
    .pf-plate__label { display: flex; align-items: baseline; gap: .5rem; margin: .5rem 0 0; }
    .pf-plate__label b { flex: none; color: var(--muted); font-weight: 400; font-size: .66rem; letter-spacing: .14em; }
    .pf-plate__label span {
      font-family: var(--display);
      font-size: clamp(.85rem, 1vw, .98rem);
      line-height: 1.15;
      letter-spacing: -.02em;
    }
    .pf-dev__head { font-size: .92em; }

    /* ======================================================================
       EMPTY CHAPTER
       ====================================================================== */
    .pf-empty { max-width: var(--max); margin: 0 auto; padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0; }
    .pf-empty__lead { max-width: 34rem; margin: 0 0 1.75rem; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }

    /* ======================================================================
       TECH PACKS — five documents, one below another
       ====================================================================== */
    .pf-docs {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
      list-style: none;
    }
    .pf-doc {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.25rem, 2.4vw, 2rem);
      align-items: start;
      padding: clamp(2rem, 4vw, 3.25rem) 0;
      border-top: 1px solid var(--line);
    }
    .pf-doc:first-child { border-top: 1px solid var(--line-strong); }
    /* Measured alternation: the document changes side every row, so five
       documents read as a rhythm rather than as one component repeated five
       times. Reading order is unchanged — the preview stays first in the
       markup and only its column moves. */
    @media (min-width: 900px) {
      .pf-doc { grid-template-columns: minmax(0, 1fr) minmax(0, 19rem); gap: clamp(2rem, 4vw, 3.5rem); }
      .pf-doc[data-side='right'] { grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); }
      .pf-doc[data-side='right'] .pf-doc__page { grid-column: 2; grid-row: 1; }
      .pf-doc[data-side='right'] .pf-doc__meta { grid-column: 1; grid-row: 1; text-align: right; }
      .pf-doc[data-side='right'] .pf-doc__open { margin-left: auto; }
    }
    /* The document itself, at a size you can read. One hairline, because a
       sheet of paper has an edge — nothing else is drawn around it. */
    .pf-doc__page { position: relative; display: block; border: 1px solid var(--line-strong); background: var(--pf-paper); color: inherit; text-decoration: none; }
    .pf-doc__page:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-doc__page img { display: block; width: 100%; height: auto; }
    .pf-doc__blank { display: block; aspect-ratio: 297 / 210; }
    .pf-doc__num { margin: 0; color: var(--muted); letter-spacing: .22em; }
    .pf-doc__title {
      margin: .55rem 0 0;
      font-family: var(--display);
      font-size: clamp(1.5rem, 2.4vw, 2rem);
      line-height: 1.02;
      letter-spacing: -.035em;
    }
    .pf-doc__line { margin: .6rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
    .pf-doc__stamp { margin: .9rem 0 0; color: var(--signal); }
    .pf-doc__open {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin-top: 1.6rem;
      padding-bottom: .3rem;
      color: var(--signal);
      text-decoration: none;
      transition: gap .3s var(--ease);
    }
    .pf-doc__open .arrow { width: 1em; height: 1em; }
    .pf-doc__open:hover { gap: 1rem; }
    .pf-doc__open:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

    /* The reader. A layer above the chapter, built on the click that asks for
       a document and torn down again on close. */
    .pf-reader {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      background: var(--paper);
    }
    .pf-reader[hidden] { display: none; }
    .pf-reader__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem var(--gutter);
      border-bottom: 1px solid var(--line-strong);
    }
    .pf-reader__title { margin: 0; color: var(--muted); }
    .pf-reader__tools { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2rem); }
    .pf-reader__close {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
      padding: .35rem 0;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
      font-family: var(--mono);
      font-size: .7rem;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .pf-reader__close:hover { color: var(--signal); }
    .pf-reader__close span { font-size: 1.15rem; line-height: 1; }
    .pf-reader__close:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-reader__mount { flex: 1; min-height: 0; background: var(--ink-soft); }
    .pf-reader__mount object { width: 100%; height: 100%; border: 0; }
    .pf-reader__fallback {
      max-width: 34rem;
      margin: 0;
      padding: clamp(2rem, 5vw, 4rem) var(--gutter);
      color: var(--paper-bright);
      font-size: 1rem;
      line-height: 1.65;
    }
    .pf-reader__fallback a { color: var(--signal); }
    .pf-reader__tab { color: var(--muted); }
    .pf-reader__tab:hover { color: var(--signal); }

    /* ======================================================================
       PATTERN & 3D DEVELOPMENT — the digital workshop

       This chapter is the only one that is not on paper. The whole layer is
       ink, top bar to last hairline, because the work in it happens on a
       screen in a dark room and the chapter should feel like that room rather
       than like a beige page with black rectangles punched into it.

       Same brand, inverted: paper type, warm grey for the second voice, the
       one orange as a signal and nothing else, hairlines as low-opacity paper.
       No blue, no gradient, no glow.
       ====================================================================== */
    .pf-world--motion {
      --pf-ink-line: rgba(251, 250, 246, .14);
      --pf-ink-line-strong: rgba(251, 250, 246, .26);
      --pf-ink-soft: rgba(251, 250, 246, .74);
      --pf-ink-muted: rgba(251, 250, 246, .5);
      background: var(--ink);
      color: var(--paper-bright);
    }
    .pf--js .pf-world--motion { background: var(--ink); }
    .pf-world--motion .pf-bar {
      background: var(--ink);
      border-bottom-color: var(--pf-ink-line);
    }
    .pf-world--motion .pf-bar__tag { color: var(--pf-ink-muted); }
    .pf-world--motion .pf-bar__tag b { color: var(--paper-bright); }
    .pf-world--motion .pf-back { color: var(--paper-bright); }
    .pf-world--motion .pf-back:hover { color: var(--signal); }
    .pf-world--motion .pf-head__descriptor { color: var(--pf-ink-soft); }
    .pf-world--motion .pf-prov { border-left-color: var(--pf-ink-line-strong); }
    .pf-world--motion .pf-prov span { color: var(--pf-ink-muted); }

    /* ---- the video list ---- */
    .pf-videos {
      max-width: 64rem;
      margin: 0 auto;
      padding: 0 var(--gutter) clamp(3rem, 6vw, 6rem);
      list-style: none;
    }
    /* Spacing and hairlines, not boxes: nothing here is a card. */
    .pf-video { padding: clamp(2rem, 4vw, 3.25rem) 0; border-top: 1px solid var(--pf-ink-line); }
    .pf-video:first-child { border-top: 1px solid var(--pf-ink-line-strong); }
    .pf-video:last-child { border-bottom: 1px solid var(--pf-ink-line); }
    .pf-video__head { display: flex; align-items: baseline; gap: clamp(.9rem, 2vw, 1.6rem); margin: 0 0 clamp(.9rem, 1.6vw, 1.3rem); }
    .pf-video__num { flex: none; color: var(--pf-ink-muted); font-style: normal; letter-spacing: .2em; }
    .pf-video__head h3 {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(1.35rem, 2.4vw, 1.9rem);
      line-height: 1.02;
      letter-spacing: -.035em;
    }
    /* Every slot is the same frame at the same width — the format the real
       recordings will arrive in. */
    .pf-video__frame {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      /* A shade off the world's own ink, so the frame reads as a surface
         inside the room rather than as a hole cut in it. One hairline, no
         border on the other three sides and no shadow. */
      background: #17171a;
      border-top: 1px solid var(--pf-ink-line);
    }
    .pf-video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pf-video__pending {
      position: absolute;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
      color: var(--pf-ink-muted);
      letter-spacing: .28em;
      text-align: center;
    }
    .pf-video__frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(45deg, rgba(251, 250, 246, .03) 0 10px, transparent 10px 20px);
      pointer-events: none;
    }
    .pf-video[data-playing] .pf-video__frame::after { display: none; }
    .pf-play {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      padding: .8rem 1.1rem;
      border: 1px solid rgba(251, 250, 246, .55);
      background: rgba(17, 17, 15, .6);
      color: var(--paper-bright);
      cursor: pointer;
      transform: translate(-50%, -50%);
      transition: background .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease);
    }
    .pf-play:hover { background: var(--signal); border-color: var(--signal); color: var(--ink); }
    .pf-play:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-play__mark { width: 0; height: 0; border-left: .6rem solid currentColor; border-top: .38rem solid transparent; border-bottom: .38rem solid transparent; }
    .pf-video__player { position: absolute; inset: 0; z-index: 3; }
    .pf-video__player[hidden] { display: none; }
    .pf-video__player iframe { width: 100%; height: 100%; border: 0; background: #000; }
    .pf-video__desc { max-width: 42rem; margin: clamp(.9rem, 1.6vw, 1.3rem) 0 0; color: var(--pf-ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-video__privacy { margin: .5rem 0 0; color: var(--pf-ink-muted); font-size: .85rem; }

    /* ---- the state before the first recording is published ---- */
    .pf-soon {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) clamp(4rem, 9vw, 8rem);
      border-top: 1px solid var(--pf-ink-line-strong);
    }
    .pf-soon__label { margin: 0; color: var(--signal); letter-spacing: .24em; }
    .pf-soon__lead {
      margin: clamp(1rem, 2vw, 1.6rem) 0 0;
      font-family: var(--display);
      font-variation-settings: 'wdth' 112;
      font-weight: 850;
      font-size: clamp(2.2rem, 6vw, 4.6rem);
      line-height: .9;
      letter-spacing: -.05em;
    }
    .pf-soon__note {
      max-width: 40rem;
      margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
      color: var(--pf-ink-soft);
      font-size: clamp(.95rem, 1.2vw, 1.05rem);
      line-height: 1.65;
    }
    /* The same four steps as the chapter covers, in the dark. */
    .pf-soon__meter {
      display: flex;
      align-items: flex-end;
      gap: clamp(.5rem, .95vw, .85rem);
      height: clamp(3rem, 5.5vw, 4.6rem);
      margin-top: clamp(2rem, 4vw, 3.25rem);
    }
    .pf-soon__meter i { display: block; width: 2px; background: rgba(251, 250, 246, .55); }
    .pf-soon__meter i:nth-child(1) { height: 52%; }
    .pf-soon__meter i:nth-child(2) { height: 66%; }
    .pf-soon__meter i:nth-child(3) { height: 82%; }
    .pf-soon__meter i:nth-child(4) { height: 100%; background: var(--signal); }

    /* ======================================================================
       RESPONSIVE
       ====================================================================== */
    /* Below the two-column viewer the rail becomes a COMPACT STRIP under the
       garments: three equal thumbnails in one row with the arrows between
       them, so the deck stays the dominant image on a phone instead of being
       followed by three screen-wide plates. */
    @media (max-width: 1023px) {
      .pf-dev__plates {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.1rem, 4vw, 1.75rem);
        justify-items: stretch;
      }
      .pf-plate { width: 100%; }
      .pf-plate__link {
        left: calc(clamp(1.1rem, 4vw, 1.75rem) * -1);
        top: 50%;
        width: clamp(1.1rem, 4vw, 1.75rem);
        height: 1px;
        transform: translateY(-50%);
      }
      /* The tick turns to point along the row. */
      .pf-plate__link::after {
        left: auto;
        right: .04rem;
        bottom: auto;
        top: 50%;
        width: .34rem;
        height: .34rem;
        margin-top: -.17rem;
        transform: rotate(-45deg);
      }
      .pf-plate__label { display: block; margin-top: .45rem; }
      .pf-plate__label b { display: block; font-size: .6rem; }
      .pf-plate__label span { display: block; margin-top: .1rem; font-size: clamp(.72rem, 2.6vw, .86rem); }
      .pf-plate__stamp { font-size: .58rem; padding: .16rem .3rem; letter-spacing: .12em; }
      .pf-plate__blank::before, .pf-plate__blank::after { width: .5rem; height: .5rem; }
      .pf-dev__head { margin-bottom: .9rem; }
    }

    @media (max-width: 760px) {
      .pf-covers { gap: 1rem; padding-bottom: 4rem; }
      .pf-cover,
      .pf-cover + .pf-cover {
        min-height: min(78svh, 42rem);
        margin: 0;
      }
      .pf-cover__name { max-width: 9ch; font-size: clamp(2.35rem, 10.2vw, 4rem); }
      .pf-cover__meter { height: 2.8rem; }

      .pf-cats__list { display: block; }
      .pf-cats__list > li,
      .pf-cats__list > li:nth-child(n) { margin: 0 0 1rem; }
      .pf-cat,
      .pf-cats__list > li:nth-child(even) .pf-cat {
        min-height: 0;
        aspect-ratio: 4 / 5;
      }
      .pf-cat__content { min-height: 100%; padding: 1rem; }
      .pf-cat__label { font-size: clamp(2rem, 9vw, 3.2rem); }
      .pf-cat__go { display: block; }
      .pf-cat__blurb { margin: 0; font-size: .82rem; }
      a.pf-cat:hover .pf-cat__label { transform: none; }
    }

    @media (max-width: 430px) {
      .pf-project__profile > div { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
      .pf-bar__tag { max-width: 48vw; text-align: right; }
      .pf-reader__tab { display: none; }
    }

    /* ======================================================================
       REDUCED MOTION — everything still works, nothing moves decoratively.
       ====================================================================== */
    @media (prefers-reduced-motion: reduce) {
      .pf-cover,
      .pf-cover__go,
      .pf-cat,
      .pf-back,
      .pf-slot,
      .pf-stack,
      .pf-step,
      .pf-play,
      .pf-world { transition: none !important; }
      .pf--js .pf-world { transform: none; }
    }
  </style>
</SiteLayout>
