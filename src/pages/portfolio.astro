    }
    .pf-plate__link::after {
      content: '';
      position: absolute;
      left: -.24rem;
      bottom: .1rem;
      width: .5rem;
      height: .5rem;
      border-right: 1px solid var(--signal);
      border-bottom: 1px solid var(--signal);
      transform: rotate(45deg);
