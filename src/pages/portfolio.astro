---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import GarmentWorld from '../components/portfolio/GarmentWorld.astro';
import WomenswearAct from '../components/portfolio/WomenswearAct.astro';
import TechPackWorld from '../components/portfolio/TechPackWorld.astro';
import SimulationWorld from '../components/portfolio/SimulationWorld.astro';
import WorldNavigation from '../components/portfolio/WorldNavigation.astro';
import { chapters, garmentWorlds, techPacks, simulationSessions } from '../data/portfolio';
import '../styles/portfolio-director.css';
import '../styles/portfolio-cinematic.css';
import '../styles/portfolio-womenswear.css';
import type { Subject } from '../data/portfolio';

/* The development-only story lab renders this page with one internal test
   garment added to a territory (see src/pages/lab/[story].astro). The public
   route never passes it. */
interface Props {
  lab?: { category: string; subject: Subject };
}
const { lab } = Astro.props as Props;

/* Every chapter opens. A chapter with nothing published still has an
   architecture worth walking into — its categories are listed, each marked
   pending, and nothing inside claims work that does not exist. Refusing to
   open it hid the structure without making the page any more truthful. */

/* Womenswear's cover is the last frame of the opening — the match cut lands
   on it — so it is the one chapter whose cover is not a section of its own.
   The other three each get one, built to the same composition. */
const [womenswearChapter, ...coverChapters] = chapters;

/* THE ONE HIGHLIGHTED WORD.
   aberbach.co sets exactly one word of a statement in colour — `.display em`
   across the whole site. The Portfolio keeps that signature and swaps the
   colour for the chapter's own sampled token. The word is stored as data
   rather than as markup, so the statement can be proofread as a sentence and
   the split is checked at build time instead of being trusted. */
const split = (statement: string, word: string) => {
  const at = statement.indexOf(word);
  if (at < 0) throw new Error(`"${word}" is not in "${statement}"`);
  return [statement.slice(0, at), word, statement.slice(at + word.length)] as const;
};
---

<SiteLayout
  title="Portfolio — Soufiane Aberbach"
  description="Womenswear and menswear product development, production-ready tech packs and CLO3D garment simulation — shown as development evidence, not decoration."
  marker="SA-PORTFOLIO-V8"
  page="portfolio"
  noindex={!!lab}
>
  <!-- BUILD-MARKER: SA-PORTFOLIO-V8 -->
  {lab && (
    <p class="pf-lab-notice" data-lab-notice>
      <b>Story lab · internal</b>
      The garment is a temporary reference photograph. Every process plate is a placeholder; no evidence is shown.
    </p>
  )}
  {lab && (
    /* The lab opens straight onto its test garment. */
    <script is:inline define:vars={{ target: `#womenswear/${lab.category}/${lab.subject.id}` }}>
      if (!location.hash) history.replaceState(null, '', target);
    </script>
  )}
  <div class="pf" data-pf-root>
    {/* Set before first paint so the enhanced layout never flashes the
        stacked fallback. parentElement is the .pf root, so the flag cannot
        reach any other page. */}
    <script is:inline>
      document.currentScript.parentElement.classList.add('pf--js');
    </script>

    {/* ------------------------------------------------------------------
        THE OPENING.

        One photographic environment, art-directed around the master scene:
        three figures standing in a bone studio that is the same bone as the
        page, so the picture has no frame and no rectangle — the practice is
        simply standing there. The title occupies the clean band the scene
        leaves above the figures; the chapter index and the Womenswear
        entrance are later states of the SAME image plane, not new screens.

        The handoff is a match cut. The woman in red is in both supplied
        scenes at the same camera distance, so the view pushes in on her,
        swaps plates while she is pinned to the same point at the same scale,
        and pulls back into her own frame. See the runtime for the geometry.
        ------------------------------------------------------------------ */}
    <section
      class="pf-cinema"
      id="portfolio-index"
      data-cinema
      data-phase="opening"
      data-active-chapter=""
      aria-labelledby="pf-cinema-title"
    >
      <div class="pf-cinema__sticky">
        {/* ONE IMAGE PLANE. It is the campaign plate, then the index's
            preview field, then the Womenswear entrance. */}
        <div class="pf-cinema__media" data-cinema-media aria-hidden="true">
          <figure class="pf-scene pf-scene--master" data-scene="master" data-image-source="User-supplied master scene">
            <img
              src="/portfolio/master/master-scene.png"
              srcset="/portfolio/master/master-scene-900.webp 900w, /portfolio/master/master-scene-1400.webp 1400w, /portfolio/master/master-scene-1900.webp 1900w"
              sizes="(max-width: 767px) 128vw, 100vw"
              width="1672" height="941" alt=""
              fetchpriority="high" decoding="async"
            />
          </figure>

          {/* The plate the opening cuts to. Same woman, same light, same
              ground — which is what makes the cut read as one camera move. */}
          <figure
            class="pf-scene pf-scene--women"
            data-scene="women"
            data-image-source={womenswearChapter.cover.credit.source}
          >
            <img
              src="/portfolio/master/womenswear-scene.png"
              srcset="/portfolio/master/womenswear-scene-900.webp 900w, /portfolio/master/womenswear-scene-1400.webp 1400w, /portfolio/master/womenswear-scene-1900.webp 1900w"
              sizes="(max-width: 767px) 128vw, 100vw"
              width="1672" height="941" alt=""
              loading="lazy" decoding="async"
            />
          </figure>
        </div>

        {/* THE MASTHEAD — TWO EQUAL FORCES, ONE FAMILY, TWO WIDTHS.
            Archivo is served to this site as a variable font with a WIDTH
            axis of 75..125, and the rest of aberbach.co never leaves 104..112.
            The Portfolio takes the ends of that axis, which is a voice the
            home page cannot have.

            INSTINCT is set expanded and open — eight wide capitals, tracked
            out, breathing. CONSTRUCTION is set condensed and packed — twelve
            narrow capitals, tracked in. At one cap height the two words come
            out the same width and the same weight of ink, so NEITHER
            OUTRANKS THE OTHER: the difference between them is character, not
            size. The ampersand between them is set light at the middle of the
            axis — the hinge the two forces turn on. */}
        <h1 class="pf-cinema__title" id="pf-cinema-title" data-cinema-title>
          <span class="pf-cinema__kicker">Between</span>
          <span class="pf-cinema__instinct">Instinct</span>
          <span class="pf-cinema__amp">&amp;</span>
          <span class="pf-cinema__construction">Construction</span>
        </h1>

        <p class="pf-cinema__thesis" data-cinema-thesis>
          Fashion design, pattern development and technical product work
          — connected from concept to production.
        </p>

        {/* THE WOMENSWEAR COVER. Not a separate screen: the last frame of the
            opening. Its type sits in the negative space the Womenswear plate
            leaves on the left, in ink on the scene's own bone — no dark scrim
            over the photograph. Everything about its geometry is shared with
            the three covers that follow, which is what makes the four read as
            one family rather than four ideas. */}
        <div
          class="pf-women-threshold pf-cover"
          data-women-threshold
          style={`--accent:${womenswearChapter.accent};--subject:${womenswearChapter.subject}`}
          aria-labelledby="womenswear-entry-title"
        >
          <div class="pf-cover__copy pf-women-threshold__copy">
            <p class="pf-cover__rule" aria-hidden="true"></p>
            <h2 class="pf-cover__name" id="womenswear-entry-title">{womenswearChapter.title}</h2>
            <p class="pf-cover__statement">
              {split(womenswearChapter.statement, womenswearChapter.highlight)[0]}
              <em>{womenswearChapter.highlight}</em>
              {split(womenswearChapter.statement, womenswearChapter.highlight)[2]}
            </p>
            <a class="pf-cover__action pf-women-threshold__action label" href="#womenswear" data-nav>
              {womenswearChapter.action} <Arrow />
            </a>
          </div>
        </div>

        <p class="pf-cinema__scroll label" data-cinema-scroll>
          <span>Scroll to open the practice</span><i aria-hidden="true"></i>
        </p>
      </div>
      <span class="pf-cinema__entry-anchor" id="womenswear-entry" aria-hidden="true"></span>
    </section>

    {/* ------------------------------------------------------------------
        THE SEQUENCE.

        Opening → Womenswear → Menswear → Development → Tech Packs → ending.

        Four covers, and nothing between them. The journey travels from
        instinct toward construction: two chapters of design, then the
        development that resolves them, then the documentation that hands them
        over — one practice, four capabilities, in the order the work is made.

        SAME GRAMMAR, DIFFERENT DIALECT. Every cover is the chapter's NAME set
        as the headline, one sentence with one word in the chapter's own
        colour, and one way in — over a plate standing in the right of the
        frame. What differs is how each one behaves: Womenswear moves with the
        garment, Menswear locks to a grid, Development draws itself into
        being, Tech Packs is paper. Those are the chapters' characters, not
        four unrelated ideas.

        The number is NOT repeated here. One control carries the position for
        the whole journey.
        ------------------------------------------------------------------ */}

    {chapters.map((chapter) => {
      /* Womenswear's cover is the frame the opening's match cut lands on, so
         its section is only rendered where that cut cannot happen — motion
         off, or no script at all. Every cover is built from this one block,
         so the four cannot drift apart. */
      const still = chapter.id === womenswearChapter.id;
      const [before, word, after] = split(chapter.statement, chapter.highlight);
      const file = chapter.id === 'tech-packs';
      return (
        <section
          class={`pf-cover pf-cover--section pf-cover--${chapter.id}${still ? ' pf-cover--still' : ''}`}
          id={`cover-${chapter.id}`}
          data-cover={chapter.id}
          style={`--accent:${chapter.accent};--subject:${chapter.subject}`}
          aria-labelledby={`cover-${chapter.id}-name`}
        >
          <div class="pf-cover__frame">
            {/* DEVELOPMENT'S CONSTRUCTION AXIS. One line struck across the
                frame at the garment's own waist, ticked at both ends: the
                axis a pattern is drafted against. It is the only graphic
                mark in the sequence, it carries no numbers, and it is drawn
                as the cover arrives rather than sitting there. Menswear's
                three hairlines, which were decoration standing in for
                structure, are gone. */}
            {chapter.id === '3d-simulation' && (
              <div class="pf-cover__axis" aria-hidden="true"></div>
            )}

            {file ? (
              /* A tech pack is a FILE, so the cover stages one: the supplied
                 cover sheet at the front of a small stack of three more,
                 standing in the same zone the photographic plates occupy. */
              <div class="pf-cover__plate pf-cover__plate--file" data-file-stack>
                <div class="pf-file">
                  <span class="pf-file__sheet pf-file__sheet--d" aria-hidden="true"></span>
                  <span class="pf-file__sheet pf-file__sheet--c" aria-hidden="true"></span>
                  <span class="pf-file__sheet pf-file__sheet--b" aria-hidden="true"></span>
                  {/* Behind the front page, so it slides out from under it. */}
                  <span class="pf-file__tab label" aria-hidden="true">Style file</span>
                  <figure class="pf-file__front" data-image-source={chapter.cover.credit.source}>
                    <img
                      src={chapter.cover.image.src}
                      srcset={chapter.cover.image.srcset}
                      sizes="(max-width: 767px) 84vw, 42vw"
                      width={chapter.cover.image.width}
                      height={chapter.cover.image.height}
                      alt={chapter.cover.image.alt}
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </div>
              </div>
            ) : (
              <figure class="pf-cover__plate" data-image-source={chapter.cover.credit.source}>
                <img
                  src={chapter.cover.image.src}
                  srcset={chapter.cover.image.srcset}
                  sizes="(max-width: 767px) 128vw, 100vw"
                  width={chapter.cover.image.width}
                  height={chapter.cover.image.height}
                  alt={chapter.cover.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            <div class="pf-cover__copy">
              <p class="pf-cover__rule" aria-hidden="true"></p>
              {/* DEVELOPMENT'S DIALECT: the name is drawn before it is filled.
                  `data-echo` renders a second, outlined copy of the word that
                  starts offset and settles onto the solid one as the cover
                  arrives — 2D line becoming a dimensional thing, which is the
                  chapter's whole subject. It is decorative to no one: the
                  echo is a CSS `content` string, so it never reaches the
                  accessibility tree or the page's text. */}
              {/* THE CHAPTER'S NAME, ON THE JOURNEY'S OWN AXIS.
                  The masthead sets INSTINCT at the wide end of Archivo's
                  width axis and CONSTRUCTION at the narrow end. The four
                  chapter titles then travel between those two poles in
                  order — WOMENSWEAR expanded, MENSWEAR at the middle,
                  DEVELOPMENT narrowing, TECH PACKS condensed — so the
                  typography itself moves from instinct toward construction
                  as the visitor does. One family, four voices, no decoration.

                  DEVELOPMENT also carries `data-echo`: a second, outlined
                  copy of the word that starts offset and a degree off true
                  and registers onto the solid one as the cover arrives — a
                  2D line becoming a dimensional thing. It is a CSS `content`
                  string, so it never reaches the accessibility tree. */}
              <h2
                class="pf-cover__name"
                id={`cover-${chapter.id}-name`}
                data-echo={chapter.id === '3d-simulation' ? chapter.title : undefined}
              >{chapter.title}</h2>
              <p class="pf-cover__statement">{before}<em>{word}</em>{after}</p>
              <a class="pf-cover__action label" href={`#${chapter.id}`} data-nav data-chapter={chapter.id}>
                {chapter.action} <Arrow />
              </a>
            </div>
          </div>
        </section>
      );
    })}

    {/* THE ENDING. The visitor has been through all four worlds; repeating
        them as a directory would explain the journey they just took. One line
        resolves it, in the site's own voice and with the site's own single
        coloured word, and one thing to do next. */}
    <section class="pf-outro" id="portfolio-ending" aria-labelledby="pf-outro-title">
      <p class="pf-outro__rule" aria-hidden="true"></p>
      <h2 class="pf-outro__title display" id="pf-outro-title">
        One practice.<br />From design to <em>production</em>.
      </h2>
      <a class="pf-outro__brief button button--signal" href="/contact/">
        Start a brief <span aria-hidden="true"><Arrow /></span>
      </a>
    </section>

    {/* THE ONE PORTFOLIO CONTROL.
        It replaces four separate systems: the cover register, the edge rail,
        the per-chapter contents rails and the ending's directory. At rest it
        says only where you are — `02 / 04 MENSWEAR`. Opened, by pointer or by
        keyboard, it is the four chapters. It is the only place in the journey
        that numbers anything. */}
    <nav class="pf-where" aria-label="Portfolio chapters" data-where hidden>
      <button type="button" class="pf-where__now label" data-where-toggle aria-expanded="false">
        <span class="pf-where__count" data-where-count>01 / 0{chapters.length}</span>
        <span class="pf-where__name" data-where-name>{chapters[0].title}</span>
        <i class="pf-where__caret" aria-hidden="true"></i>
      </button>
      <ol class="pf-where__list" data-where-list>
        {chapters.map((chapter) => (
          <li>
            <a
              href={`#cover-${chapter.id}`}
              data-where-link={chapter.id}
              style={`--accent:${chapter.accent}`}
            >
              <span class="pf-where__n label">{chapter.number}</span>
              <span class="pf-where__label">{chapter.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="pf-worlds" data-worlds>
      {/* ACT I is its own component. Womenswear is no longer a category index
          in front of a viewer; it is a directed sequence of five movements.
          Menswear keeps the two-screen GarmentWorld until its own act is
          written, which is why the two are deliberately separate files rather
          than one component with a mode flag. */}
      {garmentWorlds.map((world) => (
        world.id === 'womenswear' ? <WomenswearAct world={world} lab={lab} /> : <GarmentWorld world={world} />
      ))}
      <SimulationWorld sessions={simulationSessions} />
      <TechPackWorld packs={techPacks} />
    </div>
    <dialog class="pf-evidence-reader" data-evidence-reader aria-labelledby="pf-evidence-title">
      <div class="pf-evidence-reader__bar"><h2 id="pf-evidence-title" class="label"></h2><button type="button" data-evidence-close>Close <span aria-hidden="true">×</span></button></div>
      <div class="pf-evidence-reader__art" data-evidence-mount></div>
      <p class="label" data-evidence-caption></p>
    </dialog>

    {/* Progressive enhancement, made explicit. Every screen of every chapter
        is in the served HTML and readable without a script; this runs before
        first paint and collapses the category viewers so the enhanced page
        shows one screen at a time instead of all of them at once. */}
    <script is:inline>
      for (const el of document.currentScript.parentElement.querySelectorAll('[data-screen="category"]')) {
        el.hidden = true;
      }
    </script>
  </div>

  <script>
    /* ----------------------------------------------------------------------
       THE OPENING, AND THE MATCH CUT INTO WOMENSWEAR.

       One sticky field carries two states of the same image plane:

         opening     the master scene — three figures standing in the page's
                     own bone, with the title in the band above them
         womenswear  the plane pushes in on the woman in red, cuts to her own
                     plate, and pulls back into her frame, which opens the
                     negative space the chapter's cover copy is set in

       There is no index screen between them any more. The opening hands
       straight over to the first chapter's cover, and the three that follow
       are their own sections below it.

       WHY THE CUT WORKS. She appears in both supplied plates at the same
       camera distance — 41.0% of frame width in the master, 42.1% in her own
       — so no scale correction is needed, only a pan. Each plate's
       `transform-origin` is set to HER centre in that plate (measured from
       the files: 26.4% / 75.85% of frame width). A point sits at
       `origin + translate` regardless of scale, so giving the second plate a
       translate of exactly the distance between the two origins pins her to
       the same screen point in both — at every scale, through the whole
       push-in. The crossfade then happens while she is identical in both
       frames, which is what makes it read as one camera move rather than a
       dissolve between two pictures.

       Scroll is never taken: this is a scrubbed timeline, so reading back up
       runs the move backwards through the same frames.
       ---------------------------------------------------------------------- */
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const cinema = document.querySelector<HTMLElement>('[data-cinema]');

    if (cinema && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const media = cinema.querySelector<HTMLElement>('[data-cinema-media]')!;
      const master = cinema.querySelector<HTMLElement>('[data-scene="master"]')!;
      const women = cinema.querySelector<HTMLElement>('[data-scene="women"]')!;
      const title = cinema.querySelector<HTMLElement>('[data-cinema-title]')!;
      const thesis = cinema.querySelector<HTMLElement>('[data-cinema-thesis]')!;
      const cue = cinema.querySelector<HTMLElement>('[data-cinema-scroll]')!;
      const threshold = cinema.querySelector<HTMLElement>('[data-women-threshold]')!;
      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;

      /* Where the woman in red stands in each supplied plate, as a fraction
         of that plate's width. Measured, not estimated. */
      const HER_IN_MASTER = 0.264;
      const HER_IN_WOMEN = 0.7585;
      /* The pan that aligns the two plates, in plate-width units — which is
         what GSAP's xPercent is measured in, so it holds at any scene size. */
      const MATCH = (HER_IN_MASTER - HER_IN_WOMEN) * 100;

      /* The push, and the frame she comes to rest in, are art-directed per
         format. A 16:9 plate inside a tall phone is a band across the middle
         of the screen, so there the camera goes further in and lifts her into
         the upper field, which is where the entrance copy is not. On a wide
         screen the plate already fills the frame and none of that is needed.
         All four values are read at refresh, so a rotation re-derives them. */
      const isTallNarrow = () => window.matchMedia('(max-width: 1023px) and (orientation: portrait)').matches;
      /* The offsets are taken from the VIEWPORT, not from the plate: a plate
         percentage is a different distance at 390 and at 430, which walked her
         head into the plate's dissolved top edge on the larger phone. */
      const PUSH_SCALE = () => (isMobile() ? 2.1 : isTallNarrow() ? 1.7 : 1.42);
      const PUSH_Y = () => window.innerHeight * (isMobile() ? -0.19 : isTallNarrow() ? -0.21 : 0);
      const REST_SCALE = () => (isMobile() ? 1.55 : 1);
      const REST_X = () => window.innerWidth * (isMobile() ? -0.28 : isTallNarrow() ? -0.14 : 0);
      const REST_Y = () => window.innerHeight * (isMobile() ? -0.2 : 0);

      /* Bring her toward the middle of the field for the push-in. The scene
         is wider than the field on small screens, so this is measured rather
         than fixed. */
      const centreOnHer = () => {
        const field = media.getBoundingClientRect().width;
        const scene = master.getBoundingClientRect().width || field;
        const sceneLeft = (field - scene) / 2;
        const target = field * 0.46;
        return ((target - sceneLeft - HER_IN_MASTER * scene) / scene) * 100;
      };

      let push = centreOnHer();
      threshold.setAttribute('inert', '');

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: 'portfolio-cinematic-opening',
          trigger: cinema,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.45,
          invalidateOnRefresh: true,
          onRefresh: () => { push = centreOnHer(); },
          onUpdate: ({ progress }) => {
            const phase = progress > 0.7 ? 'womenswear' : 'opening';
            if (cinema.dataset.phase !== phase) {
              cinema.dataset.phase = phase;
              threshold.toggleAttribute('inert', phase !== 'womenswear');
            }
          },
        },
      });

      /* 1. The opening gives way: the masthead and its standfirst lift out of
            the band they were set in, and the frame is left to the picture. */
      timeline
        .to([cue, thesis], { autoAlpha: 0, y: -14, duration: 0.09 }, 0.04)
        .to(title, { autoAlpha: 0, y: -26, duration: 0.13 }, 0.07);

      /* 2. The push in. The master plate scales about the woman in red, so
            the other two figures leave the frame while she stays put. */
      timeline
        .to(master, { xPercent: () => push, y: PUSH_Y, scale: PUSH_SCALE, duration: 0.4 }, 0.18)
        /* Her plate rides the same push, offset by exactly the distance
           between the two frames' versions of her — travelling in LOCKSTEP
           with the master, not pinned at the final offset. Pinned, the two
           plates only agreed at the very end of the push, so the crossfade
           landed while she was still 70px apart in the two frames and the
           cut showed a ghost. In lockstep she is in the same place at the
           same size in both at EVERY frame, which makes the cut's timing
           forgiving instead of critical. */
        .fromTo(women,
          { xPercent: () => MATCH, x: 0, y: 0, scale: 1, autoAlpha: 0 },
          { xPercent: () => push + MATCH, y: PUSH_Y, scale: PUSH_SCALE, duration: 0.4 }, 0.18)

        /* 3. The cut, made while the two frames agree. */
        .to(women, { autoAlpha: 1, duration: 0.08 }, 0.43)
        .to(master, { autoAlpha: 0, duration: 0.08 }, 0.45)

        /* 4. The pull back: the camera releases the push and pans right until
              she sits in her own frame, which opens the negative space on the
              left that the chapter's cover copy is set in. */
        .to(women, { xPercent: 0, x: REST_X, y: REST_Y, scale: REST_SCALE, duration: 0.24, ease: 'power1.out' }, 0.58)
        .fromTo(threshold,
          { autoAlpha: 0, y: () => (isMobile() ? 16 : 22) },
          { autoAlpha: 1, y: 0, duration: 0.14 }, 0.72);
    } else if (cinema) {
      /* Without motion there is no camera move to land, so the opening stays
         on the master scene and the Womenswear cover is the still section
         below it — the one the stylesheet swaps in for exactly this case. The
         landing frame that will never be reached leaves the page. */
      cinema.querySelector('[data-women-threshold]')?.setAttribute('inert', '');
    }

    /* ----------------------------------------------------------------------
       ONE FILM WHOSE LANGUAGE EVOLVES.

       Not four animation demos. Each world LEAVES in the direction the next
       world ARRIVES from, so the sequence reads as one continuous movement
       whose grammar changes as the work does — from instinct to construction.

         womenswear   FLUID. The frame opens as a band; the type drifts in
                      along the dress's own direction. It leaves travelling
                      RIGHT, along the train.
         menswear     MEASURED. Picks that motion up: the name is wiped in
                      from the LEFT, continuing the same travel, and then
                      nothing drifts again — the plate arrives square. It
                      leaves by closing top and bottom, like a shutter.
         development  DRAWN. Takes that shutter and turns its axis: the plate
                      opens from the SIDES, a drawing being squared up, while
                      an outlined copy of the name registers onto the solid
                      one and the construction axis is struck. It leaves by
                      FLATTENING — the side aperture closes to a slit.
         tech-packs   PAPER. Out of that slit a sheet arrives: no aperture,
                      because paper has none, and a slight widening as the
                      file settles. Construction logic has become a document.
       ---------------------------------------------------------------------- */
    const covers = [...document.querySelectorAll<HTMLElement>('[data-cover]:not(.pf-cover--still)')];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (covers.length > 0 && !still.matches) {
      for (const cover of covers) {
        const plate = cover.querySelector<HTMLElement>('.pf-cover__plate')!;
        const copy = cover.querySelector<HTMLElement>('.pf-cover__copy')!;
        const name = cover.querySelector<HTMLElement>('.pf-cover__name')!;
        const rule = cover.querySelector<HTMLElement>('.pf-cover__rule')!;
        const timeline = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: cover, start: 'top bottom', end: 'bottom top',
            scrub: 0.4, invalidateOnRefresh: true,
          },
        });

        switch (cover.dataset.cover) {
          case 'menswear':
            /* Measured: the plate arrives square — no scale drift, nothing
               drifting sideways. The rule draws across, then the name is
               UNCOVERED from the baseline up rather than moved into place,
               which is how a tailored thing appears: built, not floated. */
            timeline
              .fromTo(plate, { '--aperture': 26 }, { '--aperture': 0, duration: 0.3 }, 0)
              .fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.12 }, 0.16)
              /* Wiped in from the LEFT, continuing the travel Womenswear
                 left on rather than starting a new gesture. */
              .fromTo(name, { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 0.18 }, 0.2)
              .fromTo(copy.querySelectorAll('.pf-cover__statement, .pf-cover__action'),
                { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.1, stagger: 0.03 }, 0.34)
              /* Leaves as a shutter: top and bottom close on the picture. */
              .to(plate, { '--aperture': 22, duration: 0.28 }, 0.7)
              .to(copy, { autoAlpha: 0, duration: 0.16 }, 0.74);
            break;

          case '3d-simulation':
            /* Drawn: the outlined echo of the name is offset and rotated a
               degree off true, and settles onto the solid word. The plate
               opens from the sides as well as the top — a drawing being
               squared up — rather than pushing in. */
            timeline
              .fromTo(plate, { '--aperture': 24, '--aperture-x': 14 },
                { '--aperture': 0, '--aperture-x': 0, duration: 0.32 }, 0)
              .fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.1 }, 0.18)
              .fromTo(name, { '--echo-x': 26, '--echo-y': 16, '--echo-r': -1.1, '--echo-o': 1, autoAlpha: 0 },
                { '--echo-x': 0, '--echo-y': 0, '--echo-r': 0, '--echo-o': 0, autoAlpha: 1, duration: 0.2 }, 0.2)
              /* The construction axis is struck across the frame. */
              .fromTo(cover, { '--axis': 0 }, { '--axis': 1, duration: 0.14 }, 0.28)
              .fromTo(copy.querySelectorAll('.pf-cover__statement, .pf-cover__action'),
                { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.1, stagger: 0.03 }, 0.32)
              /* And it FLATTENS on the way out: the sides close toward a
                 slit, which is the shape the next chapter arrives as. */
              .to(name, { '--echo-x': -18, '--echo-y': -12, '--echo-o': 1, duration: 0.26 }, 0.7)
              .to(cover, { '--axis': 0, duration: 0.12 }, 0.7)
              .to(plate, { '--aperture': 14, '--aperture-x': 24, duration: 0.3 }, 0.7)
              .to(copy, { autoAlpha: 0, duration: 0.16 }, 0.74);
            break;

          case 'tech-packs':
            /* Paper: one object, lifting. No aperture — a sheet does not have
               one — and no scale, because paper does not zoom. */
            timeline
              /* Arrives narrow and widens — out of the slit Development
                 flattened into — and lifts. No aperture: paper has none. */
              .fromTo(plate, { y: () => window.innerHeight * 0.1, scaleX: 0.93, autoAlpha: 0 },
                { y: 0, scaleX: 1, autoAlpha: 1, duration: 0.32 }, 0)
              .fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.1 }, 0.18)
              .fromTo(name, { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 0.14 }, 0.2)
              .fromTo(copy.querySelectorAll('.pf-cover__statement, .pf-cover__action'),
                { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.1, stagger: 0.03 }, 0.32)
              .to(plate, { y: () => window.innerHeight * -0.07, duration: 0.28 }, 0.7)
              .to(copy, { autoAlpha: 0, duration: 0.16 }, 0.74);
            break;

          default:
            /* Fluid — Womenswear's still cover, and the shape any future
               chapter inherits: the band opens and the type drifts in along
               the garment's direction. */
            timeline
              .fromTo(plate, { '--aperture': 30, scale: 1.075 }, { '--aperture': 0, scale: 1, duration: 0.34 }, 0)
              .fromTo(rule, { scaleX: 0 }, { scaleX: 1, duration: 0.12 }, 0.18)
              .fromTo(copy, { autoAlpha: 0, x: -34, y: 30 }, { autoAlpha: 1, x: 0, y: 0, duration: 0.2 }, 0.2)
              .to(plate, { '--aperture': 22, scale: 1.04, duration: 0.3 }, 0.68)
              .to(copy, { autoAlpha: 0, x: 22, y: -20, duration: 0.2 }, 0.72);
        }
      }
    }

    /* ----------------------------------------------------------------------
       THE TECH PACK FILE.

       The stack answers to attention rather than performing on its own: the
       sheets step apart, the front page lifts off them and the shadow under it
       deepens. A pointer over the file also leans it a couple of degrees
       toward the cursor — the only free motion anywhere in the sequence, and
       capped at a few pixels so it reads as weight, not as a toy. Keyboard
       focus on the chapter's action drives the same state through CSS, so the
       file opens for a visitor who never touches a pointer.
       ---------------------------------------------------------------------- */
    const fileCover = document.querySelector<HTMLElement>('[data-cover="tech-packs"]');
    if (fileCover) {
      /* Keyboard parity with the hover state, without :has(). */
      fileCover.addEventListener('focusin', () => {
        const active = document.activeElement;
        if (active instanceof HTMLElement && active.matches(':focus-visible')) {
          fileCover.setAttribute('data-file-open', '');
        }
      });
      fileCover.addEventListener('focusout', () => fileCover.removeAttribute('data-file-open'));
    }

    const stack = document.querySelector<HTMLElement>('[data-file-stack] .pf-file');
    if (stack && !still.matches && window.matchMedia('(hover: hover)').matches) {
      const TILT = 1.1;
      const SHIFT = 7;
      let frame = 0;
      const lean = (event: PointerEvent) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const box = stack.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width - 0.5;
          const y = (event.clientY - box.top) / box.height - 0.5;
          stack.style.setProperty('--lean-x', `${(x * TILT).toFixed(2)}deg`);
          stack.style.setProperty('--lean-y', `${(-y * TILT).toFixed(2)}deg`);
          stack.style.setProperty('--lean-px', `${(x * SHIFT).toFixed(1)}px`);
          stack.style.setProperty('--lean-py', `${(y * SHIFT).toFixed(1)}px`);
        });
      };
      const settle = () => {
        cancelAnimationFrame(frame);
        frame = 0;
        for (const prop of ['--lean-x', '--lean-y', '--lean-px', '--lean-py']) stack.style.removeProperty(prop);
      };
      stack.addEventListener('pointermove', lean);
      stack.addEventListener('pointerleave', settle);
      stack.closest('.pf-cover')?.addEventListener('focusout', settle);
    }

    /* ----------------------------------------------------------------------
       THE ONE PORTFOLIO CONTROL.

       It replaces four systems: the cover register, the edge rail, the
       per-chapter contents rails and the ending's directory. At rest it says
       only where you are. Opened — pointer or keyboard — it is the four
       chapters. Nothing else in the journey numbers anything.
       ---------------------------------------------------------------------- */
    const where = document.querySelector<HTMLElement>('[data-where]');
    if (where && 'IntersectionObserver' in window) {
      where.hidden = false;
      const toggle = where.querySelector<HTMLButtonElement>('[data-where-toggle]')!;
      const count = where.querySelector<HTMLElement>('[data-where-count]')!;
      const label = where.querySelector<HTMLElement>('[data-where-name]')!;
      const links = new Map(
        [...where.querySelectorAll<HTMLAnchorElement>('[data-where-link]')].map((a) => [a.dataset.whereLink!, a]),
      );
      const total = String(links.size).padStart(2, '0');

      const close = () => { where.removeAttribute('data-open'); toggle.setAttribute('aria-expanded', 'false'); };
      let byPointer = false;
      const open = () => { where.setAttribute('data-open', ''); toggle.setAttribute('aria-expanded', 'true'); };
      /* A click CONFIRMS what hover has already opened rather than undoing it.
         With a plain toggle, a mouse user whose approach had opened the list
         closed it again by clicking the control — the one gesture that should
         never shut it. A click that lands on a pointer-opened list therefore
         keeps it open and simply takes ownership of it. */
      toggle.addEventListener('click', () => {
        if (where.hasAttribute('data-open')) {
          if (byPointer) { byPointer = false; return; }
          close();
          return;
        }
        open();
      });
      /* A HOVERING pointer opens it on approach and closes it on leaving. On
         touch it must not: a tap fires pointerenter, then click, then
         pointerleave, so the control opened and shut again in one gesture and
         the phone could never reach the list. There, the button is the whole
         interaction. */
      if (window.matchMedia('(hover: hover)').matches) {
        where.addEventListener('pointerenter', () => { byPointer = true; open(); });
        where.addEventListener('pointerleave', () => { byPointer = false; close(); });
      }
      where.addEventListener('focusout', (event) => {
        if (!where.contains(event.relatedTarget as Node)) close();
      });
      where.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') { close(); toggle.focus(); }
      });
      /* Its own links jump to a cover; the browser's smooth scrolling is
         already on, and the covers carry ids for exactly this. */
      for (const link of links.values()) link.addEventListener('click', close);

      let current: string | null = null;
      const mark = (id: string | null) => {
        if (id === current) return;
        current = id;
        for (const [key, link] of links) {
          if (key === id) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        }
        const link = id ? links.get(id) : null;
        where.dataset.live = link ? 'true' : 'false';
        if (!link) return;
        const chapter = [...links.keys()].indexOf(id!);
        count.textContent = `${String(chapter + 1).padStart(2, '0')} / ${total}`;
        label.textContent = link.querySelector('.pf-where__label')!.textContent ?? '';
        where.style.setProperty('--accent', getComputedStyle(link).getPropertyValue('--accent'));
      };

      /* Which cover owns the screen. The opening is not a chapter, so while it
         is on screen the control says nothing and stays out of the way. */
      const zones = [...document.querySelectorAll<HTMLElement>('[data-cover]')]
        .filter((el) => getComputedStyle(el).display !== 'none');
      const seen = new Map<Element, number>();
      const watcher = new IntersectionObserver((entries) => {
        for (const entry of entries) seen.set(entry.target, entry.intersectionRatio);
        let best: HTMLElement | null = null;
        let bestRatio = 0.3;
        for (const zone of zones) {
          const ratio = seen.get(zone) ?? 0;
          if (ratio > bestRatio) { bestRatio = ratio; best = zone; }
        }
        mark(best?.dataset.cover ?? null);
      }, { threshold: [0, 0.3, 0.55, 0.8] });
      for (const zone of zones) watcher.observe(zone);

      /* The Womenswear cover is the opening's landing frame when there is a
         cut to land, and that frame is not a section an observer can watch —
         so the opening's own phase reports it. */
      const cinemaEl = document.querySelector<HTMLElement>('[data-cinema]');
      if (cinemaEl && !zones.some((z) => z.dataset.cover === 'womenswear')) {
        new MutationObserver(() => {
          if (cinemaEl.dataset.phase === 'womenswear') mark('womenswear');
          else if (current === 'womenswear') mark(null);
        }).observe(cinemaEl, { attributes: true, attributeFilter: ['data-phase'] });
      }
    }
  </script>

  <script>
    /* --------------------------------------------------------------------
       Portfolio V8 runtime.

       The navigation is three levels deep and the URL carries all of it:

         #                      the portfolio index
         #womenswear            that chapter's CATEGORY INDEX
         #womenswear/evening    one category's garment viewer

       Everything else — the deck, the documents, the video slots — is driven
       from that one piece of state, so Back always steps back exactly one
       level and a reload lands where the visitor was.
       -------------------------------------------------------------------- */
      const root = document.querySelector<HTMLElement>('[data-pf-root]');
    if (root) {
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      /* Has the visitor done anything yet? A level opened by the page's own
         address is the page initialising, not the visitor choosing. */
      let visitorActed = false;
      for (const type of ['pointerdown', 'keydown'] as const) {
        window.addEventListener(type, () => { visitorActed = true; }, { capture: true, once: true });
      }
      const chapterLinks = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];

      /* ---- 1. chapters and screens ------------------------------------ */
      const worlds = new Map<string, HTMLElement>(
        [...root.querySelectorAll<HTMLElement>('[data-world]')].map((el) => [el.dataset.world!, el]),
      );
      const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
      let openWorld: HTMLElement | null = null;
      let restoreFocusTo: HTMLElement | null = null;
      const evidenceReader = root.querySelector<HTMLDialogElement>('[data-evidence-reader]')!;
      let evidenceOpener: HTMLElement | null = null;
      const closeEvidence = () => {
        evidenceReader.close();
        evidenceReader.querySelector('[data-evidence-mount]')?.replaceChildren();
        evidenceOpener?.focus({ preventScroll: true });
      };
      evidenceReader.querySelector('[data-evidence-close]')?.addEventListener('click', closeEvidence);
      evidenceReader.addEventListener('cancel', (event) => { event.preventDefault(); closeEvidence(); });
      for (const opener of root.querySelectorAll<HTMLElement>('[data-evidence-open]')) {
        opener.addEventListener('click', () => {
          evidenceOpener = opener;
          evidenceReader.querySelector('#pf-evidence-title')!.textContent = opener.dataset.evidenceTitle ?? '';
          const art = opener.querySelector('img,.pf-plate__blank')!;
          evidenceReader.querySelector('[data-evidence-mount]')!.replaceChildren(art.cloneNode(true));
          evidenceReader.querySelector('[data-evidence-caption]')!.textContent =
            opener.hasAttribute('data-evidence-demo') ? 'Demo plate / No project evidence supplied' : 'Development evidence / Full image';
          evidenceReader.showModal();
        });
      }

      const setInert = (on: boolean) => {
        for (const el of [document.querySelector('.site-header'), document.querySelector('.site-footer')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
        /* Everything the sequence is made of. A chapter opens over the page,
           so the opening, the four covers, their contents rails, the ending
           and the position marker all leave the focus order behind it. */
        for (const el of root.querySelectorAll<HTMLElement>(
          '.pf-cinema, .pf-cover--section, .pf-outro, .pf-where',
        )) {
          el.toggleAttribute('inert', on);
        }
      };

      /* ----------------------------------------------------------------
         THE GARMENT LAYER.

         A chapter's ranges are ways INTO the work, so choosing a garment opens
         that garment's own short film. It is a layer inside the chapter — the
         same ground, the same furniture, the same territory — and it is the
         deepest of four levels: portfolio, chapter, territory, garment.

         All of it is server-rendered and simply hidden, so the markup is
         addressable, the images are real images, and nothing here invents a
         stage a project did not supply.
         ---------------------------------------------------------------- */
      let openSubject: HTMLElement | null = null;
      let subjectReturnTo: HTMLElement | null = null;
      /* THE DOOR THE VISITOR USED, so leaving a garment puts them back on the
         frame they chose rather than at the top of the range. Recorded from
         the door itself rather than from the focus, because a garment can be
         opened by a click that never moved the focus — and by a pasted URL,
         where there is no door at all and nothing to return to. */
      for (const door of root.querySelectorAll<HTMLElement>('[data-open-subject]')) {
        door.addEventListener('click', () => { subjectReturnTo = door; });
      }

      /* THE FRAME A DOOR STANDS FOR. A range door wraps its picture; a deck
         or pair door lies over it as a sibling; a hero's "Enter this garment"
         is a line of type whose garment is the scene's own plate. The layer
         opens out of, and closes back into, the picture — never the label. */
      const frameOf = (door: HTMLElement): HTMLElement =>
        door.querySelector<HTMLElement>('[data-door-source]')
        ?? door.parentElement?.querySelector<HTMLElement>('[data-door-source]')
        ?? door.closest('.pf-sc__frame')?.querySelector<HTMLElement>('figure')
        ?? door;
      const shown = (el: HTMLElement) => {
        const box = el.getBoundingClientRect();
        return box.width > 0 && box.height > 0;
      };
      /* The rect as a clip, in viewport percentages: the four numbers the
         layer is clipped to while it grows out of, or back into, a frame. */
      const insetOf = (el: HTMLElement) => {
        const box = el.getBoundingClientRect();
        const w = window.innerWidth;
        const h = window.innerHeight;
        const pct = (n: number, of: number) => `${Math.min(100, Math.max(0, (n / of) * 100)).toFixed(2)}%`;
        return `inset(${pct(box.top, h)} ${pct(w - box.right, w)} ${pct(h - box.bottom, h)} ${pct(box.left, w)})`;
      };
      let subjectMotion: Animation | null = null;
      /* A garment on its way out: still on screen until its exit finishes,
         and put away at once if anything else needs the screen first. */
      let exiting: HTMLElement | null = null;
      const putAway = (subject: HTMLElement) => {
        subject.hidden = true;
        subject.removeAttribute('data-inspect');
        subject.removeAttribute('data-fore');
        subject.dispatchEvent(new CustomEvent('pf:subject-reset'));
        if (exiting === subject) exiting = null;
      };

      const closeSubject = () => {
        if (!openSubject) return;
        const leaving = openSubject;
        openSubject = null;
        const world = leaving.closest<HTMLElement>('[data-world]');
        /* THE WAY BACK IS THE WAY IN. The door the visitor used, or — for a
           garment that was reached by its address, with no door behind it —
           the garment's own frame in its territory, so a shared link still
           ends on the work in its place in the range. */
        let back = subjectReturnTo && document.contains(subjectReturnTo) ? subjectReturnTo : null;
        subjectReturnTo = null;
        if (!back && world) {
          back = [...world.querySelectorAll<HTMLElement>(`[data-open-subject="${leaving.dataset.subject}"]`)]
            .find((door) => shown(frameOf(door))) ?? null;
        }
        /* The territory behind never moved while the garment was open, so a
           door that was on screen is still on screen. Only a door that is not
           — the address case — is brought into view, and instantly, because
           it happens behind the layer. */
        if (back) {
          const frame = frameOf(back);
          const box = frame.getBoundingClientRect();
          if (box.bottom < 0 || box.top > window.innerHeight) {
            frame.scrollIntoView({ block: 'center', inline: 'nearest' });
          }
        }
        subjectMotion?.cancel();
        /* The garment leaves as it is — turned, or held close — and is put
           back to rest only once it is out of sight. */
        const finish = () => {
          putAway(leaving);
          subjectMotion = null;
          if (back && document.contains(back)) back.focus({ preventScroll: true });
        };
        /* THE EXIT. The same clip as the entrance, run back into the frame
           the garment came from, and shorter: the visitor is leaving, the
           system answers. The layer thins out as it closes, so what is left
           in the frame at the end is the garment in its range, not an empty
           piece of the layer's own ground. */
        if (back && !reduced()) {
          subjectMotion = leaving.animate(
            [
              { clipPath: 'inset(0% 0% 0% 0%)', opacity: 1 },
              { clipPath: insetOf(frameOf(back)), opacity: 0 },
            ],
            { duration: 280, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
          );
          exiting = leaving;
          subjectMotion.onfinish = finish;
          subjectMotion.oncancel = () => { if (exiting === leaving && openSubject !== leaving) putAway(leaving); };
          /* Focus moves now, not after the clip: a key pressed during the
             exit belongs to the range the visitor is returning to. */
          if (document.contains(back)) back.focus({ preventScroll: true });
        } else {
          finish();
        }
      };

      const showSubject = (world: HTMLElement | null, id: string | null) => {
        const next = world && id
          ? world.querySelector<HTMLElement>(`[data-subject="${id}"]`)
          : null;
        if (!next) { closeSubject(); return; }
        if (openSubject === next) return;
        if (exiting === next) exiting = null;
        subjectMotion?.cancel();
        subjectMotion = null;
        if (exiting) putAway(exiting);
        if (openSubject) putAway(openSubject);
        const active = document.activeElement as HTMLElement | null;
        if (!subjectReturnTo && active && world!.contains(active) && active.matches('[data-open-subject]')) {
          subjectReturnTo = active;
        }
        openSubject = next;
        next.hidden = false;
        next.scrollTop = 0;
        next.dispatchEvent(new CustomEvent('pf:subject-open'));
        /* THE ENTRANCE. The layer is clipped to the frame the visitor chose
           and opens out from it, so the garment grows out of its place in the
           range instead of a panel appearing over the top of it. The layer
           stays opaque the whole way: fading it in as well had the range, the
           hero and the garment all showing through each other at the start. */
        const source = subjectReturnTo && document.contains(subjectReturnTo) ? frameOf(subjectReturnTo) : null;
        if (source && shown(source) && !reduced()) {
          subjectMotion = next.animate(
            [{ clipPath: insetOf(source) }, { clipPath: 'inset(0% 0% 0% 0%)' }],
            { duration: 420, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
          );
          subjectMotion.onfinish = () => { subjectMotion = null; };
        }
        /* The layer itself takes the focus: it is labelled by the garment's
           name, the next Tab reaches its way out, and a garment reached by a
           pasted address does not light up a control nobody chose. */
        next.focus({ preventScroll: true });
      };

      /* A DECK CARD IS READ TWICE: a card behind the leader steps forward
         when it is chosen, and the card in front — already chosen — is
         entered. One gesture, two meanings, which is how a deck behaves
         anyway. Bound here rather than in the act so the runway keeps owning
         its own cards. */
      for (const link of root.querySelectorAll<HTMLAnchorElement>('.pf-slot__door')) {
        /* A DECK IS DRAGGED WITH THE SAME POINTER that chooses a card, so a
           drag must not end in a navigation. The door remembers where the
           press began and stands down if the hand moved. */
        let downAt: { x: number; y: number } | null = null;
        link.addEventListener('pointerdown', (event) => { downAt = { x: event.clientX, y: event.clientY }; });
        link.addEventListener('click', (event) => {
          const moved = downAt
            ? Math.hypot(event.clientX - downAt.x, event.clientY - downAt.y) > 8
            : false;
          downAt = null;
          if (moved) { event.preventDefault(); event.stopPropagation(); return; }
          const slot = link.closest<HTMLElement>('.pf-slot');
          if (!slot || slot.dataset.depth === '0') return;
          event.preventDefault();
          event.stopPropagation();
          const panel = slot.closest<HTMLElement>('.pf-panel');
          const index = Number(slot.dataset.slot);
          const queue = queues.find((q) => q.panel === panel);
          if (queue && Number.isFinite(index)) goTo(queue, index);
        });
      }

      /* THE READER'S OWN CONTROLS: the views, and looking closer.

         Two rules hold everything below together.

         A VIEW IS A STATE. Front and back are what the garment IS on screen,
         not where the pointer happens to be: the visitor turns it, and it
         stays turned until the visitor turns it again — including while they
         reach for "Look closer".

         DIRECT MANIPULATION IS DIRECT. Whatever follows a hand (the turn
         under a drag, the inspection under a pointer or a finger) is written
         straight onto the picture's own transform and clip, every frame, with
         nothing eased behind it and no box resized. Easing is only for the
         moments the system finishes a move on its own: a release settling, a
         toggle, entering or leaving inspection. */
      const easeOut = (x: number) => 1 - Math.pow(1 - x, 3);
      const easeInOut = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const clamp01 = (x: number) => Math.min(1, Math.max(0, x));

      for (const subject of root.querySelectorAll<HTMLElement>('.pf-rd__subject')) {
        const inspect = subject.querySelector<HTMLButtonElement>('[data-rd-inspect]');
        const windows = [...subject.querySelectorAll<HTMLElement>('[data-rd-window]')];
        const travelPlate = subject.querySelector<HTMLElement>('[data-rd-travel]');
        const travelWindow = travelPlate?.querySelector<HTMLElement>('[data-rd-window]') ?? null;
        const travelImg = travelWindow?.querySelector<HTMLImageElement>('img') ?? null;
        const travelName = travelPlate?.querySelector<HTMLElement>('.pf-rd__vname') ?? null;
        /* The turn is drawn by script only where motion is welcome; without
           it the plate opens onto the whole photograph (see the CSS), which
           withholds nothing. */
        const travels = () => !!travelPlate && !reduced();
        const front = Number(getComputedStyle(travelPlate ?? subject).getPropertyValue('--front')) || 0.55;

        /* ---- THE TURN ------------------------------------------------- */
        /* `t`: 0 is the front, 1 the back. Between the two only while a hand
           or a settle is moving it. */
        let t = 0;
        let settling = 0;
        /* Where the visible part of the photograph is, for a given `t`. The
           window keeps one width — the wider of the two views — and is
           clipped down to the view it is showing, so the front never shows a
           sliver of the back, or the back of the front, and no layout runs
           while the frame travels. */
        const travelGeometry = (at: number) => {
          const iw = travelImg!.offsetWidth;
          const W = travelWindow!.clientWidth;
          const w = (front + at * (1 - 2 * front)) * iw;
          const a = at * front * iw;
          const L = Math.max(0, (W - w) / 2);
          return { iw, W, w, a, L, H: travelWindow!.clientHeight };
        };
        const drawTravel = () => {
          if (!travels() || !travelImg || !travelWindow) return;
          const g = travelGeometry(t);
          travelWindow.style.clipPath = `inset(0px ${g.L.toFixed(2)}px 0px ${g.L.toFixed(2)}px)`;
          if (!subject.hasAttribute('data-inspect')) {
            travelImg.style.transform = `translate3d(${(g.L - g.a).toFixed(2)}px, 0, 0)`;
          }
          if (travelName) travelName.style.transform = `translate3d(${g.L.toFixed(2)}px, 0, 0)`;
          /* ONE NAME AT A TIME. The label switches at the half-way point
             rather than crossfading, so an unfinished turn never prints
             FRONT and BACK over each other. */
          const side = t < 0.5 ? 'front' : 'back';
          if (travelPlate!.dataset.side !== side) {
            travelPlate!.dataset.side = side;
            for (const el of travelPlate!.querySelectorAll<HTMLElement>('[data-rd-vfront],[data-rd-vback]')) {
              el.setAttribute('aria-pressed', String(el.hasAttribute(side === 'front' ? 'data-rd-vfront' : 'data-rd-vback')));
            }
          }
        };
        const settleTo = (target: number, duration: number, ease: (x: number) => number) => {
          cancelAnimationFrame(settling);
          const from = t;
          if (reduced() || Math.abs(target - from) < 0.001) { t = target; drawTravel(); return; }
          const began = performance.now();
          const span = duration * Math.max(0.35, Math.abs(target - from));
          const step = (now: number) => {
            const x = clamp01((now - began) / span);
            t = from + (target - from) * ease(x);
            drawTravel();
            if (x < 1) settling = requestAnimationFrame(step);
          };
          settling = requestAnimationFrame(step);
        };
        /* A deliberate toggle travels like the camera move it is; a release
           only finishes what the hand already started. */
        const turnTo = (target: number) => settleTo(target, 520, easeInOut);

        if (travelPlate && travelWindow && travelImg) {
          travelPlate.setAttribute('data-js-travel', '');
          let press: { id: number; x: number; t: number; at: number; moved: boolean } | null = null;
          let lastX = 0, lastAt = 0, velocity = 0;
          travelPlate.addEventListener('pointerdown', (event) => {
            if (!travels() || subject.hasAttribute('data-inspect') || event.button !== 0) return;
            if ((event.target as HTMLElement).closest('[data-rd-vfront],[data-rd-vback]')) return;
            cancelAnimationFrame(settling);
            press = { id: event.pointerId, x: event.clientX, t, at: performance.now(), moved: false };
            lastX = event.clientX; lastAt = press.at; velocity = 0;
          });
          travelPlate.addEventListener('pointermove', (event) => {
            if (!press || event.pointerId !== press.id) return;
            const dx = event.clientX - press.x;
            if (!press.moved) {
              if (Math.abs(dx) < 6) return;
              press.moved = true;
              try { travelPlate.setPointerCapture(press.id); } catch {}
            }
            /* Pulling the frame to the left brings the back in, the way a
               garment turned on a stand would. One frame-width of travel is
               the whole turn. */
            const g = travelGeometry(press.t);
            t = clamp01(press.t - dx / Math.max(1, g.w));
            const now = performance.now();
            if (now > lastAt) velocity = (event.clientX - lastX) / (now - lastAt);
            lastX = event.clientX; lastAt = now;
            drawTravel();
          });
          const release = (event: PointerEvent, cancelled: boolean) => {
            if (!press || event.pointerId !== press.id) return;
            const { moved } = press;
            press = null;
            try { travelPlate.releasePointerCapture(event.pointerId); } catch {}
            if (!moved) {
              /* A press that never travelled is a choice: turn it. */
              if (!cancelled) turnTo(t < 0.5 ? 1 : 0);
              return;
            }
            /* A flick is enough; otherwise the nearer view wins. Either way
               the garment comes to rest on a view, never part-way. */
            const target = !cancelled && Math.abs(velocity) > 0.4 ? (velocity < 0 ? 1 : 0) : (t < 0.5 ? 0 : 1);
            settleTo(target, 300, easeOut);
          };
          travelPlate.addEventListener('pointerup', (event) => release(event, false));
          /* Only a real cancel ends a turn early. Losing pointer capture is not
             one: a touch already captures implicitly to the picture it began
             on, and the browser hands capture back and forth while the moves
             keep arriving. */
          travelPlate.addEventListener('pointercancel', (event) => release(event, true));

          /* The two names under the frame are the turn's keyboard controls
             as well as its labels. Without motion both views are already on
             screen, so they stay labels. */
          if (!reduced()) for (const [el, value] of [
            [travelPlate.querySelector<HTMLElement>('[data-rd-vfront]'), 0],
            [travelPlate.querySelector<HTMLElement>('[data-rd-vback]'), 1],
          ] as Array<[HTMLElement | null, number]>) {
            if (!el) continue;
            el.setAttribute('tabindex', '0');
            el.setAttribute('role', 'button');
            el.setAttribute('aria-pressed', String(value === 0));
            const choose = () => {
              if (subject.hasAttribute('data-inspect')) setInspect(false);
              turnTo(value);
            };
            el.addEventListener('click', choose);
            el.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); }
            });
          }
        }

        /* ---- FOREGROUND ----------------------------------------------- */
        /* The second view is brought to the front when it is chosen — the
           gesture Occasion's garments are read with. Each view is a real
           control, so the swap is the same for a click, a tap and a key. */
        if (subject.dataset.rdReveal === 'foreground') {
          for (const view of subject.querySelectorAll<HTMLElement>('.pf-rd__view')) {
            const second = view.dataset.index === '1';
            const name = view.querySelector('.pf-rd__vname')?.textContent?.trim() ?? '';
            const sync = () => {
              const fore = subject.hasAttribute('data-fore');
              view.setAttribute('aria-pressed', String(second === fore));
            };
            view.setAttribute('role', 'button');
            view.setAttribute('tabindex', '0');
            view.setAttribute('aria-label', `${name} view, large`);
            sync();
            subject.addEventListener('pf:fore', sync);
            const choose = () => {
              if (subject.hasAttribute('data-inspect')) return;
              subject.toggleAttribute('data-fore', second);
              subject.dispatchEvent(new CustomEvent('pf:fore'));
            };
            view.addEventListener('click', choose);
            view.addEventListener('keydown', (event) => {
              if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); }
            });
          }
        }

        /* ---- LOOKING CLOSER ------------------------------------------- */
        /* Where to look is two fractions, shared by every view of the
           garment: 0 is the left or top edge of the VIEW (not the
           photograph), 1 its right or bottom edge. */
        let fx = 0.5, fy = 0.5;
        /* The bounds come from the picture as it is actually laid out: the
           part of the photograph this view shows, the window it shows it in,
           and a magnification that brings the rendition to roughly its own
           pixel size. Every edge of the view — collar, sleeve, hem — is
           reachable, and nothing beyond it (the other figure, the studio
           margin past the frame) ever is. */
        const inspectGeometry = (win: HTMLElement) => {
          const img = win.querySelector<HTMLImageElement>('img')!;
          const iw = img.offsetWidth;
          const H = win.clientHeight;
          let L = 0, w = win.clientWidth, a = -img.offsetLeft;
          if (win === travelWindow && travels()) {
            const g = travelGeometry(t);
            L = g.L; w = g.w; a = g.a;
          }
          const s = Math.min(2.6, Math.max(1.8, (img.naturalWidth || iw * 2) / Math.max(1, iw)));
          const left = img.offsetLeft;
          return {
            img, s, L, w, H,
            txMax: L - left - s * a,
            txMin: L + w - left - s * (a + w),
            tyMax: 0,
            tyMin: H - s * H,
          };
        };
        const drawInspect = () => {
          if (!subject.hasAttribute('data-inspect')) return;
          for (const win of windows) {
            const g = inspectGeometry(win);
            const tx = g.txMax + (g.txMin - g.txMax) * fx;
            const ty = g.tyMax + (g.tyMin - g.tyMax) * fy;
            g.img.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0) scale(${g.s.toFixed(3)})`;
          }
        };
        /* Entering and leaving are the only eased moves here, and they are
           transitions, so either can be reversed half-way. */
        const easeImages = (on: boolean) => {
          for (const win of windows) {
            const img = win.querySelector<HTMLImageElement>('img')!;
            img.style.transition = on && !reduced() ? 'transform 300ms cubic-bezier(0.23, 1, 0.32, 1)' : 'none';
          }
        };
        let easing = 0;
        const setInspect = (on: boolean) => {
          cancelAnimationFrame(settling);
          if (travels()) { t = t < 0.5 ? 0 : 1; }
          subject.toggleAttribute('data-inspect', on);
          inspect?.setAttribute('aria-pressed', String(on));
          easeImages(true);
          window.clearTimeout(easing);
          easing = window.setTimeout(() => easeImages(false), 320);
          if (on) {
            fx = 0.5; fy = 0.5;
            drawTravel();
            drawInspect();
          } else {
            for (const win of windows) {
              const img = win.querySelector<HTMLImageElement>('img')!;
              img.style.transform = '';
            }
            drawTravel();
          }
        };
        inspect?.addEventListener('click', () => setInspect(!subject.hasAttribute('data-inspect')));

        for (const win of windows) {
          /* A mouse looks where it points. */
          win.addEventListener('pointermove', (event) => {
            if (!subject.hasAttribute('data-inspect') || event.pointerType !== 'mouse') return;
            const g = inspectGeometry(win);
            const box = win.getBoundingClientRect();
            fx = clamp01((event.clientX - box.left - g.L) / Math.max(1, g.w));
            fy = clamp01((event.clientY - box.top) / Math.max(1, g.H));
            drawInspect();
          });
          /* A finger moves the picture itself, one-to-one. */
          let drag: { id: number; x: number; y: number; fx: number; fy: number } | null = null;
          win.addEventListener('pointerdown', (event) => {
            if (!subject.hasAttribute('data-inspect') || event.pointerType === 'mouse') return;
            if (drag) return;
            drag = { id: event.pointerId, x: event.clientX, y: event.clientY, fx, fy };
            easeImages(false);
            try { win.setPointerCapture(event.pointerId); } catch {}
          });
          win.addEventListener('pointermove', (event) => {
            if (!drag || event.pointerId !== drag.id) return;
            const g = inspectGeometry(win);
            fx = clamp01(drag.fx - (event.clientX - drag.x) / Math.max(1, g.txMax - g.txMin));
            fy = clamp01(drag.fy - (event.clientY - drag.y) / Math.max(1, g.tyMax - g.tyMin));
            drawInspect();
          });
          const end = (event: PointerEvent) => { if (drag && event.pointerId === drag.id) drag = null; };
          win.addEventListener('pointerup', end);
          win.addEventListener('pointercancel', end);
        }
        /* A keyboard moves the view with the arrow keys while inspecting —
           a tenth of the way per press, the whole way with Home and End. */
        subject.addEventListener('keydown', (event) => {
          if (!subject.hasAttribute('data-inspect')) return;
          const step = 0.1;
          const keys: Record<string, () => void> = {
            ArrowLeft: () => { fx = clamp01(fx - step); },
            ArrowRight: () => { fx = clamp01(fx + step); },
            ArrowUp: () => { fy = clamp01(fy - step); },
            ArrowDown: () => { fy = clamp01(fy + step); },
            Home: () => { fy = 0; },
            End: () => { fy = 1; },
          };
          const move = keys[event.key];
          if (!move) return;
          event.preventDefault();
          move();
          drawInspect();
        });

        /* ---- THE STORY ------------------------------------------------ */
        /* How the garment became real, below its first screen. Its pieces
           arrive once per visit as each movement comes into view; the bar
           names the movement the visitor is in; and a folded story (a
           supporting project) is opened by the same invitation that leads
           into an unfolded one. */
        const story = subject.querySelector<HTMLElement>('[data-st]');
        const into = subject.querySelector<HTMLButtonElement>('[data-st-into]');
        const beatLabel = subject.querySelector<HTMLElement>('[data-rd-beat]');
        const movements = [...subject.querySelectorAll<HTMLElement>('.pf-st__mv')];
        const folds = story?.dataset.stWeight === 'folded';
        const fold = (on: boolean) => {
          if (!story || !folds) return;
          story.toggleAttribute('data-st-folded', on);
          into?.setAttribute('aria-expanded', String(!on));
        };
        fold(true);
        into?.addEventListener('click', () => {
          if (!story) return;
          fold(false);
          const bar = subject.querySelector<HTMLElement>('.pf-rd__head')?.offsetHeight ?? 0;
          const top = story.getBoundingClientRect().top - subject.getBoundingClientRect().top + subject.scrollTop - bar;
          subject.scrollTo({ top, behavior: reduced() ? 'auto' : 'smooth' });
        });
        if (story && movements.length) {
          if (!reduced()) story.setAttribute('data-st-armed', '');
          const arrive = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) entry.target.setAttribute('data-st-in', '');
            }
          }, { root: subject, threshold: 0.2 });
          /* The bar's beat: whichever movement holds the middle of the
             screen. The garment's own first screen names nothing. */
          const where = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting || !beatLabel) continue;
              beatLabel.textContent = (entry.target as HTMLElement).dataset.stBeat ?? '';
            }
          }, { root: subject, rootMargin: '-48% 0px -48% 0px' });
          for (const mv of movements) { arrive.observe(mv); where.observe(mv); }
          const views = subject.querySelector('[data-rd-views]');
          if (views) where.observe(views);
          subject.addEventListener('pf:subject-reset', () => {
            for (const mv of movements) mv.removeAttribute('data-st-in');
            if (beatLabel) beatLabel.textContent = '';
            fold(true);
          });
        }

        /* ---- LIFECYCLE ------------------------------------------------ */
        /* A garment is always entered on its front, at rest. */
        const reset = () => {
          cancelAnimationFrame(settling);
          window.clearTimeout(easing);
          t = 0; fx = 0.5; fy = 0.5;
          subject.removeAttribute('data-inspect');
          inspect?.setAttribute('aria-pressed', 'false');
          for (const win of windows) {
            const img = win.querySelector<HTMLImageElement>('img')!;
            img.style.transform = ''; img.style.transition = 'none';
          }
          drawTravel();
        };
        subject.addEventListener('pf:subject-reset', reset);
        subject.addEventListener('pf:subject-open', () => {
          reset();
          /* The picture may arrive after the layer: draw again once it has
             its size. */
          for (const win of windows) {
            const img = win.querySelector<HTMLImageElement>('img')!;
            if (!img.complete) img.addEventListener('load', () => { drawTravel(); drawInspect(); }, { once: true });
          }
        });
        new ResizeObserver(() => {
          if (subject.hidden) return;
          drawTravel();
          drawInspect();
        }).observe(subject);
      }

      /* Which screen of a chapter is showing. `null` is the chapter's own
         index; a category id is that category's viewer. */
      const showScreen = (world: HTMLElement, category: string | null) => {
        const screens = [...world.querySelectorAll<HTMLElement>('[data-screen]')];
        if (screens.length === 0) return;
        let shown: HTMLElement | null = null;
        for (const screen of screens) {
          const match = screen.dataset.screen === 'index'
            ? category === null
            : screen.dataset.category === category;
          screen.hidden = !match;
          if (match) shown = screen;
        }
        /* An unknown category falls back to the index rather than leaving the
           chapter blank. */
        if (!shown) {
          for (const screen of screens) screen.hidden = screen.dataset.screen !== 'index';
        }
        /* ACT I is one screen, so a category in the hash is not a screen to
           show — it is a movement to travel to. `#womenswear` opens the act
           at the top; `#womenswear/evening` opens it at that movement. */
        if (world.hasAttribute('data-act')) {
          const movement = category && world.querySelector<HTMLElement>(`[data-movement="${category}"]`);
          if (movement) {
            /* Land on the category opening, clear of the chapter's bar. */
            const top = world.scrollTop
              + movement.getBoundingClientRect().top
              - world.getBoundingClientRect().top
              - (world.querySelector('.pf-act__bar')?.getBoundingClientRect().height ?? 0);
            world.scrollTo({ top: Math.max(0, Math.round(top)), behavior: reduced() ? 'auto' : 'smooth' });
            return;
          }
        }
        world.scrollTop = 0;
      };

      const closeWorld = () => {
        if (!openWorld) return;
        closeSubject();
        openWorld.removeAttribute('data-open');
        openWorld = null;
        document.body.classList.remove('no-scroll');
        setInert(false);
        const target = restoreFocusTo;
        restoreFocusTo = null;
        /* Focus has to land after the layer is gone, or the browser scrolls
           the still-fixed panel instead of the page. */
        if (target && document.contains(target)) target.focus({ preventScroll: true });
      };

      /* `keepPlace`: the chapter is already open and only the GARMENT level is
         changing. The territory behind a garment is the visitor's place in the
         range, so opening or closing a garment must not scroll it or move the
         focus inside it — the garment layer handles both. */
      const openWorldById = (id: string, category: string | null, keepPlace = false) => {
        const next = worlds.get(id);
        if (!next) { closeWorld(); return; }
        const already = openWorld === next;
        if (already && keepPlace) return;
        if (!already) {
          if (openWorld) openWorld.removeAttribute('data-open');
          if (!restoreFocusTo) {
            const active = document.activeElement as HTMLElement | null;
            restoreFocusTo = active && root.contains(active) && active.matches('a[data-nav],[data-chapter]')
              ? active
              : chapterLinks.find((link) => link.dataset.chapter === id) ?? active;
          }
          openWorld = next;
          next.setAttribute('data-open', '');
          document.body.classList.add('no-scroll');
        }
        showScreen(next, category);
        if (!already && !reduced()) {
          const entrance = next.querySelector<HTMLElement>('.pf-head');
          entrance?.animate([
            { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(18px)' },
            { clipPath: 'inset(0 0 0% 0)', transform: 'translateY(0)' },
          ], { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }
        /* Order matters twice over here.
           focus() is a no-op on a visibility:hidden element and data-open has
           not been through style recalc yet, so force that first. And the
           focus has to move BEFORE the index is marked inert: the cover the
           visitor just activated lives inside it, and the blur the UA performs
           when a focused element's container becomes inert lands after a focus
           call made on the same tick. */
        void next.offsetHeight;
        /* A chapter opened by the visitor puts the focus on its first control.
           A chapter opened by its ADDRESS, before the visitor has done
           anything, focuses the chapter itself: focusing a control there made
           the browser draw a keyboard ring around "Portfolio" for the whole
           visit, on a page nobody had pressed a key on. */
        const first = next.querySelector<HTMLElement>(FOCUSABLE);
        (visitorActed ? (first ?? next) : next).focus({ preventScroll: true });
        if (!already) setInert(true);
        layoutAll();
      };

      /* #world / category / subject. The third segment is a GARMENT: the act
         addresses individual work, so a project can be linked to, shared,
         reloaded into and stepped back out of like any other level. */
      const parseHash = () => {
        const raw = window.location.hash.replace('#', '');
        if (!raw) return { world: null as string | null, category: null as string | null, subject: null as string | null };
        const [world, category, subject] = raw.split('/');
        return { world, category: category ?? null, subject: subject ?? null };
      };

      const syncFromHash = () => {
        if (evidenceReader.open) closeEvidence();
        if (openWorld?.querySelector('[data-reader][open]')) closeReader(openWorld);
        const { world, category, subject } = parseHash();
        if (world && worlds.has(world)) {
          /* Entering a garment, or stepping back out of it into the territory
             it belongs to, is a change at the garment level only. */
          const garmentOnly = openWorld === worlds.get(world)
            && (subject !== null || (openSubject !== null && openSubject.dataset.of === category));
          openWorldById(world, category, garmentOnly);
          /* The garment layer is the deepest level, and it is opened AFTER
             the chapter and the territory, so leaving it lands the visitor
             back exactly where they were. */
          showSubject(worlds.get(world)!, subject);
        } else {
          showSubject(null, null);
          closeWorld();
        }
      };

      const go = (hash: string) => {
        if (window.location.hash !== hash) window.history.pushState({}, '', hash || window.location.pathname);
        syncFromHash();
      };

      /* The covers and the category links are real anchors so every level is
         reachable with the script gone. With the script running we take the
         click over: letting the browser perform the fragment navigation meant
         it also ran its own focus handling afterwards, which threw away the
         focus we had just moved into the layer. */
      for (const link of root.querySelectorAll<HTMLAnchorElement>('a[data-nav]')) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          const hash = link.getAttribute('href') ?? '';
          if (!hash.startsWith('#')) return;
          event.preventDefault();
          go(hash === '#portfolio-index' ? '' : hash);
          /* A contents rail names the thing it points at. Tech Packs and
             Pattern Development are one column each, so the URL addresses the
             chapter and the rail brings the named document or recording into
             view inside it — the link keeps its promise without inventing a
             second level of history that does not exist. */
          const focus = link.dataset.focus;
          if (focus && openWorld) {
            const item = openWorld.querySelector<HTMLElement>(`[data-doc="${focus}"], [data-video="${focus}"]`);
            item?.scrollIntoView({ block: 'start', behavior: reduced() ? 'auto' : 'smooth' });
          }
        });
      }

      window.addEventListener('popstate', syncFromHash);
      window.addEventListener('hashchange', syncFromHash);

      /* Escape steps back one level, the same as the on-screen control. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !openWorld) return;
        /* The act's movement list is a layer as much as a reader is, and it
           closes itself — so this handler stays out of the way rather than
           swallowing the key and shutting the whole chapter. */
        if (openWorld.querySelector('[data-act-where][data-open]')) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        if (evidenceReader.open) { closeEvidence(); return; }
        /* A GARMENT IS THE DEEPEST LEVEL, so it is the first thing Escape
           gives back: inspection, then the garment, then the territory, then
           the chapter. One press undoes one thing. */
        if (openSubject) {
          if (openSubject.hasAttribute('data-inspect')) {
            openSubject.querySelector<HTMLElement>('[data-rd-inspect]')?.click();
            return;
          }
          const { world, category } = parseHash();
          go(category ? `#${world}/${category}` : `#${world}`);
          return;
        }
        const reader = openWorld.querySelector<HTMLElement>('[data-reader]:not([hidden])');
        if (reader) { event.preventDefault(); closeReader(openWorld); return; }
        event.preventDefault();
        /* One level up, computed from the URL rather than replayed from the
           history stack: every level is a pushState entry, so `back()` would
           have walked FORWARD again whenever the visitor had already stepped
           up once with the on-screen control. */
        const { world, category } = parseHash();
        go(category ? `#${world}` : '');
      }, true);

      /* Focus trap. Only ever active while a layer is open. */
      document.addEventListener('keydown', (event) => {
        if (evidenceReader.open || openWorld?.querySelector('[data-reader][open]')) return;
        if (event.key !== 'Tab' || !openWorld) return;
        /* While a garment is open it IS the layer, so the trap holds inside
           it rather than in the chapter behind it. */
        const scope = openSubject ?? openWorld;
        const items = [...scope.querySelectorAll<HTMLElement>(FOCUSABLE)]
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        /* The layer itself holds the focus when it opens: Tab enters it from
           the top, Shift+Tab from the bottom, and neither leaves it. */
        if (document.activeElement === scope) { event.preventDefault(); (event.shiftKey ? last : first).focus(); }
        else if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        else if (!openWorld.contains(document.activeElement)) { event.preventDefault(); first.focus(); }
      });

      /* ---- 2. the garment deck ----------------------------------------- */
      /* HOW MANY, AND HOW MUCH SMALLER.
         The depth has to be obvious at a glance, which means the steps are
         large: each garment behind the active one is about a fifth smaller
         again. Five cards at that rhythm would put the furthest one at 42% of
         the leader — roughly 145px of a full-length model at 1440, too small
         to judge a garment by — so the desktop deck carries FOUR. Four
         readable garments with real distance between them beat five cramped
         ones, and the composition is what is being designed here. */
      const geometry = (panel?: HTMLElement) => {
        const w = window.innerWidth;
        if (w >= 1024) return { visible: 4, scales: [0.52, 0.66, 0.82, 1] };
        return { visible: 3, scales: [0.55, 0.75, 1] };
      };

      /* 3:4. Measured from the renditions: 39 of 49 are exactly 0.749, and the
         rest letterbox into this canvas rather than being cropped. */
      const CANVAS = 0.75;

      interface Queue {
        panel: HTMLElement;
        stage: HTMLElement;
        stack: HTMLElement;
        slots: HTMLElement[];
        fronts: number[];
        counter: HTMLElement | null;
        prev: HTMLElement | null;
        next: HTMLElement | null;
        index: number;
        drag: number;
        width: number;
        motion: Animation[];
        revision: number;
      }

      const queues: Queue[] = [...root.querySelectorAll<HTMLElement>('.pf-panel')].map((panel) => ({
        panel,
        stage: panel.querySelector<HTMLElement>('[data-stage]')!,
        stack: panel.querySelector<HTMLElement>('[data-stack]')!,
        slots: [...panel.querySelectorAll<HTMLElement>('.pf-slot')],
        /* How much of each image, from its left edge, must stay uncovered for
           the front view to read completely. Measured per image; see FRONT in
           the data module. */
        fronts: [...panel.querySelectorAll<HTMLElement>('.pf-slot')]
          .map((slot) => Number(slot.dataset.front) || 0.55),
        counter: panel.querySelector<HTMLElement>('[data-counter-current]'),
        prev: panel.querySelector<HTMLElement>('[data-step="-1"]'),
        next: panel.querySelector<HTMLElement>('[data-step="1"]'),
        index: 0,
        drag: 0,
        width: 0,
        motion: [],
        revision: 0,
      }));

      const layout = (queue: Queue) => {
        const { visible, scales } = geometry(queue.panel);
        const stageWidth = queue.stage.clientWidth;
        if (stageWidth === 0) return;

        const nominal = Math.min(visible, queue.slots.length);
        const scale = scales.slice(-nominal);

        /* THE DECK.
           Visual order runs left to right: the furthest garment on the left,
           the active one flush against the right end. Each card is overlapped
           on its RIGHT by the card in front of it, and the amount left showing
           is that image's own measured front fraction — so what stays visible
           is a complete front view, never half a model. The active card has
           nothing in front of it, so it shows the whole photograph.

           The leading card's width is solved from the WORST CASE arrangement
           of front fractions in this category rather than from the current
           window, so the active garment does not resize every time you step. */
        const widest = [...queue.fronts].sort((a, b) => b - a);
        let span = 1;
        for (let k = 0; k < nominal - 1; k += 1) span += scale[k] * (widest[k] ?? 0.6);
        const width0 = stageWidth / span;
        const height0 = width0 / CANVAS;
        queue.width = width0;
        queue.stage.style.setProperty('--stage-h', `${Math.round(height0)}px`);

        /* Position k holds the image (index + nominal - 1 - k), so the active
           one lands at the right-hand end. Near the end of a category the
           left-hand positions simply have no image to hold. */
        const placed: Array<{ slot: HTMLElement; k: number; w: number; h: number; x: number }> = [];
        let x = 0;
        for (let k = 0; k < nominal; k += 1) {
          const itemIndex = (queue.index + (nominal - 1 - k)) % queue.slots.length;
          const slot = queue.slots[itemIndex];
          const s = scale[k];
          const w = width0 * s;
          const h = height0 * s;
          placed.push({ slot, k, w, h, x });
          const leading = k === nominal - 1;
          x += leading ? w : w * (queue.fronts[itemIndex] ?? 0.6);
        }

        const used = placed.length ? placed[placed.length - 1].x + placed[placed.length - 1].w : 0;
        const offset = Math.max(0, (stageWidth - used) / 2);

        const shown = new Set(placed.map((item) => item.slot));
        for (const slot of queue.slots) if (!shown.has(slot)) slot.hidden = true;

        for (const item of placed) {
          item.slot.hidden = false;
          item.slot.style.setProperty('--x', `${Math.round(offset + item.x)}px`);
          item.slot.style.setProperty('--w', `${Math.round(item.w)}px`);
          item.slot.style.setProperty('--h', `${Math.round(item.h)}px`);
          /* One shared floor. Every garment stands on the same baseline, so
             the smaller ones read as the same presentation further away rather
             than as differently sized photographs. */
          item.slot.style.zIndex = String(10 + item.k);
          const depth = nominal - 1 - item.k;
          /* The floor plane: each step back stands a little higher, scaled to
             the leading card so the rise is proportional at every width. */
          item.slot.style.setProperty('--lift', `${Math.round(depth * width0 * 0.035)}px`);
          item.slot.dataset.depth = String(depth);
        }
      };

      const layoutAll = () => {
        for (const queue of queues) {
          if (queue.panel.hidden) continue;
          if (queue.panel.closest('[data-screen]')?.hidden) continue;
          layout(queue);
        }
      };

      const render = (queue: Queue) => {
        queue.slots.forEach((slot, i) => slot.toggleAttribute('data-active', i === queue.index));
        if (queue.counter) {
          const noun = queue.counter.dataset.noun ?? 'Project';
          queue.counter.textContent = `${noun} ${String(queue.index + 1).padStart(2, '0')}`;
        }
        if (queue.prev) (queue.prev as HTMLButtonElement).disabled = queue.slots.length < 2;
        if (queue.next) (queue.next as HTMLButtonElement).disabled = queue.slots.length < 2;
        layout(queue);
      };

      interface WheelMotion {
        from: number; to: number; direction: number; progress: number;
        animations: Animation[]; ghosts: HTMLElement[]; raf: number;
      }
      const wheels = new Map<Queue, WheelMotion>();
      const finishWheel = (queue: Queue, commit: boolean) => {
        const wheel = wheels.get(queue);
        if (!wheel) return;
        cancelAnimationFrame(wheel.raf);
        queue.index = commit ? wheel.to : wheel.from;
        wheel.animations.forEach((a) => a.cancel());
        wheel.ghosts.forEach((g) => g.remove());
        wheels.delete(queue);
        render(queue);
      };
      const seekWheel = (wheel: WheelMotion, progress: number) => {
        wheel.progress = progress;
        wheel.animations.forEach((a) => { a.currentTime = progress * 1000; });
      };
      const prepareWheel = (queue: Queue, next: number) => {
        finishWheel(queue, true);
        const from = queue.index;
        const to = ((next % queue.slots.length) + queue.slots.length) % queue.slots.length;
        if (to === from) return null;
        const direction = next > from ? 1 : -1;
        const before = new Map(queue.slots.filter((s) => !s.hidden).map((slot) => [slot, {
          rect: slot.getBoundingClientRect(), depth: Number(slot.dataset.depth),
        }]));
        queue.index = to;
        layout(queue);
        queue.index = from;
        const stage = queue.stage.getBoundingClientRect();
        const farDepth = Math.min(geometry(queue.panel).visible, queue.slots.length) - 1;
        const wheel: WheelMotion = { from, to, direction, progress: 0, animations: [], ghosts: [], raf: 0 };
        const animate = (element: HTMLElement, start: string, end: string) => {
          const a = element.animate([{ transform: start }, { transform: end }], { duration: 1000, fill: 'both', easing: 'linear' });
          a.pause(); a.currentTime = 0; wheel.animations.push(a);
        };
        for (const slot of queue.slots) {
          const previous = before.get(slot);
          const leaving = slot.hidden;
          if (leaving && !previous) continue;
          slot.hidden = false;
          const after = slot.getBoundingClientRect();
          const at = (x: number, y: number, sx = 1, sy = sx) => `translate(${x}px,${y}px) scale(${sx},${sy})`;
          const entry = at(direction > 0 ? stage.left - after.right - 2 : stage.right - after.left + 2, 0, 1);
          const exit = at(direction > 0 ? stage.right - after.left + 2 : stage.left - after.right - 2, 0, 1);
          const start = previous ? at(previous.rect.left - after.left, previous.rect.top - after.top,
            previous.rect.width / after.width, previous.rect.height / after.height) : entry;
          const recycled = previous && !leaving && (direction > 0
            ? previous.depth === 0 && Number(slot.dataset.depth) === farDepth
            : previous.depth === farDepth && Number(slot.dataset.depth) === 0);
          if (recycled) {
            // Two edge instances of the same circular item; neither teleports through the visible field.
            const ghost = slot.cloneNode(true) as HTMLElement;
            ghost.removeAttribute('data-slot'); ghost.removeAttribute('data-active');
            ghost.setAttribute('data-wheel-ghost', ''); ghost.setAttribute('aria-hidden', 'true');
            ghost.style.zIndex = direction > 0 ? '30' : '1';
            queue.stack.append(ghost); wheel.ghosts.push(ghost);
            animate(ghost, start, exit);
            animate(slot, entry, 'none');
          } else animate(slot, start, leaving ? exit : 'none');
        }
        wheels.set(queue, wheel);
        return wheel;
      };
      const settleWheel = (queue: Queue, commit: boolean) => {
        const wheel = wheels.get(queue);
        if (!wheel) return;
        cancelAnimationFrame(wheel.raf);
        if (reduced()) { finishWheel(queue, commit); return; }
        const start = wheel.progress;
        const target = commit ? 1 : 0;
        const duration = Math.max(150, 600 * Math.abs(target - start));
        const began = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - began) / duration);
          seekWheel(wheel, start + (target - start) * (1 - Math.pow(1 - t, 3)));
          if (t < 1) wheel.raf = requestAnimationFrame(tick);
          else finishWheel(queue, commit);
        };
        wheel.raf = requestAnimationFrame(tick);
      };
      const goTo = (queue: Queue, next: number) => {
        finishWheel(queue, true);
        if (!prepareWheel(queue, next)) return;
        const wheel = wheels.get(queue)!;
        queue.index = wheel.to;
        if (queue.counter) queue.counter.textContent = `${queue.counter.dataset.noun ?? 'Project'} ${String(queue.index + 1).padStart(2, '0')}`;
        settleWheel(queue, true);
      };
      for (const queue of queues) {
        if (!queue.slots.length) continue;
        queue.prev?.addEventListener('click', () => goTo(queue, queue.index - 1));
        queue.next?.addEventListener('click', () => goTo(queue, queue.index + 1));
        queue.stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(queue, queue.index + 1); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(queue, queue.index - 1); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(queue, 0); }
          else if (event.key === 'End') { event.preventDefault(); goTo(queue, queue.slots.length - 1); }
        });
        /* A PRESS IS NOT YET A DRAG. Capturing the pointer on the press
           itself re-targeted the click that follows onto the stage, so a card
           in the act — every one of which is a door — could never be entered
           with a mouse. The deck now only takes the pointer once the hand has
           actually travelled; a press that stays put is left alone and the
           door underneath receives its click. */
        let pressed = false, dragging = false, startX = 0, pointerId = -1;
        const DRAG_START = 6;
        queue.stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || queue.slots.length < 2) return;
          /* The deck never starts a drag from its own controls. A GARMENT'S
             DOOR is the exception: in the act every card is a link into that
             garment's own story, and the whole deck would stop being
             draggable if a link over it counted as a control. The door itself
             stands down when the hand moved — see its click handler. */
          if ((event.target as HTMLElement).closest('button,a:not([data-open-subject])')) return;
          pressed = true; dragging = false;
          startX = event.clientX; pointerId = event.pointerId; queue.drag = 0;
        });
        queue.stage.addEventListener('pointermove', (event) => {
          if (!pressed || event.pointerId !== pointerId) return;
          if (!dragging) {
            if (Math.abs(event.clientX - startX) < DRAG_START) return;
            dragging = true;
            finishWheel(queue, true);
            try { queue.stage.setPointerCapture(pointerId); } catch {}
          }
          queue.drag = event.clientX - startX;
          if (Math.abs(queue.drag) < 2) return;
          const direction = Math.sign(queue.drag);
          let wheel = wheels.get(queue);
          if (wheel && wheel.direction !== direction) { finishWheel(queue, false); wheel = undefined; }
          wheel ??= prepareWheel(queue, queue.index + direction) ?? undefined;
          if (wheel) seekWheel(wheel, Math.min(.98, Math.abs(queue.drag) / Math.max(150, queue.width * .65)));
        });
        queue.stage.addEventListener('pointerup', (event) => {
          if (event.pointerId !== pointerId) return;
          pressed = false;
          if (!dragging) return;
          dragging = false;
          try { queue.stage.releasePointerCapture(pointerId); } catch {}
          const commit = Math.abs(queue.drag) >= Math.max(44, queue.width * .18);
          queue.drag = 0;
          settleWheel(queue, commit);
        });
        queue.stage.addEventListener('pointercancel', () => {
          pressed = false;
          if (!dragging) return;
          dragging = false; queue.drag = 0; settleWheel(queue, false);
        });
        render(queue);
      }

      /* ---- 3. the PDF reader ------------------------------------------- */
      /* Not one byte of any document is fetched with the page. The <iframe> is
         created by the click that asks for it and destroyed when the reader
         closes, so five demo packs cost nothing until one is opened. */
      const closeReader = (world: HTMLElement) => {
        const reader = world.querySelector<HTMLDialogElement>('[data-reader]');
        if (!reader || reader.hidden) return;
        reader.querySelector<HTMLElement>('[data-reader-mount]')?.replaceChildren();
        reader.close();
        reader.hidden = true;
        world.classList.remove('pf-world--reading');
        const back = reader.dataset.openerId
          ? world.querySelector<HTMLElement>(`#${reader.dataset.openerId}`)
          : null;
        back?.focus({ preventScroll: true });
        const savedScroll = Number(reader.dataset.scrollTop ?? 0);
        world.scrollTop = savedScroll;
        /* Chromium restores a modal dialog's scroll target after close() on
           its next rendering step. Reapply the chapter position afterwards,
           so closing never nudges the dossier list. */
        requestAnimationFrame(() => {
          world.scrollTop = savedScroll;
          requestAnimationFrame(() => { world.scrollTop = savedScroll; });
        });
        window.setTimeout(() => { world.scrollTop = savedScroll; }, 80);
      };

      for (const world of worlds.values()) {
        const reader = world.querySelector<HTMLDialogElement>('[data-reader]');
        if (!reader) continue;
        const mount = reader.querySelector<HTMLElement>('[data-reader-mount]')!;
        const title = reader.querySelector<HTMLElement>('[data-reader-title]');

        for (const opener of world.querySelectorAll<HTMLElement>('[data-open-pdf]')) {
          /* Pointer activation focuses the document before `click`, and that
             focus may scroll a long folio row into a different alignment.
             Capture the origin before focus so Close returns to the exact
             reading position the visitor selected from. */
          opener.addEventListener('pointerdown', () => {
            reader.dataset.scrollTop = String(world.scrollTop);
          });
          opener.addEventListener('click', (event) => {
            const href = opener.getAttribute('href');
            if (!href) return;
            if ((event as MouseEvent).metaKey || (event as MouseEvent).ctrlKey) return;
            /* Inline PDF viewing is unreliable on phones — iOS renders one
               page and will not scroll it — so below this width the anchor is
               left alone and the document opens in its own tab. */
            event.preventDefault();
            if ((event as MouseEvent).detail === 0 || !reader.dataset.scrollTop) {
              reader.dataset.scrollTop = String(world.scrollTop);
            }
            /* <object> rather than <iframe>: when a browser has no PDF
               viewer the object's own fallback content renders in its place,
               so the visitor gets a working link instead of a blank panel. */
            const frame = document.createElement('object');
            frame.data = href;
            frame.type = 'application/pdf';
            frame.setAttribute('aria-label', opener.dataset.docTitle ?? 'Technical pack');
            const fallback = document.createElement('p');
            fallback.className = 'pf-reader__fallback';
            const link = document.createElement('a');
            link.href = href;
            link.target = '_blank';
            link.rel = 'noopener';
            link.textContent = 'Open this document in a new tab';
            fallback.append('This browser cannot display a PDF inline. ', link);
            const preview = opener.querySelector('img');
            if (preview) fallback.prepend(preview.cloneNode(true));
            frame.append(fallback);
            mount.replaceChildren(frame);
            if (window.matchMedia('(max-width: 899px)').matches) {
              const mobile = document.createElement('div');
              mobile.className = 'pf-reader-mobile';
              const cover = opener.querySelector('img');
              if (cover) mobile.append(cover.cloneNode(true));
              const description = document.createElement('p');
              description.textContent = 'Document preview. Open the PDF in your device reader for all pages.';
              const mobileLink = link.cloneNode(true);
              mobile.append(description, mobileLink);
              mount.replaceChildren(mobile);
            }
            if (title) title.textContent = opener.dataset.docTitle ?? '';
            const tab = reader.querySelector<HTMLAnchorElement>('[data-reader-tab]');
            if (tab) tab.href = href;
            reader.dataset.openerId = opener.id;
            reader.hidden = false;
            reader.showModal();
            reader.querySelector<HTMLElement>('[data-reader-close]')?.focus({ preventScroll: true });
            world.classList.add('pf-world--reading');
          });
        }

        reader.querySelector<HTMLElement>('[data-reader-close]')
          ?.addEventListener('click', () => closeReader(world));
        reader.addEventListener('cancel', (event) => { event.preventDefault(); closeReader(world); });
      }

      /* ---- 4. video slots: no player before a click --------------------- */
      for (const world of worlds.values()) {
        for (const item of world.querySelectorAll<HTMLElement>('[data-video]')) {
          const play = item.querySelector<HTMLElement>('[data-play]');
          const mount = item.querySelector<HTMLElement>('[data-player]');
          const youtubeId = item.dataset.youtube;
          if (!play || !mount || !youtubeId) continue;
          play.addEventListener('click', () => {
            /* Created here and nowhere else. Before this click no request has
               been made to any Google domain. nocookie is the privacy-enhanced
               host; autoplay applies to the click that just happened, not to
               page load. */
            const frame = document.createElement('iframe');
            frame.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
            frame.title = item.querySelector('h3')?.textContent ?? 'Simulation video';
            frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('loading', 'lazy');
            mount.replaceChildren(frame);
            mount.hidden = false;
            item.setAttribute('data-playing', '');
            play.hidden = true;
          });
        }
      }

      /* Womenswear discovery is a continuous exhibition. Only the position
         control tracks scrolling; garment inspection keeps its own gestures. */
      const act = root.querySelector<HTMLElement>('[data-act]');
      if (act) {
        const movements = [...act.querySelectorAll<HTMLElement>('[data-movement]')];
        const where = act.querySelector<HTMLElement>('[data-act-where]');
        const toggle = act.querySelector<HTMLElement>('[data-act-toggle]');
        const count = act.querySelector<HTMLElement>('[data-act-count]');
        const name = act.querySelector<HTMLElement>('[data-act-name]');
        const links = [...act.querySelectorAll<HTMLElement>('[data-act-link]')];
        let ticking = false;
        /* Which territory is being read, for the one control that names it. */
        const nameNow = (h: number) => {
          if (name && count) {
            /* The movement being read is the one the reading line — four
               tenths down the screen — is actually inside. Distance to a
               movement's start put the label on the next one all through a
               long run. */
            const line = h * 0.4;
            let best = 0;
            let bestDistance = Infinity;
            movements.forEach((movement, index) => {
              const box = movement.getBoundingClientRect();
              if (box.top <= line && box.bottom >= line) { bestDistance = -1; best = index; return; }
              if (bestDistance === -1) return;
              const distance = Math.min(Math.abs(box.top - line), Math.abs(box.bottom - line));
              if (distance < bestDistance) { bestDistance = distance; best = index; }
            });
            const current = movements[best];
            name.textContent = current.dataset.actTitle ?? '';
            count.textContent = `${String(best + 1).padStart(2, '0')} / ${String(movements.length).padStart(2, '0')}`;
            for (const link of links) {
              const on = link.dataset.actLink === current.dataset.movement;
              if (on) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            }
          }
        };
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => { ticking = false; nameNow(window.innerHeight); });
        };
        act.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        nameNow(window.innerHeight);

        /* The territory control. Same manners as the chapter control on the
           journey outside: hover opens it, a click confirms rather than
           undoes it, Escape and leaving close it. */
        if (where && toggle) {
          let byPointer = false;
          const open = () => { where.setAttribute('data-open', ''); toggle.setAttribute('aria-expanded', 'true'); };
          const shut = () => { where.removeAttribute('data-open'); toggle.setAttribute('aria-expanded', 'false'); };
          toggle.addEventListener('click', () => {
            if (where.hasAttribute('data-open')) {
              if (byPointer) { byPointer = false; return; }
              shut();
              return;
            }
            open();
          });
          if (window.matchMedia('(hover: hover)').matches) {
            where.addEventListener('pointerenter', () => { byPointer = true; open(); });
            where.addEventListener('pointerleave', () => { byPointer = false; shut(); });
          }
          where.addEventListener('focusout', (event) => {
            if (!where.contains(event.relatedTarget as Node)) shut();
          });
          /* Escape with the movement list open closes the LIST, and stops
             there: the same key also closes the chapter, and one press should
             undo one thing. Bound to the document rather than to the control,
             because the list can be open while the focus is anywhere — the
             key still has to close the thing that is open. */
          document.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape' || !where.hasAttribute('data-open')) return;
            event.stopPropagation();
            shut();
            toggle.focus();
          });
          for (const link of links) link.addEventListener('click', shut);
        }
      }

      /* ---- relayout ---------------------------------------------------- */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutAll, 120);
      });
      window.addEventListener('orientationchange', () => window.setTimeout(layoutAll, 200));
      /* Late webfonts and image decode both change the stage box. */
      window.addEventListener('load', layoutAll);

      layoutAll();
      syncFromHash();

      /* Debug surface for the smoke tests. */
      (window as unknown as Record<string, unknown>).__portfolioRunway = {
        getState() {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live.find((q) => q.panel.closest('[data-world]')?.hasAttribute('data-open'))
            ?? live[0] ?? queues[0];
          const { visible } = geometry(queue.panel);
          return {
            activeIndex: queue.index,
            position: queue.index,
            count: queue.slots.length,
            visibleTarget: visible,
            visibleNow: queue.slots.filter((slot) => !slot.hidden).length,
            /* The active card leads the deck: it is the right-most and the
               top-most, and nothing covers it. */
            activeIsLeading: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden);
              if (shown.length === 0) return false;
              const active = queue.slots[queue.index];
              const right = shown.reduce((a, b) => (b.getBoundingClientRect().right > a.getBoundingClientRect().right ? b : a));
              const top = shown.reduce((a, b) => (Number(b.style.zIndex) > Number(a.style.zIndex) ? b : a));
              return right === active && top === active;
            })(),
            overlaps: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden)
                .map((slot) => slot.getBoundingClientRect())
                .sort((a, b) => a.left - b.left);
              let n = 0;
              for (let i = 0; i < shown.length - 1; i += 1) if (shown[i + 1].left < shown[i].right - 1) n += 1;
              return n;
            })(),
            openWorld: openWorld?.dataset.world ?? null,
            screen: openWorld?.querySelector<HTMLElement>('[data-screen]:not([hidden])')?.dataset.screen ?? null,
            reducedMotion: reduced(),
          };
        },
        goTo(i: number) {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live[0] ?? queues[0];
          goTo(queue, i);
          return queue.index;
        },
      };
    }
  </script>

