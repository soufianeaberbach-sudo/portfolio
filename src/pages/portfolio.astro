---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import GarmentWorld from '../components/portfolio/GarmentWorld.astro';
import TechPackWorld from '../components/portfolio/TechPackWorld.astro';
import SimulationWorld from '../components/portfolio/SimulationWorld.astro';
import { chapters, garmentWorlds, techPacks, simulationSessions } from '../data/portfolio';
import '../styles/portfolio-director.css';

/* A cover title is set to fill its measure, not to a fixed size: a short name
   and a long one should occupy about the same optical width, the way they
   would on four covers of the same book. The scale is derived from the name's
   own length and capped at both ends. */
const coverScale = (title: string) => Math.min(11, Math.max(5.6, 148 / title.length));

/* Every chapter opens. A chapter with nothing published still has an
   architecture worth walking into — its categories are listed, each marked
   pending, and nothing inside claims work that does not exist. Refusing to
   open it hid the structure without making the page any more truthful. */
---

<SiteLayout
  title="Portfolio — Soufiane Aberbach"
  description="Womenswear and menswear product development, production-ready tech packs and CLO3D garment simulation — shown as development evidence, not decoration."
  marker="SA-PORTFOLIO-V8"
  page="portfolio"
>
  <!-- BUILD-MARKER: SA-PORTFOLIO-V8 -->
  <div class="pf" data-pf-root>
    {/* Set before first paint so the enhanced layout never flashes the
        stacked fallback. parentElement is the .pf root, so the flag cannot
        reach any other page. */}
    <script is:inline>
      document.currentScript.parentElement.classList.add('pf--js');
    </script>

    <section class="pf-intro" id="portfolio-index">
      <p class="eyebrow">Portfolio / 02</p>
      <h1 class="display pf-intro__title">Four ways to read the work.</h1>
      <p class="pf-intro__lede">
        Product development, technical documentation and digital validation shown as evidence — not decoration.
      </p>
    </section>

    {/* ------------------------------------------------------------------
        FOUR CHAPTER COVERS

        Four separated image-led openings arranged as one asymmetric editorial
        spread. They introduce the worlds without turning into a navigation
        grid or previewing the category lists inside.
       ------------------------------------------------------------------ */}
    <section class="pf-covers" aria-labelledby="pf-covers-title" data-covers>
      <h2 class="pf-sr" id="pf-covers-title">Portfolio chapters</h2>

      {chapters.map((chapter, index) => (
          <a
            class="pf-cover"
            href={`#${chapter.id}`}
            data-nav
            data-chapter={chapter.id}
            data-publication={chapter.publication}
            data-tone="image"
            data-cover-index={index + 1}
            data-image-source={chapter.cover.credit.source}
            data-image-source-page={chapter.cover.credit.sourcePage}
            data-image-photographer={chapter.cover.credit.photographer}
            style={`--cover-vw:${coverScale(chapter.title).toFixed(2)};--cover-cqw:${(coverScale(chapter.title) * 1.26).toFixed(2)}cqw`}
          >
            <span class="pf-cover__art" aria-hidden="true">
              <img
                class="pf-cover__still"
                src={chapter.cover.image.src}
                srcset={chapter.cover.image.srcset}
                sizes="(max-width: 899px) 92vw, 62vw"
                width={chapter.cover.image.width}
                height={chapter.cover.image.height}
                alt=""
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
                style={`object-position:${chapter.cover.focalPosition ?? '50% 50%'}`}
              />
            </span>

            {/* The register: the chapter's number at one margin, its kind at
                the other, on the rule that opens the cover. */}
            <span class="pf-cover__register" aria-hidden="true">
              <i class="pf-cover__num">{chapter.number}</i>
              <i class="pf-cover__kind">{chapter.kind}</i>
            </span>

            <span class="pf-cover__type">
              <b class="pf-cover__name">{chapter.title}</b>
              <span class="pf-cover__intent">{['Silhouette / proportion / desire', 'Structure / volume / balance', 'Design intent, made explicit', 'From pattern lines to digital fit'][index]}</span>
              <span class="pf-cover__go label" aria-hidden="true">Open chapter <Arrow /></span>
            </span>

            {/* THE SIGNATURE. Four rules stepping up to full height, in the
                same 52 / 66 / 82 / 100 rhythm the garment deck recedes by.
                The whole portfolio is about work moving forward from an idea
                to a finished garment, and this is that idea drawn once per
                chapter — the last step, the result, carrying the one signal.
                Tech Packs takes a register of ruled document fields instead:
                same rhythm, a document's own language. */}
            <span class={`pf-cover__meter${chapter.id === 'tech-packs' ? ' pf-cover__meter--doc' : ''}`} aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </span>
          </a>
      ))}
    </section>

    {/* ------------------------------------------------------------------
        THE FOUR CHAPTERS

        Present in the document, always. With the script running these become
        full-screen layers opened from a cover; without it they are four
        ordinary sections the chapter anchors jump to, carrying every
        category, document and video slot as real HTML.
       ------------------------------------------------------------------ */}
    <div class="pf-worlds" data-worlds>
      {garmentWorlds.map((world) => <GarmentWorld world={world} />)}
      <TechPackWorld packs={techPacks} />
      <SimulationWorld sessions={simulationSessions} />
    </div>

    {/* Progressive enhancement, made explicit. Every screen of every chapter
        is in the served HTML and readable without a script; this runs before
        first paint and collapses the category viewers so the enhanced page
        shows one screen at a time instead of all of them at once. */}
    <script is:inline>
      for (const el of document.currentScript.parentElement.querySelectorAll('[data-screen="category"]')) {
        el.hidden = true;
      }
    </script>
  </div>

  <script>
    /* --------------------------------------------------------------------
       Portfolio V8 runtime.

       The navigation is three levels deep and the URL carries all of it:

         #                      the portfolio index
         #womenswear            that chapter's CATEGORY INDEX
         #womenswear/evening    one category's garment viewer

       Everything else — the deck, the documents, the video slots — is driven
       from that one piece of state, so Back always steps back exactly one
       level and a reload lands where the visitor was.
       -------------------------------------------------------------------- */
    const root = document.querySelector<HTMLElement>('[data-pf-root]');
    if (root) {
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chapterLinks = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];

      /* ---- 1. chapters and screens ------------------------------------ */
      const worlds = new Map<string, HTMLElement>(
        [...root.querySelectorAll<HTMLElement>('[data-world]')].map((el) => [el.dataset.world!, el]),
      );
      const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
      let openWorld: HTMLElement | null = null;
      let restoreFocusTo: HTMLElement | null = null;

      const setInert = (on: boolean) => {
        for (const el of [document.querySelector('.site-header'), document.querySelector('.site-footer')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
        for (const el of [root.querySelector('.pf-covers'), root.querySelector('.pf-intro')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
      };

      /* Which screen of a chapter is showing. `null` is the chapter's own
         index; a category id is that category's viewer. */
      const showScreen = (world: HTMLElement, category: string | null) => {
        const screens = [...world.querySelectorAll<HTMLElement>('[data-screen]')];
        if (screens.length === 0) return;
        let shown: HTMLElement | null = null;
        for (const screen of screens) {
          const match = screen.dataset.screen === 'index'
            ? category === null
            : screen.dataset.category === category;
          screen.hidden = !match;
          if (match) shown = screen;
        }
        /* An unknown category falls back to the index rather than leaving the
           chapter blank. */
        if (!shown) {
          for (const screen of screens) screen.hidden = screen.dataset.screen !== 'index';
        }
        world.scrollTop = 0;
      };

      const closeWorld = () => {
        if (!openWorld) return;
        openWorld.removeAttribute('data-open');
        openWorld = null;
        document.body.classList.remove('no-scroll');
        setInert(false);
        const target = restoreFocusTo;
        restoreFocusTo = null;
        /* Focus has to land after the layer is gone, or the browser scrolls
           the still-fixed panel instead of the page. */
        if (target && document.contains(target)) target.focus({ preventScroll: true });
      };

      const openWorldById = (id: string, category: string | null) => {
        const next = worlds.get(id);
        if (!next) { closeWorld(); return; }
        const already = openWorld === next;
        if (!already) {
          if (openWorld) openWorld.removeAttribute('data-open');
          if (!restoreFocusTo) {
            restoreFocusTo = chapterLinks.find((link) => link.dataset.chapter === id)
              ?? (document.activeElement as HTMLElement | null);
          }
          openWorld = next;
          next.setAttribute('data-open', '');
          document.body.classList.add('no-scroll');
        }
        showScreen(next, category);
        if (!already && !reduced()) {
          const entrance = next.querySelector<HTMLElement>('.pf-head');
          entrance?.animate([
            { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(18px)' },
            { clipPath: 'inset(0 0 0% 0)', transform: 'translateY(0)' },
          ], { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }
        /* Order matters twice over here.
           focus() is a no-op on a visibility:hidden element and data-open has
           not been through style recalc yet, so force that first. And the
           focus has to move BEFORE the index is marked inert: the cover the
           visitor just activated lives inside it, and the blur the UA performs
           when a focused element's container becomes inert lands after a focus
           call made on the same tick. */
        void next.offsetHeight;
        const first = next.querySelector<HTMLElement>(FOCUSABLE);
        (first ?? next).focus({ preventScroll: true });
        if (!already) setInert(true);
        layoutAll();
      };

      const parseHash = () => {
        const raw = window.location.hash.replace('#', '');
        if (!raw) return { world: null as string | null, category: null as string | null };
        const [world, category] = raw.split('/');
        return { world, category: category ?? null };
      };

      const syncFromHash = () => {
        const { world, category } = parseHash();
        if (world && worlds.has(world)) openWorldById(world, category);
        else closeWorld();
      };

      const go = (hash: string) => {
        if (window.location.hash !== hash) window.history.pushState({}, '', hash || window.location.pathname);
        syncFromHash();
      };

      /* The covers and the category links are real anchors so every level is
         reachable with the script gone. With the script running we take the
         click over: letting the browser perform the fragment navigation meant
         it also ran its own focus handling afterwards, which threw away the
         focus we had just moved into the layer. */
      for (const link of root.querySelectorAll<HTMLAnchorElement>('a[data-nav]')) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          const hash = link.getAttribute('href') ?? '';
          if (!hash.startsWith('#')) return;
          event.preventDefault();
          go(hash === '#portfolio-index' ? '' : hash);
        });
      }

      window.addEventListener('popstate', syncFromHash);
      window.addEventListener('hashchange', syncFromHash);

      /* Escape steps back one level, the same as the on-screen control. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !openWorld) return;
        const reader = openWorld.querySelector<HTMLElement>('[data-reader]:not([hidden])');
        if (reader) { closeReader(openWorld); return; }
        event.preventDefault();
        /* One level up, computed from the URL rather than replayed from the
           history stack: every level is a pushState entry, so `back()` would
           have walked FORWARD again whenever the visitor had already stepped
           up once with the on-screen control. */
        const { world, category } = parseHash();
        go(category ? `#${world}` : '');
      });

      /* Focus trap. Only ever active while a layer is open. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab' || !openWorld) return;
        const items = [...openWorld.querySelectorAll<HTMLElement>(FOCUSABLE)]
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        else if (!openWorld.contains(document.activeElement)) { event.preventDefault(); first.focus(); }
      });

      /* ---- 2. the garment deck ----------------------------------------- */
      /* HOW MANY, AND HOW MUCH SMALLER.
         The depth has to be obvious at a glance, which means the steps are
         large: each garment behind the active one is about a fifth smaller
         again. Five cards at that rhythm would put the furthest one at 42% of
         the leader — roughly 145px of a full-length model at 1440, too small
         to judge a garment by — so the desktop deck carries FOUR. Four
         readable garments with real distance between them beat five cramped
         ones, and the composition is what is being designed here. */
      const geometry = () => {
        const w = window.innerWidth;
        if (w >= 1024) return { visible: 4, scales: [0.52, 0.66, 0.82, 1] };
        return { visible: 3, scales: [0.55, 0.75, 1] };
      };

      /* 3:4. Measured from the renditions: 39 of 49 are exactly 0.749, and the
         rest letterbox into this canvas rather than being cropped. */
      const CANVAS = 0.75;

      interface Queue {
        panel: HTMLElement;
        stage: HTMLElement;
        stack: HTMLElement;
        slots: HTMLElement[];
        fronts: number[];
        counter: HTMLElement | null;
        prev: HTMLElement | null;
        next: HTMLElement | null;
        index: number;
        drag: number;
        width: number;
      }

      const queues: Queue[] = [...root.querySelectorAll<HTMLElement>('.pf-panel')].map((panel) => ({
        panel,
        stage: panel.querySelector<HTMLElement>('[data-stage]')!,
        stack: panel.querySelector<HTMLElement>('[data-stack]')!,
        slots: [...panel.querySelectorAll<HTMLElement>('.pf-slot')],
        /* How much of each image, from its left edge, must stay uncovered for
           the front view to read completely. Measured per image; see FRONT in
           the data module. */
        fronts: [...panel.querySelectorAll<HTMLElement>('.pf-slot')]
          .map((slot) => Number(slot.dataset.front) || 0.55),
        counter: panel.querySelector<HTMLElement>('[data-counter-current]'),
        prev: panel.querySelector<HTMLElement>('[data-step="-1"]'),
        next: panel.querySelector<HTMLElement>('[data-step="1"]'),
        index: 0,
        drag: 0,
        width: 0,
      }));

      const layout = (queue: Queue) => {
        const { visible, scales } = geometry();
        const stageWidth = queue.stage.clientWidth;
        if (stageWidth === 0) return;

        const nominal = Math.min(visible, queue.slots.length);
        const scale = scales.slice(-nominal);

        /* THE DECK.
           Visual order runs left to right: the furthest garment on the left,
           the active one flush against the right end. Each card is overlapped
           on its RIGHT by the card in front of it, and the amount left showing
           is that image's own measured front fraction — so what stays visible
           is a complete front view, never half a model. The active card has
           nothing in front of it, so it shows the whole photograph.

           The leading card's width is solved from the WORST CASE arrangement
           of front fractions in this category rather than from the current
           window, so the active garment does not resize every time you step. */
        const widest = [...queue.fronts].sort((a, b) => b - a);
        let span = 1;
        for (let k = 0; k < nominal - 1; k += 1) span += scale[k] * (widest[k] ?? 0.6);
        const width0 = stageWidth / span;
        const height0 = width0 / CANVAS;
        queue.width = width0;
        queue.stage.style.setProperty('--stage-h', `${Math.round(height0)}px`);

        /* Position k holds the image (index + nominal - 1 - k), so the active
           one lands at the right-hand end. Near the end of a category the
           left-hand positions simply have no image to hold. */
        const placed: Array<{ slot: HTMLElement; k: number; w: number; h: number; x: number }> = [];
        let x = 0;
        for (let k = 0; k < nominal; k += 1) {
          const itemIndex = (queue.index + (nominal - 1 - k)) % queue.slots.length;
          const slot = queue.slots[itemIndex];
          const s = scale[k];
          const w = width0 * s;
          const h = height0 * s;
          placed.push({ slot, k, w, h, x });
          const leading = k === nominal - 1;
          x += leading ? w : w * (queue.fronts[itemIndex] ?? 0.6);
        }

        const used = placed.length ? placed[placed.length - 1].x + placed[placed.length - 1].w : 0;
        const offset = Math.max(0, (stageWidth - used) / 2);

        const shown = new Set(placed.map((item) => item.slot));
        for (const slot of queue.slots) if (!shown.has(slot)) slot.hidden = true;

        for (const item of placed) {
          item.slot.hidden = false;
          item.slot.style.setProperty('--x', `${Math.round(offset + item.x)}px`);
          item.slot.style.setProperty('--w', `${Math.round(item.w)}px`);
          item.slot.style.setProperty('--h', `${Math.round(item.h)}px`);
          /* One shared floor. Every garment stands on the same baseline, so
             the smaller ones read as the same presentation further away rather
             than as differently sized photographs. */
          item.slot.style.zIndex = String(10 + item.k);
          const depth = nominal - 1 - item.k;
          /* The floor plane: each step back stands a little higher, scaled to
             the leading card so the rise is proportional at every width. */
          item.slot.style.setProperty('--lift', `${Math.round(depth * width0 * 0.035)}px`);
          item.slot.dataset.depth = String(depth);
        }
      };

      const layoutAll = () => {
        for (const queue of queues) {
          if (queue.panel.hidden) continue;
          if (queue.panel.closest('[data-screen]')?.hidden) continue;
          layout(queue);
        }
      };

      const render = (queue: Queue) => {
        queue.slots.forEach((slot, i) => slot.toggleAttribute('data-active', i === queue.index));
        if (queue.counter) {
          const noun = queue.counter.dataset.noun ?? 'Project';
          queue.counter.textContent = `${noun} ${String(queue.index + 1).padStart(2, '0')}`;
        }
        if (queue.prev) (queue.prev as HTMLButtonElement).disabled = queue.slots.length < 2;
        if (queue.next) (queue.next as HTMLButtonElement).disabled = queue.slots.length < 2;
        layout(queue);
      };

      const goTo = (queue: Queue, next: number) => {
        const wrapped = ((next % queue.slots.length) + queue.slots.length) % queue.slots.length;
        if (wrapped === queue.index) return;
        queue.index = wrapped;
        render(queue);
      };

      for (const queue of queues) {
        if (queue.slots.length === 0) continue;

        queue.prev?.addEventListener('click', () => goTo(queue, queue.index - 1));
        queue.next?.addEventListener('click', () => goTo(queue, queue.index + 1));

        queue.stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(queue, queue.index + 1); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(queue, queue.index - 1); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(queue, 0); }
          else if (event.key === 'End') { event.preventDefault(); goTo(queue, queue.slots.length - 1); }
        });

        /* Direct manipulation. During the gesture the stack is translated by
           the SAME SIGN as the pointer delta — hand right, cards right. On
           release, a leftward drag past the threshold advances, because
           dragging left is what pulls the next garment into the lead. */
        let dragging = false;
        let startX = 0;
        let pointerId = -1;

        queue.stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || queue.slots.length < 2) return;
          const target = event.target as HTMLElement;
          if (target.closest('button, a')) return;
          event.preventDefault();
          dragging = true;
          startX = event.clientX;
          pointerId = event.pointerId;
          queue.stage.setPointerCapture(pointerId);
          queue.stack.setAttribute('data-dragging', '');
        });

        queue.stage.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          queue.drag = event.clientX - startX;
          queue.stack.style.setProperty('--drag', `${queue.drag}px`);
        });

        const endDrag = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          try { queue.stage.releasePointerCapture(pointerId); } catch { /* already released */ }
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
          const threshold = Math.max(44, queue.width * 0.18);
          const travelled = queue.drag;
          queue.drag = 0;
          if (travelled <= -threshold) goTo(queue, queue.index + 1);
          else if (travelled >= threshold) goTo(queue, queue.index - 1);
        };

        queue.stage.addEventListener('pointerup', endDrag);
        /* A cancel is an abort, not a release — it snaps back and changes
           nothing. */
        queue.stage.addEventListener('pointercancel', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          queue.drag = 0;
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
        });

        render(queue);
      }

      /* ---- 3. the PDF reader ------------------------------------------- */
      /* Not one byte of any document is fetched with the page. The <iframe> is
         created by the click that asks for it and destroyed when the reader
         closes, so five demo packs cost nothing until one is opened. */
      const closeReader = (world: HTMLElement) => {
        const reader = world.querySelector<HTMLElement>('[data-reader]');
        if (!reader || reader.hidden) return;
        reader.querySelector<HTMLElement>('[data-reader-mount]')?.replaceChildren();
        reader.hidden = true;
        document.body.classList.remove('no-scroll');
        world.classList.remove('pf-world--reading');
        const back = reader.dataset.openerId
          ? world.querySelector<HTMLElement>(`#${reader.dataset.openerId}`)
          : null;
        back?.focus({ preventScroll: true });
      };

      for (const world of worlds.values()) {
        const reader = world.querySelector<HTMLElement>('[data-reader]');
        if (!reader) continue;
        const mount = reader.querySelector<HTMLElement>('[data-reader-mount]')!;
        const title = reader.querySelector<HTMLElement>('[data-reader-title]');

        for (const opener of world.querySelectorAll<HTMLElement>('[data-open-pdf]')) {
          opener.addEventListener('click', (event) => {
            const href = opener.getAttribute('href');
            if (!href) return;
            if ((event as MouseEvent).metaKey || (event as MouseEvent).ctrlKey) return;
            /* Inline PDF viewing is unreliable on phones — iOS renders one
               page and will not scroll it — so below this width the anchor is
               left alone and the document opens in its own tab. */
            if (window.matchMedia('(max-width: 899px)').matches) return;
            event.preventDefault();
            /* <object> rather than <iframe>: when a browser has no PDF
               viewer the object's own fallback content renders in its place,
               so the visitor gets a working link instead of a blank panel. */
            const frame = document.createElement('object');
            frame.data = href;
            frame.type = 'application/pdf';
            frame.setAttribute('aria-label', opener.dataset.docTitle ?? 'Technical pack');
            const fallback = document.createElement('p');
            fallback.className = 'pf-reader__fallback';
            const link = document.createElement('a');
            link.href = href;
            link.target = '_blank';
            link.rel = 'noopener';
            link.textContent = 'Open this document in a new tab';
            fallback.append('This browser cannot display a PDF inline. ', link);
            frame.append(fallback);
            mount.replaceChildren(frame);
            if (title) title.textContent = opener.dataset.docTitle ?? '';
            const tab = reader.querySelector<HTMLAnchorElement>('[data-reader-tab]');
            if (tab) tab.href = href;
            reader.dataset.openerId = opener.id;
            reader.hidden = false;
            reader.querySelector<HTMLElement>('[data-reader-close]')?.focus({ preventScroll: true });
            world.classList.add('pf-world--reading');
          });
        }

        reader.querySelector<HTMLElement>('[data-reader-close]')
          ?.addEventListener('click', () => closeReader(world));
      }

      /* ---- 4. video slots: no player before a click --------------------- */
      for (const world of worlds.values()) {
        for (const item of world.querySelectorAll<HTMLElement>('[data-video]')) {
          const play = item.querySelector<HTMLElement>('[data-play]');
          const mount = item.querySelector<HTMLElement>('[data-player]');
          const youtubeId = item.dataset.youtube;
          if (!play || !mount || !youtubeId) continue;
          play.addEventListener('click', () => {
            /* Created here and nowhere else. Before this click no request has
               been made to any Google domain. nocookie is the privacy-enhanced
               host; autoplay applies to the click that just happened, not to
               page load. */
            const frame = document.createElement('iframe');
            frame.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
            frame.title = item.querySelector('h3')?.textContent ?? 'Simulation video';
            frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('loading', 'lazy');
            mount.replaceChildren(frame);
            mount.hidden = false;
            item.setAttribute('data-playing', '');
            play.hidden = true;
          });
        }
      }

      /* ---- relayout ---------------------------------------------------- */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutAll, 120);
      });
      window.addEventListener('orientationchange', () => window.setTimeout(layoutAll, 200));
      /* Late webfonts and image decode both change the stage box. */
      window.addEventListener('load', layoutAll);

      layoutAll();
      syncFromHash();

      /* Debug surface for the smoke tests. */
      (window as unknown as Record<string, unknown>).__portfolioRunway = {
        getState() {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live.find((q) => q.panel.closest('[data-world]')?.hasAttribute('data-open'))
            ?? live[0] ?? queues[0];
          const { visible } = geometry();
          return {
            activeIndex: queue.index,
            position: queue.index,
            count: queue.slots.length,
            visibleTarget: visible,
            visibleNow: queue.slots.filter((slot) => !slot.hidden).length,
            /* The active card leads the deck: it is the right-most and the
               top-most, and nothing covers it. */
            activeIsLeading: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden);
              if (shown.length === 0) return false;
              const active = queue.slots[queue.index];
              const right = shown.reduce((a, b) => (b.getBoundingClientRect().right > a.getBoundingClientRect().right ? b : a));
              const top = shown.reduce((a, b) => (Number(b.style.zIndex) > Number(a.style.zIndex) ? b : a));
              return right === active && top === active;
            })(),
            overlaps: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden)
                .map((slot) => slot.getBoundingClientRect())
                .sort((a, b) => a.left - b.left);
              let n = 0;
              for (let i = 0; i < shown.length - 1; i += 1) if (shown[i + 1].left < shown[i].right - 1) n += 1;
              return n;
            })(),
            openWorld: openWorld?.dataset.world ?? null,
            screen: openWorld?.querySelector<HTMLElement>('[data-screen]:not([hidden])')?.dataset.screen ?? null,
            reducedMotion: reduced(),
          };
        },
        goTo(i: number) {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live[0] ?? queues[0];
          goTo(queue, i);
          return queue.index;
        },
      };
    }
  </script>

  <style is:global>
    /* ======================================================================
       PORTFOLIO V8
       Every selector below is inside .pf. Nothing here reaches another page.

       Written from scratch, not layered on V7: the folio table, the film
       strip, the cover artwork and the old single-screen viewer chrome are
       gone from the stylesheet entirely rather than overridden.
       ====================================================================== */

    /* One white. .devtools/normalise-ground.mjs resolves every derived
       rendition's studio ground to 255 — edge-connected flood fill, tight
       tolerance, feathered mask, masters untouched — so the studio is simply
       white and the photographs meet it exactly. */
    .pf { --pf-stage: #ffffff; --pf-paper: #ffffff; }

    .pf-sr {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* ======================================================================
       INTRO — an opening statement, then out of the way.
       ====================================================================== */
    .pf-intro {
      max-width: var(--max);
      margin: 0 auto;
      padding: calc(var(--header-h) + clamp(.75rem, 1.6vw, 1.3rem)) var(--gutter) clamp(1rem, 1.8vw, 1.6rem);
    }
    .pf-intro__title {
      max-width: 20ch;
      margin: .9rem 0 0;
      font-size: clamp(2rem, 4.2vw, 3.5rem);
      line-height: .94;
      letter-spacing: -.045em;
    }
    .pf-intro__lede {
      max-width: 34rem;
      margin: .85rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(.96rem, 1.3vw, 1.05rem);
      line-height: 1.6;
    }

    /* ======================================================================
       FOUR CHAPTER COVERS

       Four image-led editorial openings arranged with unequal scale and air.
       ====================================================================== */
    .pf-covers { border-top: 1px solid var(--line-strong); }

    /* A cover is a composition, not a centred word on an empty field: a
       register rule across the top, the name set large and low against one
       margin, and the progression signature at the foot. The axis alternates
       chapter to chapter, so the four share one system and none of them reads
       as the same slide twice. */
    .pf-cover {
      position: relative;
      display: grid;
      grid-template-rows: auto 1fr auto;
      min-height: clamp(30rem, 82vh, 48rem);
      padding: clamp(1.5rem, 2.6vw, 2.4rem) var(--gutter) clamp(1.75rem, 3vw, 2.8rem);
      color: inherit;
      text-decoration: none;
      overflow: hidden;
      container-type: inline-size;
    }
    .pf-cover + .pf-cover { border-top: 1px solid var(--line-strong); }
    .pf-cover:focus-visible { outline: 2px solid var(--signal); outline-offset: -4px; }

    .pf-cover__register {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: clamp(.7rem, 1.2vw, 1rem);
      border-bottom: 1px solid var(--line);
    }
    .pf-cover__num,
    .pf-cover__kind {
      font-family: var(--mono);
      font-size: .7rem;
      font-style: normal;
      letter-spacing: .26em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .pf-cover__num { color: var(--ink); }

    .pf-cover__type {
      position: relative;
      z-index: 2;
      align-self: end;
      display: grid;
      justify-items: start;
      max-width: 100%;
    }
    .pf-cover__name {
      display: block;
      margin: 0;
      font-family: var(--display);
      font-variation-settings: 'wdth' 112;
      font-weight: 850;
      /* The title is the hero. It runs as large as its own length allows —
         see coverScale in the frontmatter — and never breaks inside a word. */
      font-size: clamp(2.4rem, calc(var(--cover-vw, 11) * 1vw), 9.5rem);
      line-height: .84;
      letter-spacing: -.055em;
      text-wrap: balance;
      overflow-wrap: normal;
      word-break: keep-all;
      hyphens: none;
    }
    .pf-cover__go {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin-top: clamp(1.1rem, 2vw, 1.8rem);
      color: var(--signal);
      transition: gap .3s var(--ease);
    }
    .pf-cover__go .arrow { width: 1em; height: 1em; }
    .pf-cover:hover .pf-cover__go { gap: 1.05rem; }

    /* The signature: four rules stepping up in the same rhythm the garment
       deck recedes by, the last one carrying the signal. */
    .pf-cover__meter {
      position: relative;
      z-index: 2;
      align-self: end;
      justify-self: start;
      display: flex;
      align-items: flex-end;
      gap: clamp(.5rem, .95vw, .85rem);
      height: clamp(3rem, 5.5vw, 4.6rem);
      margin-top: clamp(1.75rem, 3.4vw, 3rem);
    }
    .pf-cover__meter i { display: block; width: 2px; background: var(--ink); }
    .pf-cover__meter i:nth-child(1) { height: 52%; }
    .pf-cover__meter i:nth-child(2) { height: 66%; }
    .pf-cover__meter i:nth-child(3) { height: 82%; }
    .pf-cover__meter i:nth-child(4) { height: 100%; background: var(--signal); }
    /* A document register instead of a scale, for the chapter whose subject is
       paper: the same four steps, laid flat as ruled fields. */
    .pf-cover__meter--doc { flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: clamp(.5rem, .9vw, .8rem); width: clamp(8rem, 14vw, 13rem); }
    .pf-cover__meter--doc i { width: 52%; height: 2px; }
    .pf-cover__meter--doc i:nth-child(2) { width: 100%; }
    .pf-cover__meter--doc i:nth-child(3) { width: 74%; }
    .pf-cover__meter--doc i:nth-child(4) { width: 34%; }

    /* ---- the axis alternates, so no two covers read the same way ---- */
    /* 01 sits against the left margin. */
    .pf-cover[data-chapter='menswear'] .pf-cover__type,
    .pf-cover[data-chapter='menswear'] .pf-cover__meter { justify-self: end; justify-items: end; }
    .pf-cover[data-chapter='menswear'] .pf-cover__name { text-align: right; }
    .pf-cover[data-chapter='menswear'] .pf-cover__go { justify-self: end; }
    /* 03 hangs its name one step in from the margin, the way a technical sheet
       indents from its binding edge. */
    .pf-cover[data-chapter='tech-packs'] .pf-cover__type { padding-left: clamp(0rem, 8vw, 7rem); }
    .pf-cover[data-chapter='tech-packs'] .pf-cover__meter { justify-self: end; }

    /* ---- 04 keeps the cinematic frame from the real recording ---- */
    .pf-cover[data-tone='dark'] { background: var(--ink); color: var(--paper-bright); }
    .pf-cover__art { position: absolute; inset: 0; z-index: 0; display: block; }
    .pf-cover__still { width: 100%; height: 100%; object-fit: cover; object-position: center 32%; }
    .pf-cover__art::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(17, 17, 15, .95) 0%, rgba(17, 17, 15, .72) 42%, rgba(17, 17, 15, .62) 78%, rgba(17, 17, 15, .82) 100%);
    }
    .pf-cover[data-tone='dark'] .pf-cover__register { border-bottom-color: rgba(251, 250, 246, .22); }
    .pf-cover[data-tone='dark'] .pf-cover__num { color: var(--paper-bright); }
    .pf-cover[data-tone='dark'] .pf-cover__kind { color: rgba(251, 250, 246, .6); }
    .pf-cover[data-tone='dark'] .pf-cover__meter i { background: rgba(251, 250, 246, .6); }
    .pf-cover[data-tone='dark'] .pf-cover__meter i:nth-child(4) { background: var(--signal); }

    /* V9 cover gallery: four independent editorial image fields, composed as
       one paced spread rather than four identical full-width bands. */
    .pf-covers {
      display: grid;
      gap: clamp(1rem, 2vw, 2rem);
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1rem, 2vw, 2rem) var(--gutter) clamp(4rem, 8vw, 8rem);
      border-top: 0;
    }
    .pf-cover,
    .pf-cover + .pf-cover {
      min-height: min(76svh, 52rem);
      padding: clamp(1rem, 1.8vw, 1.6rem);
      border: 0;
      background: var(--ink);
      color: var(--paper-bright);
      isolation: isolate;
    }
    .pf-cover__still { transform: scale(1.01); transition: transform .8s var(--ease); }
    .pf-cover:hover .pf-cover__still { transform: scale(1.035); }
    .pf-cover__art::after {
      background: linear-gradient(to top, rgba(17, 17, 15, .9) 0%, rgba(17, 17, 15, .26) 55%, rgba(17, 17, 15, .6) 100%);
    }
    .pf-cover__register { border-bottom-color: rgba(251, 250, 246, .32); }
    .pf-cover__num { color: var(--paper-bright); }
    .pf-cover__kind { color: rgba(251, 250, 246, .68); }
    .pf-cover__name {
      max-width: 9ch;
      font-size: clamp(2.4rem, var(--cover-cqw), 8rem);
      text-wrap: pretty;
    }
    .pf-cover__meter i { background: rgba(251, 250, 246, .68); }
    .pf-cover__meter i:nth-child(4) { background: var(--signal); }

    @media (min-width: 900px) {
      .pf-covers { grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: start; }
      .pf-cover[data-cover-index='1'] { grid-column: 1 / span 7; min-height: min(78svh, 54rem); }
      .pf-cover[data-cover-index='2'] { grid-column: 8 / span 5; min-height: min(60svh, 42rem); margin-top: clamp(5rem, 10vw, 9rem); }
      .pf-cover[data-cover-index='3'] { grid-column: 1 / span 5; min-height: min(58svh, 40rem); margin-top: clamp(1rem, 3vw, 3rem); }
      .pf-cover[data-cover-index='4'] { grid-column: 6 / span 7; min-height: min(82svh, 56rem); margin-top: clamp(-5rem, -4vw, -2.5rem); }
      .pf-cover[data-cover-index='2'] .pf-cover__type,
      .pf-cover[data-cover-index='2'] .pf-cover__meter,
      .pf-cover[data-cover-index='4'] .pf-cover__type,
      .pf-cover[data-cover-index='4'] .pf-cover__meter { justify-self: end; justify-items: end; }
      .pf-cover[data-cover-index='2'] .pf-cover__name,
      .pf-cover[data-cover-index='4'] .pf-cover__name { text-align: right; }
    }

    /* ======================================================================
       CHAPTERS
       ====================================================================== */

    /* Fallback (no script): four ordinary sections, every screen rendered in
       full. The inner blocks carry the width cap, so the white studio band can
       run edge to edge in both modes. */
    .pf-world { border-top: 1px solid var(--line-strong); scroll-margin-top: var(--header-h); }
    .pf-world .pf-bar { display: none; }
    .pf-screen { padding: clamp(2.5rem, 5vw, 4rem) 0; }

    /* Enhanced: a full-screen layer, one screen of it at a time. */
    .pf--js .pf-worlds { display: contents; }
    .pf--js .pf-world {
      position: fixed;
      inset: 0;
      z-index: 150;
      border-top: 0;
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      visibility: hidden;
      transform: translateY(1rem);
      /* visibility is stepped, not eased. Transitioning it meant the computed
         value was still `hidden` for the first frame after data-open was set,
         and focus() is a no-op on a hidden element — which is what used to
         leave activeElement on <body> and break the focus trap. */
      transition: opacity .38s var(--ease), transform .45s var(--ease), visibility 0s linear .38s;
    }
    .pf--js .pf-world[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity .38s var(--ease), transform .45s var(--ease), visibility 0s linear 0s;
    }
    .pf-world:focus { outline: none; }
    .pf--js .pf-screen { padding: 0 0 clamp(3rem, 6vw, 5rem); }
    .pf-screen[hidden] { display: none; }

    .pf--js .pf-bar {
      position: sticky;
      top: 0;
      z-index: 8;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem var(--gutter);
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }
    .pf-back {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      color: inherit;
      font-family: var(--mono);
      font-size: .7rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      text-decoration: none;
      transition: color .25s var(--ease);
    }
    .pf-back .arrow { width: 1.1em; height: 1.1em; }
    .pf-back:hover { color: var(--signal); }
    .pf-bar__tag { margin: 0; color: var(--muted); }
    .pf-bar__tag b { color: var(--ink); font-weight: 500; }

    .pf-head {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1.75rem, 3.4vw, 3rem) var(--gutter) clamp(1.25rem, 2.2vw, 2rem);
    }
    .pf-head h2 { margin: 0; font-size: clamp(2.1rem, 5vw, 4rem); line-height: .92; letter-spacing: -.045em; }
    .pf-head__descriptor {
      max-width: 38rem;
      margin: .9rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(.95rem, 1.2vw, 1.05rem);
      line-height: 1.6;
    }

    /* Provenance, not a warning: a label and the fact, quiet but at reading
       size, in the margin position a credit line occupies. */
    .pf-prov {
      display: grid;
      gap: .35rem;
      max-width: 38rem;
      margin: clamp(1.25rem, 2.4vw, 2rem) 0 0;
      padding-left: 1rem;
      border-left: 1px solid var(--line-strong);
    }
    .pf-prov b { color: var(--signal); font-weight: 400; }
    .pf-prov span { color: var(--muted); font-size: .9rem; line-height: 1.55; }
    /* Beside the controls: one quiet line, no rule of its own, no section. */
    .pf-prov--inline {
      display: block;
      max-width: 44rem;
      margin: clamp(.7rem, 1.2vw, 1rem) 0 0;
      padding-left: 0;
      border-left: 0;
    }
    .pf-prov--inline b { margin-right: .5rem; }
    .pf-prov--inline span { font-size: .88rem; }

    /* ======================================================================
       CATEGORY INDEX — the first screen of a garment chapter

       Large image-led category covers with an asymmetric editorial rhythm.
       ====================================================================== */
    .pf-cats { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .pf-cats__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }

    .pf-cat {
      position: relative;
      display: grid;
      /* The number hangs outside the title's column, the metadata sits against
         the far margin, and the blurb is indented under the title — three
         different alignments rather than one even row of fields. */
      grid-template-columns: 4.5rem minmax(0, 1fr) auto 2rem;
      align-items: baseline;
      gap: .5rem clamp(1rem, 2vw, 2rem);
      padding: clamp(1.6rem, 3vw, 2.9rem) 0;
      border-bottom: 1px solid var(--line);
      color: var(--muted);
      text-decoration: none;
      transition: color .35s var(--ease), border-color .35s var(--ease);
    }
    a.pf-cat:hover { color: var(--ink); border-bottom-color: var(--ink); }
    a.pf-cat:focus-visible { outline: 2px solid var(--signal); outline-offset: -3px; }
    .pf-cat__num {
      grid-column: 1;
      grid-row: 1;
      font-family: var(--mono);
      font-size: .74rem;
      font-style: normal;
      letter-spacing: .2em;
      transition: color .35s var(--ease);
    }
    a.pf-cat:hover .pf-cat__num { color: var(--signal); }
    .pf-cat__label {
      grid-column: 2;
      grid-row: 1;
      font-family: var(--display);
      font-variation-settings: 'wdth' 112;
      font-weight: 800;
      font-size: clamp(1.6rem, 4vw, 3.4rem);
      line-height: .96;
      letter-spacing: -.05em;
      color: var(--ink);
      transition: transform .45s var(--ease);
    }
    a.pf-cat:hover .pf-cat__label { transform: translateX(.6rem); }
    .pf-cat__blurb {
      grid-column: 2;
      grid-row: 2;
      max-width: 40rem;
      margin-top: .7rem;
      color: var(--muted);
      font-size: .92rem;
      line-height: 1.55;
    }
    .pf-cat__count { grid-column: 3; grid-row: 1; justify-self: end; font-weight: 400; letter-spacing: .18em; }
    .pf-cat__go {
      grid-column: 4;
      grid-row: 1;
      justify-self: end;
      color: var(--signal);
      transition: transform .45s var(--ease);
    }
    .pf-cat__go .arrow { width: 1.15rem; height: 1.15rem; }
    a.pf-cat:hover .pf-cat__go { transform: translateX(.45rem); }
    /* A category with nothing behind it is not a link and does not pretend. */
    div.pf-cat { cursor: default; }
    div.pf-cat .pf-cat__label { color: var(--ink-soft); }

    /* Image-led editorial category indexes. The unequal spans create a
       deliberate magazine rhythm; each chapter keeps its exact category
       count and every visual is also the entrance to its working gallery. */
    .pf-cats__list {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(1rem, 2.2vw, 2.2rem);
      border: 0;
    }
    .pf-cats__list > li { min-width: 0; }
    .pf-cats__list > li:nth-child(1) { grid-column: 1 / span 7; }
    .pf-cats__list > li:nth-child(2) { grid-column: 8 / span 5; margin-top: clamp(4rem, 8vw, 7rem); }
    .pf-cats__list > li:nth-child(3) { grid-column: 2 / span 5; }
    .pf-cats__list > li:nth-child(4) { grid-column: 7 / span 6; margin-top: clamp(-3rem, -2vw, -1rem); }
    .pf-cats__list > li:nth-child(5) { grid-column: 1 / span 8; margin-top: clamp(1rem, 4vw, 4rem); }
    .pf-cats--menswear .pf-cats__list > li:nth-child(3) { grid-column: 1 / span 6; }
    .pf-cats--menswear .pf-cats__list > li:nth-child(4) { grid-column: 7 / span 6; }
    .pf-cat {
      display: block;
      min-height: clamp(24rem, 56vw, 43rem);
      padding: 0;
      border: 0;
      overflow: hidden;
      isolation: isolate;
      background: var(--ink);
      color: var(--paper-bright);
    }
    .pf-cats__list > li:nth-child(even) .pf-cat { min-height: clamp(21rem, 43vw, 35rem); }
    .pf-cat__media,
    .pf-cat__shade { position: absolute; inset: 0; display: block; }
    .pf-cat__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      filter: saturate(.82) contrast(1.03);
      transition: transform .8s var(--ease), filter .6s var(--ease);
    }
    .pf-cat__shade {
      z-index: 1;
      background: linear-gradient(to top, rgba(17, 17, 15, .9), rgba(17, 17, 15, .08) 60%, rgba(17, 17, 15, .44));
    }
    .pf-cat__content {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-rows: auto 1fr auto auto;
      gap: .75rem 1rem;
      min-height: inherit;
      padding: clamp(1rem, 2vw, 1.7rem);
    }
    .pf-cat__num { grid-column: 1; grid-row: 1; color: var(--paper-bright); }
    .pf-cat__count { grid-column: 3; grid-row: 1; color: rgba(251, 250, 246, .76); }
    .pf-cat__label {
      grid-column: 1 / -1;
      grid-row: 3;
      max-width: 11ch;
      color: var(--paper-bright);
      font-size: clamp(2rem, 4vw, 4.1rem);
    }
    .pf-cat__blurb {
      grid-column: 1 / span 2;
      grid-row: 4;
      max-width: 36rem;
      margin: 0;
      color: rgba(251, 250, 246, .74);
    }
    .pf-cat__go { grid-column: 3; grid-row: 4; align-self: end; color: var(--signal); }
    a.pf-cat:hover .pf-cat__label { transform: none; }
    a.pf-cat:hover .pf-cat__media img { transform: scale(1.035); filter: saturate(1) contrast(1.02); }
    a.pf-cat:hover { color: var(--paper-bright); }

    /* ======================================================================
       THE STUDIO — one continuous white photographic field, full width
       ====================================================================== */
    .pf-studio {
      padding: clamp(1.5rem, 3vw, 2.75rem) 0 clamp(1.75rem, 3.4vw, 3rem);
      background: var(--pf-stage);
    }
    .pf-studio__inner { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

    .pf-viewer {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.75rem);
      align-items: start;
    }
    /* 71 / 29. The final garment is the result and carries the argument; the
       three development stages are the proof behind it and are sized to say
       so. Two columns from 1024 up, because the rail is now small enough that
       the garments and all three plates compose together rather than the
       plates pushing the deck out of the screen. */
    @media (min-width: 1024px) {
      .pf-viewer { grid-template-columns: minmax(0, 78fr) minmax(0, 22fr); gap: clamp(1.75rem, 2.8vw, 3rem); }
    }

    .pf-deck { min-width: 0; }

    /* FALLBACK (no script): every garment is a normal grid cell in the studio.
       Complete, scrollable and readable — the deck is an enhancement layered
       on top of this, never a prerequisite for seeing the work. */
    .pf-stage { position: relative; }
    .pf-stage:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-stack {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .pf-slot__figure { margin: 0; }

    /* ENHANCED: the depth deck. */
    .pf--js .pf-stage {
      height: var(--stage-h, 420px);
      overflow: hidden;
      cursor: grab;
      touch-action: pan-y;
      -webkit-user-select: none;
      user-select: none;
    }
    .pf--js .pf-stack {
      display: block;
      position: absolute;
      inset: 0;
      transform: translate3d(var(--drag, 0px), 0, 0);
      transition: transform .55s var(--ease);
    }
    .pf--js .pf-stack[data-dragging] { transition: none; }
    .pf--js .pf-slot {
      position: absolute;
      left: var(--x, 0);
      /* ONE RECEDING FLOOR. The garments share a floor plane rather than a
         flat baseline: each step back stands a little higher, the way objects
         rise toward a horizon. Without it four different sizes in a row read
         as four unrelated photographs; with it they read as one presentation
         seen from a distance. */
      bottom: var(--lift, 0);
      width: var(--w, 0);
      height: var(--h, 0);
      /* Opaque, because the occlusion is real: the card in front physically
         covers the back view of the card behind it.

         NO SHADOW, NO BORDER, NO FRAME. Depth is carried by scale, overlap and
         stacking order alone — a cast shadow at the seam turns garments
         standing in one studio into white cards lying on a table. */
      background: var(--pf-stage);
      transition: left .58s var(--ease), width .58s var(--ease), height .58s var(--ease),
                  bottom .58s var(--ease);
    }
    /* Atmospheric recession, on the PHOTOGRAPH and never on the card.
       Fading the whole slot let the garment behind it show through its own
       opaque white ground and ringed every figure with a ghost — the occlusion
       is load-bearing. Fading only the image lightens the further garments
       against the studio, which is what air does over distance, and leaves the
       card in front covering what it covers. */
    .pf--js .pf-slot__figure img { transition: filter .58s var(--ease); }
    .pf--js .pf-slot[data-depth='1'] .pf-slot__figure img,
    .pf--js .pf-slot[data-depth='2'] .pf-slot__figure img { filter: none; }
    .pf--js .pf-slot[data-depth='3'] .pf-slot__figure img { filter: blur(2.6px) contrast(.94); }
    @media (max-width: 1023px) {
      .pf--js .pf-slot[data-depth='2'] .pf-slot__figure img { filter: blur(2.2px) contrast(.95); }
    }
    .pf--js .pf-slot__figure { position: relative; width: 100%; height: 100%; }
    .pf-slot[hidden] { display: none; }
    /* contain, never cover: a head, a hem or a train is never cut off.
       pointer-events: none is load-bearing — without it the first pointermove
       over a slot starts a native image drag, the browser fires pointercancel,
       and the gesture dies about twelve pixels in. */
    .pf-slot__figure img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      pointer-events: none;
      -webkit-user-drag: none;
    }
    .pf-slot__caption {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .pf-runbar {
      display: flex;
      align-items: center;
      gap: clamp(.9rem, 1.8vw, 1.6rem);
      margin-top: clamp(.9rem, 1.6vw, 1.4rem);
      padding-top: clamp(.7rem, 1.2vw, 1rem);
      border-top: 1px solid var(--line);
    }
    .pf-step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .4rem;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
      transition: color .25s var(--ease), transform .25s var(--ease), opacity .25s var(--ease);
    }
    .pf-step .arrow { width: 1.15rem; height: 1.15rem; }
    .pf-step:hover:not(:disabled) { color: var(--signal); }
    .pf-step[data-step='-1']:hover:not(:disabled) { transform: translateX(-3px); }
    .pf-step[data-step='1']:hover:not(:disabled) { transform: translateX(3px); }
    .pf-step:disabled { opacity: .2; cursor: default; }
    .pf-step:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; }
    .pf-runbar__count { margin: 0; letter-spacing: .18em; color: var(--ink); }
    .pf-runbar__count i { color: var(--muted); font-style: normal; }

    /* ======================================================================
       DEVELOPMENT — three equal plates, one above the other
       ====================================================================== */
    .pf-devcol { min-width: 0; }
    .pf-project[hidden] { display: none; }
    .pf-project__number { margin: 0; color: var(--signal); }
    .pf-project__title {
      margin: .5rem 0 0;
      font-family: var(--display);
      font-size: clamp(1.3rem, 2vw, 1.7rem);
      line-height: 1.05;
      letter-spacing: -.03em;
    }
    .pf-project__profile { margin: 1.25rem 0 0; }
    .pf-project__profile > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
    .pf-project__profile dt {
      color: var(--muted);
      font-family: var(--mono);
      font-size: .64rem;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .pf-project__profile dd { margin: 0; font-size: .92rem; line-height: 1.55; }
    .pf-project__description { margin: 1.1rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-project__tags { margin: .9rem 0 0; color: var(--muted); }
    .pf-project__tags i { font-style: normal; opacity: .5; }

    .pf-dev { margin-top: clamp(.5rem, 1vw, 1rem); }
    .pf-project .pf-dev { margin-top: clamp(1.5rem, 2.4vw, 2rem); }
    .pf-dev__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: .45rem 1.1rem;
      margin: 0 0 clamp(1rem, 1.7vw, 1.5rem);
      padding-bottom: .7rem;
      border-bottom: 1px solid var(--line-strong);
    }
    .pf-dev__title { color: var(--ink); }
    .pf-dev__note { color: var(--signal); }

    /* Same width, same height, same ratio, read top to bottom. */
    .pf-dev__plates {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.4rem, 2.2vw, 1.9rem);
      margin: 0;
      padding: 0;
      list-style: none;
      justify-items: start;
    }
    .pf-plate { position: relative; min-width: 0; width: 100%; }
    .pf-plate__art { position: relative; aspect-ratio: 4 / 3; }
    /* Beside the deck the plates are deliberately small — evidence, not a
       second gallery. Sized so the whole three-step rail stands no taller than
       the garments it belongs to, which is what removed the need to make the
       deck sticky to keep them in the same view. */
    @media (min-width: 1024px) {
      /* The whole rail is one column the width of a plate, so its heading rule
         ends where the plates end instead of running past them. */
      .pf-dev { width: clamp(9.5rem, 12.6vw, 12.5rem); }
      .pf-dev__head { display: block; margin-bottom: .8rem; padding-bottom: .5rem; }
      .pf-dev__note { display: block; margin-top: .3rem; line-height: 1.45; }
      .pf-dev__plates { gap: clamp(.8rem, 1.1vw, 1rem); }
      .pf-plate { width: 100%; }
    }
    .pf-plate__art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    /* The arrow between one step and the next, drawn in the gap. */
    .pf-plate__link {
      position: absolute;
      left: 50%;
      top: calc(clamp(1.4rem, 2.2vw, 1.9rem) * -1);
      width: 1px;
      height: clamp(1.4rem, 2.2vw, 1.9rem);
      background: var(--line-strong);
    }
    @media (min-width: 1024px) {
      .pf-plate__link { top: calc(clamp(.8rem, 1.1vw, 1rem) * -1); height: clamp(.8rem, 1.1vw, 1rem); }
      .pf-plate__link::after { width: .38rem; height: .38rem; left: -.18rem; }
    }
    .pf-plate__link::after {
      content: '';
      position: absolute;
      left: -.24rem;
      bottom: .1rem;
      width: .5rem;
      height: .5rem;
      border-right: 1px solid var(--signal);
      border-bottom: 1px solid var(--signal);
      transform: rotate(45deg);
    }

    /* A blank plate is a drawing sheet waiting for content: a hairline frame,
       registration ticks at two corners, and its own technical ground. Not an
       empty administrative rectangle. */
    .pf-plate__blank {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      padding: clamp(.5rem, .8vw, .75rem);
      /* Quiet. This is supporting proof beside a photograph of a garment, and
         a heavy frame around an empty plate competes with the thing it is
         evidence for. */
      border: 1px solid var(--line);
    }
    .pf-plate__blank::before,
    .pf-plate__blank::after {
      content: '';
      position: absolute;
      width: .7rem;
      height: .7rem;
      border: 1px solid var(--ink);
      opacity: .22;
      pointer-events: none;
    }
    .pf-plate__blank::before { left: -1px; top: -1px; border-width: 1px 0 0 1px; }
    .pf-plate__blank::after { right: -1px; bottom: -1px; border-width: 0 1px 1px 0; }
    .pf-plate[data-plate='sketch'] .pf-plate__blank {
      background: repeating-linear-gradient(45deg, transparent 0 9px, rgba(17, 17, 15, .032) 9px 10px);
    }
    .pf-plate[data-plate='pattern'] .pf-plate__blank {
      background:
        repeating-linear-gradient(to right, rgba(17, 17, 15, .045) 0 1px, transparent 1px 26px),
        repeating-linear-gradient(to bottom, rgba(17, 17, 15, .045) 0 1px, transparent 1px 26px);
    }
    .pf-plate[data-plate='simulation'] .pf-plate__blank {
      background-image:
        linear-gradient(to bottom, transparent, rgba(17, 17, 15, .07) 24%, rgba(17, 17, 15, .07) 76%, transparent),
        linear-gradient(to bottom, rgba(17, 17, 15, .035), rgba(17, 17, 15, 0) 62%);
      background-size: 1px 100%, 100% 100%;
      background-position: 50% 0, 0 0;
      background-repeat: no-repeat;
    }
    /* Microtype, not illegible type: the smallest thing on this page is still
       set at about eleven pixels. */
    .pf-plate__stamp {
      padding: .2rem .4rem;
      border: 1px solid var(--line-strong);
      color: var(--muted);
      font-size: .66rem;
      letter-spacing: .18em;
    }
    .pf-plate__label { display: flex; align-items: baseline; gap: .5rem; margin: .5rem 0 0; }
    .pf-plate__label b { flex: none; color: var(--muted); font-weight: 400; font-size: .66rem; letter-spacing: .14em; }
    .pf-plate__label span {
      font-family: var(--display);
      font-size: clamp(.85rem, 1vw, .98rem);
      line-height: 1.15;
      letter-spacing: -.02em;
    }
    .pf-dev__head { font-size: .92em; }

    /* ======================================================================
       EMPTY CHAPTER
       ====================================================================== */
    .pf-empty { max-width: var(--max); margin: 0 auto; padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0; }
    .pf-empty__lead { max-width: 34rem; margin: 0 0 1.75rem; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }

    /* ======================================================================
       TECH PACKS — five documents, one below another
       ====================================================================== */
    .pf-docs {
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter);
      list-style: none;
    }
    .pf-doc {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.25rem, 2.4vw, 2rem);
      align-items: start;
      padding: clamp(2rem, 4vw, 3.25rem) 0;
      border-top: 1px solid var(--line);
    }
    .pf-doc:first-child { border-top: 1px solid var(--line-strong); }
    /* Measured alternation: the document changes side every row, so five
       documents read as a rhythm rather than as one component repeated five
       times. Reading order is unchanged — the preview stays first in the
       markup and only its column moves. */
    @media (min-width: 900px) {
      .pf-doc { grid-template-columns: minmax(0, 1fr) minmax(0, 19rem); gap: clamp(2rem, 4vw, 3.5rem); }
      .pf-doc[data-side='right'] { grid-template-columns: minmax(0, 19rem) minmax(0, 1fr); }
      .pf-doc[data-side='right'] .pf-doc__page { grid-column: 2; grid-row: 1; }
      .pf-doc[data-side='right'] .pf-doc__meta { grid-column: 1; grid-row: 1; text-align: right; }
      .pf-doc[data-side='right'] .pf-doc__open { margin-left: auto; }
    }
    /* The document itself, at a size you can read. One hairline, because a
       sheet of paper has an edge — nothing else is drawn around it. */
    .pf-doc__page { position: relative; display: block; border: 1px solid var(--line-strong); background: var(--pf-paper); color: inherit; text-decoration: none; }
    .pf-doc__page:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-doc__page img { display: block; width: 100%; height: auto; }
    .pf-doc__blank { display: block; aspect-ratio: 297 / 210; }
    .pf-doc__num { margin: 0; color: var(--muted); letter-spacing: .22em; }
    .pf-doc__title {
      margin: .55rem 0 0;
      font-family: var(--display);
      font-size: clamp(1.5rem, 2.4vw, 2rem);
      line-height: 1.02;
      letter-spacing: -.035em;
    }
    .pf-doc__line { margin: .6rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
    .pf-doc__stamp { margin: .9rem 0 0; color: var(--signal); }
    .pf-doc__open {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      margin-top: 1.6rem;
      padding-bottom: .3rem;
      color: var(--signal);
      text-decoration: none;
      transition: gap .3s var(--ease);
    }
    .pf-doc__open .arrow { width: 1em; height: 1em; }
    .pf-doc__open:hover { gap: 1rem; }
    .pf-doc__open:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

    /* The reader. A layer above the chapter, built on the click that asks for
       a document and torn down again on close. */
    .pf-reader {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: flex;
      flex-direction: column;
      background: var(--paper);
    }
    .pf-reader[hidden] { display: none; }
    .pf-reader__bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem var(--gutter);
      border-bottom: 1px solid var(--line-strong);
    }
    .pf-reader__title { margin: 0; color: var(--muted); }
    .pf-reader__tools { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2rem); }
    .pf-reader__close {
      display: inline-flex;
      align-items: center;
      gap: .6rem;
      padding: .35rem 0;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
      font-family: var(--mono);
      font-size: .7rem;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .pf-reader__close:hover { color: var(--signal); }
    .pf-reader__close span { font-size: 1.15rem; line-height: 1; }
    .pf-reader__close:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-reader__mount { flex: 1; min-height: 0; background: var(--ink-soft); }
    .pf-reader__mount object { width: 100%; height: 100%; border: 0; }
    .pf-reader__fallback {
      max-width: 34rem;
      margin: 0;
      padding: clamp(2rem, 5vw, 4rem) var(--gutter);
      color: var(--paper-bright);
      font-size: 1rem;
      line-height: 1.65;
    }
    .pf-reader__fallback a { color: var(--signal); }
    .pf-reader__tab { color: var(--muted); }
    .pf-reader__tab:hover { color: var(--signal); }

    /* ======================================================================
       PATTERN & 3D DEVELOPMENT — the digital workshop

       This chapter is the only one that is not on paper. The whole layer is
       ink, top bar to last hairline, because the work in it happens on a
       screen in a dark room and the chapter should feel like that room rather
       than like a beige page with black rectangles punched into it.

       Same brand, inverted: paper type, warm grey for the second voice, the
       one orange as a signal and nothing else, hairlines as low-opacity paper.
       No blue, no gradient, no glow.
       ====================================================================== */
    .pf-world--motion {
      --pf-ink-line: rgba(251, 250, 246, .14);
      --pf-ink-line-strong: rgba(251, 250, 246, .26);
      --pf-ink-soft: rgba(251, 250, 246, .74);
      --pf-ink-muted: rgba(251, 250, 246, .5);
      background: var(--ink);
      color: var(--paper-bright);
    }
    .pf--js .pf-world--motion { background: var(--ink); }
    .pf-world--motion .pf-bar {
      background: var(--ink);
      border-bottom-color: var(--pf-ink-line);
    }
    .pf-world--motion .pf-bar__tag { color: var(--pf-ink-muted); }
    .pf-world--motion .pf-bar__tag b { color: var(--paper-bright); }
    .pf-world--motion .pf-back { color: var(--paper-bright); }
    .pf-world--motion .pf-back:hover { color: var(--signal); }
    .pf-world--motion .pf-head__descriptor { color: var(--pf-ink-soft); }
    .pf-world--motion .pf-prov { border-left-color: var(--pf-ink-line-strong); }
    .pf-world--motion .pf-prov span { color: var(--pf-ink-muted); }

    /* ---- the video list ---- */
    .pf-videos {
      max-width: 64rem;
      margin: 0 auto;
      padding: 0 var(--gutter) clamp(3rem, 6vw, 6rem);
      list-style: none;
    }
    /* Spacing and hairlines, not boxes: nothing here is a card. */
    .pf-video { padding: clamp(2rem, 4vw, 3.25rem) 0; border-top: 1px solid var(--pf-ink-line); }
    .pf-video:first-child { border-top: 1px solid var(--pf-ink-line-strong); }
    .pf-video:last-child { border-bottom: 1px solid var(--pf-ink-line); }
    .pf-video__head { display: flex; align-items: baseline; gap: clamp(.9rem, 2vw, 1.6rem); margin: 0 0 clamp(.9rem, 1.6vw, 1.3rem); }
    .pf-video__num { flex: none; color: var(--pf-ink-muted); font-style: normal; letter-spacing: .2em; }
    .pf-video__head h3 {
      margin: 0;
      font-family: var(--display);
      font-size: clamp(1.35rem, 2.4vw, 1.9rem);
      line-height: 1.02;
      letter-spacing: -.035em;
    }
    /* Every slot is the same frame at the same width — the format the real
       recordings will arrive in. */
    .pf-video__frame {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      /* A shade off the world's own ink, so the frame reads as a surface
         inside the room rather than as a hole cut in it. One hairline, no
         border on the other three sides and no shadow. */
      background: #17171a;
      border-top: 1px solid var(--pf-ink-line);
    }
    .pf-video__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pf-video__pending {
      position: absolute;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
      color: var(--pf-ink-muted);
      letter-spacing: .28em;
      text-align: center;
    }
    .pf-video__frame::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(45deg, rgba(251, 250, 246, .03) 0 10px, transparent 10px 20px);
      pointer-events: none;
    }
    .pf-video[data-playing] .pf-video__frame::after { display: none; }
    .pf-play {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      padding: .8rem 1.1rem;
      border: 1px solid rgba(251, 250, 246, .55);
      background: rgba(17, 17, 15, .6);
      color: var(--paper-bright);
      cursor: pointer;
      transform: translate(-50%, -50%);
      transition: background .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease);
    }
    .pf-play:hover { background: var(--signal); border-color: var(--signal); color: var(--ink); }
    .pf-play:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-play__mark { width: 0; height: 0; border-left: .6rem solid currentColor; border-top: .38rem solid transparent; border-bottom: .38rem solid transparent; }
    .pf-video__player { position: absolute; inset: 0; z-index: 3; }
    .pf-video__player[hidden] { display: none; }
    .pf-video__player iframe { width: 100%; height: 100%; border: 0; background: #000; }
    .pf-video__desc { max-width: 42rem; margin: clamp(.9rem, 1.6vw, 1.3rem) 0 0; color: var(--pf-ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-video__privacy { margin: .5rem 0 0; color: var(--pf-ink-muted); font-size: .85rem; }

    /* ---- the state before the first recording is published ---- */
    .pf-soon {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) clamp(4rem, 9vw, 8rem);
      border-top: 1px solid var(--pf-ink-line-strong);
    }
    .pf-soon__label { margin: 0; color: var(--signal); letter-spacing: .24em; }
    .pf-soon__lead {
      margin: clamp(1rem, 2vw, 1.6rem) 0 0;
      font-family: var(--display);
      font-variation-settings: 'wdth' 112;
      font-weight: 850;
      font-size: clamp(2.2rem, 6vw, 4.6rem);
      line-height: .9;
      letter-spacing: -.05em;
    }
    .pf-soon__note {
      max-width: 40rem;
      margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
      color: var(--pf-ink-soft);
