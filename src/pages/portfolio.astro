---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import GarmentWorld from '../components/portfolio/GarmentWorld.astro';
import TechPackWorld from '../components/portfolio/TechPackWorld.astro';
import SimulationWorld from '../components/portfolio/SimulationWorld.astro';
import { chapters, garmentWorlds, techPacks, simulationSessions, womenswear } from '../data/portfolio';

/* The live preview stage. Womenswear shows three of the reference photographs
   in the same leading-image logic the world itself uses, so the index hints at
   the interaction before you enter it — and the stage is labelled as the
   reference preview it is. Menswear has no photography here, so its preview is
   typographic; a borrowed womenswear image would be a false claim. */
const womenswearPreview = [
  womenswear.categories[3].references[0].image,
  womenswear.categories[0].references[0].image,
  womenswear.categories[1].references[3].image,
];
const menswearCategories = garmentWorlds[1].categories;
const firstSession = simulationSessions[0];
const openable = (state: string) => state !== 'unpublished';
---

<SiteLayout
  title="Portfolio — Soufiane Aberbach"
  description="Womenswear and menswear product development, production-ready tech packs and CLO3D garment simulation — shown as development evidence, not decoration."
  marker="SA-PORTFOLIO-V6"
  page="portfolio"
>
  <!-- BUILD-MARKER: SA-PORTFOLIO-V6 -->
  <div class="pf" data-pf-root>
    {/* Set before first paint so the enhanced layout never flashes the
        stacked fallback. parentElement is the .pf root, so the flag cannot
        reach any other page. */}
    <script is:inline>
      document.currentScript.parentElement.classList.add('pf--js');
    </script>

    <section class="pf-intro" id="portfolio-index">
      <p class="eyebrow">Portfolio / 02</p>
      <h1 class="display pf-intro__title">Four ways<br />to read the work.</h1>
      <p class="pf-intro__lede">
        Product development, technical documentation and digital validation shown as evidence — not decoration.
      </p>
      <p class="label pf-intro__meta">Four chapters</p>
    </section>

    {/* ------------------------------------------------------------------
        THE LIVING EDITORIAL INDEX

        Four chapter entries on the left, one preview stage on the right.
        Hovering or keyboard-focusing an entry changes the preview; the
        active entry takes the single orange signal. The entries are real
        anchors, so with the script gone they still reach their world.
       ------------------------------------------------------------------ */}
    <section class="pf-index" aria-labelledby="pf-index-title">
      <h2 class="pf-index__title" id="pf-index-title">Portfolio chapters</h2>

      {/* A chapter with nothing published is listed — the four-world
          architecture is the point of this page — but it is NOT a link. There
          is no empty world to walk into, and presenting one as openable would
          dress absence as finished evidence. It carries one restrained line
          saying what it is waiting for. */}
      <ol class="pf-index__chapters" data-chapters>
        {chapters.map((chapter, index) => {
          const Tag = openable(chapter.publication) ? 'a' : 'div';
          return (
            <li>
              <Tag
                class="pf-chapter"
                href={openable(chapter.publication) ? `#${chapter.id}` : undefined}
                data-chapter={chapter.id}
                data-publication={chapter.publication}
                aria-current={index === 0 ? 'true' : 'false'}
              >
                <i class="pf-chapter__num label">{chapter.number}</i>
                <span class="pf-chapter__title">{chapter.title}</span>
                <span class="pf-chapter__desc">{chapter.descriptor}</span>
                {chapter.stateNote && (
                  <span class="pf-chapter__state">{chapter.stateNote}</span>
                )}
                {openable(chapter.publication) && (
                  <span class="pf-chapter__go label" aria-hidden="true">Open <Arrow /></span>
                )}
              </Tag>
            </li>
          );
        })}
      </ol>

      {/* Decorative: every chapter's name and descriptor is already in the
          list beside it, so the stage adds nothing for a screen reader. */}
      <div class="pf-stagepane" aria-hidden="true" data-preview-stage>
        <div class="pf-preview" data-preview="womenswear" data-active>
          <div class="pf-preview__queue">
            {womenswearPreview.map((asset, index) => (
              <span class="pf-preview__card" style={`--i:${index}`}>
                <img src={asset.src} srcset={asset.srcset} sizes="22vw" width={asset.width} height={asset.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              </span>
            ))}
          </div>
          <p class="label pf-preview__tag">Five markets / temporary references</p>
        </div>

        <div class="pf-preview pf-preview--type" data-preview="menswear">
          <ol class="pf-preview__index">
            {menswearCategories.map((category) => (
              <li><i class="label">{category.number}</i><span>{category.label}</span></li>
            ))}
          </ol>
          <p class="label pf-preview__tag">Not yet published</p>
        </div>

        <div class="pf-preview pf-preview--doc" data-preview="tech-packs">
          <div class="pf-preview__sheet">
            <span class="pf-preview__sheetline"></span>
            <span class="pf-preview__sheetline"></span>
            <span class="pf-preview__sheetline"></span>
            <span class="pf-preview__sheetline"></span>
            <span class="pf-preview__sheetline"></span>
          </div>
          <p class="label pf-preview__tag">Not yet published</p>
        </div>

        <div class="pf-preview pf-preview--motion" data-preview="3d-simulation">
          {firstSession?.poster && (
            <img class="pf-preview__still" src={firstSession.poster} width="512" height="910" alt="" loading="lazy" decoding="async" />
          )}
          <p class="label pf-preview__tag">CLO3D / simulation sample</p>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------------
        THE FOUR WORLDS

        Present in the document, always. With the script running these become
        full-screen layers opened from the index; without it they are four
        ordinary sections the chapter anchors jump to, carrying every project
        title, profile and description as real HTML.
       ------------------------------------------------------------------ */}
    <div class="pf-worlds" data-worlds>
      {garmentWorlds.map((world) => <GarmentWorld world={world} />)}
      <TechPackWorld packs={techPacks} />
      <SimulationWorld sessions={simulationSessions} />
    </div>
  </div>

  <script>
    /* --------------------------------------------------------------------
       Portfolio V6 runtime.

       Three independent pieces, each degrading to something readable:
         1. the landing preview (hover / focus)
         2. world opening + closing, driven entirely by location.hash
         3. the project queue: windowing, direct-manipulation drag, keyboard
       -------------------------------------------------------------------- */
    const root = document.querySelector<HTMLElement>('[data-pf-root]');
    if (root) {
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- 1. landing preview ----------------------------------------- */
      /* Includes the unpublished chapters, which are <div> rather than <a>:
         they still drive the preview stage on hover, they just do not open. */
      const chapterLinks = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];
      const previews = [...root.querySelectorAll<HTMLElement>('[data-preview]')];

      const showPreview = (id: string) => {
        for (const link of chapterLinks) link.setAttribute('aria-current', String(link.dataset.chapter === id));
        for (const preview of previews) preview.toggleAttribute('data-active', preview.dataset.preview === id);
      };

      for (const link of chapterLinks) {
        const id = link.dataset.chapter!;
        /* pointerenter rather than mouseenter so a pen or touch hover counts,
           and focus so the keyboard gets exactly the same stage. */
        link.addEventListener('pointerenter', () => showPreview(id));
        link.addEventListener('focus', () => showPreview(id));
      }

      /* ---- 2. worlds --------------------------------------------------- */
      const worlds = new Map<string, HTMLElement>(
        [...root.querySelectorAll<HTMLElement>('[data-world]')].map((el) => [el.dataset.world!, el]),
      );
      const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
      let openWorld: HTMLElement | null = null;
      let restoreFocusTo: HTMLElement | null = null;

      const setInert = (on: boolean) => {
        for (const el of [document.querySelector('.site-header'), document.querySelector('.site-footer')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
        const index = root.querySelector<HTMLElement>('.pf-index');
        const intro = root.querySelector<HTMLElement>('.pf-intro');
        for (const el of [index, intro]) if (el) el.toggleAttribute('inert', on);
      };

      const closeWorld = () => {
        if (!openWorld) return;
        openWorld.removeAttribute('data-open');
        openWorld = null;
        document.body.classList.remove('no-scroll');
        setInert(false);
        const target = restoreFocusTo;
        restoreFocusTo = null;
        /* Focus has to land after the layer is gone, or the browser scrolls
           the still-fixed panel instead of the page. */
        if (target && document.contains(target)) target.focus({ preventScroll: true });
      };

      const openWorldById = (id: string) => {
        const next = worlds.get(id);
        if (!next) { closeWorld(); return; }
        if (openWorld === next) return;
        if (openWorld) openWorld.removeAttribute('data-open');
        if (!restoreFocusTo) {
          restoreFocusTo = chapterLinks.find((link) => link.dataset.chapter === id)
            ?? (document.activeElement as HTMLElement | null);
        }
        openWorld = next;
        next.setAttribute('data-open', '');
        document.body.classList.add('no-scroll');
        next.scrollTop = 0;
        /* Order matters twice over here.
           focus() is a no-op on a visibility:hidden element and data-open has
           not been through style recalc yet, so force that first.
           And the focus has to move BEFORE the index is marked inert: the
           chapter link the visitor just activated lives inside it, and the
           blur the UA performs when a focused element's container becomes
           inert lands after a focus call made on the same tick — which is
           exactly what kept putting activeElement back on <body>. */
        void next.offsetHeight;
        const first = next.querySelector<HTMLElement>(FOCUSABLE);
        (first ?? next).focus({ preventScroll: true });
        setInert(true);
        layoutAll();
      };

      const syncFromHash = () => {
        const id = window.location.hash.replace('#', '');
        if (worlds.has(id)) openWorldById(id);
        else closeWorld();
      };

      /* The chapter entries are real anchors so that the worlds are reachable
         with the script gone. With the script running we take the click over:
         letting the browser perform the fragment navigation meant it also ran
         its own focus handling afterwards, which threw away the focus we had
         just moved into the layer and left activeElement on <body>. pushState
         puts the same URL in the bar without that side effect, and popstate
         below keeps the Back button behaving exactly as before. */
      for (const link of chapterLinks) {
        if (link.tagName !== 'A') continue;
        link.addEventListener('click', (event) => {
          const id = link.dataset.chapter!;
          if (!worlds.has(id)) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || (event as MouseEvent).button !== 0) return;
          event.preventDefault();
          if (window.location.hash !== `#${id}`) window.history.pushState({ world: id }, '', `#${id}`);
          openWorldById(id);
        });
      }

      window.addEventListener('popstate', syncFromHash);

      /* Close returns through history so the browser Back button and the
         in-page control agree about what "back" means. */
      for (const button of root.querySelectorAll<HTMLElement>('[data-world-close]')) {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          if (window.history.length > 1 && window.location.hash) window.history.back();
          else { window.location.hash = ''; syncFromHash(); }
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !openWorld) return;
        event.preventDefault();
        if (window.history.length > 1 && window.location.hash) window.history.back();
        else { window.location.hash = ''; syncFromHash(); }
      });

      /* Focus trap. Only ever active while a layer is open. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab' || !openWorld) return;
        const items = [...openWorld.querySelectorAll<HTMLElement>(FOCUSABLE)]
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        else if (!openWorld.contains(document.activeElement)) { event.preventDefault(); first.focus(); }
      });

      window.addEventListener('hashchange', syncFromHash);

      /* ---- 3. the project queue ---------------------------------------- */
      /* Geometry, by width. `visible` is the number of projects on screen at
         once; `ratio` is how much smaller each one is than the one before it.
         Nothing is a fixed pixel offset — every number below is derived from
         the measured stage width, so the composition breathes instead of
         being a desktop layout shrunk down. */
      const geometry = () => {
        const w = window.innerWidth;
        /* Two states, not four. The rule is desktop five / mobile three, and
           1024 is a desktop. Between 1024 and 1199 the information panel drops
           below the stage (see the CSS breakpoint), which gives the queue the
           full content width — that is what lets five complete garments fit at
           1024 without any of them becoming unreadable. */
        if (w >= 1024) return { visible: 5, ratio: 0.78, gap: 10, lift: 7 };
        if (w >= 760) return { visible: 3, ratio: 0.74, gap: 8, lift: 6 };
        return { visible: 3, ratio: 0.70, gap: 6, lift: 5 };
      };

      /* 3:4. Measured from the renditions: 39 of 49 are exactly 0.749, and the
         rest letterbox into this canvas rather than being cropped. */
      const CANVAS = 0.75;

      interface Queue {
        panel: HTMLElement;
        stage: HTMLElement;
        stack: HTMLElement;
        slots: HTMLElement[];
        infos: HTMLElement[];
        counter: HTMLElement | null;
        prev: HTMLElement | null;
        next: HTMLElement | null;
        index: number;
        drag: number;
        width: number;
      }

      const queues: Queue[] = [...root.querySelectorAll<HTMLElement>('.pf-panel')].map((panel) => ({
        panel,
        stage: panel.querySelector<HTMLElement>('[data-stage]')!,
        stack: panel.querySelector<HTMLElement>('[data-stack]')!,
        slots: [...panel.querySelectorAll<HTMLElement>('.pf-slot')],
        infos: [...panel.querySelectorAll<HTMLElement>('[data-project-info]')],
        counter: panel.querySelector<HTMLElement>('[data-counter-current]'),
        prev: panel.querySelector<HTMLElement>('[data-step="-1"]'),
        next: panel.querySelector<HTMLElement>('[data-step="1"]'),
        index: 0,
        drag: 0,
        width: 0,
      }));

      const layout = (queue: Queue) => {
        const { visible, ratio, gap, lift } = geometry();
        const stageWidth = queue.stage.clientWidth;
        if (stageWidth === 0) return;

        /* The nominal slot count is fixed for the category, so the active
           image does not grow as the queue runs out near the end. */
        const nominal = Math.min(visible, queue.slots.length);
        let scaleSum = 0;
        for (let i = 0; i < nominal; i += 1) scaleSum += ratio ** i;
        const width0 = (stageWidth - gap * (nominal - 1)) / scaleSum;
        const height0 = width0 / CANVAS;
        queue.width = width0;
        queue.stage.style.setProperty('--stage-h', `${Math.round(height0 + lift * (nominal - 1))}px`);

        let x = 0;
        queue.slots.forEach((slot, i) => {
          const offset = i - queue.index;
          if (offset < 0 || offset >= nominal) {
            slot.hidden = true;
            return;
          }
          slot.hidden = false;
          const scale = ratio ** offset;
          const w = width0 * scale;
          const h = height0 * scale;
          slot.style.setProperty('--x', `${Math.round(x)}px`);
          slot.style.setProperty('--w', `${Math.round(w)}px`);
          slot.style.setProperty('--h', `${Math.round(h)}px`);
          /* Things further away sit slightly higher, the way a receding object
             rises toward a horizon. It reads as depth without a drop shadow,
             a rotation or a dark overlay. */
          slot.style.setProperty('--lift', `${offset * lift}px`);
          slot.dataset.depth = String(offset);
          slot.style.zIndex = String(50 - offset);
          x += w + gap;
        });
      };

      const layoutAll = () => { for (const queue of queues) if (!queue.panel.hidden) layout(queue); };

      const render = (queue: Queue) => {
        queue.infos.forEach((info, i) => { info.hidden = i !== queue.index; });
        queue.slots.forEach((slot, i) => slot.toggleAttribute('data-active', i === queue.index));
        if (queue.counter) {
          const noun = queue.counter.dataset.noun ?? 'Project';
          queue.counter.textContent = `${noun} ${String(queue.index + 1).padStart(2, '0')}`;
        }
        if (queue.prev) (queue.prev as HTMLButtonElement).disabled = queue.index === 0;
        if (queue.next) (queue.next as HTMLButtonElement).disabled = queue.index >= queue.slots.length - 1;
        layout(queue);
      };

      const goTo = (queue: Queue, next: number) => {
        const clamped = Math.max(0, Math.min(queue.slots.length - 1, next));
        if (clamped === queue.index) return;
        queue.index = clamped;
        render(queue);
      };

      for (const queue of queues) {
        if (queue.slots.length === 0) continue;

        queue.prev?.addEventListener('click', () => goTo(queue, queue.index - 1));
        queue.next?.addEventListener('click', () => goTo(queue, queue.index + 1));

        /* Keyboard: the stage is focusable and the arrows drive it. Nothing
           here needs a pointer. */
        queue.stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(queue, queue.index + 1); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(queue, queue.index - 1); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(queue, 0); }
          else if (event.key === 'End') { event.preventDefault(); goTo(queue, queue.slots.length - 1); }
        });

        /* Direct manipulation.
           During the gesture the stack is translated by the SAME SIGN as the
           pointer delta — hand right, cards right. On release, a leftward drag
           past the threshold advances to the next project, because dragging
           left is what pulls the next project into the leading position. */
        let dragging = false;
        let startX = 0;
        let pointerId = -1;

        const resistance = (dx: number) => {
          const atStart = queue.index === 0 && dx > 0;
          const atEnd = queue.index >= queue.slots.length - 1 && dx < 0;
          return (atStart || atEnd) ? dx * 0.3 : dx;
        };

        queue.stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || queue.slots.length < 2) return;
          const target = event.target as HTMLElement;
          if (target.closest('button, a')) return;
          event.preventDefault();
          dragging = true;
          startX = event.clientX;
          pointerId = event.pointerId;
          queue.stage.setPointerCapture(pointerId);
          queue.stack.setAttribute('data-dragging', '');
        });

        queue.stage.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          queue.drag = resistance(event.clientX - startX);
          queue.stack.style.setProperty('--drag', `${queue.drag}px`);
        });

        const endDrag = (event: PointerEvent) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          try { queue.stage.releasePointerCapture(pointerId); } catch { /* already released */ }
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
          const threshold = Math.max(48, queue.width * 0.22);
          const travelled = queue.drag;
          queue.drag = 0;
          if (travelled <= -threshold) goTo(queue, queue.index + 1);
          else if (travelled >= threshold) goTo(queue, queue.index - 1);
        };

        queue.stage.addEventListener('pointerup', endDrag);
        /* A cancel is an abort, not a release — it snaps back and changes
           nothing. */
        queue.stage.addEventListener('pointercancel', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          queue.drag = 0;
          queue.stack.removeAttribute('data-dragging');
          queue.stack.style.setProperty('--drag', '0px');
        });

        render(queue);
      }

      /* ---- category switching ------------------------------------------ */
      for (const world of worlds.values()) {
        const buttons = [...world.querySelectorAll<HTMLElement>('[data-category]')];
        const panels = [...world.querySelectorAll<HTMLElement>('[data-panel]')];
        for (const button of buttons) {
          button.addEventListener('click', () => {
            const id = button.dataset.category!;
            for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
            for (const panel of panels) panel.hidden = panel.dataset.panel !== id;
            layoutAll();
          });
        }
      }

      /* ---- 4. sessions: nothing is fetched until play is pressed -------- */
      for (const world of worlds.values()) {
        const sessions = [...world.querySelectorAll<HTMLElement>('[data-session]')];
        for (const link of world.querySelectorAll<HTMLElement>('[data-session-link]')) {
          link.addEventListener('click', () => {
            const id = link.dataset.sessionLink!;
            for (const other of world.querySelectorAll<HTMLElement>('[data-session-link]')) {
              other.setAttribute('aria-pressed', String(other === link));
            }
            for (const session of sessions) session.hidden = session.dataset.session !== id;
          });
        }

        for (const session of sessions) {
          const play = session.querySelector<HTMLElement>('[data-play]');
          const mount = session.querySelector<HTMLElement>('[data-player]');
          if (!play || !mount) continue;
          play.addEventListener('click', () => {
            const youtubeId = session.dataset.youtube;
            const videoSrc = session.dataset.video;
            if (youtubeId) {
              /* Created here and nowhere else. Before this click no request
                 has been made to any Google domain. nocookie is the
                 privacy-enhanced host; autoplay applies to the click that
                 just happened, not to page load. */
              const frame = document.createElement('iframe');
              frame.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
              frame.title = session.querySelector('h3')?.textContent ?? 'Simulation session';
              frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
              frame.setAttribute('allowfullscreen', '');
              frame.setAttribute('loading', 'lazy');
              mount.replaceChildren(frame);
            } else if (videoSrc) {
              /* Same contract for a self-hosted session: no src on the
                 element until now, so the bytes are not fetched on load. */
              const video = document.createElement('video');
              video.src = videoSrc;
              video.controls = true;
              video.autoplay = true;
              video.playsInline = true;
              video.setAttribute('preload', 'auto');
              mount.replaceChildren(video);
            } else {
              return;
            }
            mount.hidden = false;
            session.setAttribute('data-playing', '');
            play.hidden = true;
          });
        }
      }

      /* ---- relayout ---------------------------------------------------- */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutAll, 120);
      });
      window.addEventListener('orientationchange', () => window.setTimeout(layoutAll, 200));
      /* Late webfonts and image decode both change the stage box. */
      window.addEventListener('load', layoutAll);

      layoutAll();
      syncFromHash();

      /* Debug surface for the smoke tests. Mirrors the old
         window.__portfolioRunway contract so the overlay assertions that
         predate V6 keep running, and adds what V6 needs to prove. */
      (window as unknown as Record<string, unknown>).__portfolioRunway = {
        getState() {
          const queue = queues.find((q) => !q.panel.hidden && q.panel.closest('[data-world]')?.hasAttribute('data-open'))
            ?? queues.find((q) => !q.panel.hidden)
            ?? queues[0];
          const { visible, ratio } = geometry();
          return {
            activeIndex: queue.index,
            position: queue.index,
            count: queue.slots.length,
            visibleTarget: visible,
            visibleNow: queue.slots.filter((slot) => !slot.hidden).length,
            ratio,
            activeIsLeftmost: queue.slots.filter((s) => !s.hidden)[0] === queue.slots[queue.index],
            openWorld: openWorld?.dataset.world ?? null,
            reducedMotion: reduced(),
          };
        },
        /* Used by the drag-direction test: reports the sign the stack is
           translated by for a given pointer delta. */
        dragProbe(deltaX: number) {
          const queue = queues.find((q) => !q.panel.hidden) ?? queues[0];
          const before = queue.index;
          queue.stack.style.setProperty('--drag', `${deltaX}px`);
          const applied = getComputedStyle(queue.stack).getPropertyValue('--drag').trim();
          queue.stack.style.setProperty('--drag', '0px');
          return { applied, before };
        },
        goTo(i: number) {
          const queue = queues.find((q) => !q.panel.hidden) ?? queues[0];
          goTo(queue, i);
          return queue.index;
        },
      };
    }
  </script>

  <style is:global>
    /* ======================================================================
       PORTFOLIO V6
       Every selector below is inside .pf. Nothing here reaches another page.
       ====================================================================== */

        /* Two different whites, both measured rather than picked.
       --pf-stage is the garment studio. Sampling the ground of all 49
       renditions gives 238-255 with a median of 248, so no single value makes
       every tile disappear. Two candidates were rendered and compared rather
       than argued about: the median (#f8f8f8) leaves the lightest photographs
       sitting on the stage as brighter rectangles, which reads as a glowing
       tile; multiply compositing scales the gap by (255 - ground) and pushed
       the darkest photograph sixteen levels down. Sitting just under the
       lightest cluster puts every edge on the same, softer side — a tile is
       never brighter than its stage, so the residual reads as paper rather
       than as a panel. The remaining difference is inherent to the source
       photography; normalising it belongs in gen-portfolio.sh, not in CSS.
       --pf-paper is for document surfaces: sheets, dossiers, evidence plates. */
    .pf { --pf-stage: #fcfcfc; --pf-paper: #ffffff; }

    /* ---------- intro ---------- */
    .pf-intro {
      max-width: var(--max);
      margin: 0 auto;
      padding: calc(var(--header-h) + clamp(1.5rem, 3vw, 2.5rem)) var(--gutter) clamp(1.5rem, 2.5vw, 2rem);
    }
    .pf-intro__title {
      margin: 1.25rem 0 0;
      font-size: clamp(2.5rem, 5.9vw, 5.1rem);
      line-height: .93;
      letter-spacing: -.045em;
    }
    .pf-intro__lede {
      max-width: 34rem;
      margin: 1.35rem 0 0;
      color: var(--ink-soft);
      font-size: clamp(1rem, 1.5vw, 1.12rem);
      line-height: 1.65;
    }
    .pf-intro__meta { margin: .9rem 0 0; color: var(--muted); }

    /* ---------- the living editorial index ---------- */
    .pf-index {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, .78fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: start;
      max-width: var(--max);
      margin: 0 auto;
      padding: 0 var(--gutter) clamp(4rem, 9vw, 8rem);
    }
    .pf-index__title {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .pf-index__chapters { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }

    .pf-chapter {
      position: relative;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: clamp(1rem, 2.4vw, 2.25rem);
      row-gap: .4rem;
      padding: clamp(1.15rem, 1.9vw, 1.7rem) 0;
      border-bottom: 1px solid var(--line);
      color: inherit;
      text-decoration: none;
      transition: padding-left .45s var(--ease);
    }
    .pf-chapter__num { grid-column: 1; grid-row: 1 / span 2; color: var(--muted); padding-top: .45rem; transition: color .3s var(--ease); }
    .pf-chapter__title {
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(1.6rem, 2.9vw, 2.6rem);
      line-height: 1;
      letter-spacing: -.035em;
    }
    .pf-chapter__title { grid-column: 2; grid-row: 1; }
    .pf-chapter__desc { grid-column: 2; grid-row: 2; color: var(--muted); font-size: .95rem; line-height: 1.55; max-width: 30rem; }
    /* The one restrained line on a chapter that is not published work. */
    .pf-chapter__state {
      grid-column: 2;
      grid-row: 3;
      position: relative;
      margin-top: .5rem;
      padding-left: .95rem;
      max-width: 32rem;
      color: var(--ink-soft);
      font-size: .88rem;
      line-height: 1.5;
    }
    .pf-chapter__state::before {
      content: '';
      position: absolute;
      left: 0;
      top: .52em;
      width: .35rem;
      height: .35rem;
      background: var(--signal);
    }
    .pf-chapter[data-publication='unpublished'] { cursor: default; }
    .pf-chapter[data-publication='unpublished'] .pf-chapter__title { color: var(--ink-soft); }
    /* No hover lift and no orange marker on something that does not open. */
    .pf-chapter[data-publication='unpublished']:hover { padding-left: 0; }

    .pf-chapter__go {
      grid-column: 3;
      grid-row: 1 / span 2;
      align-self: center;
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      color: var(--signal);
      opacity: 0;
      transform: translateX(-.4rem);
      transition: opacity .35s var(--ease), transform .35s var(--ease);
    }
    .pf-chapter__go .arrow { width: 1em; height: 1em; }

    /* The single controlled signal: one square against the active entry.
       Not a border, not a fill, not a rule under the words. */
    .pf-chapter::before {
      content: '';
      position: absolute;
      left: 0;
      top: calc(clamp(1.15rem, 1.9vw, 1.7rem) + .62rem);
      width: .42rem;
      height: .42rem;
      background: var(--signal);
      opacity: 0;
      transform: scale(.4);
      transition: opacity .35s var(--ease), transform .35s var(--ease);
    }
    .pf-chapter[aria-current='true'] { padding-left: 1.35rem; }
    .pf-chapter[aria-current='true']::before { opacity: 1; transform: scale(1); }
    .pf-chapter[aria-current='true'] .pf-chapter__num { color: var(--ink); }
    .pf-chapter[aria-current='true'] .pf-chapter__go { opacity: 1; transform: none; }
    .pf-chapter:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }

    /* ---------- preview stage ---------- */
    .pf-stagepane {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
      align-self: start;
      display: grid;
      /* A deliberate height rather than an aspect ratio: the four previews
         share one grid cell, so without it the tallest one (the 4:5 video
         still) set the box and left the garment preview stranded at the
         bottom of a tall white field. */
      height: clamp(21rem, 29vw, 26rem);
      border: 1px solid var(--line);
      background: var(--pf-paper);
      overflow: hidden;
    }
    .pf-preview {
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-width: 0;
      min-height: 0;
      overflow: hidden;
      padding: clamp(1rem, 2vw, 1.75rem);
      opacity: 0;
      visibility: hidden;
      transform: scale(1.015);
      transition: opacity .5s var(--ease), transform .6s var(--ease), visibility .5s;
    }
    .pf-preview[data-active] { opacity: 1; visibility: visible; transform: none; }
    .pf-preview__tag { margin: 1rem 0 0; color: var(--muted); }

    /* Womenswear: the same leading-image logic as the world itself. */
    .pf-preview__queue { display: flex; align-items: flex-end; gap: .5rem; flex: 1; min-height: 0; }
    .pf-preview__queue .pf-preview__card { max-height: 100%; }
    .pf-preview__card { display: block; flex: none; aspect-ratio: 3 / 4; }
    .pf-preview__card:nth-child(1) { width: 42%; }
    .pf-preview__card:nth-child(2) { width: 31%; }
    .pf-preview__card:nth-child(3) { width: 22%; }
    .pf-preview__card img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: bottom center; }

    /* Menswear: typographic, because there is no menswear photograph. */
    .pf-preview--type { justify-content: center; }
    .pf-preview__index { margin: 0; padding: 0; list-style: none; }
    .pf-preview__index li { display: flex; gap: .9rem; align-items: baseline; padding: .85rem 0; border-bottom: 1px solid var(--line); }
    .pf-preview__index li:first-child { border-top: 1px solid var(--line); }
    .pf-preview__index i { color: var(--muted); flex: none; }
    .pf-preview__index span { font-family: var(--display); font-size: clamp(.95rem, 1.5vw, 1.15rem); letter-spacing: -.01em; }

    /* Tech packs: a ruled sheet with nothing written on it. The rules are
       uniform and evidently abstract — they are not standing in for
       measurements, sizes or any other fabricated data. */
    .pf-preview--doc { justify-content: center; }
    .pf-preview__sheet { display: grid; gap: clamp(.75rem, 1.8vw, 1.2rem); padding: clamp(1rem, 3vw, 2.5rem) 0; }
    .pf-preview__sheetline { display: block; height: 1px; background: var(--line); }
    .pf-preview__sheetline:nth-child(1) { width: 38%; background: var(--line-strong); }
    .pf-preview__sheetline:nth-child(2) { width: 100%; }
    .pf-preview__sheetline:nth-child(3) { width: 100%; }
    .pf-preview__sheetline:nth-child(4) { width: 72%; }
    .pf-preview__sheetline:nth-child(5) { width: 54%; }

    /* 3D: the real poster frame from the real session. */
    .pf-preview--motion { position: relative; padding: 0; justify-content: flex-end; }
    .pf-preview__still { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
    .pf-preview--motion .pf-preview__tag {
      position: absolute; left: 0; right: 0; bottom: 0;
      margin: 0; padding: clamp(1rem, 2vw, 1.75rem);
      color: var(--paper);
      background: linear-gradient(to top, rgba(17, 17, 15, .72), transparent);
    }

    /* ======================================================================
       WORLDS
       ====================================================================== */

    /* Fallback (no script): four ordinary sections. Everything is readable,
       scrollable and reachable by the chapter anchors. */
    .pf-world {
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(3rem, 6vw, 5rem) var(--gutter);
      border-top: 1px solid var(--line-strong);
      scroll-margin-top: var(--header-h);
    }
    .pf-world__bar { display: none; }

    /* Enhanced: a full-screen layer. */
    .pf--js .pf-worlds { display: contents; }
    .pf--js .pf-world {
      position: fixed;
      inset: 0;
      z-index: 150;
      max-width: none;
      margin: 0;
      padding: 0 0 clamp(3rem, 6vw, 5rem);
      border-top: 0;
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      opacity: 0;
      visibility: hidden;
      transform: translateY(1.25rem);
      /* visibility is stepped, not eased. Transitioning it over .4s meant the
         computed value was still `hidden` for the first frame after data-open
         was set, and focus() is a no-op on a hidden element — which is why
         opening a world left activeElement on <body> and broke the focus trap.
         Opening switches it at 0s; closing delays it until the fade is done so
         the layer does not disappear before it has finished leaving. */
      transition: opacity .4s var(--ease), transform .5s var(--ease), visibility 0s linear .4s;
    }
    .pf--js .pf-world[data-open] {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity .4s var(--ease), transform .5s var(--ease), visibility 0s linear 0s;
    }
    .pf-world:focus { outline: none; }
    .pf--js .pf-world__bar {
      position: sticky;
      top: 0;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem var(--gutter);
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }
    .pf-world__back {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      color: inherit;
      font-family: var(--mono);
      font-size: .7rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .pf-world__back .arrow { width: 1.1em; height: 1.1em; }
    .pf-world__back:hover { color: var(--signal); }
    .pf-world__tag { color: var(--muted); margin: 0; }
    .pf-world__tag b { color: var(--ink); font-weight: 500; }

    .pf-world__head { max-width: var(--max); margin: 0 auto; padding: clamp(2rem, 4vw, 3.5rem) var(--gutter) clamp(1.25rem, 2vw, 2rem); }
    .pf-world__head h2 { margin: 0; font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: .95; letter-spacing: -.04em; }
    .pf-world__descriptor { max-width: 38rem; margin: 1rem 0 0; color: var(--ink-soft); line-height: 1.6; }
    .pf-world__head:has(+ .pf-notice) { padding-bottom: .5rem; }

    /* ---------- subcategory index: numbers, type, one rule ---------- */
    .pf-cats { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .pf-cats ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 clamp(1.25rem, 3vw, 2.75rem);
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--line-strong);
      border-bottom: 1px solid var(--line);
    }
    .pf-cat {
      display: flex;
      align-items: baseline;
      gap: .55rem;
      padding: 1rem 0;
      border: 0;
      background: none;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: color .3s var(--ease);
    }
    .pf-cat__num { font-family: var(--mono); font-size: .7rem; letter-spacing: .14em; font-style: normal; }
    .pf-cat__label { font-family: var(--display); font-size: clamp(.9rem, 1.35vw, 1.05rem); letter-spacing: -.01em; }
    .pf-cat__count { font-family: var(--mono); font-size: .62rem; color: var(--muted); }
    .pf-cat:hover { color: var(--ink); }
    .pf-cat[aria-pressed='true'] { color: var(--ink); }
    /* The marker is a square before the number, never a rule beneath the
       words — a coloured line under text reads as a spelling error. */
    .pf-cat[aria-pressed='true'] .pf-cat__num { position: relative; color: var(--ink); }
    .pf-cat[aria-pressed='true'] .pf-cat__num::before {
      content: '';
      position: absolute;
      left: -.7rem;
      top: .34em;
      width: .34rem;
      height: .34rem;
      background: var(--signal);
    }
    .pf-cat:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }

    /* ---------- the reference disclaimer ----------
       Body size, full measure, sitting above the work in the reading order.
       Deliberately not small print: it is the sentence that tells you what you
       are looking at. */
    .pf-notice {
      max-width: var(--max);
      margin: 0 auto;
      padding: 1.1rem var(--gutter);
      color: var(--ink-soft);
      font-size: clamp(.94rem, 1.25vw, 1.02rem);
      line-height: 1.6;
    }
    .pf-notice > * { max-width: 46rem; }
    .pf-notice b { position: relative; padding-left: .95rem; color: var(--ink); font-weight: 600; }
    .pf-notice b::before {
      content: '';
      position: absolute;
      left: 0;
      top: .5em;
      width: .4rem;
      height: .4rem;
      background: var(--signal);
    }

    /* The information panel in reference mode. No profile rows, because there
       is nothing verified to put in them. */
    .pf-refpanel { padding-top: 1.5rem; }
    .pf-refpanel__lead { margin: 0; color: var(--ink); font-size: .98rem; line-height: 1.6; }
    .pf-refpanel__note { margin: 1rem 0 0; color: var(--muted); font-size: .88rem; line-height: 1.6; }

    .pf-panel { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .pf-panel[hidden] { display: none; }
    .pf-panel__blurb { max-width: 34rem; margin: 1.5rem 0 0; color: var(--muted); font-size: .95rem; line-height: 1.6; }

    /* ---------- viewer ---------- */
    .pf-viewer {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
      margin-top: clamp(1.5rem, 3vw, 2.5rem);
    }

    /* ONE white studio. Every garment sits in the same light, so the row does
       not read as five unrelated rectangular photographs. */
    /* FALLBACK (no script): the stage is simply the white studio and every
       project is a normal grid cell inside it. Complete, scrollable and
       readable — the queue below is an enhancement layered on top of this,
       never a prerequisite for seeing the work. */
    .pf-stage {
      position: relative;
      background: var(--pf-stage);
      border: 1px solid var(--line);
      padding: 1rem;
    }
    .pf-stage:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-stack {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .pf-slot__figure { margin: 0; }

    /* ENHANCED: the leading-image depth queue. */
    .pf--js .pf-stage {
      height: var(--stage-h, 420px);
      padding: 0;
      overflow: hidden;
      cursor: grab;
      touch-action: pan-y;
      -webkit-user-select: none;
      user-select: none;
    }
    .pf--js .pf-stack {
      display: block;
      position: absolute;
      inset: 0;
      transform: translate3d(var(--drag, 0px), 0, 0);
      transition: transform .55s var(--ease);
    }
    .pf--js .pf-stack[data-dragging] { transition: none; }
    .pf--js .pf-slot {
      position: absolute;
      left: var(--x, 0);
      bottom: var(--lift, 0);
      width: var(--w, 0);
      height: var(--h, 0);
      transition: left .55s var(--ease), width .55s var(--ease), height .55s var(--ease), bottom .55s var(--ease), opacity .55s var(--ease);
    }
    .pf--js .pf-slot__figure { position: relative; width: 100%; height: 100%; }
    .pf-slot[hidden] { display: none; }
    /* contain, never cover: a head, a hem or a train is never cut off. The
       image backgrounds are white and so is the stage, so the individual
       frames dissolve into one studio instead of reading as tiles. */
    /* pointer-events: none is load-bearing. Without it the first pointermove
       over a slot started a native image drag, the browser fired
       pointercancel, and the gesture died about twelve pixels in. The stage
       owns the whole interaction; the images are not targets. */
    .pf-slot__figure img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      pointer-events: none;
      -webkit-user-drag: none;
    }
    /* The number is stated in the information panel, so on screen this would
       be the same fact twice. It stays in the document for assistive tech,
       which has no panel to read it from. */
    .pf-slot__caption {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* Depth: scale and position do the work. The farthest one or two take a
       very restrained blur — enough to sit back, never enough to stop the
       garment being evaluated. */
    .pf-slot[data-depth='3'] { opacity: .94; }
    .pf-slot[data-depth='4'] { opacity: .86; }

    /* ---------- project information ---------- */
    .pf-info { min-width: 0; }
    .pf-info__nav {
      display: flex;
      align-items: center;
      gap: .75rem;
      padding-bottom: .9rem;
      border-bottom: 1px solid var(--line);
    }
    .pf-step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--line-strong);
      background: none;
      color: inherit;
      cursor: pointer;
      transition: background .25s var(--ease), color .25s var(--ease), opacity .25s var(--ease);
    }
    .pf-step .arrow { width: 1.05rem; height: 1.05rem; }
    .pf-step:hover:not(:disabled) { background: var(--ink); color: var(--paper); }
    .pf-step:disabled { opacity: .3; cursor: default; }
    .pf-step:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
    .pf-info__counter { margin: 0; }
    .pf-info__counter i { color: var(--muted); font-style: normal; }

    .pf-project[hidden] { display: none; }
    .pf-project__number { margin: 1.5rem 0 0; color: var(--signal); }
    .pf-project__title {
      margin: .5rem 0 0;
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(1.35rem, 2.1vw, 1.75rem);
      line-height: 1.1;
      letter-spacing: -.025em;
    }
    .pf-project__profile { margin: 1.5rem 0 0; }
    .pf-project__profile > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
    .pf-project__profile dt {
      margin: 0;
      color: var(--muted);
      font-family: var(--mono);
      font-size: .64rem;
      letter-spacing: .14em;
      text-transform: uppercase;
      line-height: 1.6;
    }
    .pf-project__profile dd { margin: 0; font-size: .92rem; line-height: 1.55; }
    .pf-project__description { margin: 1.25rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-project__tags { margin: 1rem 0 0; color: var(--muted); }
    .pf-project__tags i { font-style: normal; opacity: .5; }

    /* ---------- development evidence ---------- */
    .pf-evidence { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--line-strong); }
    .pf-evidence__head { margin: 0 0 .9rem; color: var(--muted); }
    .pf-evidence__strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .55rem; margin: 0; padding: 0; list-style: none; }
    .pf-evidence__item { position: relative; display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
    .pf-evidence__arrow {
      position: absolute;
      left: -.5rem;
      top: .1rem;
      display: inline-flex;
      color: var(--signal);
      transform: translateX(-50%);
    }
    .pf-evidence__arrow .arrow { width: .72rem; height: .72rem; }
    .pf-evidence__plate { display: block; aspect-ratio: 4 / 5; background: var(--pf-paper); border: 1px solid var(--line); }
    .pf-evidence__plate img { width: 100%; height: 100%; object-fit: contain; }
    .pf-evidence__step { color: var(--muted); font-size: .6rem; font-weight: 400; }
    .pf-evidence__name { font-family: var(--display); font-size: .82rem; line-height: 1.2; letter-spacing: -.01em; }
    /* No asset for any stage yet: the strip becomes the same three stages as
       type on a rule. Nothing stands in for work that has not been made. */
    .pf-evidence--type .pf-evidence__strip { border-top: 1px solid var(--line); padding-top: .8rem; }
    .pf-evidence__result { display: flex; align-items: center; gap: .4rem; margin: .9rem 0 0; color: var(--muted); font-family: var(--mono); font-size: .62rem; letter-spacing: .12em; text-transform: uppercase; }
    .pf-evidence__result .arrow { width: .8rem; height: .8rem; color: var(--signal); }

    /* ---------- menswear / empty worlds ---------- */
    .pf-empty { max-width: var(--max); margin: 0 auto; padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0; }
    .pf-empty__lead { max-width: 34rem; margin: 0; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }
    .pf-empty__list { max-width: 46rem; margin: 2rem 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
    .pf-empty__list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .35rem 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
    .pf-empty__list i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-empty__list span { font-family: var(--display); font-size: 1.1rem; letter-spacing: -.015em; }
    .pf-empty__list small { color: var(--muted); font-size: .88rem; line-height: 1.5; }

    /* ---------- tech packs ---------- */
    .pf-docs {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 23rem);
      gap: clamp(1.5rem, 3.5vw, 3.5rem);
      align-items: start;
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0;
    }
    /* Sized as a sheet of paper, not as a full-width panel: at column width
       the empty dossier read as a void rather than as a document. */
    .pf-sheet {
      display: flex;
      flex-direction: column;
      max-width: 32rem;
      aspect-ratio: 297 / 210;
      padding: clamp(1.25rem, 2.5vw, 2.25rem);
      border: 1px solid var(--line-strong);
      background: var(--pf-paper);
    }
    .pf-sheet__head, .pf-sheet__foot { display: flex; justify-content: space-between; color: var(--muted); }
    .pf-sheet__head { padding-bottom: .9rem; border-bottom: 1px solid var(--line-strong); }
    .pf-sheet__foot { padding-top: .9rem; border-top: 1px solid var(--line); }
    .pf-sheet__body { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; gap: .5rem; padding: clamp(.75rem, 2vw, 1.4rem) 0; }
    .pf-sheet__body i { display: block; height: 1px; background: var(--line); }
    .pf-sheet__body i:nth-child(1) { width: 34%; background: var(--line-strong); }
    .pf-sheet__body i:nth-child(4) { width: 78%; }
    .pf-sheet__body i:nth-child(6) { width: 61%; }
    .pf-sheet__body i:nth-child(8) { width: 43%; }
    .pf-dossier { margin: 0; }
    .pf-dossier[hidden] { display: none; }
    .pf-dossier img { width: 100%; height: auto; border: 1px solid var(--line); background: var(--pf-paper); }
    .pf-dossier__blank { display: block; aspect-ratio: 297 / 210; border: 1px solid var(--line); background: var(--pf-paper); }
    .pf-dossier figcaption h3 { margin: .4rem 0 1rem; font-family: var(--display); font-size: 1.4rem; letter-spacing: -.02em; }
    .pf-docs__head { margin: 0 0 1rem; color: var(--muted); }
    .pf-docs__head--split { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-strong); }
    .pf-docs__note { margin: 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-docs__list, .pf-contents { margin: 0; padding: 0; list-style: none; }
    .pf-contents li { display: grid; grid-template-columns: 2.1rem minmax(0, 1fr); gap: .25rem .75rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
    .pf-contents li:first-child { border-top: 1px solid var(--line); }
    .pf-contents i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-contents span { font-family: var(--display); font-size: .98rem; letter-spacing: -.01em; }
    .pf-contents small { color: var(--muted); font-size: .84rem; line-height: 1.5; }
    .pf-docs__index .button { margin-top: 1.75rem; }

    /* ---------- 3d simulation ---------- */
    .pf-motion {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      gap: clamp(1.5rem, 3.5vw, 3.5rem);
      align-items: start;
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0;
    }
    .pf-session[hidden] { display: none; }
    /* The children are positioned, not grid-placed. Inside a grid the
       poster's `height: 100%` was cyclic against a content-sized row, so the
       512x910 still kept its intrinsic height, the row grew to 1709px and the
       centred play control was pushed out of the clipped frame. An absolute
       inset resolves against the frame's own border box, which aspect-ratio
       has already made definite. */
    .pf-session__frame {
      position: relative;
      aspect-ratio: 16 / 10;
      background: var(--ink);
      overflow: hidden;
    }
    .pf-session__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
    .pf-play {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      padding: .75rem 1.1rem;
      border: 1px solid rgba(243, 240, 233, .45);
      background: rgba(17, 17, 15, .58);
      color: var(--paper);
      cursor: pointer;
      transition: background .3s var(--ease), border-color .3s var(--ease);
    }
    .pf-play:hover { background: var(--signal); border-color: var(--signal); color: var(--ink); }
    .pf-play:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-play__mark { width: 0; height: 0; border-left: .6rem solid currentColor; border-top: .38rem solid transparent; border-bottom: .38rem solid transparent; }
    .pf-session__player { position: absolute; inset: 0; z-index: 3; }
    .pf-session__player[hidden] { display: none; }
    .pf-session__player iframe, .pf-session__player video { width: 100%; height: 100%; border: 0; background: var(--ink); }
    .pf-session[data-playing] .pf-session__poster { opacity: 0; }
    .pf-session__meta h3 { margin: 1.25rem 0 0; font-family: var(--display); font-size: clamp(1.3rem, 2.2vw, 1.75rem); letter-spacing: -.025em; }
    .pf-session__meta p { margin: .75rem 0 0; max-width: 40rem; color: var(--ink-soft); line-height: 1.65; }
    .pf-session__labels { color: var(--muted); }
    .pf-session__labels i { font-style: normal; opacity: .5; }
    .pf-session__privacy { color: var(--muted); font-size: .85rem; }
    .pf-motion__head { margin: 0 0 1rem; color: var(--muted); }
    .pf-motion__list { margin: 0; padding: 0; list-style: none; }
    .pf-sessionlink {
      display: grid;
      grid-template-columns: 2.1rem minmax(0, 1fr) auto;
      gap: .75rem;
      align-items: baseline;
      width: 100%;
      padding: .9rem 0;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: none;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      text-align: left;
    }
    .pf-sessionlink:first-child { border-top: 1px solid var(--line); }
    .pf-sessionlink span { font-family: var(--display); font-size: 1rem; letter-spacing: -.01em; }
    .pf-sessionlink small { font-family: var(--mono); font-size: .64rem; }
    .pf-sessionlink[aria-pressed='true'] { color: var(--ink); }
    .pf-sessionlink[aria-pressed='true'] i { color: var(--signal); }
    .pf-sessionlink:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
    .pf-motion__note { margin: 1.5rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }
    .pf-motion__index .button { margin-top: 1.5rem; }

    /* ======================================================================
       RESPONSIVE
       ====================================================================== */

    /* The stage keeps the whole content width from here down, so five complete
       garments still fit at 1024. Above it there is room for the panel beside
       the queue. */
    @media (max-width: 1199px) {
      .pf-viewer, .pf-docs, .pf-motion { grid-template-columns: minmax(0, 1fr); }
    }

    @media (max-width: 900px) {
      .pf-index { grid-template-columns: minmax(0, 1fr); }
      /* No hover on a touch screen, so the sticky stage is dropped entirely
         and each chapter becomes a full-width editorial band carrying its own
         restrained preview. */
      .pf-stagepane { display: none; }
      .pf-chapter { grid-template-columns: auto minmax(0, 1fr); padding: clamp(1.25rem, 3.4vw, 1.8rem) 0; }
      /* Row 4, not 3: the state note took row 3 and the two were printing on
         top of each other. */
      .pf-chapter__go { grid-column: 2; grid-row: 4; align-self: start; margin-top: .55rem; }
      /* The corner square marks the chapter the preview is showing. A chapter
         that does not open has no preview to mark. */
      .pf-chapter[data-publication='unpublished']::before { content: none; }
      .pf-chapter__title { font-size: clamp(1.9rem, 7.5vw, 2.6rem); }
      .pf-chapter__go { opacity: 1; transform: none; }
      .pf-chapter[aria-current='true'] { padding-left: 0; }
      .pf-chapter::before { top: calc(clamp(1.25rem, 3.4vw, 1.8rem) + .55rem); left: auto; right: 0; opacity: 1; transform: none; }
    }

    @media (max-width: 760px) {
      .pf-session__frame { aspect-ratio: 4 / 5; }
      .pf-viewer { gap: 1.75rem; }
      .pf-info__nav { position: sticky; top: 3.4rem; z-index: 3; background: var(--paper); padding-top: .75rem; }
      /* Three across, still, and sized deliberately rather than shrunk: at
         390px each stage is ~30vw wide, which keeps the label legible. */
      .pf-evidence__strip { gap: .4rem; }
      .pf-evidence__name { font-size: .74rem; }
      .pf-evidence__arrow { left: -.25rem; }
      .pf-cats ul { gap: 0 1.1rem; }
      .pf-cat { padding: .8rem 0; }
      .pf-cat__label { font-size: .82rem; }
      .pf-project__profile > div { grid-template-columns: 6.5rem minmax(0, 1fr); gap: .75rem; }
    }

    @media (max-width: 430px) {
      .pf-cat__label { font-size: .78rem; }
      .pf-evidence__name { font-size: .7rem; }
      .pf-project__profile > div { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
    }

    /* ======================================================================
       REDUCED MOTION — everything still works, nothing moves decoratively.
       ====================================================================== */
    @media (prefers-reduced-motion: reduce) {
      .pf-chapter,
      .pf-chapter::before,
      .pf-chapter__go,
      .pf-preview,
      .pf-slot,
      .pf-stack,
      .pf-world { transition: none !important; }
      .pf--js .pf-world { transform: none; }
      .pf-slot[data-depth='3'],
      .pf-slot[data-depth='4'] { filter: none; }
    }
  </style>
</SiteLayout>
