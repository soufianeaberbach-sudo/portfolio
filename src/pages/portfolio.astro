---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import GarmentWorld from '../components/portfolio/GarmentWorld.astro';
import TechPackWorld from '../components/portfolio/TechPackWorld.astro';
import SimulationWorld from '../components/portfolio/SimulationWorld.astro';
import WorldNavigation from '../components/portfolio/WorldNavigation.astro';
import { chapters, garmentWorlds, techPacks, simulationSessions } from '../data/portfolio';
import '../styles/portfolio-director.css';
import '../styles/portfolio-cinematic.css';
import '../styles/portfolio-journey.css';

const chapterActions = [
  'Explore silhouettes',
  'Enter construction',
  'Open documentation',
  'Trace development',
];

const chapterNotes = [
  'Movement / form / proportion',
  'Structure / balance / tailoring',
  'Specification / clarity / handoff',
  'Pattern / validation / resolution',
];

const journeyCopy = [
  {
    eyebrow: 'Silhouette / movement / form',
    title: 'Silhouette in motion.',
    text: 'Fashion led by proportion, gesture and the way a garment moves.',
  },
  {
    eyebrow: 'Structure / tailoring / proportion',
    title: 'Cut with clarity.',
    text: 'A more architectural rhythm, where every line earns its place.',
  },
  {
    eyebrow: 'Specification / decision / handoff',
    title: 'The product, made legible.',
    text: 'Documents become the shared language between design and production.',
  },
  {
    eyebrow: 'Pattern / validation / resolution',
    title: 'Form becomes resolved.',
    text: 'Development makes construction, fit and digital validation visible.',
  },
];

/* Every chapter opens. A chapter with nothing published still has an
   architecture worth walking into — its categories are listed, each marked
   pending, and nothing inside claims work that does not exist. Refusing to
   open it hid the structure without making the page any more truthful. */
---

<SiteLayout
  title="Portfolio — Soufiane Aberbach"
  description="Womenswear and menswear product development, production-ready tech packs and CLO3D garment simulation — shown as development evidence, not decoration."
  marker="SA-PORTFOLIO-V8"
  page="portfolio"
>
  <!-- BUILD-MARKER: SA-PORTFOLIO-V8 -->
  <div class="pf" data-pf-root>
    {/* Set before first paint so the enhanced layout never flashes the
        stacked fallback. parentElement is the .pf root, so the flag cannot
        reach any other page. */}
    <script is:inline>
      document.currentScript.parentElement.classList.add('pf--js');
    </script>

    <section
      class="pf-cinema"
      id="portfolio-index"
      data-cinema
      data-active-chapter="womenswear"
      aria-labelledby="pf-cinema-title"
    >
      <div class="pf-cinema__sticky">
        <p class="pf-cinema__folio label" data-cinema-folio>
          <span>Soufiane Aberbach</span><span>Selected work / 2026</span>
        </p>

        <h1 class="pf-cinema__title display" id="pf-cinema-title" data-cinema-title>
          <span class="pf-cinema__between" data-title-between>Between</span>
          <span class="pf-cinema__instinct" data-title-instinct>Instinct</span>
          <span class="pf-cinema__construction" data-title-construction>&amp; Construction</span>
        </h1>

        <p class="pf-cinema__thesis" data-cinema-thesis>
          Fashion ideas developed into products that can be made.
        </p>

        <div class="pf-cinema__media" data-cinema-media aria-hidden="true">
          {chapters.map((chapter, index) => (
            <figure
              class={`pf-cinema__visual pf-cinema__visual--${chapter.id}`}
              data-media-chapter={chapter.id}
              data-image-source={chapter.cover.credit.source}
            >
              <img
                src={chapter.cover.image.src}
                srcset={chapter.cover.image.srcset}
                sizes="(max-width: 767px) 100vw, 82vw"
                width={chapter.cover.image.width}
                height={chapter.cover.image.height}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding="async"
                style={`object-position:${chapter.cover.focalPosition ?? '50% 50%'}`}
              />
            </figure>
          ))}
        </div>

        <div class="pf-cinema__register" aria-hidden="true" data-cinema-register>
          <i></i><b></b><span class="label">01—04</span>
        </div>

        <nav class="pf-living-index" aria-label="Portfolio chapters" data-living-index>
          <p class="label"><span>Portfolio chapters</span><span>Four areas of practice</span></p>
          <ol>
            {chapters.map((chapter, index) => (
              <li>
                <a
                  class="pf-index-row"
                  href={`#journey-${chapter.id}`}
                  data-journey-nav={index}
                  data-chapter={chapter.id}
                  data-index-row
                  aria-current={chapter.id === 'womenswear' ? 'true' : undefined}
                >
                  <span class="pf-index-row__number label">{chapter.number}</span>
                  <strong class="pf-index-row__title display">{chapter.title}</strong>
                  <span class="pf-index-row__note">{chapterNotes[index]}</span>
                  <span class="pf-index-row__action label">{chapterActions[index]} <Arrow /></span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="pf-women-threshold" data-women-threshold aria-labelledby="womenswear-entry-title">
          <nav class="pf-women-threshold__index" aria-label="Portfolio chapter index">
            {chapters.map((chapter, index) => (
              <a
                href={`#journey-${chapter.id}`}
                data-journey-nav={index}
                aria-current={chapter.id === 'womenswear' ? 'page' : undefined}
              >
                <span>{chapter.number}</span>{chapter.title}
              </a>
            ))}
          </nav>
          <div class="pf-women-threshold__copy">
            <p class="label"><span>01</span> Womenswear</p>
            <h2 class="display" id="womenswear-entry-title">Designed<br />to move.</h2>
            <p>Silhouette and proportion guide every cut.</p>
            <a class="pf-women-threshold__action label" href="#journey-womenswear" data-journey-nav="0">
              Follow the journey <Arrow />
            </a>
          </div>
          <p class="pf-women-threshold__credit label">Chapter cover / visual direction asset</p>
        </div>

        <p class="pf-cinema__scroll label" data-cinema-scroll>
          <span>Scroll to open the practice</span><i aria-hidden="true"></i>
        </p>
      </div>
      <span class="pf-cinema__entry-anchor" id="womenswear-entry" aria-hidden="true"></span>
    </section>

    <section class="pf-journey" data-journey aria-label="Portfolio journey" data-active-chapter="womenswear">
      <div class="pf-journey__sticky">
        <nav class="pf-journey__index" aria-label="Portfolio journey chapters">
          <p class="label"><span>Portfolio journey</span><span data-journey-counter>01 / 04</span></p>
          <ol>
            {chapters.map((chapter, index) => (
              <li>
                <a
                  href={`#journey-${chapter.id}`}
                  data-journey-nav={index}
                  data-journey-index={chapter.id}
                  aria-current={index === 0 ? 'step' : undefined}
                >
                  <span>{chapter.number}</span><strong>{chapter.title}</strong>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div class="pf-journey__stage" data-journey-stage>
          {chapters.map((chapter, index) => (
            <article
              class={`pf-journey__scene pf-journey__scene--${chapter.id}`}
              data-journey-scene={chapter.id}
              data-scene-index={index}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <figure class="pf-journey__image" data-journey-image>
                <img
                  src={chapter.cover.image.src}
                  srcset={chapter.cover.image.srcset}
                  sizes="100vw"
                  width={chapter.cover.image.width}
                  height={chapter.cover.image.height}
                  alt=""
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  style={`object-position:${chapter.cover.focalPosition ?? '50% 50%'}`}
                />
              </figure>
              <div class="pf-journey__wash" aria-hidden="true"></div>
              <div class="pf-journey__copy">
                <p class="pf-journey__eyebrow label"><span>{chapter.number}</span>{journeyCopy[index].eyebrow}</p>
                <h2 class="display">{journeyCopy[index].title}</h2>
                <p>{journeyCopy[index].text}</p>
                <a class="pf-journey__action label" href={`#${chapter.id}`} data-nav>
                  {chapterActions[index]} <Arrow />
                </a>
              </div>
              <p class="pf-journey__chapter display" aria-hidden="true">{chapter.title}</p>
              <span class="pf-journey__register" aria-hidden="true"><i></i></span>
            </article>
          ))}

          <article class="pf-journey__scene pf-journey__scene--ending" data-journey-scene="ending" data-scene-index="4" aria-hidden="true">
            <div class="pf-journey__ending-copy">
              <p class="label">The work continues</p>
              <h2 class="display">Have something<br />in development?</h2>
              <a class="pf-journey__action label" href="/contact/">Discuss a product <Arrow /></a>
            </div>
            <p class="pf-journey__ending-note">Design intent, translated into a product that can be made.</p>
          </article>
        </div>
      </div>

      {chapters.map((chapter, index) => (
        <span
          class="pf-journey__anchor"
          id={`journey-${chapter.id}`}
          data-journey-anchor={index}
          style={`--anchor-step:${index}`}
          aria-hidden="true"
        ></span>
      ))}
      <span class="pf-journey__anchor pf-journey__anchor--ending" id="journey-ending" aria-hidden="true"></span>
    </section>

    <div class="pf-worlds" data-worlds>
      {garmentWorlds.map((world) => <GarmentWorld world={world} />)}
      <TechPackWorld packs={techPacks} />
      <SimulationWorld sessions={simulationSessions} />
    </div>
    <dialog class="pf-evidence-reader" data-evidence-reader aria-labelledby="pf-evidence-title">
      <div class="pf-evidence-reader__bar"><h2 id="pf-evidence-title" class="label"></h2><button type="button" data-evidence-close>Close <span aria-hidden="true">×</span></button></div>
      <div class="pf-evidence-reader__art" data-evidence-mount></div>
      <p class="label" data-evidence-caption></p>
    </dialog>

    {/* Progressive enhancement, made explicit. Every screen of every chapter
        is in the served HTML and readable without a script; this runs before
        first paint and collapses the category viewers so the enhanced page
        shows one screen at a time instead of all of them at once. */}
    <script is:inline>
      for (const el of document.currentScript.parentElement.querySelectorAll('[data-screen="category"]')) {
        el.hidden = true;
      }
    </script>
  </div>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const cinema = document.querySelector<HTMLElement>('[data-cinema]');

    if (cinema && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const media = cinema.querySelector<HTMLElement>('[data-cinema-media]')!;
      const index = cinema.querySelector<HTMLElement>('[data-living-index]')!;
      const rows = [...cinema.querySelectorAll<HTMLAnchorElement>('[data-index-row]')];
      const register = cinema.querySelector<HTMLElement>('[data-cinema-register]')!;
      const title = cinema.querySelector<HTMLElement>('[data-cinema-title]')!;
      const instinct = cinema.querySelector<HTMLElement>('[data-title-instinct]')!;
      const construction = cinema.querySelector<HTMLElement>('[data-title-construction]')!;
      const between = cinema.querySelector<HTMLElement>('[data-title-between]')!;
      const folio = cinema.querySelector<HTMLElement>('[data-cinema-folio]')!;
      const thesis = cinema.querySelector<HTMLElement>('[data-cinema-thesis]')!;
      const cue = cinema.querySelector<HTMLElement>('[data-cinema-scroll]')!;
      const threshold = cinema.querySelector<HTMLElement>('[data-women-threshold]')!;
      const isMobile = window.matchMedia('(max-width: 767px)').matches;

      const activateChapter = (id: string) => {
        cinema.dataset.activeChapter = id;
        const activeIndex = rows.findIndex((row) => row.dataset.chapter === id);
        cinema.style.setProperty('--register-y', `${18 + Math.max(0, activeIndex) * 22}%`);
        for (const row of rows) {
          if (row.dataset.chapter === id) row.setAttribute('aria-current', 'true');
          else row.removeAttribute('aria-current');
        }
      };

      for (const row of rows) {
        const activate = () => activateChapter(row.dataset.chapter ?? 'womenswear');
        row.addEventListener('pointerenter', activate);
        row.addEventListener('focus', activate);
        row.addEventListener('touchstart', activate, { passive: true });
      }

      cinema.querySelector<HTMLAnchorElement>('a[href="#womenswear-entry"]')?.addEventListener('click', (event) => {
        event.preventDefault();
        const destination = cinema.offsetTop + cinema.offsetHeight - window.innerHeight;
        window.scrollTo({ top: destination, behavior: 'smooth' });
      });

      const timeline = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          id: 'portfolio-cinematic-opening',
          trigger: cinema,
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.45,
          invalidateOnRefresh: true,
          onUpdate: ({ progress }) => {
            cinema.dataset.phase = progress > 0.72 ? 'womenswear' : progress > 0.3 ? 'index' : 'opening';
            if (progress > 0.72) activateChapter('womenswear');
          },
        },
      });

      timeline
        .to([cue, thesis], { autoAlpha: 0, y: -16, duration: 0.12 }, 0.02)
        .to(folio, { autoAlpha: 0.42, duration: 0.14 }, 0.04)
        .to(instinct, { xPercent: -10, yPercent: -88, scale: 0.5, autoAlpha: 0.08, duration: 0.3 }, 0.06)
        .to(construction, { xPercent: 8, yPercent: 86, scale: 0.5, autoAlpha: 0.06, duration: 0.3 }, 0.06)
        .to(between, { xPercent: -12, yPercent: -25, scale: 0.78, autoAlpha: 0.18, duration: 0.3 }, 0.06)
        .to(register, { autoAlpha: 1, duration: 0.1 }, 0.17);

      if (!isMobile) {
        timeline.to(media, {
          left: '50%', top: '13%', width: '46%', height: '73%', duration: 0.34,
        }, 0.07);
      } else {
        timeline.to(media, {
          left: '4.6%', top: '12.5%', width: '90.8%', height: '39%', duration: 0.34,
        }, 0.07);
      }

      timeline
        .to(title, { autoAlpha: 0, duration: 0.12 }, 0.25)
        .fromTo(index, { autoAlpha: 0, x: isMobile ? 0 : -22, y: isMobile ? 18 : 0 }, {
          autoAlpha: 1, x: 0, y: 0, duration: 0.2,
        }, 0.25)
        .to({}, { duration: 0.26 }, 0.45)
        .to(index, { autoAlpha: 0, x: isMobile ? 0 : -24, y: isMobile ? 18 : 0, duration: 0.16 }, 0.71)
        .to([register, folio], { autoAlpha: 0, duration: 0.13 }, 0.73)
        .to(media, { left: '0%', top: '0%', width: '100%', height: '100%', duration: 0.27 }, 0.72)
        .fromTo(threshold, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.19 }, 0.81);
    }
  </script>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const journey = document.querySelector<HTMLElement>('[data-journey]');

    if (journey) {
      const scenes = [...journey.querySelectorAll<HTMLElement>('[data-journey-scene]')];
      const indexLinks = [...journey.querySelectorAll<HTMLAnchorElement>('[data-journey-index]')];
      const counter = journey.querySelector<HTMLElement>('[data-journey-counter]');
      const reduceJourneyMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chapterIds = ['womenswear', 'menswear', 'tech-packs', '3d-simulation', 'ending'];
      const accents = ['#c83d46', '#3157c8', '#d48a2c', '#7668d8', '#11110f'];
      const foregrounds = ['#11110f', '#11110f', '#11110f', '#15171d', '#11110f'];
      const surfaces = ['#f3f0e9', '#f3f0e9', '#e7e2d9', '#d9dbe1', '#f3f0e9'];
      const mutedForegrounds = [
        'rgb(17 17 15 / 56%)',
        'rgb(17 17 15 / 56%)',
        'rgb(17 17 15 / 56%)',
        'rgb(21 23 29 / 58%)',
        'rgb(17 17 15 / 56%)',
      ];
      let activeScene = -1;

      const setActiveScene = (next: number) => {
        if (next === activeScene) return;
        activeScene = next;
        journey.dataset.activeChapter = chapterIds[next];
        journey.style.setProperty('--journey-accent', accents[next]);
        journey.style.setProperty('--journey-foreground', foregrounds[next]);
        journey.style.setProperty('--journey-surface', surfaces[next]);
        journey.style.setProperty('--journey-muted', mutedForegrounds[next]);
        scenes.forEach((scene, index) => scene.setAttribute(
          'aria-hidden',
          reduceJourneyMotion() || index === next ? 'false' : 'true',
        ));
        indexLinks.forEach((link, index) => {
          if (index === next) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
        if (counter) counter.textContent = next < 4 ? `0${next + 1} / 04` : 'Journey complete';
      };

      setActiveScene(0);

      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-journey-nav]')) {
        link.addEventListener('click', (event) => {
          const requested = Number(link.dataset.journeyNav ?? 0);
          if (!Number.isFinite(requested)) return;
          event.preventDefault();
          setActiveScene(requested);

          if (reduceJourneyMotion()) {
            scenes[requested]?.scrollIntoView({ behavior: 'auto', block: 'start' });
            return;
          }

          const travel = Math.max(0, journey.offsetHeight - window.innerHeight);
          const chapterProgress = requested === 0 ? 0.085 : requested / 4;
          const destination = journey.offsetTop + travel * chapterProgress;
          window.scrollTo({ top: destination, behavior: 'smooth' });
        });
      }

      if (reduceJourneyMotion()) {
        const reducedObserver = new IntersectionObserver((entries) => {
          const mostVisible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!mostVisible) return;
          setActiveScene(Number((mostVisible.target as HTMLElement).dataset.sceneIndex ?? 0));
        }, { threshold: [0.45, 0.65] });
        scenes.forEach((scene) => reducedObserver.observe(scene));
      } else {
        gsap.set(scenes, { autoAlpha: 0 });
        gsap.set(scenes[0], { autoAlpha: 1 });

        const sceneTimeline = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            id: 'portfolio-full-journey',
            trigger: journey,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.5,
            invalidateOnRefresh: true,
            onUpdate: ({ progress }) => setActiveScene(Math.min(4, Math.round(progress * 4))),
          },
        });

        const womenImage = scenes[0].querySelector<HTMLElement>('.pf-journey__image');
        const womenCopy = scenes[0].querySelector<HTMLElement>('.pf-journey__copy');
        const womenChapter = scenes[0].querySelector<HTMLElement>('.pf-journey__chapter');
        const journeyMobile = window.matchMedia('(max-width: 767px)').matches;

        if (womenImage) {
          sceneTimeline.fromTo(
            womenImage,
            { left: '0%', top: '0%', width: '100%', height: '100%', right: 'auto', bottom: 'auto' },
            journeyMobile
              ? { left: '1.1rem', top: '10rem', width: 'calc(100% - 2.2rem)', height: '42%', duration: 0.34 }
              : { left: '39%', top: '13%', width: '56.5%', height: '80%', duration: 0.34 },
            0,
          );
        }
        if (womenCopy) sceneTimeline.fromTo(womenCopy, { autoAlpha: 0, y: 18 }, { autoAlpha: 1, y: 0, duration: 0.24 }, 0.12);
        if (womenChapter) sceneTimeline.fromTo(womenChapter, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.22 }, 0.13);
        const entries = [
          { clipPath: 'inset(0 0 0 44%)', xPercent: 5, scale: 1 },
          { clipPath: 'inset(7% 5% 7% 36%)', yPercent: 4, rotation: 0.7, scale: 1 },
          { clipPath: 'inset(0 0 0 28%)', xPercent: 4, scale: 1.055 },
          { clipPath: 'inset(0 0 8% 0)', yPercent: 5, scale: 1 },
        ];
        const exits = [
          { xPercent: -6, scale: 1.035 },
          { xPercent: -3, scale: 0.985 },
          { yPercent: -3, rotation: -0.5, scale: 0.98 },
          { scale: 0.96 },
        ];

        for (let index = 1; index < scenes.length; index += 1) {
          const at = index - 0.58;
          const outgoingCopy = scenes[index - 1].querySelector<HTMLElement>('.pf-journey__copy,.pf-journey__ending-copy');
          const incomingCopy = scenes[index].querySelector<HTMLElement>('.pf-journey__copy,.pf-journey__ending-copy');
          sceneTimeline
            .to(scenes[index - 1], { autoAlpha: 0, duration: 0.58, ...exits[index - 1] }, at)
            .fromTo(
              scenes[index],
              { autoAlpha: 0, ...entries[index - 1] },
              { autoAlpha: 1, clipPath: 'inset(0% 0% 0% 0%)', xPercent: 0, yPercent: 0, rotation: 0, scale: 1, duration: 0.62 },
              at,
            );

          if (outgoingCopy) sceneTimeline.to(outgoingCopy, { autoAlpha: 0, y: -12, duration: 0.2 }, at);
          if (incomingCopy) {
            sceneTimeline.fromTo(
              incomingCopy,
              { autoAlpha: 0, y: 18 },
              { autoAlpha: 1, y: 0, duration: 0.3 },
              at + 0.25,
            );
          }

          const image = scenes[index].querySelector<HTMLImageElement>('.pf-journey__image img');
          if (image) {
            sceneTimeline.fromTo(image, { scale: 1.035 }, { scale: 1, duration: 0.8 }, at);
          }
        }

        sceneTimeline.to({}, { duration: 0.42 });
      }
    }
  </script>

  <script>
    /* --------------------------------------------------------------------
       Portfolio V8 runtime.

       The navigation is three levels deep and the URL carries all of it:

         #                      the portfolio index
         #womenswear            that chapter's CATEGORY INDEX
         #womenswear/evening    one category's garment viewer

       Everything else — the deck, the documents, the video slots — is driven
       from that one piece of state, so Back always steps back exactly one
       level and a reload lands where the visitor was.
       -------------------------------------------------------------------- */
      const root = document.querySelector<HTMLElement>('[data-pf-root]');
    if (root) {
      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const chapterLinks = [...root.querySelectorAll<HTMLElement>('[data-chapter]')];

      /* ---- 1. chapters and screens ------------------------------------ */
      const worlds = new Map<string, HTMLElement>(
        [...root.querySelectorAll<HTMLElement>('[data-world]')].map((el) => [el.dataset.world!, el]),
      );
      const FOCUSABLE = 'a[href],button:not([disabled]),input,select,textarea,[tabindex]:not([tabindex="-1"])';
      let openWorld: HTMLElement | null = null;
      let restoreFocusTo: HTMLElement | null = null;
      const evidenceReader = root.querySelector<HTMLDialogElement>('[data-evidence-reader]')!;
      let evidenceOpener: HTMLElement | null = null;
      const closeEvidence = () => {
        evidenceReader.close();
        evidenceReader.querySelector('[data-evidence-mount]')?.replaceChildren();
        evidenceOpener?.focus({ preventScroll: true });
      };
      evidenceReader.querySelector('[data-evidence-close]')?.addEventListener('click', closeEvidence);
      evidenceReader.addEventListener('cancel', (event) => { event.preventDefault(); closeEvidence(); });
      for (const opener of root.querySelectorAll<HTMLElement>('[data-evidence-open]')) {
        opener.addEventListener('click', () => {
          evidenceOpener = opener;
          evidenceReader.querySelector('#pf-evidence-title')!.textContent = opener.dataset.evidenceTitle ?? '';
          const art = opener.querySelector('img,.pf-plate__blank')!;
          evidenceReader.querySelector('[data-evidence-mount]')!.replaceChildren(art.cloneNode(true));
          evidenceReader.querySelector('[data-evidence-caption]')!.textContent =
            opener.hasAttribute('data-evidence-demo') ? 'Demo plate / No project evidence supplied' : 'Development evidence / Full image';
          evidenceReader.showModal();
        });
      }

      const setInert = (on: boolean) => {
        for (const el of [document.querySelector('.site-header'), document.querySelector('.site-footer')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
        for (const el of [root.querySelector('.pf-covers'), root.querySelector('.pf-intro')]) {
          if (el) (el as HTMLElement).toggleAttribute('inert', on);
        }
      };

      /* Which screen of a chapter is showing. `null` is the chapter's own
         index; a category id is that category's viewer. */
      const showScreen = (world: HTMLElement, category: string | null) => {
        const screens = [...world.querySelectorAll<HTMLElement>('[data-screen]')];
        if (screens.length === 0) return;
        let shown: HTMLElement | null = null;
        for (const screen of screens) {
          const match = screen.dataset.screen === 'index'
            ? category === null
            : screen.dataset.category === category;
          screen.hidden = !match;
          if (match) shown = screen;
        }
        /* An unknown category falls back to the index rather than leaving the
           chapter blank. */
        if (!shown) {
          for (const screen of screens) screen.hidden = screen.dataset.screen !== 'index';
        }
        world.scrollTop = 0;
      };

      const closeWorld = () => {
        if (!openWorld) return;
        openWorld.removeAttribute('data-open');
        openWorld = null;
        document.body.classList.remove('no-scroll');
        setInert(false);
        const target = restoreFocusTo;
        restoreFocusTo = null;
        /* Focus has to land after the layer is gone, or the browser scrolls
           the still-fixed panel instead of the page. */
        if (target && document.contains(target)) target.focus({ preventScroll: true });
      };

      const openWorldById = (id: string, category: string | null) => {
        const next = worlds.get(id);
        if (!next) { closeWorld(); return; }
        const already = openWorld === next;
        if (!already) {
          if (openWorld) openWorld.removeAttribute('data-open');
          if (!restoreFocusTo) {
            const active = document.activeElement as HTMLElement | null;
            restoreFocusTo = active && root.contains(active) && active.matches('a[data-nav],[data-chapter]')
              ? active
              : chapterLinks.find((link) => link.dataset.chapter === id) ?? active;
          }
          openWorld = next;
          next.setAttribute('data-open', '');
          document.body.classList.add('no-scroll');
        }
        showScreen(next, category);
        if (!already && !reduced()) {
          const entrance = next.querySelector<HTMLElement>('.pf-head');
          entrance?.animate([
            { clipPath: 'inset(0 0 100% 0)', transform: 'translateY(18px)' },
            { clipPath: 'inset(0 0 0% 0)', transform: 'translateY(0)' },
          ], { duration: 450, easing: 'cubic-bezier(.2,.7,.2,1)' });
        }
        /* Order matters twice over here.
           focus() is a no-op on a visibility:hidden element and data-open has
           not been through style recalc yet, so force that first. And the
           focus has to move BEFORE the index is marked inert: the cover the
           visitor just activated lives inside it, and the blur the UA performs
           when a focused element's container becomes inert lands after a focus
           call made on the same tick. */
        void next.offsetHeight;
        const first = next.querySelector<HTMLElement>(FOCUSABLE);
        (first ?? next).focus({ preventScroll: true });
        if (!already) setInert(true);
        layoutAll();
      };

      const parseHash = () => {
        const raw = window.location.hash.replace('#', '');
        if (!raw) return { world: null as string | null, category: null as string | null };
        const [world, category] = raw.split('/');
        return { world, category: category ?? null };
      };

      const syncFromHash = () => {
        if (evidenceReader.open) closeEvidence();
        if (openWorld?.querySelector('[data-reader][open]')) closeReader(openWorld);
        const { world, category } = parseHash();
        if (world && worlds.has(world)) openWorldById(world, category);
        else closeWorld();
      };

      const go = (hash: string) => {
        if (window.location.hash !== hash) window.history.pushState({}, '', hash || window.location.pathname);
        syncFromHash();
      };

      /* The covers and the category links are real anchors so every level is
         reachable with the script gone. With the script running we take the
         click over: letting the browser perform the fragment navigation meant
         it also ran its own focus handling afterwards, which threw away the
         focus we had just moved into the layer. */
      for (const link of root.querySelectorAll<HTMLAnchorElement>('a[data-nav]')) {
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
          const hash = link.getAttribute('href') ?? '';
          if (!hash.startsWith('#')) return;
          event.preventDefault();
          go(hash === '#portfolio-index' ? '' : hash);
        });
      }

      window.addEventListener('popstate', syncFromHash);
      window.addEventListener('hashchange', syncFromHash);

      /* Escape steps back one level, the same as the on-screen control. */
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !openWorld) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        if (evidenceReader.open) { closeEvidence(); return; }
        const reader = openWorld.querySelector<HTMLElement>('[data-reader]:not([hidden])');
        if (reader) { event.preventDefault(); closeReader(openWorld); return; }
        event.preventDefault();
        /* One level up, computed from the URL rather than replayed from the
           history stack: every level is a pushState entry, so `back()` would
           have walked FORWARD again whenever the visitor had already stepped
           up once with the on-screen control. */
        const { world, category } = parseHash();
        go(category ? `#${world}` : '');
      }, true);

      /* Focus trap. Only ever active while a layer is open. */
      document.addEventListener('keydown', (event) => {
        if (evidenceReader.open || openWorld?.querySelector('[data-reader][open]')) return;
        if (event.key !== 'Tab' || !openWorld) return;
        const items = [...openWorld.querySelectorAll<HTMLElement>(FOCUSABLE)]
          .filter((el) => el.offsetParent !== null || el === document.activeElement);
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        else if (!openWorld.contains(document.activeElement)) { event.preventDefault(); first.focus(); }
      });

      /* ---- 2. the garment deck ----------------------------------------- */
      /* HOW MANY, AND HOW MUCH SMALLER.
         The depth has to be obvious at a glance, which means the steps are
         large: each garment behind the active one is about a fifth smaller
         again. Five cards at that rhythm would put the furthest one at 42% of
         the leader — roughly 145px of a full-length model at 1440, too small
         to judge a garment by — so the desktop deck carries FOUR. Four
         readable garments with real distance between them beat five cramped
         ones, and the composition is what is being designed here. */
      const geometry = () => {
        const w = window.innerWidth;
        if (w >= 1024) return { visible: 4, scales: [0.52, 0.66, 0.82, 1] };
        return { visible: 3, scales: [0.55, 0.75, 1] };
      };

      /* 3:4. Measured from the renditions: 39 of 49 are exactly 0.749, and the
         rest letterbox into this canvas rather than being cropped. */
      const CANVAS = 0.75;

      interface Queue {
        panel: HTMLElement;
        stage: HTMLElement;
        stack: HTMLElement;
        slots: HTMLElement[];
        fronts: number[];
        counter: HTMLElement | null;
        prev: HTMLElement | null;
        next: HTMLElement | null;
        index: number;
        drag: number;
        width: number;
        motion: Animation[];
        revision: number;
      }

      const queues: Queue[] = [...root.querySelectorAll<HTMLElement>('.pf-panel')].map((panel) => ({
        panel,
        stage: panel.querySelector<HTMLElement>('[data-stage]')!,
        stack: panel.querySelector<HTMLElement>('[data-stack]')!,
        slots: [...panel.querySelectorAll<HTMLElement>('.pf-slot')],
        /* How much of each image, from its left edge, must stay uncovered for
           the front view to read completely. Measured per image; see FRONT in
           the data module. */
        fronts: [...panel.querySelectorAll<HTMLElement>('.pf-slot')]
          .map((slot) => Number(slot.dataset.front) || 0.55),
        counter: panel.querySelector<HTMLElement>('[data-counter-current]'),
        prev: panel.querySelector<HTMLElement>('[data-step="-1"]'),
        next: panel.querySelector<HTMLElement>('[data-step="1"]'),
        index: 0,
        drag: 0,
        width: 0,
        motion: [],
        revision: 0,
      }));

      const layout = (queue: Queue) => {
        const { visible, scales } = geometry();
        const stageWidth = queue.stage.clientWidth;
        if (stageWidth === 0) return;

        const nominal = Math.min(visible, queue.slots.length);
        const scale = scales.slice(-nominal);

        /* THE DECK.
           Visual order runs left to right: the furthest garment on the left,
           the active one flush against the right end. Each card is overlapped
           on its RIGHT by the card in front of it, and the amount left showing
           is that image's own measured front fraction — so what stays visible
           is a complete front view, never half a model. The active card has
           nothing in front of it, so it shows the whole photograph.

           The leading card's width is solved from the WORST CASE arrangement
           of front fractions in this category rather than from the current
           window, so the active garment does not resize every time you step. */
        const widest = [...queue.fronts].sort((a, b) => b - a);
        let span = 1;
        for (let k = 0; k < nominal - 1; k += 1) span += scale[k] * (widest[k] ?? 0.6);
        const width0 = stageWidth / span;
        const height0 = width0 / CANVAS;
        queue.width = width0;
        queue.stage.style.setProperty('--stage-h', `${Math.round(height0)}px`);

        /* Position k holds the image (index + nominal - 1 - k), so the active
           one lands at the right-hand end. Near the end of a category the
           left-hand positions simply have no image to hold. */
        const placed: Array<{ slot: HTMLElement; k: number; w: number; h: number; x: number }> = [];
        let x = 0;
        for (let k = 0; k < nominal; k += 1) {
          const itemIndex = (queue.index + (nominal - 1 - k)) % queue.slots.length;
          const slot = queue.slots[itemIndex];
          const s = scale[k];
          const w = width0 * s;
          const h = height0 * s;
          placed.push({ slot, k, w, h, x });
          const leading = k === nominal - 1;
          x += leading ? w : w * (queue.fronts[itemIndex] ?? 0.6);
        }

        const used = placed.length ? placed[placed.length - 1].x + placed[placed.length - 1].w : 0;
        const offset = Math.max(0, (stageWidth - used) / 2);

        const shown = new Set(placed.map((item) => item.slot));
        for (const slot of queue.slots) if (!shown.has(slot)) slot.hidden = true;

        for (const item of placed) {
          item.slot.hidden = false;
          item.slot.style.setProperty('--x', `${Math.round(offset + item.x)}px`);
          item.slot.style.setProperty('--w', `${Math.round(item.w)}px`);
          item.slot.style.setProperty('--h', `${Math.round(item.h)}px`);
          /* One shared floor. Every garment stands on the same baseline, so
             the smaller ones read as the same presentation further away rather
             than as differently sized photographs. */
          item.slot.style.zIndex = String(10 + item.k);
          const depth = nominal - 1 - item.k;
          /* The floor plane: each step back stands a little higher, scaled to
             the leading card so the rise is proportional at every width. */
          item.slot.style.setProperty('--lift', `${Math.round(depth * width0 * 0.035)}px`);
          item.slot.dataset.depth = String(depth);
        }
      };

      const layoutAll = () => {
        for (const queue of queues) {
          if (queue.panel.hidden) continue;
          if (queue.panel.closest('[data-screen]')?.hidden) continue;
          layout(queue);
        }
      };

      const render = (queue: Queue) => {
        queue.slots.forEach((slot, i) => slot.toggleAttribute('data-active', i === queue.index));
        if (queue.counter) {
          const noun = queue.counter.dataset.noun ?? 'Project';
          queue.counter.textContent = `${noun} ${String(queue.index + 1).padStart(2, '0')}`;
        }
        if (queue.prev) (queue.prev as HTMLButtonElement).disabled = queue.slots.length < 2;
        if (queue.next) (queue.next as HTMLButtonElement).disabled = queue.slots.length < 2;
        layout(queue);
      };

      interface WheelMotion {
        from: number; to: number; direction: number; progress: number;
        animations: Animation[]; ghosts: HTMLElement[]; raf: number;
      }
      const wheels = new Map<Queue, WheelMotion>();
      const finishWheel = (queue: Queue, commit: boolean) => {
        const wheel = wheels.get(queue);
        if (!wheel) return;
        cancelAnimationFrame(wheel.raf);
        queue.index = commit ? wheel.to : wheel.from;
        wheel.animations.forEach((a) => a.cancel());
        wheel.ghosts.forEach((g) => g.remove());
        wheels.delete(queue);
        render(queue);
      };
      const seekWheel = (wheel: WheelMotion, progress: number) => {
        wheel.progress = progress;
        wheel.animations.forEach((a) => { a.currentTime = progress * 1000; });
      };
      const prepareWheel = (queue: Queue, next: number) => {
        finishWheel(queue, true);
        const from = queue.index;
        const to = ((next % queue.slots.length) + queue.slots.length) % queue.slots.length;
        if (to === from) return null;
        const direction = next > from ? 1 : -1;
        const before = new Map(queue.slots.filter((s) => !s.hidden).map((slot) => [slot, {
          rect: slot.getBoundingClientRect(), depth: Number(slot.dataset.depth),
        }]));
        queue.index = to;
        layout(queue);
        queue.index = from;
        const stage = queue.stage.getBoundingClientRect();
        const farDepth = Math.min(geometry().visible, queue.slots.length) - 1;
        const wheel: WheelMotion = { from, to, direction, progress: 0, animations: [], ghosts: [], raf: 0 };
        const animate = (element: HTMLElement, start: string, end: string) => {
          const a = element.animate([{ transform: start }, { transform: end }], { duration: 1000, fill: 'both', easing: 'linear' });
          a.pause(); a.currentTime = 0; wheel.animations.push(a);
        };
        for (const slot of queue.slots) {
          const previous = before.get(slot);
          const leaving = slot.hidden;
          if (leaving && !previous) continue;
          slot.hidden = false;
          const after = slot.getBoundingClientRect();
          const at = (x: number, y: number, sx = 1, sy = sx) => `translate(${x}px,${y}px) scale(${sx},${sy})`;
          const entry = at(direction > 0 ? stage.left - after.right - 2 : stage.right - after.left + 2, 0, 1);
          const exit = at(direction > 0 ? stage.right - after.left + 2 : stage.left - after.right - 2, 0, 1);
          const start = previous ? at(previous.rect.left - after.left, previous.rect.top - after.top,
            previous.rect.width / after.width, previous.rect.height / after.height) : entry;
          const recycled = previous && !leaving && (direction > 0
            ? previous.depth === 0 && Number(slot.dataset.depth) === farDepth
            : previous.depth === farDepth && Number(slot.dataset.depth) === 0);
          if (recycled) {
            // Two edge instances of the same circular item; neither teleports through the visible field.
            const ghost = slot.cloneNode(true) as HTMLElement;
            ghost.removeAttribute('data-slot'); ghost.removeAttribute('data-active');
            ghost.setAttribute('data-wheel-ghost', ''); ghost.setAttribute('aria-hidden', 'true');
            ghost.style.zIndex = direction > 0 ? '30' : '1';
            queue.stack.append(ghost); wheel.ghosts.push(ghost);
            animate(ghost, start, exit);
            animate(slot, entry, 'none');
          } else animate(slot, start, leaving ? exit : 'none');
        }
        wheels.set(queue, wheel);
        return wheel;
      };
      const settleWheel = (queue: Queue, commit: boolean) => {
        const wheel = wheels.get(queue);
        if (!wheel) return;
        cancelAnimationFrame(wheel.raf);
        if (reduced()) { finishWheel(queue, commit); return; }
        const start = wheel.progress;
        const target = commit ? 1 : 0;
        const duration = Math.max(150, 600 * Math.abs(target - start));
        const began = performance.now();
        const tick = (now: number) => {
          const t = Math.min(1, (now - began) / duration);
          seekWheel(wheel, start + (target - start) * (1 - Math.pow(1 - t, 3)));
          if (t < 1) wheel.raf = requestAnimationFrame(tick);
          else finishWheel(queue, commit);
        };
        wheel.raf = requestAnimationFrame(tick);
      };
      const goTo = (queue: Queue, next: number) => {
        finishWheel(queue, true);
        if (!prepareWheel(queue, next)) return;
        const wheel = wheels.get(queue)!;
        queue.index = wheel.to;
        if (queue.counter) queue.counter.textContent = `${queue.counter.dataset.noun ?? 'Project'} ${String(queue.index + 1).padStart(2, '0')}`;
        settleWheel(queue, true);
      };
      for (const queue of queues) {
        if (!queue.slots.length) continue;
        queue.prev?.addEventListener('click', () => goTo(queue, queue.index - 1));
        queue.next?.addEventListener('click', () => goTo(queue, queue.index + 1));
        queue.stage.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(queue, queue.index + 1); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(queue, queue.index - 1); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(queue, 0); }
          else if (event.key === 'End') { event.preventDefault(); goTo(queue, queue.slots.length - 1); }
        });
        let dragging = false, startX = 0, pointerId = -1;
        queue.stage.addEventListener('pointerdown', (event) => {
          if (event.button !== 0 || queue.slots.length < 2) return;
          if ((event.target as HTMLElement).closest('button,a')) return;
          finishWheel(queue, true);
          dragging = true; startX = event.clientX; pointerId = event.pointerId; queue.drag = 0;
          queue.stage.setPointerCapture(pointerId);
        });
        queue.stage.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          queue.drag = event.clientX - startX;
          if (Math.abs(queue.drag) < 2) return;
          const direction = Math.sign(queue.drag);
          let wheel = wheels.get(queue);
          if (wheel && wheel.direction !== direction) { finishWheel(queue, false); wheel = undefined; }
          wheel ??= prepareWheel(queue, queue.index + direction) ?? undefined;
          if (wheel) seekWheel(wheel, Math.min(.98, Math.abs(queue.drag) / Math.max(150, queue.width * .65)));
        });
        queue.stage.addEventListener('pointerup', (event) => {
          if (!dragging || event.pointerId !== pointerId) return;
          dragging = false;
          try { queue.stage.releasePointerCapture(pointerId); } catch {}
          const commit = Math.abs(queue.drag) >= Math.max(44, queue.width * .18);
          queue.drag = 0;
          settleWheel(queue, commit);
        });
        queue.stage.addEventListener('pointercancel', () => { dragging = false; queue.drag = 0; settleWheel(queue, false); });
        render(queue);
      }

      /* ---- 3. the PDF reader ------------------------------------------- */
      /* Not one byte of any document is fetched with the page. The <iframe> is
         created by the click that asks for it and destroyed when the reader
         closes, so five demo packs cost nothing until one is opened. */
      const closeReader = (world: HTMLElement) => {
        const reader = world.querySelector<HTMLDialogElement>('[data-reader]');
        if (!reader || reader.hidden) return;
        reader.querySelector<HTMLElement>('[data-reader-mount]')?.replaceChildren();
        reader.close();
        reader.hidden = true;
        world.classList.remove('pf-world--reading');
        const back = reader.dataset.openerId
          ? world.querySelector<HTMLElement>(`#${reader.dataset.openerId}`)
          : null;
        back?.focus({ preventScroll: true });
        const savedScroll = Number(reader.dataset.scrollTop ?? 0);
        world.scrollTop = savedScroll;
        /* Chromium restores a modal dialog's scroll target after close() on
           its next rendering step. Reapply the chapter position afterwards,
           so closing never nudges the dossier list. */
        requestAnimationFrame(() => {
          world.scrollTop = savedScroll;
          requestAnimationFrame(() => { world.scrollTop = savedScroll; });
        });
        window.setTimeout(() => { world.scrollTop = savedScroll; }, 80);
      };

      for (const world of worlds.values()) {
        const reader = world.querySelector<HTMLDialogElement>('[data-reader]');
        if (!reader) continue;
        const mount = reader.querySelector<HTMLElement>('[data-reader-mount]')!;
        const title = reader.querySelector<HTMLElement>('[data-reader-title]');

        for (const opener of world.querySelectorAll<HTMLElement>('[data-open-pdf]')) {
          /* Pointer activation focuses the document before `click`, and that
             focus may scroll a long folio row into a different alignment.
             Capture the origin before focus so Close returns to the exact
             reading position the visitor selected from. */
          opener.addEventListener('pointerdown', () => {
            reader.dataset.scrollTop = String(world.scrollTop);
          });
          opener.addEventListener('click', (event) => {
            const href = opener.getAttribute('href');
            if (!href) return;
            if ((event as MouseEvent).metaKey || (event as MouseEvent).ctrlKey) return;
            /* Inline PDF viewing is unreliable on phones — iOS renders one
               page and will not scroll it — so below this width the anchor is
               left alone and the document opens in its own tab. */
            event.preventDefault();
            if ((event as MouseEvent).detail === 0 || !reader.dataset.scrollTop) {
              reader.dataset.scrollTop = String(world.scrollTop);
            }
            /* <object> rather than <iframe>: when a browser has no PDF
               viewer the object's own fallback content renders in its place,
               so the visitor gets a working link instead of a blank panel. */
            const frame = document.createElement('object');
            frame.data = href;
            frame.type = 'application/pdf';
            frame.setAttribute('aria-label', opener.dataset.docTitle ?? 'Technical pack');
            const fallback = document.createElement('p');
            fallback.className = 'pf-reader__fallback';
            const link = document.createElement('a');
            link.href = href;
            link.target = '_blank';
            link.rel = 'noopener';
            link.textContent = 'Open this document in a new tab';
            fallback.append('This browser cannot display a PDF inline. ', link);
            const preview = opener.querySelector('img');
            if (preview) fallback.prepend(preview.cloneNode(true));
            frame.append(fallback);
            mount.replaceChildren(frame);
            if (window.matchMedia('(max-width: 899px)').matches) {
              const mobile = document.createElement('div');
              mobile.className = 'pf-reader-mobile';
              const cover = opener.querySelector('img');
              if (cover) mobile.append(cover.cloneNode(true));
              const description = document.createElement('p');
              description.textContent = 'Document preview. Open the PDF in your device reader for all pages.';
              const mobileLink = link.cloneNode(true);
              mobile.append(description, mobileLink);
              mount.replaceChildren(mobile);
            }
            if (title) title.textContent = opener.dataset.docTitle ?? '';
            const tab = reader.querySelector<HTMLAnchorElement>('[data-reader-tab]');
            if (tab) tab.href = href;
            reader.dataset.openerId = opener.id;
            reader.hidden = false;
            reader.showModal();
            reader.querySelector<HTMLElement>('[data-reader-close]')?.focus({ preventScroll: true });
            world.classList.add('pf-world--reading');
          });
        }

        reader.querySelector<HTMLElement>('[data-reader-close]')
          ?.addEventListener('click', () => closeReader(world));
        reader.addEventListener('cancel', (event) => { event.preventDefault(); closeReader(world); });
      }

      /* ---- 4. video slots: no player before a click --------------------- */
      for (const world of worlds.values()) {
        for (const item of world.querySelectorAll<HTMLElement>('[data-video]')) {
          const play = item.querySelector<HTMLElement>('[data-play]');
          const mount = item.querySelector<HTMLElement>('[data-player]');
          const youtubeId = item.dataset.youtube;
          if (!play || !mount || !youtubeId) continue;
          play.addEventListener('click', () => {
            /* Created here and nowhere else. Before this click no request has
               been made to any Google domain. nocookie is the privacy-enhanced
               host; autoplay applies to the click that just happened, not to
               page load. */
            const frame = document.createElement('iframe');
            frame.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1`;
            frame.title = item.querySelector('h3')?.textContent ?? 'Simulation video';
            frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('loading', 'lazy');
            mount.replaceChildren(frame);
            mount.hidden = false;
            item.setAttribute('data-playing', '');
            play.hidden = true;
          });
        }
      }

      /* ---- relayout ---------------------------------------------------- */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutAll, 120);
      });
      window.addEventListener('orientationchange', () => window.setTimeout(layoutAll, 200));
      /* Late webfonts and image decode both change the stage box. */
      window.addEventListener('load', layoutAll);

      layoutAll();
      syncFromHash();

      /* Debug surface for the smoke tests. */
      (window as unknown as Record<string, unknown>).__portfolioRunway = {
        getState() {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live.find((q) => q.panel.closest('[data-world]')?.hasAttribute('data-open'))
            ?? live[0] ?? queues[0];
          const { visible } = geometry();
          return {
            activeIndex: queue.index,
            position: queue.index,
            count: queue.slots.length,
            visibleTarget: visible,
            visibleNow: queue.slots.filter((slot) => !slot.hidden).length,
            /* The active card leads the deck: it is the right-most and the
               top-most, and nothing covers it. */
            activeIsLeading: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden);
              if (shown.length === 0) return false;
              const active = queue.slots[queue.index];
              const right = shown.reduce((a, b) => (b.getBoundingClientRect().right > a.getBoundingClientRect().right ? b : a));
              const top = shown.reduce((a, b) => (Number(b.style.zIndex) > Number(a.style.zIndex) ? b : a));
              return right === active && top === active;
            })(),
            overlaps: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden)
                .map((slot) => slot.getBoundingClientRect())
                .sort((a, b) => a.left - b.left);
              let n = 0;
              for (let i = 0; i < shown.length - 1; i += 1) if (shown[i + 1].left < shown[i].right - 1) n += 1;
              return n;
            })(),
            openWorld: openWorld?.dataset.world ?? null,
            screen: openWorld?.querySelector<HTMLElement>('[data-screen]:not([hidden])')?.dataset.screen ?? null,
            reducedMotion: reduced(),
          };
        },
        goTo(i: number) {
          const live = queues.filter((q) => !q.panel.hidden && !q.panel.closest('[data-screen]')?.hidden);
          const queue = live[0] ?? queues[0];
          goTo(queue, i);
          return queue.index;
        },
      };
    }
  </script>

  <style is:global>
    /* ======================================================================
       PORTFOLIO V8
