    .pf-cover__go .arrow { width: 1em; height: 1em; }
    .pf-cover:hover .pf-cover__go { gap: .95rem; }

    /* ---------- 01 WOMENSWEAR: one garment, standing in the studio ------- */
    .pf-cover[data-chapter='womenswear'] { grid-template-columns: minmax(0, 42%) minmax(0, 1fr); }
    .pf-cover[data-chapter='womenswear'] .pf-cover__type { grid-column: 1; grid-row: 1; }
    .pf-cover[data-chapter='womenswear'] .pf-cover__art {
      grid-column: 2;
      grid-row: 1;
      background: var(--pf-stage);
    }
    /* No frame, no shadow, no card. The garment stands on the ground, exactly
       as it does inside the chapter. */
    .pf-cover__garment {
      position: absolute;
      inset: clamp(1.25rem, 2.6vw, 2.5rem) clamp(1.25rem, 2.6vw, 2.5rem) 0;
      width: calc(100% - 2 * clamp(1.25rem, 2.6vw, 2.5rem));
      height: calc(100% - clamp(1.25rem, 2.6vw, 2.5rem));
      object-fit: contain;
      object-position: bottom center;
    }

    /* ---------- 02 MENSWEAR: typographic, because there is no photograph -- */
    .pf-cover[data-chapter='menswear'] { grid-template-columns: minmax(0, 40%) minmax(0, 1fr); }
    .pf-cover[data-chapter='menswear'] .pf-cover__type { grid-column: 1; grid-row: 1; }
    .pf-cover[data-chapter='menswear'] .pf-cover__art {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      padding-right: var(--gutter);
    }
    .pf-covertype { display: flex; flex-direction: column; }
    .pf-covertype__row {
      display: flex;
      align-items: baseline;
      gap: clamp(.9rem, 2vw, 1.75rem);
      padding: clamp(.85rem, 1.7vw, 1.45rem) 0;
      border-bottom: 1px solid var(--line);
    }
    .pf-covertype__row:first-child { border-top: 1px solid var(--line-strong); }
    .pf-covertype__row i {
      flex: none;
      width: 2rem;
      color: var(--muted);
      font-family: var(--mono);
      font-size: .68rem;
      font-style: normal;
      letter-spacing: .16em;
    }
    .pf-covertype__row b {
      color: var(--ink-soft);
      font-family: var(--display);
      font-weight: 500;
      font-size: clamp(1.1rem, 2.4vw, 2.1rem);
      line-height: 1.1;
      letter-spacing: -.03em;
    }

    /* ---------- 03 TECH PACKS: a physical folio on the table ------------- */
    .pf-cover[data-chapter='tech-packs'] { grid-template-columns: minmax(0, 1fr) minmax(0, 40%); }
    .pf-cover[data-chapter='tech-packs'] .pf-cover__art {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(2rem, 4vw, 3.5rem) var(--gutter);
    }
    .pf-cover[data-chapter='tech-packs'] .pf-cover__type { grid-column: 2; grid-row: 1; }

    /* Thickness from stacked page edges and a bound spine. Hairlines and
       offsets only — no gloss, no page curl, no blur. */
    .pf-foliomark {
      position: relative;
      display: block;
      width: min(100%, 36rem);
      aspect-ratio: 297 / 210;
    }
    .pf-foliomark__leaf,
    .pf-foliomark__cover {
      position: absolute;
      inset: 0;
      display: block;
      border: 1px solid var(--line);
      background: var(--pf-paper);
