      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }
    .pf-world__back {
      display: inline-flex;
      align-items: center;
      gap: .55rem;
      color: inherit;
      font-family: var(--mono);
      font-size: .7rem;
      letter-spacing: .16em;
      text-transform: uppercase;
      text-decoration: none;
    }
    .pf-world__back .arrow { width: 1.1em; height: 1.1em; }
    .pf-world__back:hover { color: var(--signal); }
    .pf-world__tag { color: var(--muted); margin: 0; }
    .pf-world__tag b { color: var(--ink); font-weight: 500; }

    .pf-world__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      gap: clamp(1.25rem, 3vw, 3rem);
      align-items: end;
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1.25rem, 2.4vw, 2.1rem) var(--gutter) clamp(1rem, 1.6vw, 1.4rem);
    }
    .pf-world__head h2 { margin: 0; font-size: clamp(1.9rem, 3.6vw, 3.1rem); line-height: .95; letter-spacing: -.035em; }
    .pf-world__descriptor { max-width: 34rem; margin: .6rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.55; }

    /* Provenance, not a warning. No orange field, no box, no exclamation —
       a label and the fact, in the margin position a credit line occupies. */
    .pf-prov { padding-left: 1rem; border-left: 1px solid var(--line-strong); }
    .pf-prov__label { margin: 0; color: var(--signal); }
    .pf-prov__text { margin: .4rem 0 0; color: var(--muted); font-size: .88rem; line-height: 1.5; }

    /* ======================================================================
       THE SUBCHAPTER INDEX

       Five numbered editorial bands, the first thing inside a garment chapter.
       Not tabs, not pills, not a one-line menu. The selected band takes the
       studio ground and shows one restrained preview of what is inside it;
       hovering another band previews that one the same way. The preview strip
       is a reserved track, so revealing it never moves the type.
       ====================================================================== */
    .pf-index { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .pf-index__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }

    .pf-band {
      position: relative;
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr) 3rem clamp(5rem, 10vw, 8.5rem);
      align-items: baseline;
      gap: .3rem clamp(.75rem, 1.5vw, 1.25rem);
      width: 100%;
      padding: clamp(1rem, 1.8vw, 1.6rem) 0 clamp(1rem, 1.8vw, 1.6rem) 1.25rem;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: none;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      text-align: left;
      overflow: hidden;
      transition: background-color .45s var(--ease), color .35s var(--ease);
    }
    .pf-band:hover,
    .pf-band[aria-pressed='true'] { background: var(--pf-stage); color: var(--ink); }
    .pf-band:focus-visible { outline: 2px solid var(--signal); outline-offset: -3px; }

    /* The one signal in the index. A square at the head of the selected band,
       never a rule beneath the words. */
    .pf-band__mark {
      position: absolute;
      left: 0;
      top: 50%;
      width: .38rem;
      height: .38rem;
      margin-top: -.19rem;
      background: var(--signal);
      opacity: 0;
      transition: opacity .35s var(--ease);
    }
    .pf-band[aria-pressed='true'] .pf-band__mark { opacity: 1; }

    .pf-band__num {
      grid-column: 1;
      grid-row: 1;
      font-family: var(--mono);
      font-size: .7rem;
      font-style: normal;
      letter-spacing: .16em;
    }
    .pf-band__label {
      grid-column: 2;
      grid-row: 1;
      font-family: var(--display);
      font-weight: 600;
      font-size: clamp(1.15rem, 2.4vw, 2.1rem);
      line-height: 1.02;
      letter-spacing: -.035em;
      color: var(--ink);
    }
    .pf-band__blurb {
      grid-column: 2;
      grid-row: 2;
      max-width: 46rem;
      color: var(--muted);
      font-size: .86rem;
      line-height: 1.5;
    }
    .pf-band__count { grid-column: 3; grid-row: 1; justify-self: end; color: var(--muted); font-weight: 400; }

    /* The reserved track. Empty at rest, so nothing shifts when the preview
       fades in. */
    .pf-band__preview {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: clamp(5rem, 10vw, 8.5rem);
      opacity: 0;
      transition: opacity .45s var(--ease);
      pointer-events: none;
    }
    .pf-band:hover .pf-band__preview,
    .pf-band[aria-pressed='true'] .pf-band__preview { opacity: 1; }
    .pf-band__preview img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
    }

    /* ======================================================================
       THE STUDIO

       One white band the full width of the viewport. The deck and the
       development panel share it, so the viewer reads as a lit studio rather
       than as a white rectangle laid on beige.
       ====================================================================== */
    .pf-studio {
      margin-top: clamp(1.25rem, 2.4vw, 2rem);
      padding: clamp(1.5rem, 3vw, 2.75rem) 0 clamp(1.75rem, 3.4vw, 3rem);
      background: var(--pf-stage);
    }
    .pf-studio__inner { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .pf-panel[hidden] { display: none; }

    .pf-viewer {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.75rem, 3vw, 2.75rem);
      align-items: center;
    }
    /* 65 / 35. Below this the two columns cannot both hold their job — five
       complete garments need the whole width — so the plates move under the
       deck instead of being squeezed beside it. */
    @media (min-width: 1360px) {
      .pf-viewer {
        grid-template-columns: minmax(0, 65fr) minmax(0, 35fr);
        gap: clamp(2rem, 3.2vw, 3.5rem);
      }
    }

    /* ---------- the deck ---------- */
    .pf-deck { min-width: 0; }

    /* FALLBACK (no script): every garment is a normal grid cell in the studio.
       Complete, scrollable and readable — the deck below is an enhancement
       layered on top of this, never a prerequisite for seeing the work. */
    .pf-stage { position: relative; }
    .pf-stage:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-stack {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .pf-slot__figure { margin: 0; }

    /* ENHANCED: the layered deck. */
    .pf--js .pf-stage {
      height: var(--stage-h, 420px);
      overflow: hidden;
      cursor: grab;
      touch-action: pan-y;
      -webkit-user-select: none;
      user-select: none;
    }
    .pf--js .pf-stack {
      display: block;
      position: absolute;
      inset: 0;
      transform: translate3d(var(--drag, 0px), 0, 0);
      transition: transform .55s var(--ease);
    }
    .pf--js .pf-stack[data-dragging] { transition: none; }
    .pf--js .pf-slot {
      position: absolute;
      left: var(--x, 0);
      /* Receding cards sit a little higher, the way objects rise toward a
         horizon. Small — six pixels a step — but it stops the row reading as
         one flat baseline. */
      bottom: var(--lift, 0);
      width: var(--w, 0);
      height: var(--h, 0);
      /* Opaque, because the occlusion is real: the card in front physically
         covers the back view of the card behind it. A transparent card would
         let both views show through each other.

         NO SHADOW, NO BORDER, NO FRAME. Depth is carried by overlap, by scale
         and by stacking order alone. A cast shadow at the seam turned five
         garments standing in one studio into five white cards lying on a
         table, which is the card language this rebuild removes. */
      background: var(--pf-stage);
      transition: left .58s var(--ease), width .58s var(--ease), height .58s var(--ease),
                  bottom .58s var(--ease), opacity .58s var(--ease);
    }
    .pf--js .pf-slot__figure { position: relative; width: 100%; height: 100%; }
    .pf-slot[hidden] { display: none; }
    /* contain, never cover: a head, a hem or a train is never cut off.
       pointer-events: none is load-bearing. Without it the first pointermove
       over a slot started a native image drag, the browser fired
       pointercancel, and the gesture died about twelve pixels in. The stage
       owns the whole interaction; the images are not targets. */
    .pf-slot__figure img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: bottom center;
      pointer-events: none;
      -webkit-user-drag: none;
    }
    /* The number is stated in the run bar, so on screen this would be the same
       fact twice. It stays in the document for assistive tech, which has no
       run bar to read it from. */
    .pf-slot__caption {
      position: absolute;
      width: 1px; height: 1px;
      margin: -1px; padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* ---------- the run bar: the deck's own navigation ---------- */
    .pf-runbar {
      display: flex;
      align-items: center;
      gap: clamp(.9rem, 1.8vw, 1.6rem);
      margin-top: clamp(.9rem, 1.6vw, 1.4rem);
      padding-top: clamp(.7rem, 1.2vw, 1rem);
      border-top: 1px solid var(--line);
    }
    .pf-step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .4rem;
      border: 0;
      background: none;
      color: var(--ink);
      cursor: pointer;
      transition: color .25s var(--ease), transform .25s var(--ease), opacity .25s var(--ease);
    }
    .pf-step .arrow { width: 1.15rem; height: 1.15rem; }
    .pf-step:hover:not(:disabled) { color: var(--signal); }
    .pf-step[data-step='-1']:hover:not(:disabled) { transform: translateX(-3px); }
    .pf-step[data-step='1']:hover:not(:disabled) { transform: translateX(3px); }
    .pf-step:disabled { opacity: .2; cursor: default; }
    .pf-step:focus-visible { outline: 2px solid var(--signal); outline-offset: 1px; }
    .pf-runbar__count { margin: 0; letter-spacing: .18em; color: var(--ink); }
    .pf-runbar__count i { color: var(--muted); font-style: normal; }

    /* ======================================================================
       PROJECT DEVELOPMENT — the three stages, full size

       One component renders this panel in both states. A stage with a real
       asset shows it; a stage without one shows a plate that says it is a demo
       layout. Publishing real evidence replaces the placeholder by adding data
       — nothing here is conditional on the state.
       ====================================================================== */
    .pf-devcol { min-width: 0; }
    .pf-project[hidden] { display: none; }
    .pf-project__number { margin: 0; color: var(--signal); }
    .pf-project__title {
      margin: .5rem 0 0;
      font-family: var(--display);
      font-size: clamp(1.3rem, 2vw, 1.7rem);
      line-height: 1.05;
      letter-spacing: -.03em;
    }
    .pf-project__profile { margin: 1.25rem 0 0; }
    .pf-project__profile > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
    .pf-project__profile dt {
      color: var(--muted);
      font-family: var(--mono);
      font-size: .64rem;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .pf-project__profile dd { margin: 0; font-size: .92rem; line-height: 1.55; }
    .pf-project__description { margin: 1.1rem 0 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.65; }
    .pf-project__tags { margin: .9rem 0 0; color: var(--muted); }
    .pf-project__tags i { font-style: normal; opacity: .5; }

    .pf-dev { margin-top: clamp(1.1rem, 1.8vw, 1.5rem); }
    .pf-project .pf-dev { margin-top: clamp(1.5rem, 2.4vw, 2rem); }
    .pf-dev__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: .45rem 1.1rem;
      margin: 0 0 clamp(.9rem, 1.5vw, 1.3rem);
      padding-bottom: .7rem;
      border-bottom: 1px solid var(--line-strong);
    }
    .pf-dev__title { color: var(--ink); }
    /* The one signal in this panel: the strip says what it is, in the one
       colour the site uses to mean "read this". */
    .pf-dev__note { color: var(--signal); }

    .pf-dev__plates {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1rem, 1.8vw, 1.6rem);
      margin: 0;
      padding: 0;
      list-style: none;
    }
    @media (min-width: 1360px) {
      /* Two and one, in step order.
         Beside the deck the panel is a third of the width, and three plates
         stacked down it would stand about twice as tall as the deck — the
         garments would float in the middle of a column of white with the
         development running past them on both sides. Two portrait plates and
         one wide one bring the panel within reach of the deck's height while
         keeping every plate large. */
      .pf-dev__plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .pf-plate[data-plate='sketch'] .pf-plate__art,
      .pf-plate[data-plate='pattern'] .pf-plate__art { aspect-ratio: 3 / 4; }
      .pf-plate[data-plate='simulation'] { grid-column: 1 / -1; }
      .pf-plate[data-plate='simulation'] .pf-plate__art { aspect-ratio: 16 / 9; }
    }
    .pf-plate { min-width: 0; }
    .pf-plate__art { position: relative; aspect-ratio: 4 / 3; }
    .pf-plate__art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }

    /* A demo plate does not draw a sketch, a pattern or a garment. It is
       visibly an empty technical layout, stamped, so it cannot be read as
       work. The three are told apart by their ground alone. */
    .pf-plate__blank {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      padding: clamp(.65rem, 1.1vw, .95rem);
      border: 1px solid var(--line-strong);
    }
    .pf-plate[data-plate='sketch'] .pf-plate__blank {
      background: repeating-linear-gradient(45deg, transparent 0 9px, rgba(17, 17, 15, .05) 9px 10px);
    }
    .pf-plate[data-plate='pattern'] .pf-plate__blank {
      background:
        repeating-linear-gradient(to right, rgba(17, 17, 15, .07) 0 1px, transparent 1px 28px),
        repeating-linear-gradient(to bottom, rgba(17, 17, 15, .07) 0 1px, transparent 1px 28px);
    }
    /* A centre-front axis and the fall of light down a backdrop. A full
       crosshair read as a window divided into four panes, which is a frame,
       not a ground. */
    .pf-plate[data-plate='simulation'] .pf-plate__blank {
      background:
        linear-gradient(to right, transparent calc(50% - .5px), rgba(17, 17, 15, .09) calc(50% - .5px) calc(50% + .5px), transparent calc(50% + .5px)),
        linear-gradient(to bottom, rgba(17, 17, 15, .05), rgba(17, 17, 15, 0) 62%);
    }
    .pf-plate__stamp {
      padding: .28rem .5rem;
      border: 1px solid var(--muted);
      color: var(--muted);
      font-size: .58rem;
      letter-spacing: .2em;
    }
    .pf-plate__caption { color: var(--muted); font-size: .58rem; letter-spacing: .16em; }
    .pf-plate__label { display: flex; align-items: baseline; gap: .6rem; margin: .65rem 0 0; }
    .pf-plate__label b { flex: none; color: var(--muted); font-weight: 400; }
    .pf-plate__label span {
      font-family: var(--display);
      font-size: clamp(.95rem, 1.25vw, 1.15rem);
      line-height: 1.15;
      letter-spacing: -.02em;
    }

    /* ======================================================================
       EMPTY CHAPTERS
       ====================================================================== */
    .pf-empty { max-width: var(--max); margin: 0 auto; padding: clamp(1rem, 2vw, 2rem) var(--gutter) 0; }
    .pf-empty__lead { max-width: 34rem; margin: 0; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }
    .pf-empty__list { max-width: 46rem; margin: 2rem 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
    .pf-empty__list li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: .35rem 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
    .pf-empty__list i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-empty__list span { font-family: var(--display); font-size: 1.1rem; letter-spacing: -.015em; }
    .pf-empty__list small { color: var(--muted); font-size: .88rem; line-height: 1.5; }

    /* ======================================================================
       TECH PACKS — the folio table

       One dossier open on the table, the rest of the library lying behind it,
       and a numbered side index. Paper, page edges and a bound spine; no
       gloss, no cartoon page curl, no 3D.
       ====================================================================== */
    .pf-library {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      max-width: var(--max);
      margin: 0 auto;
      padding: clamp(1.25rem, 2.4vw, 2.25rem) var(--gutter) 0;
      align-items: start;
    }
    @media (min-width: 1100px) {
      .pf-library { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); }
    }

    .pf-library__table { position: relative; min-width: 0; padding: clamp(1.25rem, 2.4vw, 2.25rem) 0 0 clamp(1.25rem, 2.4vw, 2.25rem); }
    /* The rest of the library, lying on the table behind the open dossier. */
    .pf-library__pile { position: absolute; inset: 0; pointer-events: none; }
    .pf-library__pile i {
      position: absolute;
      display: block;
      width: min(70%, 26rem);
      aspect-ratio: 297 / 210;
      border: 1px solid var(--line);
      background: var(--pf-paper);
    }
    .pf-library__pile i:nth-child(1) { left: 0; top: 0; transform: rotate(-2.4deg); }
    .pf-library__pile i:nth-child(2) { left: .9rem; top: .7rem; transform: rotate(1.4deg); }
    .pf-library__pile i:nth-child(3) { left: 1.7rem; top: 1.4rem; transform: rotate(-.6deg); }

    .pf-folio { position: relative; margin: 0; display: grid; gap: clamp(1.25rem, 2.4vw, 2rem); }
    .pf-folio[hidden] { display: none; }
    .pf-folio__object { position: relative; display: block; width: min(100%, 38rem); aspect-ratio: 297 / 210; }
    .pf-folio__edge,
    .pf-folio__cover { position: absolute; inset: 0; display: block; border: 1px solid var(--line); background: var(--pf-paper); }
    .pf-folio__edge:nth-child(1) { transform: translate(15px, 15px); }
    .pf-folio__edge:nth-child(2) { transform: translate(10px, 10px); }
    .pf-folio__edge:nth-child(3) { transform: translate(5px, 5px); }
    .pf-folio__cover { border-color: var(--line-strong); display: flex; overflow: hidden; }
    .pf-folio__spine { position: relative; flex: none; width: clamp(1.2rem, 2.4vw, 2.1rem); background: var(--ink); }
    .pf-folio__spine::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 12%;
      bottom: 12%;
      width: 1px;
      background: rgba(251, 250, 246, .32);
    }
    .pf-folio__scan { flex: 1; width: 100%; height: 100%; object-fit: contain; }
    .pf-folio__print {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: clamp(1.1rem, 2.4vw, 2.1rem);
    }
    .pf-folio__printhead { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: .9rem; border-bottom: 1px solid var(--line-strong); }
    .pf-folio__printhead i:not(.pf-folio__stamp) { color: var(--muted); font-style: normal; }
    .pf-folio__stamp {
      flex: none;
      font-style: normal;
      padding: .28rem .5rem;
      border: 1px solid var(--signal);
      color: var(--signal);
      letter-spacing: .2em;
    }
    .pf-folio__rules { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; padding: clamp(.9rem, 2vw, 1.6rem) 0; }
    .pf-folio__rules i { display: block; height: 1px; background: var(--line); }
    .pf-folio__rules i:nth-child(1) { width: 38%; background: var(--line-strong); }
    .pf-folio__rules i:nth-child(2) { width: 82%; }
    .pf-folio__rules i:nth-child(3) { width: 64%; }
    .pf-folio__rules i:nth-child(4) { width: 76%; }
    .pf-folio__rules i:nth-child(5) { width: 45%; }
    .pf-folio__printfoot { padding-top: .9rem; border-top: 1px solid var(--line); color: var(--muted); }

    .pf-folio__meta { max-width: 38rem; }
    .pf-folio__kind { margin: 0; color: var(--signal); }
    .pf-folio__meta h3 { margin: .5rem 0 0; font-family: var(--display); font-size: clamp(1.35rem, 2.2vw, 1.8rem); letter-spacing: -.03em; }
    .pf-folio__scope { margin: .6rem 0 0; color: var(--muted); font-size: .88rem; line-height: 1.55; }
    .pf-folio__open { margin-top: 1.25rem; }

    .pf-library__head { margin: 0 0 1rem; color: var(--muted); }
    .pf-library__head--split { margin-top: 2.25rem; padding-top: 1.4rem; border-top: 1px solid var(--line-strong); }
    .pf-library__list, .pf-contents { margin: 0; padding: 0; list-style: none; }
    .pf-doc {
      position: relative;
      display: grid;
      grid-template-columns: 2.2rem minmax(0, 1fr);
      gap: .2rem .8rem;
      width: 100%;
      padding: .9rem 0 .9rem 1.1rem;
      border: 0;
      border-bottom: 1px solid var(--line);
      background: none;
      color: var(--muted);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: color .3s var(--ease);
    }
    .pf-library__list li:first-child .pf-doc { border-top: 1px solid var(--line); }
    .pf-doc:hover { color: var(--ink); }
    .pf-doc:focus-visible { outline: 2px solid var(--signal); outline-offset: -2px; }
    .pf-doc__mark {
      position: absolute;
      left: 0;
      top: 1.2rem;
      width: .36rem;
      height: .36rem;
      background: var(--signal);
      opacity: 0;
      transition: opacity .3s var(--ease);
    }
    .pf-doc[aria-pressed='true'] .pf-doc__mark { opacity: 1; }
    .pf-doc[aria-pressed='true'] { color: var(--ink); }
    .pf-doc__num { grid-column: 1; grid-row: 1; font-style: normal; }
    .pf-doc__title { grid-column: 2; grid-row: 1; font-family: var(--display); font-size: 1rem; letter-spacing: -.015em; color: var(--ink); }
    .pf-doc__meta { grid-column: 2; grid-row: 2; color: var(--muted); font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }

    .pf-contents li { display: grid; grid-template-columns: 2.1rem minmax(0, 1fr); gap: .25rem .75rem; padding: .85rem 0; border-bottom: 1px solid var(--line); }
    .pf-contents li:first-child { border-top: 1px solid var(--line); }
    .pf-contents i { grid-row: 1 / span 2; color: var(--muted); font-style: normal; }
    .pf-contents span { font-family: var(--display); font-size: .98rem; letter-spacing: -.01em; }
    .pf-contents small { color: var(--muted); font-size: .84rem; line-height: 1.5; }
    .pf-library__index .button { margin-top: 1.75rem; }

    /* ======================================================================
       3D SIMULATION — the theatre

       A dark band running the full width: one large frame, then a film strip
       of every session slot. The recording is portrait, so the frame is
       portrait and the theatre is what surrounds it — nothing is cropped to
       force a cinema shape onto it.
       ====================================================================== */
    .pf-reel {
      margin-top: clamp(1rem, 2vw, 1.75rem);
      padding: clamp(1.75rem, 3.4vw, 3rem) 0 clamp(2rem, 4vw, 3.5rem);
      background: var(--ink);
      color: var(--paper-bright);
    }
    .pf-reel__stage,
    .pf-strip,
    .pf-reel__note { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }

    .pf-session[hidden] { display: none; }
    .pf-session {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.75rem);
      align-items: center;
    }
    @media (min-width: 1024px) {
      .pf-session { grid-template-columns: minmax(0, 27rem) minmax(0, 1fr); }
    }
    .pf-session__frame {
      position: relative;
      width: 100%;
      max-width: 27rem;
      aspect-ratio: 512 / 910;
      max-height: min(70vh, 38rem);
      margin-inline: auto;
      overflow: hidden;
      background: #000;
      border: 1px solid rgba(251, 250, 246, .16);
    }
    .pf-session__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pf-play {
      position: absolute;
      left: 50%;
      bottom: 1.25rem;
      z-index: 2;
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      padding: .8rem 1.1rem;
      border: 1px solid rgba(251, 250, 246, .55);
      background: rgba(17, 17, 15, .6);
      color: var(--paper-bright);
      cursor: pointer;
      transform: translateX(-50%);
      transition: background .25s var(--ease), border-color .25s var(--ease), color .25s var(--ease);
    }
    .pf-play:hover { background: var(--signal); border-color: var(--signal); color: var(--ink); }
    .pf-play:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-play__mark { width: 0; height: 0; border-left: .6rem solid currentColor; border-top: .38rem solid transparent; border-bottom: .38rem solid transparent; }

    /* Not a disabled play button — there is nothing to play, so nothing
       offers to play it. */
    .pf-pending {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .7rem;
      text-align: center;
      background:
        repeating-linear-gradient(45deg, rgba(251, 250, 246, .035) 0 10px, transparent 10px 20px),
        #0b0b0a;
    }
    .pf-pending__slot { margin: 0; color: var(--paper-bright); font-size: .78rem; letter-spacing: .22em; }
    .pf-pending__state { margin: 0; color: var(--signal); letter-spacing: .2em; }

    .pf-session__player { position: absolute; inset: 0; z-index: 3; }
    .pf-session__player[hidden] { display: none; }
    .pf-session__player iframe, .pf-session__player video { width: 100%; height: 100%; border: 0; background: #000; }
    .pf-session[data-playing] .pf-session__poster { opacity: 0; }
    .pf-session__kind { margin: 0; color: var(--signal); }
    .pf-session__meta h3 { margin: .7rem 0 0; font-family: var(--display); font-size: clamp(1.4rem, 2.6vw, 2.2rem); letter-spacing: -.035em; }
    .pf-session__meta > p { margin: .8rem 0 0; max-width: 38rem; color: rgba(251, 250, 246, .78); line-height: 1.65; }
    .pf-session__labels { color: rgba(251, 250, 246, .55); }
    .pf-session__labels i { font-style: normal; opacity: .5; }
    .pf-session__privacy { font-size: .85rem; color: rgba(251, 250, 246, .55); }

    /* ---------- the film strip ---------- */
    .pf-strip { margin-top: clamp(1.75rem, 3.4vw, 3rem); }
    .pf-strip__head {
      display: flex;
      align-items: baseline;
      gap: .6rem;
      margin: 0 0 .9rem;
      padding-bottom: .7rem;
      border-bottom: 1px solid rgba(251, 250, 246, .18);
      color: rgba(251, 250, 246, .6);
    }
    .pf-strip__head i { font-style: normal; color: var(--paper-bright); }
    .pf-strip__reel {
      display: flex;
      gap: .75rem;
      margin: 0;
      padding: .55rem 0;
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
      /* The sprocket rails. Two hairline tracks of perforations above and
         below the frames, drawn on the ground rather than on each cell. */
      background:
        repeating-linear-gradient(to right, rgba(251, 250, 246, .22) 0 6px, transparent 6px 18px) top left / 100% 3px no-repeat,
        repeating-linear-gradient(to right, rgba(251, 250, 246, .22) 0 6px, transparent 6px 18px) bottom left / 100% 3px no-repeat;
    }
    .pf-strip__cell { flex: none; scroll-snap-align: start; }
    .pf-frame {
      display: block;
      width: clamp(6.75rem, 8.4vw, 8.25rem);
      padding: 0;
      border: 0;
      background: none;
      color: rgba(251, 250, 246, .62);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: color .3s var(--ease);
    }
    .pf-frame:hover { color: var(--paper-bright); }
    .pf-frame:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
    .pf-frame__window {
      position: relative;
      display: block;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #0b0b0a;
      border: 1px solid rgba(251, 250, 246, .16);
    }
    .pf-frame[aria-pressed='true'] .pf-frame__window { border-color: var(--signal); }
    .pf-frame__window img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .pf-frame__blank {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(251, 250, 246, .3);
      font-family: var(--mono);
      font-size: 1.4rem;
      letter-spacing: .1em;
      background: repeating-linear-gradient(45deg, rgba(251, 250, 246, .035) 0 9px, transparent 9px 18px);
    }
    .pf-frame__label { display: block; margin-top: .55rem; }
    .pf-frame__num { display: block; font-style: normal; color: var(--muted); }
    .pf-frame[aria-pressed='true'] .pf-frame__num { color: var(--signal); }
    .pf-frame__label span {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
      min-height: 2.4em;
      margin-top: .22rem;
      font-family: var(--display);
      font-size: .88rem;
      line-height: 1.2;
      letter-spacing: -.015em;
      color: inherit;
    }
    .pf-frame__label small { display: block; margin-top: .3rem; color: rgba(251, 250, 246, .42); font-size: .58rem; }

    .pf-reel__note {
      display: grid;
      gap: 1.25rem;
      justify-items: start;
      margin-top: clamp(1.75rem, 3.4vw, 3rem);
      padding-top: clamp(1.25rem, 2.4vw, 2rem);
      border-top: 1px solid rgba(251, 250, 246, .16);
    }
    .pf-reel__note p { max-width: 44rem; margin: 0; color: rgba(251, 250, 246, .72); font-size: .95rem; line-height: 1.65; }
    .pf-reel__note .button { border-color: rgba(251, 250, 246, .4); color: var(--paper-bright); }
    .pf-reel__note .button:hover { background: var(--paper-bright); color: var(--ink); }
    .pf-world--motion .pf-prov { border-left-color: var(--line-strong); }

    /* ======================================================================
       RESPONSIVE
       ====================================================================== */

    /* ---- covers stack to one column, art above type ----------------------
       Every selector here carries [data-chapter] so it matches the specificity
       of the per-chapter placement above and actually overrides it. Written
       without the attribute these rules lost, the art kept its desktop
       grid-column: 2 in a one-column grid, and the garment and the folio were
       pushed into an implicit track off the side of the cover.
       --------------------------------------------------------------------- */
    @media (max-width: 900px) {
      .pf-cover[data-chapter] {
        /* The art takes whatever the type does not, so the garment and the
           folio stay the largest thing on the cover instead of shrinking to a
           fixed strip with air above and below them. */
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(clamp(13rem, 34vh, 19rem), 1fr) auto;
        min-height: clamp(26rem, 74vh, 40rem);
      }
      .pf-cover[data-chapter] .pf-cover__art { grid-column: 1; grid-row: 1; align-self: stretch; }
      .pf-cover[data-chapter] .pf-cover__type { grid-column: 1; grid-row: 2; }

      /* Menswear is a page of type, so its title leads and the categories
         follow it — the reading order a cover with no photograph wants. */
      .pf-cover[data-chapter='menswear'] { grid-template-rows: auto auto; align-content: center; }
      .pf-cover[data-chapter='menswear'] .pf-cover__type { grid-row: 1; }
      .pf-cover[data-chapter='menswear'] .pf-cover__art { grid-row: 2; padding: 0 var(--gutter) clamp(1.5rem, 5vw, 2.5rem); }
      .pf-cover[data-chapter='tech-packs'] .pf-cover__art {
        display: flex;
        align-items: center;
        padding: clamp(1.5rem, 6vw, 2.5rem) var(--gutter);
      }
      .pf-cover[data-chapter='3d-simulation'] { grid-template-rows: 1fr auto; align-content: end; }
      .pf-cover[data-chapter='3d-simulation'] .pf-cover__still { object-position: center 34%; }
      .pf-cover[data-chapter='3d-simulation'] .pf-cover__art { position: absolute; inset: 0; min-height: 0; }
      .pf-cover[data-chapter='3d-simulation'] .pf-cover__art::after {
        background: linear-gradient(to top, rgba(17, 17, 15, .95) 0%, rgba(17, 17, 15, .78) 45%, rgba(17, 17, 15, .25) 100%);
      }
      .pf-cover[data-chapter='3d-simulation'] .pf-cover__type { grid-row: 1; }
    }

    /* ---- chapter interiors ---- */
    @media (max-width: 1023px) {
      .pf-world__head { grid-template-columns: minmax(0, 1fr); align-items: start; }
      .pf-prov { padding-left: .9rem; }
    }

    /* One folio on the table and the rest of the library as a shelf that runs
       across under it, rather than a column of five rows pushing the contents
       list off the bottom of the phone. */
    @media (max-width: 1099px) {
      .pf-library__list {
        display: flex;
        gap: .75rem;
        overflow-x: auto;
        scroll-snap-type: x proximity;
        scrollbar-width: none;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .pf-library__list::-webkit-scrollbar { display: none; }
      .pf-library__list li { flex: none; scroll-snap-align: start; width: clamp(9rem, 42vw, 12rem); }
      .pf-library__list li:first-child .pf-doc { border-top: 0; }
      .pf-doc { height: 100%; border-bottom: 0; }
      .pf-doc__mark { top: .95rem; }
    }

    @media (max-width: 760px) {
      /* The bands lose their preview track and keep their type: at this width
         a 5rem strip of photograph costs more than it gives. */
      .pf-band { grid-template-columns: 2.4rem minmax(0, 1fr) 2.6rem; }
      .pf-band__preview { display: none; }
      .pf-band__label { font-size: clamp(1.05rem, 4.6vw, 1.5rem); }
      .pf-band__blurb { font-size: .8rem; }

      /* Plates go under the deck and stay large — one per row, not three
         thumbnails squeezed across a phone. */
      .pf-dev__plates { grid-template-columns: minmax(0, 1fr); }
      .pf-plate__art { aspect-ratio: 3 / 2; }

      .pf-library__table { padding-left: 0; }
      .pf-library__pile i { width: 78%; }
    }

    @media (max-width: 430px) {
      .pf-cover__name { font-size: clamp(2.1rem, 11vw, 2.9rem); }
      .pf-project__profile > div { grid-template-columns: minmax(0, 1fr); gap: .15rem; }
    }

    /* ======================================================================
       REDUCED MOTION — everything still works, nothing moves decoratively.
       ====================================================================== */
    @media (prefers-reduced-motion: reduce) {
      .pf-cover,
      .pf-cover__go,
      .pf-band,
      .pf-band__mark,
      .pf-band__preview,
      .pf-doc,
      .pf-doc__mark,
      .pf-frame,
      .pf-slot,
      .pf-stack,
      .pf-step,
      .pf-world { transition: none !important; }
      .pf--js .pf-world { transform: none; }
    }
  </style>
</SiteLayout>
