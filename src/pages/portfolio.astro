function openCollection(category) {


    collectionName.textContent =
    category.name;


    looksContainer.innerHTML = "";


    category.looks.forEach(
        (look, index) => {

            createLook(
                look,
                index,
                category.looks.length
            );

        }
    );


    collection.classList.add("active");


    gsap.to(
        collection,
        {
            autoAlpha: 1,
            duration: .7,
            ease: "power4.out"
        }
    );


    document.body.style.overflow =
    "hidden";


    collection.scrollTop = 0;


    ScrollTrigger.refresh();

}


/* =====================================================
   CLOSE COLLECTION
===================================================== */

collectionClose.addEventListener(
    "click",
    closeCollection
);


function closeCollection() {


    gsap.to(
        collection,
        {

            autoAlpha: 0,

            duration: .5,

            ease: "power3.inOut",

            onComplete: () => {

                collection.classList.remove(
                    "active"
                );

                looksContainer.innerHTML = "";

                document.body.style.overflow =
                "";

                ScrollTrigger
                    .getAll()
                    .forEach(
                        trigger => trigger.kill()
                    );

            }

        }
    );

}


/* =====================================================
   CREATE LOOK
===================================================== */

function createLook(
    look,
    index,
    total
) {


    const section =
    document.createElement("section");


    section.className =
    "look-section";


    const cards =
    [];


    portfolioData;


    for (
        let i = 0;
        i < total;
        i++
    ) {


        const card =
        document.createElement("div");


        card.className =
        "look-card";


        card.innerHTML = `

            <img
                src="${
                    findLookImage(
                        i,
                        total,
                        index,
                        look
                    )
                }"
                alt=""
            >

        `;


        cards.push(card);

    }


    section.innerHTML = `

        <div class="look-stage">


            <div class="look-visual">

            </div>


            <div
                class="current-label"
            >

                LOOK
                ${String(index + 1).padStart(2,"0")}

            </div>


            <div class="look-details">

            </div>


            <div class="look-progress">

                ${String(index + 1).padStart(2,"0")}
                /
                ${String(total).padStart(2,"0")}

            </div>

        </div>

    `;


    const visual =
    section.querySelector(
        ".look-visual"
    );


    const details =
    section.querySelector(
        ".look-details"
    );


    cards.length = 0;


    const categoryLooks =
    getCurrentLookSet();


    categoryLooks.forEach(
        (item, cardIndex) => {

            const card =
            document.createElement("div");


            card.className =
            "look-card";


            card.dataset.index =
            cardIndex;


            card.innerHTML = `

                <img
                    src="${item.image}"
                    alt=""
                >

            `;


            visual.appendChild(card);


            cards.push(card);

        }
    );


    categoryLooks.forEach(
        (item, itemIndex) => {

            const detail =
            document.createElement("div");


            detail.className =
            "details-item";


            detail.innerHTML = `

                <div class="details-index">

                    ${String(itemIndex + 1)
                        .padStart(2,"0")}
                    /
                    ${String(total)
                        .padStart(2,"0")}

                </div>


                <h2 class="details-title">

                    ${item.title}

                </h2>


                <p class="details-description">

                    ${item.description}

                </p>

            `;


            details.appendChild(detail);

        }
    );


    looksContainer.appendChild(section);


    initializeMechanicalStack(
        section,
        cards,
        details,
        categoryLooks
    );

}


