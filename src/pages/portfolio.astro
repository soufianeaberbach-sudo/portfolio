                <h2 class="category-title">

                    ${category.name}

                </h2>


                <p class="category-description">

                    ${category.description}

                </p>

            </div>

        `;


        section.addEventListener(
            "click",
            () => openCollection(category)
        );


        categories.appendChild(section);

    }
);


