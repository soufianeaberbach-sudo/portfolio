    .pf-plate__art { position: relative; aspect-ratio: 4 / 3; }
    /* Beside the deck the plates are deliberately small — evidence, not a
       second gallery. Sized so the whole three-step rail stands no taller than
       the garments it belongs to, which is what removed the need to make the
       deck sticky to keep them in the same view. */
    @media (min-width: 1024px) {
