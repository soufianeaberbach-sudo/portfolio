       on top of this, never a prerequisite for seeing the work. */
    .pf-stage { position: relative; }
    .pf-stage:focus-visible { outline: 2px solid var(--signal); outline-offset: 3px; }
    .pf-stack {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .pf-slot__figure { margin: 0; }

    /* ENHANCED: the depth deck. */
    .pf--js .pf-stage {
      height: var(--stage-h, 420px);
      overflow: hidden;
      cursor: grab;
      touch-action: pan-y;
      -webkit-user-select: none;
      user-select: none;
