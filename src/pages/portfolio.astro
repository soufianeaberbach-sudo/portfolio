    .pf-foliomark__leaf:nth-child(1) { transform: translate(14px, 14px) rotate(-1.6deg); }
    .pf-foliomark__leaf:nth-child(2) { transform: translate(7px, 7px) rotate(.9deg); }
    .pf-foliomark__cover { border-color: var(--line-strong); display: flex; }
    .pf-foliomark__spine {
      position: relative;
      flex: none;
      width: clamp(1rem, 2vw, 1.7rem);
      background: var(--ink);
    }
    .pf-foliomark__spine::after {
      content: '';
      position: absolute;
