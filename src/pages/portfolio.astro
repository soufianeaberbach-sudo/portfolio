            /* The active card leads the deck: it is the right-most and the
               top-most, and nothing covers it. */
            activeIsLeading: (() => {
              const shown = queue.slots.filter((slot) => !slot.hidden);
              if (shown.length === 0) return false;
              const active = queue.slots[queue.index];
              const right = shown.reduce((a, b) => (b.getBoundingClientRect().right > a.getBoundingClientRect().right ? b : a));
