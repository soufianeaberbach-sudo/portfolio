---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import BriefForm from '../components/BriefForm.astro';
import References from '../components/References.astro';
import { profiles } from '../components/SocialLinks.astro';

/* Contact — the first step of the process, not another sales page.
 *
 * The visitor arrives having already read four pages. The only job left is to
 * make the first move easy: permission in the hero, a real form within one
 * short scroll, and the proof that reduces risk placed where the risk is
 * actually taken — beside and immediately below the form, never after it.
 *
 * The form posts to a Cloudflare Worker (worker/index.ts). Nothing on this
 * page promises an upload, because there isn't one; the optional link field
 * covers the same need without storage, size or privacy complexity.
 */
const email = 'soufiane.aberbach@gmail.com';

const faqs = [
  {
    q: 'Do I need a finished design?',
    a: 'No. A rough sketch, a reference photo or a written description is enough to discuss whether the garment is producible.',
  },
  {
    q: 'Can I come to you with an existing fit or development problem?',
    a: 'Yes. A pattern plus fit photos often makes a balance problem visible faster than starting the garment again.',
  },
  {
    q: 'Do you work remotely and internationally?',
    a: 'Yes. The work is done from Tangier on GMT+1, which overlaps the full European working day, and companies can be invoiced directly.',
  },
  {
    q: 'How do I share files?',
    a: 'Paste a Google Drive, Dropbox or WeTransfer link in the brief form — there is no upload on this page. Larger technical material can follow by email once the first reply has gone back.',
  },
  {
    q: 'How is project material handled?',
    a: 'A submitted brief travels from your browser to this site’s Cloudflare hosting, is stored there so nothing is lost in transit, and is emailed on to Soufiane. It is not published, shared or added to this portfolio. The spam check on the form is Cloudflare Turnstile, which loads a script from Cloudflare — the only third-party script on the site.',
  },
];
---

<SiteLayout
  title="Contact — Soufiane Aberbach"
  description="Start a development brief with Soufiane Aberbach in Tangier. A sketch, a reference, an existing sample, a fit issue or a production question is enough to begin."
  marker="SA-CONTACT-V6"
  page="contact"
>
  <!-- BUILD-MARKER: SA-CONTACT-V6 -->

  <section class="ct-hero">
    <div class="section-shell ct-hero__grid">
      <div class="ct-hero__copy" data-reveal>
        <p class="eyebrow">Contact / 05</p>
        <h1 class="display ct-hero__title">Start with<br />what you <em>have</em>.</h1>
      </div>
      <aside class="ct-hero__aside" data-reveal>
        <p>
          A sketch, a reference, an existing sample, a fit issue or a production
          question is enough to begin. Nothing has to be resolved before you write.
        </p>
        <p class="label ct-hero__availability">Available for selected freelance development work</p>
      </aside>
    </div>
  </section>

  <section class="ct-brief" id="brief" aria-labelledby="ct-brief-title">
    <div class="section-shell ct-brief__grid">
      <div class="ct-brief__intro" data-reveal>
        <p class="eyebrow">Development brief</p>
        <h2 class="display ct-brief__title" id="ct-brief-title">Describe where<br />the product <em>is</em>.</h2>
        <ol class="ct-steps">
          <li><span class="label">01</span><p>You describe the garment or the production problem.</p></li>
          <li><span class="label">02</span><p>It is read personally and scoped honestly.</p></li>
          <li><span class="label">03</span><p>A written route and a realistic next step come back.</p></li>
        </ol>
      </div>

      <div class="ct-brief__form" data-reveal>
        <BriefForm />
      </div>

      <!-- Who vouches, visible while the form is being filled in. The quotes
           follow immediately below; nothing is left until after the ask. -->
      <div class="ct-brief__vouch" data-reveal>
        <References mode="list" />
      </div>
    </div>

    <div class="section-shell ct-brief__refs">
      <div class="ct-brief__refs-head" data-reveal>
        <p class="eyebrow">References</p>
        <h3 class="display" id="ct-refs-title">In their own words.</h3>
      </div>
      <References mode="full" />
    </div>
  </section>

  <section class="ct-workspace" aria-label="Soufiane's freelance workspace">
    <div class="section-shell ct-workspace__grid">
      <div class="ct-workspace__note" data-reveal>
        <p class="eyebrow">Working environment</p>
        <p>Pattern, fit and technical decisions are developed here before they move to production.</p>
      </div>
      <figure data-reveal>
        <img
          src="/contact-figure-1400.webp"
          srcset="/contact-figure-800.webp 800w, /contact-figure-1400.webp 1400w"
          sizes="(max-width: 900px) 100vw, 54vw"
          width="1510"
          height="980"
          alt="Soufiane Aberbach at his desk beside a monitor displaying his current portfolio website"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="label">Freelance workspace / Tangier</figcaption>
      </figure>
    </div>
  </section>

  <section class="ct-direct" aria-labelledby="ct-direct-title">
    <div class="section-shell ct-direct__grid">
      <h2 class="sr-only" id="ct-direct-title">Direct contact and business status</h2>
      <div data-reveal>
        <p class="label">Direct email</p>
        <a class="ct-direct__email" href={`mailto:${email}`}>{email} <span><Arrow /></span></a>
      </div>
      <div data-reveal>
        <p class="label">Professional profiles</p>
        {/* Rendered here rather than reusing the footer's SocialLinks nav: that
            component paints its glyph in var(--paper) for a dark ground, so on
            this paper background it showed four empty bordered boxes. Names
            are also plainer than "in" / "up" / "fiverr." abbreviations. */}
        <ul class="ct-profiles">
          {profiles.map((profile) => (
            <li>
              <a href={profile.href} target="_blank" rel="noopener noreferrer">
                <span>{profile.name}</span>
                <span class="sr-only">(opens in a new tab)</span>
                <i aria-hidden="true"><Arrow /></i>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="ct-direct__business" data-reveal>
        <p class="label">Business status</p>
        <strong>Registered Moroccan Auto-Entrepreneur</strong>
        <span>Since 2018 &middot; B2B invoicing available</span>
        <span>Tangier, Morocco &middot; GMT+1</span>
      </div>
    </div>
  </section>

  <section class="ct-faq section-shell" aria-labelledby="ct-faq-title">
    <div class="ct-faq__head" data-reveal>
      <p class="eyebrow">Before you write</p>
      <h2 class="display" id="ct-faq-title">Useful answers.</h2>
    </div>
    <div class="ct-faq__list" data-reveal>
      {faqs.map((item) => (
        <details><summary>{item.q}</summary><p>{item.a}</p></details>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  /* ---------- Hero: shorter than a viewport, so the form is one short scroll
       away rather than two screens down. ---------- */
  .ct-hero {
    min-height: min(68svh, 42rem);
    display: grid;
    align-items: end;
    padding: calc(var(--header-h) + clamp(3rem, 6vw, 5rem)) 0 clamp(2.5rem, 5vw, 4rem);
    background: var(--ink);
    color: var(--paper);
  }
  .ct-hero__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(16rem, .55fr); align-items: end; gap: clamp(2rem, 6vw, 6rem); }
  .ct-hero .eyebrow { margin: 0 0 clamp(1.25rem, 2.5vw, 2rem); color: color-mix(in srgb, var(--paper) 58%, var(--ink)); }
  .ct-hero__title { font-size: clamp(2.9rem, 8vw, 8rem); }
  .ct-hero__aside { max-width: 30rem; padding-bottom: .5rem; }
  .ct-hero__aside > p:first-child { margin: 0; color: color-mix(in srgb, var(--paper) 68%, var(--ink)); font-size: 1.05rem; line-height: 1.75; }
  /* Static and factual — no indicator dot, nothing that reads as live state. */
  .ct-hero__availability { margin: 1.75rem 0 0; padding-top: .9rem; border-top: 1px solid color-mix(in srgb, var(--paper) 32%, var(--ink)); color: color-mix(in srgb, var(--paper) 72%, var(--ink)); }

  /* ---------- The brief: the primary action ---------- */
  .ct-brief { padding-block: clamp(3.5rem, 7vw, 6.5rem) clamp(4rem, 8vw, 8rem); }
  .ct-brief__grid {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.35fr) minmax(13rem, .55fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    row-gap: clamp(2.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .ct-brief__intro { grid-column: 1; }
  .ct-brief__form { grid-column: 2; min-width: 0; }
  .ct-brief__vouch { grid-column: 3; }

  .ct-brief__title { margin: 1.75rem 0 0; font-size: clamp(2rem, 3.4vw, 3.1rem); }
  .ct-steps { margin: clamp(2rem, 3.5vw, 3rem) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .ct-steps li { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: .75rem; padding: .95rem 0; border-bottom: 1px solid var(--line); }
  .ct-steps span { color: var(--muted); }
  .ct-steps p { margin: 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.55; }

  .ct-brief__refs { margin-top: clamp(3.5rem, 6vw, 6rem); padding-top: clamp(2.5rem, 4vw, 4rem); border-top: 1px solid var(--line-strong); }
  /* The quotes need a heading of their own: the rail that names the three
     sources sits at the top of the section, which at narrow widths is a long
     way above this, and without a heading the block is invisible to anyone
     navigating by headings. */
  .ct-brief__refs-head { margin-bottom: clamp(2rem, 3.5vw, 3rem); }
  .ct-brief__refs-head .eyebrow { color: var(--muted); }
  .ct-brief__refs-head h3 { margin: 1.25rem 0 0; font-size: clamp(1.7rem, 3vw, 2.6rem); }

  /* ---------- Workspace: human proof AFTER the action ---------- */
  .ct-workspace { padding-block: clamp(3.5rem, 7vw, 7rem); border-top: 1px solid var(--line); background: var(--paper-bright); }
  .ct-workspace__grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); align-items: end; gap: clamp(2rem, 5vw, 5rem); }
  .ct-workspace__note .eyebrow { color: var(--muted); }
  .ct-workspace__note p:last-child { max-width: 26rem; margin: 1.5rem 0 0; color: var(--ink-soft); line-height: 1.7; }
  .ct-workspace figure { margin: 0; }
  /* height:auto is load-bearing: the height="980" attribute otherwise survives
     as a presentational hint, makes aspect-ratio inert and lets object-fit
     crop the photograph into the wrong box. */
  /* No frame: the photograph sits in the composition rather than in a card.
     height:auto is load-bearing — the height="980" attribute otherwise
     survives as a presentational hint, makes aspect-ratio inert and lets
     object-fit crop the image into the wrong box. */
  .ct-workspace img { display: block; width: 100%; height: auto; }
  /* Editorial metadata under the image: spacing alone. A rule across the full
     column width read as the bottom edge of a card, which is the framing this
     pass removes. */
  .ct-workspace figcaption { margin-top: 1.1rem; color: var(--muted); }

  /* ---------- Direct routes: deliberately quiet next to the form ---------- */
  .ct-direct { padding-block: clamp(3.5rem, 6vw, 6rem); border-top: 1px solid var(--line-strong); }
  .ct-direct__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 4rem); }
  .ct-direct .label { margin: 0 0 1rem; color: var(--muted); }
  .ct-direct__email { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--display); font-weight: 850; letter-spacing: -.03em; font-size: clamp(1rem, 1.5vw, 1.35rem); overflow-wrap: anywhere; transition: color .2s var(--ease); }
  .ct-direct__email:hover { color: var(--signal); }
  .ct-direct__business { display: grid; gap: .4rem; }
  .ct-direct__business strong { font-family: var(--display); font-weight: 850; letter-spacing: -.03em; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.25; }
  .ct-direct__business span { color: var(--muted); font-family: var(--mono); font-size: .72rem; line-height: 1.65; }

  /* Platform names on hairlines. Text first, arrow second — a missing icon can
     never leave the row unreadable. */
  .ct-profiles { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .ct-profiles li { border-bottom: 1px solid var(--line); }
  .ct-profiles a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.9rem;
    padding: .5rem .1rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    transition: color .18s var(--ease);
  }
  .ct-profiles a:hover { color: var(--signal); }
  .ct-profiles i { display: inline-flex; flex: 0 0 auto; color: var(--muted); transition: color .18s var(--ease), transform .18s var(--ease); }
  .ct-profiles a:hover i { color: var(--signal); transform: translate(2px, -2px); }

  /* ---------- FAQ ---------- */
  .ct-faq { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 7vw, 7rem); border-top: 1px solid var(--line); }
  .ct-faq__head h2 { margin-top: 1.75rem; font-size: clamp(2rem, 3.6vw, 3.4rem); }
  .ct-faq__list { border-top: 1px solid var(--line-strong); }
  .ct-faq details { border-bottom: 1px solid var(--line); }
  .ct-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 3.25rem; padding: 1rem 0; cursor: pointer; font-family: var(--display); font-weight: 650; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.3; }
  .ct-faq summary::after { content: '+'; flex: 0 0 auto; color: var(--signal); font-family: var(--mono); font-size: 1rem; }
  .ct-faq details[open] summary::after { content: '–'; }
  .ct-faq details p { max-width: 42rem; margin: 0 0 1.5rem; color: var(--ink-soft); line-height: 1.75; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1199px) {
    /* Trust moves ABOVE the form rather than below it: the point of the rail
       is to reduce risk before the ask, so it never falls past it. */
    .ct-brief__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
    .ct-brief__vouch { grid-column: 1 / -1; grid-row: 1; }
    .ct-brief__vouch :global(.vouch ul) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(1rem, 3vw, 2.5rem); }
    .ct-brief__intro { grid-column: 1; grid-row: 2; }
    .ct-brief__form { grid-column: 2; grid-row: 2; }
  }

  @media (max-width: 900px) {
    .ct-hero__grid,
    .ct-brief__grid,
    .ct-workspace__grid,
    .ct-direct__grid,
    .ct-faq { grid-template-columns: minmax(0, 1fr); }
    .ct-hero__aside { max-width: 38rem; }
    .ct-brief__vouch { grid-column: 1; grid-row: 1; }
    .ct-brief__intro { grid-column: 1; grid-row: 2; }
    .ct-brief__form { grid-column: 1; grid-row: 3; }
    .ct-workspace__grid > * { min-width: 0; }
  }

  @media (max-width: 560px) {
    .ct-hero { min-height: 0; padding-top: calc(var(--header-h) + 3.5rem); }
    .ct-hero__title { font-size: clamp(2.4rem, 11vw, 3.4rem); }
    .ct-brief__vouch :global(.vouch ul) { grid-template-columns: minmax(0, 1fr); }
    .ct-direct__grid { gap: 2.25rem; }
  }
</style>
