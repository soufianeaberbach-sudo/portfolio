---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ClientFeedback from '../components/ClientFeedback.astro';

const testimonials = [
  {
    reviewer: 'halaelhn',
    role: 'Fiverr client',
    proof: 'Client experience / freelance service',
    rating: 5,
    quote: 'Exceptional service provider! He far exceeded my expectations by doing much more than what was asked. Always available, highly professional, and perfectly mastering his craft. He is also a human and pleasant person. I highly recommend him without any hesitation!',
    ratings: [
      { label: 'Level of communication with the freelancer', score: 5 },
      { label: 'Quality of delivery', score: 5 },
      { label: 'Value of delivery', score: 5 },
    ],
    highlights: ['Quick responsiveness', 'Language fluency', 'Level of cooperation', 'Politeness', 'Deep understanding', 'Went above and beyond', 'Proactive communication', 'Attention to details', 'Creativity', 'Professionalism', 'Brand alignment', 'Visual appeal', 'Exceeded expectations'],
  },
  {
    reviewer: 'Khalid',
    role: 'Managing Director, Loratex',
    proof: 'Factory proof / manufacturing reliability',
    rating: 5,
    quote: "Soufiane is relentlessly precise. What stood out during his 7 years with us wasn't just his CAD expertise, but his absolute refusal to compromise on manufacturing accuracy. Working with him means you never have to worry about what happens on the cutting room floor—he solves the problem before it even gets there. A true technical backbone for any mass production line.",
    ratings: [
      { label: 'Technical Problem Solving', score: 5 },
      { label: 'Quality of Production Files', score: 5 },
      { label: 'Value & Cost Efficiency', score: 5 },
    ],
    highlights: ['Flawless pattern grading', 'Manufacturing readiness', 'Deep technical understanding', 'Attention to details', 'Proactive risk management', 'Factory floor communication', 'Exceeded expectations', 'High-volume reliability'],
  },
  {
    reviewer: 'Head of Buying',
    role: 'ASOS',
    proof: 'Brand proof / design-intent protection',
    rating: 5,
    quote: "The hardest part of offshore production is losing the design intent in translation. Soufiane ruthlessly engineers the aesthetic vision for mass production. He doesn't just execute instructions; he actively challenges them if he foresees a manufacturing risk. His 3D validation process saved us countless rounds of physical sampling and gave us complete confidence to move straight to production.",
    ratings: [
      { label: '3D Simulation Accuracy', score: 5 },
      { label: 'Protection of Design Intent', score: 5 },
      { label: 'Timeline & Delivery', score: 5 },
    ],
    highlights: ['Cost and time saving', '3D digital validation', 'Deep understanding', 'Attention to details', 'Structural engineering', 'Brand alignment', 'Proactive communication', 'Exceptional professionalism'],
  },
];
---

<SiteLayout title="Contact — Soufiane Aberbach" description="Start a fashion development brief with Soufiane Aberbach in Tangier." marker="SA-CONTACT-V5" page="contact">
  <!-- BUILD-MARKER: SA-CONTACT-V5 -->
  <section class="contact-hero">
    <div class="contact-hero__copy" data-reveal>
      <p class="eyebrow">Contact / 05</p>
      <h1 class="display">Send a sketch.<br /><span>Get a production answer.</span></h1>
    </div>
    <aside data-reveal>
      <p>No contract and no call to book. Describe the garment, reference or fit problem; the next useful production step comes back in writing.</p>
      <div class="contact-availability"><i aria-hidden="true"></i><span class="label">Development briefs open</span></div>
    </aside>
  </section>

  <section class="contact-workspace" aria-label="Soufiane's freelance workspace">
    <div class="contact-workspace__grid">
      <div class="contact-workspace__note" data-reveal>
        <p class="eyebrow">Working environment</p>
        <p>Pattern, fit and technical decisions are developed here before they move to production.</p>
      </div>
      <figure data-reveal>
        <img src="/contact.png" width="1536" height="1024" alt="Soufiane Aberbach at his desk beside a monitor displaying his current portfolio website" loading="lazy" decoding="async" />
        <figcaption class="label">Freelance workspace / Tangier</figcaption>
      </figure>
    </div>
  </section>

  <section class="brief-section" id="brief">
    <div class="brief-section__intro" data-reveal>
      <p class="eyebrow">Development brief</p>
      <h2 class="display">Five fields.<br />Two minutes.</h2>
      <div class="brief-steps">
        <div><span>01</span><p>You describe the garment or production issue.</p></div>
        <div><span>02</span><p>The brief is read personally and scoped honestly.</p></div>
        <div><span>03</span><p>You receive a written route and realistic next step.</p></div>
      </div>
    </div>

    <form class="brief-form" data-brief-form data-reveal>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" autocomplete="name" required placeholder="Name / company" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
      </div>
      <div class="field">
        <label for="project">What are you developing?</label>
        <select id="project" name="project" required>
          <option value="">Select a category</option>
          <option>Evening dress</option>
          <option>Jersey or knit</option>
          <option>Woven garment</option>
          <option>Sport</option>
          <option>Swimwear</option>
          <option>Other garment</option>
        </select>
      </div>
      <div class="field">
        <label for="stage">Where is it now?</label>
        <select id="stage" name="stage" required>
          <option value="">Select a stage</option>
          <option>Sketch or reference</option>
          <option>Pattern in progress</option>
          <option>Sample or fit problem</option>
          <option>Preparing for production</option>
          <option>Production already running</option>
        </select>
      </div>
      <div class="field field--wide">
        <label for="message">What needs solving?</label>
        <textarea id="message" name="message" rows="5" required placeholder="Describe the garment, the problem and any deadline that matters."></textarea>
      </div>
      <div class="form-action field--wide">
        <p>This button opens your email app with the brief prepared. Nothing is uploaded or stored on this site.</p>
        <button class="button button--signal" type="submit">Prepare email brief <span><Arrow /></span></button>
      </div>
      <p class="form-status field--wide" data-form-status aria-live="polite"></p>
    </form>
  </section>

  <section class="contact-direct">
    <div class="section-shell contact-direct__grid">
      <div data-reveal><p class="label">Direct email</p><a href="mailto:soufiane.aberbach@gmail.com">soufiane.aberbach@gmail.com <span><Arrow /></span></a></div>
      <div data-reveal><p class="label">Based in</p><strong>Tangier, Morocco</strong><span>GMT+1 · EU working hours</span></div>
      <div data-reveal><p class="label">Business status</p><strong>Registered Moroccan auto-entrepreneur since 2018</strong><span>Able to invoice companies directly.</span></div>
    </div>
  </section>

  <ClientFeedback items={testimonials} />

  <section class="contact-faq section-shell">
    <div data-reveal><p class="eyebrow">Before you write</p><h2 class="display">Useful answers.</h2></div>
    <div class="faq-list" data-reveal>
      <details><summary>Do I need a finished design?</summary><p>No. A rough sketch, a reference photo or a written description is enough to discuss whether the garment is producible.</p></details>
      <details><summary>Can you diagnose an existing fit problem?</summary><p>Yes. A pattern plus fit photos often makes the balance problem visible faster than starting again.</p></details>
      <details><summary>Do you work with small runs?</summary><p>The pattern and technical development principles are the same; the production route depends on the run and factory.</p></details>
      <details><summary>Will my material stay private?</summary><p>Nothing sent is shared, published or added to this portfolio without written permission.</p></details>
    </div>
  </section>

</SiteLayout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-brief-form]');
    const status = document.querySelector('[data-form-status]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const subject = `Development brief — ${data.get('project')}`;
      const body = [
        `Name / company: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        `Garment category: ${data.get('project')}`,
        `Current stage: ${data.get('stage')}`,
        '',
        'What needs solving:',
        data.get('message'),
      ].join('\n');
      status.textContent = 'Your email app is opening with the brief prepared.';
      window.location.href = `mailto:soufiane.aberbach@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  })();
</script>

<style>
  .contact-hero { min-height: 100svh; display: grid; grid-template-columns: 1.4fr .6fr; gap: 8vw; align-items: end; padding: calc(var(--header-h) + 5rem) var(--gutter) 4rem; background: var(--ink); color: var(--paper); }
  .contact-hero h1 { margin-top: 2rem; font-size: clamp(5rem, 11vw, 11.5rem); }
  .contact-hero h1 span { color: var(--signal); }
  .contact-hero aside { max-width: 30rem; padding-bottom: 1rem; }
  .contact-hero aside > p { color: #aaa89f; font-size: 1.1rem; line-height: 1.75; }
  .contact-availability { display: flex; align-items: center; gap: .75rem; margin-top: 2rem; }
  .contact-availability i { width: .6rem; height: .6rem; border-radius: 50%; background: var(--acid); box-shadow: 0 0 0 .35rem rgba(215,230,98,.12); }
  .contact-workspace { position: relative; z-index: 2; padding: 0 var(--gutter); background: var(--paper-bright); color: var(--ink); }
  .contact-workspace__grid { display: grid; grid-template-columns: minmax(12rem, .3fr) minmax(0, 1.7fr); gap: 4vw; align-items: center; }
  .contact-workspace__note { align-self: end; margin-bottom: 2rem; padding: 2rem 0; border-top: 1px solid var(--line-strong); }
  .contact-workspace__note > p:last-child { max-width: 20rem; color: var(--muted); line-height: 1.7; }
  .contact-workspace figure { position: relative; z-index: 1; margin: -8rem 0 -5rem; overflow: hidden; }
  .contact-workspace img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: center 48%; }
  .contact-workspace figcaption { position: absolute; right: 1.5rem; bottom: 1.5rem; padding: .6rem .75rem; background: rgba(17,17,15,.88); color: var(--paper); }
  .brief-section { display: grid; grid-template-columns: .7fr 1.3fr; gap: 8vw; padding: clamp(10rem, 15vw, 15rem) var(--gutter) clamp(7rem, 12vw, 12rem); background: var(--paper-bright); }
  .brief-section__intro { position: sticky; top: 8rem; align-self: start; }
  .brief-section__intro h2 { margin: 2rem 0 3rem; font-size: clamp(4rem, 7vw, 7.5rem); }
  .brief-steps { border-top: 1px solid var(--line-strong); }
  .brief-steps div { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .brief-steps span { font-family: var(--mono); font-size: .65rem; color: var(--signal); }
  .brief-steps p { margin: 0; color: var(--muted); font-size: .84rem; }
  .brief-form { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding-top: 1rem; }
  .field { position: relative; display: grid; gap: .7rem; }
  .field--wide { grid-column: 1 / -1; }
  .field label { font-family: var(--mono); font-size: .67rem; letter-spacing: .1em; text-transform: uppercase; }
  .field input, .field select, .field textarea { width: 100%; border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; padding: 1rem 0; background: transparent; color: var(--ink); outline: 0; }
  .field textarea { resize: vertical; min-height: 10rem; }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--signal); box-shadow: 0 1px 0 var(--signal); }
  .form-action { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 1rem; }
  .form-action p { max-width: 26rem; margin: 0; color: var(--muted); font-size: .75rem; line-height: 1.6; }
  .form-status { min-height: 1.5rem; margin: 0; color: var(--signal-dark); font-size: .8rem; }
  .contact-direct { padding-block: 4rem; background: color-mix(in srgb, var(--signal) 84%, var(--ink)); color: #fff; }
  .contact-direct__grid { display: grid; grid-template-columns: 1.2fr .7fr .9fr; gap: 5vw; }
  .contact-direct p { color: #fff; font-weight: 650; opacity: .82; }
  .contact-direct a { font-family: var(--display); font-size: clamp(1.25rem, 2.4vw, 2.6rem); font-weight: 700; letter-spacing: -.04em; }
  .contact-direct a span { font-size: .65em; }
  .contact-direct strong, .contact-direct div > span { display: block; }
  .contact-direct strong { margin-top: 1rem; }
  .contact-direct div > span { margin-top: .4rem; font-size: .78rem; opacity: .75; }
  .contact-faq { display: grid; grid-template-columns: .7fr 1.3fr; gap: 8vw; padding-block: clamp(7rem, 12vw, 12rem); }
  .contact-faq h2 { margin-top: 2rem; font-size: clamp(4rem, 7vw, 7rem); }
  .faq-list { border-top: 1px solid var(--line-strong); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; justify-content: space-between; gap: 2rem; padding: 1.5rem 0; cursor: pointer; font-family: var(--display); font-size: clamp(1.25rem, 2vw, 1.8rem); font-weight: 650; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: '+'; color: var(--signal); }
  .faq-list details[open] summary::after { content: '−'; }
  .faq-list details p { max-width: 42rem; margin: 0; padding: 0 0 1.5rem; color: var(--muted); line-height: 1.7; }
  @media (max-width: 900px) { .contact-hero, .brief-section, .contact-faq { grid-template-columns: minmax(0, 1fr); } .contact-hero > * { min-width: 0; } .contact-workspace { padding-top: 3rem; } .contact-workspace__grid { grid-template-columns: minmax(0, 1fr); } .contact-workspace__note { max-width: 30rem; margin-bottom: 0; } .contact-workspace figure { margin: 0 0 -3rem; } .brief-section { padding-top: clamp(8rem, 13vw, 11rem); } .brief-section__intro { position: static; } .contact-direct__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .contact-hero { min-height: 88svh; grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-top: calc(var(--header-h) + 4rem); } .contact-hero h1 { font-size: clamp(3.6rem, 15vw, 5rem); } .contact-workspace { padding-top: 3rem; } .contact-workspace__note { padding-bottom: .5rem; } .contact-workspace figure { margin-bottom: -2rem; } .contact-workspace img { aspect-ratio: 4 / 3; object-position: 58% center; } .contact-workspace figcaption { right: .75rem; bottom: .75rem; } .brief-form { grid-template-columns: 1fr; } .field--wide { grid-column: 1; } .form-action { align-items: stretch; flex-direction: column; } .contact-direct__grid { grid-template-columns: 1fr; } .contact-direct__grid > div { padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,.45); } }
</style>
