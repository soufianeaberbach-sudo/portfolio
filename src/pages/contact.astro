.sendto .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;
 animation:pulse 2s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.sendto span{font-size:13px;color:#3E3E38}
.sendto b{font-weight:600;color:var(--ink)}
.field{margin-bottom:24px;position:relative}
.field label{display:block;font-family:'JetBrains Mono',monospace;font-size:10.5px;
 letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-bottom:8px;transition:color .25s}
.field.on label{color:var(--accent)}
.field input,.field select,.field textarea{width:100%;background:transparent;border:0;
 border-bottom:1px solid var(--line);padding:11px 0;font-family:Inter,sans-serif;font-size:16px;
 color:var(--ink);outline:none;border-radius:0}
.field .uline{position:absolute;left:0;bottom:0;height:1px;width:0;background:var(--accent);
 transition:width .35s cubic-bezier(.16,1,.3,1)}
.field.on .uline{width:100%}
.field textarea{resize:vertical;min-height:100px}
.sendbtn{display:flex;align-items:center;justify-content:space-between;gap:16px;width:100%;
 background:var(--accent);color:#fff;border:0;padding:19px 24px;margin-top:8px;
 font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.14em;
 text-transform:uppercase;cursor:pointer;transition:transform .25s,background .25s}
.sendbtn:hover{background:var(--ink);transform:translateY(-2px)}
.sendbtn svg{transition:transform .3s}
.sendbtn:hover svg{transform:translateX(5px)}
.cside .blk{padding-bottom:22px;margin-bottom:22px;border-bottom:1px solid var(--line)}
.cside .blk:last-child{border-bottom:0}
.cside h4{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.14em;
