---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import BriefForm from '../components/BriefForm.astro';
import References from '../components/References.astro';
import { profiles } from '../components/SocialLinks.astro';

/* Contact — the first step of the process, not another sales page.
 *
 * The visitor arrives having already read four pages. The only job left is to
 * make the first move easy: permission in the hero, direct routes first, then
 * a real form that accepts a small reference file or link. Business status,
 * proof and third-party alternatives follow in that order.
 */
const email = 'soufianeaberbach@gmail.com';
/* One source for all three renderings of the number: the readable form, the
   tel: target and the wa.me path, which takes no + and no separators. */
const phoneDisplay = '+212 657 872 090';
const phoneDial = '+212657872090';
const whatsapp = 'https://wa.me/212657872090';

const faqs = [
  {
    q: 'Do I need a finished design?',
    a: 'No. A rough sketch, a reference photo or a written description is enough to discuss whether the garment is producible.',
  },
  {
    q: 'Can I come to you with an existing fit or development problem?',
    a: 'Yes. A pattern plus fit photos often makes a balance problem visible faster than starting the garment again.',
  },
  {
    q: 'Do you work remotely and internationally?',
    a: 'Yes. Work is coordinated remotely from Tangier, with strong overlap with European working hours, and companies can be invoiced directly.',
  },
  {
    q: 'How do I share files?',
    a: 'Attach one PDF, JPEG, PNG or WebP file up to 10 MB, or paste a Google Drive, Dropbox, Figma or web reference. Larger technical material can follow by email once the first reply has gone back.',
  },
  {
    q: 'How is project material handled?',
    a: 'The form collects your name, an optional company or brand, your email, the product stage, your message and an optional reference link. Submitted material is processed through this site&rsquo;s hosting and email providers only to receive and respond to the brief — it is stored so nothing is lost in transit, then emailed on. It is not published or used as portfolio material. The spam check is Cloudflare Turnstile, which loads a script from Cloudflare and is the only third-party script on the site. Full detail is on the privacy page.',
  },
];
---

<SiteLayout
  title="Contact — Soufiane Aberbach"
  description="Start a development brief with Soufiane Aberbach in Tangier. A sketch, a reference, an existing sample, a fit issue or a production question is enough to begin."
  marker="SA-CONTACT-V6"
  page="contact"
>
  <!-- BUILD-MARKER: SA-CONTACT-V6 -->

  <section class="ct-hero">
    <div class="section-shell ct-hero__grid">
      <div class="ct-hero__copy" data-reveal>
        <p class="eyebrow">Contact / 05</p>
        <h1 class="display ct-hero__title">Start with<br />what you <em>have</em>.</h1>
      </div>
      <aside class="ct-hero__aside" data-reveal>
        <p>
          A sketch, a reference, an existing sample, a fit issue or a production
          question is enough to begin. Nothing has to be resolved before you write.
        </p>
        <p class="label ct-hero__availability">Available for selected freelance and professional opportunities</p>
      </aside>
    </div>
  </section>

  <section class="ct-direct" aria-labelledby="ct-direct-title">
    <div class="section-shell ct-direct__composition">
      <div class="ct-reach" data-reveal>
        <p class="eyebrow">Direct contact</p>
        <h2 class="display ct-reach__title" id="ct-direct-title">Reach Soufiane<br /><em>directly</em>.</h2>
        <ul class="ct-reach__list">
          <li>
            <span class="label">Email</span>
            <a class="ct-reach__value" href={`mailto:${email}`}>
              {email}<i aria-hidden="true"><Arrow /></i>
            </a>
          </li>
          <li>
            <span class="label">Phone</span>
            <a class="ct-reach__value" href={`tel:${phoneDial}`}>
              {phoneDisplay}<i aria-hidden="true"><Arrow /></i>
            </a>
          </li>
          <li>
            <span class="label">WhatsApp</span>
            <a class="ct-reach__value" href={whatsapp} target="_blank" rel="noopener noreferrer">
              {phoneDisplay}
              <span class="sr-only">on WhatsApp (opens in a new tab)</span>
              <i aria-hidden="true"><Arrow /></i>
            </a>
          </li>
        </ul>
        <p class="ct-reach__note">
          Working hours are Morocco time (GMT+1). The development brief reaches the
          same inbox and keeps your reference attached to it.
        </p>
      </div>

      <figure class="ct-workspace__figure" data-reveal>
        <img
          src="/contact-figure-1400.webp"
          srcset="/contact-figure-800.webp 800w, /contact-figure-1400.webp 1400w"
          sizes="(max-width: 900px) 100vw, 54vw"
          width="1510"
          height="980"
          alt="Soufiane Aberbach at his desk beside a monitor displaying his current portfolio website"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="eyebrow">Working environment</span>
          <span>Pattern, fit and technical decisions are developed here before they move to production.</span>
          <strong class="label">Freelance workspace / Tangier</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="ct-brief" id="brief" aria-labelledby="ct-brief-title">
    <div class="section-shell ct-brief__grid">
      <div class="ct-brief__intro" data-reveal>
        <p class="eyebrow">Start a development brief</p>
        <h2 class="display ct-brief__title" id="ct-brief-title">Upload what<br />you <em>have</em>.</h2>
        <ol class="ct-steps">
          <li><span class="label">01</span><p>Describe the garment or the production problem.</p></li>
          <li><span class="label">02</span><p>Attach one approved reference file or share a link.</p></li>
          <li><span class="label">03</span><p>Receive an honest scope and a realistic next step.</p></li>
        </ol>
      </div>

      <div class="ct-brief__form" data-reveal>
        <BriefForm />
      </div>
    </div>
  </section>

  <section class="ct-business" aria-labelledby="ct-credential-title">
    <div class="section-shell ct-business__grid">
      <div class="ct-business__intro" data-reveal>
        <p class="eyebrow">Procurement ready</p>
        <p class="ct-signature" aria-label="Soufiane Aberbach"><span>Soufiane</span><span>Aberbach</span></p>
        <p>Direct engagement is supported by a registered Moroccan business and clear invoicing.</p>
      </div>
      <aside class="ct-credential" data-reveal>
          <p class="eyebrow" id="ct-credential-title">Registered business</p>
          <p class="ct-credential__head">
            Registered Moroccan<br />Auto&#8209;Entrepreneur
          </p>
          <dl class="ct-credential__facts">
            <div>
              <dt>Registered since</dt>
              <dd>2018</dd>
            </div>
            <div>
              <dt>Invoicing</dt>
              <dd><em>B2B invoicing available</em></dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>Tangier, Morocco</dd>
            </div>
          </dl>
          <p class="ct-credential__note">
            Formal engagement with a company is straightforward — contracts and invoices
            in your own procurement process.
          </p>
      </aside>
    </div>
  </section>

  <section class="ct-proof" aria-labelledby="ct-refs-title">
    <div class="section-shell">
      <div class="ct-proof__head" data-reveal>
        <p class="eyebrow">Professional references</p>
        <h2 class="display" id="ct-refs-title">In their own <em>words</em>.</h2>
      </div>
      <References mode="full" />
    </div>
  </section>

  <section class="ct-platforms" aria-labelledby="ct-platforms-title">
    <div class="section-shell ct-platforms__row" data-reveal>
        <p class="ct-platforms__tag" id="ct-platforms-title">Third-party platform alternatives</p>
        <p class="ct-platforms__note">Direct contact is preferred. These profiles remain available if your process requires a marketplace.</p>
        <ul class="ct-platforms__list">
          {profiles.map((profile) => (
            <li>
              <a href={profile.href} target="_blank" rel="noopener noreferrer">
                {profile.name}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
    </div>
  </section>

  <section class="ct-faq section-shell" aria-labelledby="ct-faq-title">
    <div class="ct-faq__head" data-reveal>
      <p class="eyebrow">Before you write</p>
      <h2 class="display" id="ct-faq-title">Useful answers.</h2>
    </div>
    <div class="ct-faq__list" data-reveal>
      {faqs.map((item) => (
        <details><summary>{item.q}</summary><p>{item.a}</p></details>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  /* ---------- Hero: shorter than a viewport, so the form is one short scroll
       away rather than two screens down. ---------- */
  .ct-hero {
    min-height: min(68svh, 42rem);
    display: grid;
    align-items: end;
    padding: calc(var(--header-h) + clamp(3rem, 6vw, 5rem)) 0 clamp(2.5rem, 5vw, 4rem);
    background: var(--ink);
    color: var(--paper);
  }
  .ct-hero__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(16rem, .55fr); align-items: end; gap: clamp(2rem, 6vw, 6rem); }
  .ct-hero .eyebrow { margin: 0 0 clamp(1.25rem, 2.5vw, 2rem); color: color-mix(in srgb, var(--paper) 58%, var(--ink)); }
  .ct-hero__title { font-size: clamp(2.9rem, 8vw, 8rem); }
  .ct-hero__aside { max-width: 30rem; padding-bottom: .5rem; }
  .ct-hero__aside > p:first-child { margin: 0; color: color-mix(in srgb, var(--paper) 68%, var(--ink)); font-size: 1.05rem; line-height: 1.75; }
  /* Static and factual — no indicator dot, nothing that reads as live state. */
  .ct-hero__availability { margin: 1.75rem 0 0; padding-top: .9rem; border-top: 1px solid color-mix(in srgb, var(--paper) 32%, var(--ink)); color: color-mix(in srgb, var(--paper) 72%, var(--ink)); }

  /* ---------- Direct routes + workspace: the first conversion choice ---------- */
  .ct-direct { padding-block: clamp(4rem, 7vw, 7rem); border-bottom: 1px solid var(--line-strong); overflow: hidden; }
  .ct-direct__composition {
    display: grid;
    grid-template-columns: minmax(21rem, .78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .ct-reach__title { margin-top: 1.35rem; font-size: clamp(2.6rem, 4.7vw, 4.8rem); }
  .ct-reach__list { margin: clamp(1.75rem, 3vw, 2.5rem) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .ct-reach__list li { padding: clamp(.9rem, 1.6vw, 1.15rem) 0; border-bottom: 1px solid var(--line); }
  .ct-reach__list .label { display: block; margin-bottom: .3rem; color: var(--muted); }
  .ct-reach__value {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    max-width: 100%;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: -.03em;
    font-size: clamp(1.15rem, 2.1vw, 1.75rem);
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
    box-shadow: inset 0 -2px 0 var(--signal);
    transition: color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .ct-reach__value i { flex: none; color: var(--signal); transition: transform .2s var(--ease); }
  .ct-reach__value:hover { color: var(--signal); }
  .ct-reach__value:hover i { transform: translate(2px, -2px); }
  .ct-reach__note { max-width: 31rem; margin: 1.5rem 0 0; color: var(--ink-soft); font-size: .86rem; line-height: 1.7; }

  /* The asset is already a transparent workspace cut-out. It crosses the
     section gutter and its caption sits inside the open negative space, so it
     behaves as part of the editorial composition—not as a rectangular card. */
  .ct-workspace__figure { position: relative; width: calc(100% + var(--gutter)); margin: 0 calc(var(--gutter) * -1) -3rem 0; }
  .ct-workspace__figure img { display: block; width: 100%; height: auto; }
  .ct-workspace__figure figcaption {
    position: absolute;
    left: clamp(1rem, 3vw, 3rem);
    bottom: clamp(3.5rem, 7vw, 7rem);
    z-index: 1;
    width: min(17rem, 38%);
  }
  .ct-workspace__figure figcaption > span:nth-child(2) { display: block; margin-top: 1rem; color: var(--paper); font-size: .88rem; line-height: 1.65; }
  .ct-workspace__figure figcaption strong { display: block; margin-top: 1.1rem; padding-top: .7rem; border-top: 1px solid rgba(243, 240, 233, .45); color: var(--paper); font-weight: 400; }
  .ct-workspace__figure .eyebrow { color: var(--signal); }

  /* ---------- Development brief: upload or link ---------- */
  .ct-brief { padding-block: clamp(4.5rem, 8vw, 8rem) clamp(3.5rem, 5vw, 5rem); }
  .ct-brief__grid {
    display: grid;
    grid-template-columns: minmax(17rem, .72fr) minmax(0, 1.28fr);
    column-gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .ct-brief__intro { grid-column: 1; }
  .ct-brief__form { grid-column: 2; min-width: 0; }
  .ct-brief__title { margin: 1.75rem 0 0; font-size: clamp(2.5rem, 4.6vw, 4.7rem); }
  .ct-steps { margin: clamp(2rem, 3.5vw, 3rem) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .ct-steps li { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: .75rem; padding: .95rem 0; border-bottom: 1px solid var(--line); }
  .ct-steps span { color: var(--muted); }
  .ct-steps p { margin: 0; color: var(--ink-soft); font-size: .95rem; line-height: 1.55; }

  /* ---------- Registered business / procurement ---------- */
  .ct-business { padding-block: clamp(4rem, 6vw, 6rem); border-top: 1px solid var(--line-strong); background: var(--paper-bright); }
  .ct-business__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, .75fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .ct-business__intro > p:last-child { max-width: 34rem; margin: 2rem 0 0; color: var(--ink-soft); font-size: 1rem; line-height: 1.7; }
  .ct-signature {
    margin: 1.5rem 0 0;
    font-family: var(--display);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 850;
    letter-spacing: -.07em;
    line-height: .78;
  }
  .ct-signature span { display: block; }
  .ct-signature span:last-child { color: transparent; -webkit-text-stroke: 1.25px var(--ink); }
  .ct-credential {
    padding: clamp(1.35rem, 2.4vw, 1.9rem);
    border: 1px solid var(--line-strong);
    border-top: 3px solid var(--signal);
    background: var(--paper-bright);
  }
  .ct-credential__head {
    margin: clamp(.9rem, 1.6vw, 1.2rem) 0 clamp(1.1rem, 2vw, 1.5rem);
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.25rem, 1.9vw, 1.55rem);
    letter-spacing: -.03em;
    line-height: 1.08;
  }
  .ct-credential__facts { margin: 0; display: grid; gap: .7rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .ct-credential__facts div { display: grid; grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr); gap: .75rem; align-items: baseline; }
  .ct-credential__facts dt { font-family: var(--mono); font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .ct-credential__facts dd { margin: 0; font-size: .9rem; font-weight: 500; color: var(--ink); }
  .ct-credential__facts em { font-style: normal; font-weight: 600; color: var(--signal); }
  .ct-credential__note { margin: 1.25rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: .8rem; line-height: 1.65; }

  /* ---------- Professional proof: one editorial sequence ---------- */
  .ct-proof { padding-block: clamp(4.5rem, 8vw, 8rem); border-top: 1px solid var(--line); }
  .ct-proof__head { display: grid; grid-template-columns: .55fr 1.45fr; align-items: end; gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 5rem); }
  .ct-proof__head h2 { font-size: clamp(3rem, 6.5vw, 6.5rem); }

  /* ---------- Platforms: useful, deliberately last and secondary ---------- */
  .ct-platforms { padding-block: clamp(2.25rem, 4vw, 3.5rem); border-top: 1px solid var(--line); background: var(--paper-bright); }
  .ct-platforms__row { display: grid; grid-template-columns: auto minmax(16rem, 1fr) auto; align-items: baseline; gap: 1rem clamp(1.5rem, 4vw, 4rem); }
  .ct-platforms__tag { margin: 0; font-family: var(--mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .ct-platforms__note { max-width: 32rem; margin: 0; color: var(--ink-soft); font-size: .82rem; line-height: 1.55; }
  .ct-platforms__list { display: flex; flex-wrap: wrap; gap: .5rem clamp(1rem, 2.4vw, 1.75rem); margin: 0; padding: 0; list-style: none; }
  .ct-platforms__list a {
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .06em;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: .12rem;
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  .ct-platforms__list a:hover { color: var(--signal); border-color: var(--signal); }

  /* ---------- FAQ ---------- */
  .ct-faq { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 7vw, 7rem); border-top: 1px solid var(--line); }
  .ct-faq__head h2 { margin-top: 1.75rem; font-size: clamp(2rem, 3.6vw, 3.4rem); }
  .ct-faq__list { border-top: 1px solid var(--line-strong); }
  .ct-faq details { border-bottom: 1px solid var(--line); }
  .ct-faq summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 3.25rem; padding: 1rem 0; cursor: pointer; font-family: var(--display); font-weight: 650; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.3; }
  .ct-faq summary::after { content: '+'; flex: 0 0 auto; color: var(--signal); font-family: var(--mono); font-size: 1rem; }
  .ct-faq details[open] summary::after { content: '–'; }
  .ct-faq details p { max-width: 42rem; margin: 0 0 1.5rem; color: var(--ink-soft); line-height: 1.75; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1199px) {
    .ct-brief__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); }
    .ct-platforms__row { grid-template-columns: minmax(0, .65fr) minmax(0, 1.35fr); }
    .ct-platforms__list { grid-column: 1 / -1; }
  }

  @media (max-width: 900px) {
    .ct-hero__grid,
    .ct-brief__grid,
    .ct-direct__composition,
    .ct-business__grid,
    .ct-proof__head,
    .ct-platforms__row,
    .ct-faq { grid-template-columns: minmax(0, 1fr); }
    .ct-hero__aside { max-width: 38rem; }
    .ct-brief__intro, .ct-brief__form { grid-column: 1; }
    .ct-workspace__figure { width: calc(100% + var(--gutter)); margin-left: 0; }
    .ct-workspace__figure figcaption { position: static; width: min(100%, 34rem); margin: 1.5rem 0 0; }
    .ct-workspace__figure figcaption > span:nth-child(2) { color: var(--ink-soft); }
    .ct-workspace__figure figcaption strong { border-top-color: var(--line); color: var(--muted); }
    .ct-platforms__list { grid-column: 1; }
  }

  @media (max-width: 560px) {
    .ct-hero { min-height: 0; padding-top: calc(var(--header-h) + 3.5rem); }
    .ct-hero__title { font-size: clamp(2.4rem, 11vw, 3.4rem); }
    .ct-direct__composition { gap: 2.25rem; }
    .ct-reach__title { font-size: clamp(2.5rem, 12vw, 3.4rem); }
    .ct-reach__value { font-size: 1.05rem; }
    .ct-workspace__figure { width: calc(100% + var(--gutter) * 2); margin: 0 calc(var(--gutter) * -1); }
    .ct-workspace__figure figcaption { width: auto; padding: 1.25rem var(--gutter) 0; }
    .ct-signature { font-size: clamp(3rem, 16vw, 4.3rem); }
  }
</style>
