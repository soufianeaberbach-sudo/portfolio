---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import BriefForm from '../components/BriefForm.astro';
import References from '../components/References.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<SiteLayout
  title="Contact — Soufiane Aberbach"
  description="Start a fashion development brief with Soufiane Aberbach in Tangier."
  marker="SA-CONTACT-V6"
  page="contact"
>
  <!-- BUILD-MARKER: SA-CONTACT-V6 -->
  <section class="contact-hero">
    <div class="contact-hero__copy" data-reveal>
      <p class="eyebrow">Contact / 05</p>
      <h1 class="display">Start with<br /><span>what you have.</span></h1>
    </div>
    <aside data-reveal>
      <p>A sketch, a reference, an existing sample, a fit issue or a production question is enough to begin.</p>
      <p class="contact-availability label">Available for selected freelance development work</p>
    </aside>
  </section>

  <section class="brief-section" id="brief" aria-labelledby="brief-title">
    <div class="brief-section__head section-shell" data-reveal>
      <div>
        <p class="eyebrow">02 / Development brief</p>
        <h2 class="display" id="brief-title">The first step<br />of the process.</h2>
      </div>
      <p>Share the point where the product is now and the problem that needs resolving. The brief is read personally and assessed against real production constraints.</p>
    </div>

    <div class="brief-section__grid section-shell">
      <div data-reveal><BriefForm /></div>
      <div data-reveal><References /></div>
    </div>
  </section>

  <section class="contact-workspace" aria-labelledby="workspace-title">
    <div class="contact-workspace__grid section-shell">
      <div class="contact-workspace__note" data-reveal>
        <p class="eyebrow">03 / Workspace</p>
        <h2 class="display" id="workspace-title">Where the brief<br />becomes a route.</h2>
        <p>Pattern, fit and technical decisions are developed here before they move to production.</p>
      </div>
      <figure data-reveal>
        <img
          src="/contact-figure-1400.webp"
          srcset="/contact-figure-800.webp 800w, /contact-figure-1400.webp 1400w"
          sizes="(max-width: 900px) 100vw, 62vw"
          width="1510"
          height="980"
          alt="Soufiane Aberbach at his desk beside a monitor displaying his current portfolio website"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="label">Freelance workspace / Tangier</figcaption>
      </figure>
    </div>
  </section>

  <section class="contact-routes" aria-labelledby="routes-title">
    <div class="contact-routes__head section-shell" data-reveal>
      <p class="eyebrow">04 / Direct routes + business status</p>
      <h2 class="display" id="routes-title">A credible route<br />to production.</h2>
    </div>

    <div class="contact-routes__grid section-shell">
      <article class="business-status" data-reveal>
        <p class="label">Business status</p>
        <h3>Registered Moroccan Auto-Entrepreneur</h3>
        <p>Since 2018 · B2B invoicing available</p>
        <p>Tangier, Morocco · GMT+1</p>
      </article>

      <div class="direct-routes" data-reveal>
        <div>
          <p class="label">Direct email</p>
          <a href="mailto:soufiane.aberbach@gmail.com">soufiane.aberbach@gmail.com <span><Arrow /></span></a>
        </div>
        <div>
          <p class="label">Professional platforms</p>
          <SocialLinks />
        </div>
        <p>The development brief is the primary route. Direct email and existing professional profiles remain available when they fit the conversation better.</p>
      </div>
    </div>
  </section>

  <section class="contact-faq section-shell" aria-labelledby="faq-title">
    <div data-reveal>
      <p class="eyebrow">05 / Before you send</p>
      <h2 class="display" id="faq-title">Useful answers.</h2>
    </div>
    <div class="faq-list" data-reveal>
      <details>
        <summary>Do I need a finished design?</summary>
        <p>No. A sketch, reference, existing sample or written description is enough to begin identifying the next useful step.</p>
      </details>
      <details>
        <summary>Can I contact you with an existing fit or development problem?</summary>
        <p>Yes. Describe what is not working and share a private link to the relevant pattern, sample or fit references if available.</p>
      </details>
      <details>
        <summary>Do you work remotely and internationally?</summary>
        <p>Yes. Work is coordinated remotely from Tangier, Morocco, with professional communication across international production and development teams.</p>
      </details>
      <details>
        <summary>How do I share files?</summary>
        <p>Paste a Drive, Dropbox, WeTransfer or web-reference link in the brief. Check the link’s own sharing permissions before sending it.</p>
      </details>
      <details>
        <summary>How is project material handled?</summary>
        <p>The submitted brief is stored for project follow-up and sent through the site’s email infrastructure. It is not published as portfolio material.</p>
      </details>
    </div>
  </section>
</SiteLayout>

<style>
  .contact-hero {
    min-height: min(68svh, 42rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .65fr);
    gap: 8vw;
    align-items: end;
    padding: calc(var(--header-h) + clamp(3rem, 7vw, 7rem)) var(--gutter) clamp(3rem, 5vw, 5rem);
    background: var(--ink);
    color: var(--paper);
  }
  .contact-hero h1 { margin-top: 1.5rem; font-size: clamp(5rem, 10.5vw, 11rem); }
  .contact-hero h1 span { color: var(--signal); }
  .contact-hero aside { max-width: 30rem; padding-bottom: .5rem; }
  .contact-hero aside > p:first-child { color: #aaa89f; font-size: 1.05rem; line-height: 1.7; }
  .contact-availability { margin: 1.75rem 0 0; padding-top: 1rem; border-top: 1px solid #4b4a43; color: var(--paper); }

  .brief-section { padding-block: clamp(6rem, 10vw, 10rem); background: var(--paper-bright); }
  .brief-section__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, .45fr); gap: 7vw; align-items: end; margin-bottom: clamp(4rem, 7vw, 7rem); }
  .brief-section__head h2 { margin-top: 1.5rem; font-size: clamp(4rem, 7.5vw, 8rem); }
  .brief-section__head > p { max-width: 31rem; margin: 0 0 .5rem; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .brief-section__grid { display: grid; grid-template-columns: minmax(0, 1.22fr) minmax(20rem, .78fr); gap: clamp(3rem, 7vw, 8rem); align-items: start; }
  .brief-section__grid > div { min-width: 0; }

  .contact-workspace { padding-block: clamp(6rem, 10vw, 10rem); background: var(--paper); }
  .contact-workspace__grid { display: grid; grid-template-columns: minmax(18rem, .55fr) minmax(0, 1.45fr); gap: clamp(3rem, 7vw, 8rem); align-items: center; }
  .contact-workspace__note { position: relative; z-index: 2; }
  .contact-workspace__note h2 { margin: 1.5rem 0 2rem; font-size: clamp(3.5rem, 6vw, 6.5rem); }
  .contact-workspace__note > p:last-child { max-width: 27rem; color: var(--muted); line-height: 1.7; }
  .contact-workspace figure { position: relative; margin: 0; }
  .contact-workspace figure::before { content: ''; position: absolute; z-index: 0; inset: 10% 4% 0 12%; border-top: 1px solid var(--line-strong); }
  .contact-workspace img { position: relative; z-index: 1; display: block; width: 100%; height: auto; }
  .contact-workspace figcaption { margin-top: .75rem; color: var(--muted); text-align: right; }

  .contact-routes { padding-block: clamp(6rem, 10vw, 10rem); background: var(--ink); color: var(--paper); }
  .contact-routes__head { margin-bottom: clamp(3rem, 6vw, 6rem); }
  .contact-routes__head h2 { margin-top: 1.5rem; font-size: clamp(4rem, 7.5vw, 8rem); }
  .contact-routes__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-top: 1px solid #4b4a43; border-bottom: 1px solid #4b4a43; }
  .business-status, .direct-routes { padding: clamp(2rem, 5vw, 5rem) 0; }
  .business-status { padding-right: clamp(2rem, 5vw, 5rem); border-right: 1px solid #4b4a43; }
  .business-status .label, .direct-routes .label { color: var(--signal); }
  .business-status h3 { max-width: 16ch; margin: 2rem 0 1.25rem; font-family: var(--display); font-size: clamp(2.5rem, 4.5vw, 5rem); letter-spacing: -.055em; line-height: .95; }
  .business-status p:not(.label) { margin: .45rem 0 0; color: #c7c5bb; }
  .direct-routes { display: grid; align-content: start; gap: 2.5rem; padding-left: clamp(2rem, 5vw, 5rem); }
  .direct-routes > div { padding-bottom: 2rem; border-bottom: 1px solid #4b4a43; }
  .direct-routes a { display: inline-flex; min-height: 2.75rem; align-items: center; gap: .45rem; margin-top: .9rem; font-family: var(--display); font-size: clamp(1.15rem, 2.2vw, 2.2rem); font-weight: 700; letter-spacing: -.04em; }
  .direct-routes a span { color: var(--signal); font-size: .75em; }
  .direct-routes > p { max-width: 34rem; margin: 0; color: #aaa89f; font-size: .9rem; line-height: 1.7; }

  .contact-faq { display: grid; grid-template-columns: minmax(18rem, .7fr) minmax(0, 1.3fr); gap: 8vw; padding-block: clamp(7rem, 12vw, 12rem); }
  .contact-faq h2 { margin-top: 2rem; font-size: clamp(4rem, 7vw, 7rem); }
  .faq-list { border-top: 1px solid var(--line-strong); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; min-height: 3.5rem; justify-content: space-between; gap: 2rem; align-items: center; padding: 1.25rem 0; cursor: pointer; font-family: var(--display); font-size: clamp(1.2rem, 2vw, 1.7rem); font-weight: 650; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { content: '+'; flex: 0 0 auto; color: var(--signal); }
  .faq-list details[open] summary::after { content: '−'; }
  .faq-list details p { max-width: 42rem; margin: 0; padding: 0 0 1.5rem; color: var(--muted); line-height: 1.7; }

  @media (max-width: 1024px) {
    .brief-section__grid { grid-template-columns: minmax(0, 1fr); }
    .contact-workspace__grid { grid-template-columns: minmax(16rem, .65fr) minmax(0, 1.35fr); }
  }
  @media (max-width: 800px) {
    .contact-hero, .brief-section__head, .contact-workspace__grid, .contact-faq { grid-template-columns: minmax(0, 1fr); }
    .contact-hero { gap: 2.5rem; }
    .contact-hero aside { max-width: 38rem; }
    .contact-workspace figure { width: calc(100% + (var(--gutter) * 2)); margin-inline: calc(var(--gutter) * -1); }
    .contact-workspace figcaption { padding-inline: var(--gutter); }
    .contact-routes__grid { grid-template-columns: minmax(0, 1fr); }
    .business-status { padding-right: 0; border-right: 0; border-bottom: 1px solid #4b4a43; }
    .direct-routes { padding-left: 0; }
  }
  @media (max-width: 480px) {
    .contact-hero { min-height: min(68svh, 36rem); padding-top: calc(var(--header-h) + 3.5rem); }
    .contact-hero h1 { font-size: clamp(3.65rem, 16vw, 5.1rem); }
    .brief-section__head h2, .contact-routes__head h2 { font-size: clamp(3.5rem, 15vw, 5rem); }
    .contact-workspace__note h2 { font-size: clamp(3.25rem, 14vw, 4.5rem); }
  }
</style>
