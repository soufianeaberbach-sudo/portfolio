@media(min-width:960px){.chero{flex-direction:row;align-items:center;gap:56px}
 .chero-copy{flex:1}.chero-media{flex:0 0 46%}}
.chero h1{font-family:Archivo,sans-serif;font-variation-settings:'wdth' 108;font-weight:800;
 font-size:clamp(42px,11vw,82px);letter-spacing:-.04em;line-height:.92}
.chero h1 em{font-style:normal;color:var(--accent)}
.chero .lead{color:#4E4E48;font-size:17px;line-height:1.62;margin-top:20px;max-width:46ch}
.chero-media img{width:100%;display:block}

.steps{display:grid;grid-template-columns:1fr;gap:1px;background:#2A2A26;margin-top:44px}
@media(min-width:760px){.steps{grid-template-columns:repeat(3,1fr)}}
.steps div{background:var(--ink);padding:26px 22px}
.steps .k{font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.15em;
 text-transform:uppercase;color:var(--accent);display:block;margin-bottom:10px}
.steps h4{font-family:Archivo,sans-serif;font-variation-settings:'wdth' 108;font-weight:700;
 font-size:19px;letter-spacing:-.02em;color:#F2F2EF}
.steps p{color:#9C9C93;font-size:14px;line-height:1.55;margin-top:8px}

.cwrap{max-width:1280px;margin:0 auto;padding:88px var(--pad);display:flex;flex-direction:column;gap:48px}
@media(min-width:960px){.cwrap{flex-direction:row;gap:72px}.cform-wrap{flex:1}.cside{flex:0 0 290px}}
.sendto{display:flex;align-items:center;gap:10px;margin-bottom:28px;padding:13px 15px;
