<div class="faq">
  <div class="eb rv"><span class="mono">Before you write</span></div>
  <h2 class="rv" style="margin-bottom:28px">Quick answers.</h2>
  <details class="rv"><summary>Do I need a finished design?</summary>
    <p>No. A rough sketch, a reference photo of something similar, or even a written description is enough to tell you whether it's producible and roughly what it costs.</p></details>
  <details class="rv"><summary>What if my pattern already exists and the fit is wrong?</summary>
    <p>That's one of the most common briefs. Send the pattern and the fit photos &mdash; diagnosing where the balance went wrong is usually faster than redrafting from scratch.</p></details>
  <details class="rv"><summary>Do you work with small quantities?</summary>
    <p>Yes. The pattern and tech pack work is the same whether the run is 200 pieces or 20,000 &mdash; the difference is which factories are worth approaching.</p></details>
  <details class="rv"><summary>Is my design confidential?</summary>
    <p>Yes. Nothing you send is shared, published or used in this portfolio without your written permission.</p></details>
</div>

<footer><span class="mono">Soufiane Aberbach &middot; Tangier</span><span class="mono">&copy; 2026</span></footer>
<script is:inline>
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('stuck',scrollY>50),{passive:true});
const io=new IntersectionObserver(es=>es.forEach((e,i)=>{
  if(e.isIntersecting){setTimeout(()=>e.target.classList.add('in'),i*85);io.unobserve(e.target)}
}),{threshold:.15});
document.querySelectorAll('.rv').forEach(e=>io.observe(e));
/* shared count-up for any [data-count] number */
const cio=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting)return; cio.unobserve(e.target);
  const el=e.target, raw=el.dataset.count, num=parseFloat(raw), suf=raw.replace(/[\d.,]/g,'');
  const t0=performance.now(), dur=1100;
  (function step(t){
    const p=Math.min(1,(t-t0)/dur), e2=1-Math.pow(1-p,3);
    el.textContent=(num%1?(e2*num).toFixed(1):Math.round(e2*num))+suf;
    if(p<1)requestAnimationFrame(step);
  })(performance.now());
}),{threshold:.5});
document.querySelectorAll('[data-count]').forEach(e=>cio.observe(e));

document.querySelectorAll('.field').forEach(f=>{
  const i=f.querySelector('input,select,textarea');
  i.addEventListener('focus',()=>f.classList.add('on'));
  i.addEventListener('blur',()=>{if(!i.value)f.classList.remove('on')});
});
document.getElementById('cform').addEventListener('submit',e=>{
  e.preventDefault();
  const b=e.target.querySelector('.sendbtn');
  b.textContent='Sent \u2014 thank you'; b.style.background='#141412';
});

</script>
</body>
</html>
