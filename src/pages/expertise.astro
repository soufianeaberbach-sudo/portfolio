---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ServiceEvidence from '../components/ServiceEvidence.astro';

const services = [
  {
    number: '01',
    kind: 'development',
    evidenceTitle: 'Sketch → production geometry',
    title: 'Sketch to production',
    description: 'A sketch, reference or half-finished idea becomes a garment a factory can cut, grade and repeat.',
    outputs: ['Block selection and 2D pattern', 'Full grade to measurement chart', '3D fit and drape resolution', 'Complete tech pack and marker'],
  },
  {
    number: '02',
    kind: 'monitoring',
    evidenceTitle: 'Line audit / checkpoints',
    title: 'Production monitoring',
    description: 'The first cut, first sewn piece and the line are checked so drift is corrected before final inspection.',
    outputs: ['Pre-production sample sign-off', 'First-cut and first-piece checks', 'In-line measurement audits', 'Defect diagnosis and correction'],
  },
  {
    number: '03',
    kind: 'consulting',
    evidenceTitle: 'Manufacturability analysis',
    title: 'Consulting and advice',
    description: 'A practical view of manufacturability, cost pressure, pattern risk and supplier capability before money is committed.',
    outputs: ['Manufacturability review', 'Consumption and costing input', 'Supplier capability assessment', 'Tech pack audit before hand-off'],
  },
  {
    number: '04',
    kind: 'tracking',
    evidenceTitle: 'Approval and delivery trace',
    title: 'Tracking',
    description: 'Cut ticket to shipment visibility, with critical dates flagged while there is still time to act.',
    outputs: ['Milestone visibility', 'Early slippage flags', 'Factory communication', 'Written status updates'],
  },
];
---

<SiteLayout title="Expertise — Soufiane Aberbach" description="Production-led fashion development services: sketch to production, monitoring, consulting and tracking." marker="SA-EXPERTISE-V1" page="expertise">
  <!-- BUILD-MARKER: SA-EXPERTISE-V1 -->
  <section class="page-intro expertise-intro">
    <div data-reveal>
      <p class="eyebrow">Expertise / 01</p>
      <h1 class="display page-intro__title">Four interventions.<br /><em>One</em> production line.</h1>
    </div>
    <aside class="page-intro__aside" data-reveal>
      <p class="label">Scope, not a menu</p>
      <p>Each service is built around a production failure that is easier—and less expensive—to prevent than repair.</p>
    </aside>
  </section>

  <section class="services section-shell" aria-label="Services">
    {services.map((service) => (
      <article class="service" data-reveal>
        <div class="service__number"><span>{service.number}</span><i></i></div>
        <div class="service__copy">
          <h2>{service.title}</h2>
          <p>{service.description}</p>
        </div>
        <ServiceEvidence kind={service.kind} number={service.number} title={service.evidenceTitle} outputs={service.outputs} />
      </article>
    ))}
  </section>

  <section class="boundary">
    <div class="section-shell boundary__grid">
      <div data-reveal>
        <p class="eyebrow">Working boundary</p>
        <h2 class="display">Clarity includes what is <em>not</em> offered.</h2>
      </div>
      <div class="boundary__list" data-reveal>
        <span>Collection design &amp; trend direction</span>
        <span>Fabric sourcing &amp; purchasing</span>
        <span>Branding, print &amp; graphics</span>
        <span>Hand sample sewing</span>
        <p>If the brief needs one of these, that is identified before work begins—not learned on your budget.</p>
      </div>
    </div>
  </section>

  <section class="expertise-cta section-shell">
    <p class="label" data-reveal>Not sure where the problem sits?</p>
    <h2 class="display" data-reveal>Bring the problem.<br />Leave with a production route.</h2>
    <a class="button button--signal" href="/contact/" data-reveal>Discuss a technical problem <span><Arrow /></span></a>
  </section>
</SiteLayout>

<style>
  .expertise-intro { background: var(--paper-bright); }
  .services { padding-block: clamp(4rem, 8vw, 8rem); }
  .service { display: grid; grid-template-columns: .18fr minmax(18rem, .72fr) minmax(30rem, 1.1fr); gap: 4vw; padding: clamp(3.5rem, 6vw, 6rem) 0; border-top: 1px solid var(--line-strong); }
  .service:last-child { border-bottom: 1px solid var(--line-strong); }
  .service__number { display: flex; align-items: flex-start; gap: 1rem; font-family: var(--mono); font-size: .7rem; }
  .service__number i { display: block; width: 3rem; height: 1px; margin-top: .55rem; background: var(--signal); }
  .service h2 { max-width: 44rem; margin: 0; font-family: var(--display); font-size: clamp(2.8rem, 5vw, 5.7rem); font-weight: 800; letter-spacing: -.06em; line-height: .92; }
  .service__copy p { max-width: 39rem; margin: 1.5rem 0 0; color: var(--muted); font-size: 1.02rem; line-height: 1.7; }
  .boundary { padding-block: clamp(7rem, 12vw, 12rem); background: var(--ink); color: var(--paper); }
  .boundary__grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 8vw; }
  .boundary h2 { margin-top: 2rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .boundary h2 em { color: var(--signal); font-style: normal; }
  .boundary__list { align-self: end; }
  .boundary__list span { position: relative; display: block; padding: 1.1rem 0 1.1rem 1.4rem; border-bottom: 1px solid #3f3f39; font-family: var(--display); font-size: clamp(1.2rem, 2vw, 1.8rem); }
  .boundary__list span::before { content: ''; position: absolute; left: 0; top: 50%; width: .65rem; height: 1px; background: var(--signal); }
  .boundary__list p { margin: 2rem 0 0; color: #aaa89f; line-height: 1.7; }
  .expertise-cta { padding-block: clamp(7rem, 12vw, 12rem); }
  .expertise-cta h2 { margin: 2rem 0 3rem; font-size: clamp(4rem, 9vw, 9.5rem); }
  @media (max-width: 1100px) { .service { grid-template-columns: 4rem minmax(0, 1fr); } .service > :global(.technical-proof) { grid-column: 2; } .boundary__grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .service { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 2.5rem 0; } .service > :global(.technical-proof) { grid-column: 1; } .service h2 { font-size: 2.7rem; } }
</style>
