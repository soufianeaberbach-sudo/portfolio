---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import ExpertiseVisual from '../components/ExpertiseVisual.astro';

/* Expertise answers "does he understand the problems between my idea and
   production?" — so it reads DEPTH, not time. Process owns the sequence of
   decisions; Portfolio owns the evidence. Nothing here repeats either.
   Each of the four systems gets its own photograph and its own kind of
   supporting structure, so they read as one system seen four ways rather than
   four copies of a template. All technical vocabulary is typographic: nothing
   is drawn on the photographs. */
const systems = [
  { n: '01', slug: 'design-intent', name: 'Design intent' },
  { n: '02', slug: 'fit-system', name: 'Fit system' },
  { n: '03', slug: 'technical-translation', name: 'Technical translation' },
  { n: '04', slug: 'production-control', name: 'Production control' },
];
---

<SiteLayout
  title="Expertise — Soufiane Aberbach"
  description="One garment, read four ways: design intent, fit system, technical translation and production control — the four systems that have to agree before a visual idea survives production."
  marker="SA-EXPERTISE-V3"
  page="expertise"
  footerCallout={false}
>
  <!-- BUILD-MARKER: SA-EXPERTISE-V3 -->

  <section class="ex-hero" aria-labelledby="ex-hero-title">
    <div class="ex-hero__grid section-shell">
      <p class="eyebrow" data-reveal>Expertise / 01</p>
      <h1 class="display ex-hero__title" id="ex-hero-title" data-reveal>
        One garment.<br />Four systems<br />have to <em>agree</em>.
      </h1>
      <p class="ex-hero__thought" data-reveal>
        Design intent, fit, technical information and production reality must
        describe the same product. When one drifts, the product drifts with it.
      </p>
    </div>
    <nav class="ex-index section-shell" aria-label="The four systems">
      {systems.map((s) => (
        <a href={`#${s.slug}`}><span>{s.n}</span>{s.name}</a>
      ))}
    </nav>
  </section>

  <div class="ex-stack section-shell">
    <div class="ex-stack__rail" aria-hidden="true">
      <ExpertiseVisual mode="stage" />
    </div>

    <div class="ex-stack__chapters">
      <!-- 01 — editorial and open. No measurement vocabulary here: this layer
           establishes the designer, not the technician. -->
      <article class="ch ch--intent" id="design-intent" data-stage-index="01">
        <p class="label ch__tag" data-reveal>01 / Design intent</p>
        <h2 class="display ch__q" data-reveal>Will it still look like the idea?</h2>
        <p class="ch__meaning" data-reveal>
          Silhouette, proportion, volume and material behaviour must be defined
          clearly enough that engineering supports the idea instead of quietly
          reshaping it.
        </p>
        <div class="ch__visual" data-reveal><ExpertiseVisual stage={1} /></div>
        <ul class="ch__terms" data-reveal>
          <li>Silhouette</li>
          <li>Proportion</li>
          <li>Volume</li>
          <li>Material behaviour</li>
        </ul>
        <p class="ch__editorial" data-reveal>
          The technical solution should serve the design — not replace it.
        </p>
      </article>

      <!-- 02 — a structured definition grid. The fitting photograph already
           says BODY and FIT; the vocabulary carries the engineering. -->
      <article class="ch" id="fit-system" data-stage-index="02">
        <p class="label ch__tag" data-reveal>02 / Fit system</p>
        <h2 class="display ch__q" data-reveal>Will it work on the body — and across sizes?</h2>
        <p class="ch__meaning" data-reveal>
          Balance, ease, grading and tolerance work as one system so fit remains
          coherent beyond the base size.
        </p>
        <div class="ch__visual" data-reveal><ExpertiseVisual stage={2} /></div>
        <dl class="ch__geometry" data-reveal>
          <div><dt>Block architecture</dt><dd>how the shape is generated from a controlled base</dd></div>
          <div><dt>Balance</dt><dd>how front and back hang and align</dd></div>
          <div><dt>Ease</dt><dd>the allowance required for fit and movement</dd></div>
          <div><dt>POM relationships</dt><dd>linked measurements that preserve proportion</dd></div>
          <div><dt>Grade rules</dt><dd>how geometry evolves through the size range</dd></div>
          <div><dt>Tolerance</dt><dd>acceptable production variation</dd></div>
        </dl>
      </article>

      <!-- 03 — controlled specification rows: what each document defines,
           stated without promising a saving it cannot guarantee. -->
      <article class="ch" id="technical-translation" data-stage-index="03">
        <p class="label ch__tag" data-reveal>03 / Technical translation</p>
        <h2 class="display ch__q" data-reveal>Will the factory understand the same garment?</h2>
        <p class="ch__meaning" data-reveal>
          Pattern geometry, measurements, construction information and digital
          validation remove interpretation before hand-off.
        </p>
        <div class="ch__visual" data-reveal><ExpertiseVisual stage={3} /></div>
        <ul class="ch__spec" data-reveal>
          <li><b>Production pattern</b><span>defines cut-ready geometry and construction intent</span></li>
          <li><b>Construction specification</b><span>defines seams, operations and critical details</span></li>
          <li><b>Measurements &amp; tolerances</b><span>define acceptance criteria across the size range</span></li>
          <li><b>3D validation</b><span>supports fit, proportion and drape decisions before and alongside physical sampling</span></li>
        </ul>
      </article>

      <!-- 04 — a three-stage logic, not a monitoring readout. -->
      <article class="ch" id="production-control" data-stage-index="04">
        <p class="label ch__tag" data-reveal>04 / Production control</p>
        <h2 class="display ch__q" data-reveal>Will it stay correct when repetition begins?</h2>
        <p class="ch__meaning" data-reveal>
          Manufacturability, first-piece verification and in-line control protect
          the approved product as production begins to repeat it.
        </p>
        <div class="ch__visual" data-reveal><ExpertiseVisual stage={4} /></div>
        <ol class="ch__states" data-reveal>
          <li><b>Reference</b><span>the approved product standard</span></li>
          <li><b>Deviation</b><span>production moving away from the approved reference</span></li>
          <li><b>Correction</b><span>the cause resolved before deviation multiplies through bulk</span></li>
        </ol>
        <p class="ch__risk" data-reveal>
          A good sample is not proof of a good production system. The real test is
          whether the approved product can be repeated consistently.
        </p>
      </article>
    </div>
  </div>

  <section class="ex-bridge" aria-labelledby="ex-bridge-title">
    <div class="section-shell ex-bridge__grid">
      <p class="eyebrow" data-reveal>Next / Evidence</p>
      <h2 class="display ex-bridge__title" id="ex-bridge-title" data-reveal>
        Control is a claim<br />until the work <em>proves</em> it.
      </h2>
      <p class="ex-bridge__line" data-reveal>
        The portfolio is where the thinking becomes evidence in real work.
      </p>
      <a class="button button--signal ex-bridge__cta" href="/portfolio/" data-reveal>
        See the work <span><Arrow /></span>
      </a>
    </div>
  </section>
</SiteLayout>

<script>
  /* The sticky stage only exists at >=1100px. Whichever chapter is crossing
     the viewport centre selects the lens — the page scrolls normally, nothing
     is hijacked and there are no controls to operate. */
  const stage = document.querySelector<HTMLElement>('.ex-stack__rail .exv');
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-stage-index]'));

  if (stage && chapters.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            stage.dataset.active = entry.target.dataset.stageIndex ?? '01';
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );
    chapters.forEach((chapter) => observer.observe(chapter));
  }
</script>

<style>
  /* ---------- HERO ---------- */
  .ex-hero { background: var(--paper-bright); border-bottom: 1px solid var(--line); }
  .ex-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 24rem);
    align-items: end;
    gap: 1.5rem 6vw;
    padding-top: calc(var(--header-h) + clamp(4rem, 9vw, 8rem));
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
  }
  .ex-hero__grid > .eyebrow { grid-column: 1 / -1; }
  .ex-hero__title { grid-column: 1; font-size: clamp(3.1rem, 8.4vw, 9.5rem); }
  .ex-hero__thought {
    grid-column: 2;
    max-width: 24rem;
    margin: 0 0 .6rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
  }

  /* Orientation, not decoration: four real anchors that state the page's
     structure before anything is scrolled. */
  .ex-index {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .ex-index a {
    display: flex;
    align-items: baseline;
    gap: .8rem;
    padding: 1.15rem 1.25rem 1.15rem 0;
    border-right: 1px solid var(--line);
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    transition: color .25s var(--ease);
  }
  .ex-index a:last-child { border-right: 0; }
  /* Small mono on paper fails 4.5:1 in signal; orange stays on the rules,
     indicators and large accent words. */
  .ex-index a span { color: var(--muted); }
  /* Hover keeps the text in ink and moves the orange to the underline:
     signal is 3.36:1 on paper, fine for a rule but short of the 4.5:1
     small text needs. */
  .ex-index a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* ---------- CONTROL STACK ---------- */
  .ex-stack { padding-block: clamp(4rem, 7vw, 7rem); }
  .ex-stack__rail { display: none; }

  .ch { padding-block: clamp(3.5rem, 6vw, 6rem); border-top: 1px solid var(--line); }
  .ch:first-child { border-top: 0; padding-top: 0; }
  .ch__tag { color: var(--muted); }
  .ch__q { max-width: 30ch; margin: 1.5rem 0 0; font-size: clamp(2.3rem, 5.4vw, 4.6rem); }
  .ch__meaning { max-width: 42rem; margin: 1.5rem 0 0; color: var(--ink-soft); font-size: clamp(1rem, 1.15vw, 1.12rem); line-height: 1.7; }
  .ch__visual { margin-top: clamp(2rem, 3.5vw, 3rem); }

  /* Each layer's supporting detail has its own shape and rhythm — an open term
     row and a single editorial line, a definition grid, specification rows, a
     three-stage logic. None of it is drawn on the photographs. */

  /* 01 — the design vocabulary, set as an open row rather than a data table. */
  .ch__terms {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem clamp(1.5rem, 3vw, 3rem);
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .ch__terms li { position: relative; padding-left: 1.15rem; }
  .ch__terms li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .45em;
    width: .55rem;
    height: 1px;
    background: var(--signal);
  }

  .ch__editorial {
    max-width: 34rem;
    margin: clamp(2rem, 3.5vw, 3rem) 0 0;
    color: var(--ink-soft);
    font-family: var(--display);
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 650;
    letter-spacing: -.02em;
    line-height: 1.3;
  }

  .ch__geometry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 3vw, 3rem);
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
  }
  .ch__geometry > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding: .8rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ch__geometry dt { font-family: var(--mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; }
  .ch__geometry dd { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.45; }

  .ch__spec, .ch__states { margin: clamp(1.75rem, 3vw, 2.5rem) 0 0; padding: 0; list-style: none; }
  .ch__spec { border-top: 1px solid var(--line-strong); }
  .ch__spec li {
    display: grid;
    grid-template-columns: minmax(10rem, .8fr) minmax(0, 1.2fr);
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ch__spec b { font-family: var(--display); font-size: clamp(1.05rem, 1.5vw, 1.35rem); font-weight: 700; letter-spacing: -.02em; }
  .ch__spec span { color: var(--muted); font-size: .9rem; line-height: 1.55; }

  .ch__states { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
  .ch__states li { padding: 1.1rem 1.5rem 1.1rem 0; border-top: 1px solid var(--ink); }
  .ch__states li:nth-child(2) { border-top-color: var(--signal); }
  .ch__states li:nth-child(3) { border-top-color: var(--signal); padding-right: 0; }
  .ch__states b { display: block; font-family: var(--mono); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
  .ch__states span { display: block; margin-top: .7rem; color: var(--muted); font-size: .88rem; line-height: 1.5; }
  .ch__risk { max-width: 36rem; margin: clamp(1.5rem, 2.5vw, 2.25rem) 0 0; color: var(--ink-soft); font-size: .98rem; line-height: 1.7; }

  /* ---------- BRIDGE ---------- */
  .ex-bridge { background: var(--ink); color: var(--paper); }
  .ex-bridge__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem);
    align-items: end;
    gap: 1.5rem 6vw;
    padding-block: clamp(6rem, 11vw, 11rem);
  }
  .ex-bridge__grid > .eyebrow { grid-column: 1 / -1; color: var(--paper); }
  .ex-bridge__title { grid-column: 1; margin-top: 1.5rem; font-size: clamp(2.6rem, 6.8vw, 7.5rem); }
  .ex-bridge__line { grid-column: 2; max-width: 26rem; margin: 0 0 .5rem; color: #aaa89f; line-height: 1.75; }
  .ex-bridge__cta { grid-column: 1; justify-self: start; margin-top: clamp(2rem, 4vw, 3.5rem); }

  /* ---------- DESKTOP: sticky analytical stage ---------- */
  /* Only above 1100px, and only with JS + motion allowed. Everywhere else each
     chapter carries its own image inline, so all four systems stay reachable
     without an observer or a transition. */
  @media (min-width: 1100px) {
    :global(html.js) .ex-stack {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(26rem, .92fr);
      gap: 5vw;
      align-items: start;
    }
    :global(html.js) .ex-stack__rail {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      order: 2;
    }
    :global(html.js) .ex-stack__chapters { order: 1; min-width: 0; }
    :global(html.js) .ch__visual { display: none; }
    :global(html.js) .ch { min-height: 58vh; display: flex; flex-direction: column; justify-content: center; }
    :global(html.js) .ch:first-child { padding-top: clamp(3.5rem, 6vw, 6rem); border-top: 1px solid var(--line); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ex-stack { display: block; }
    :global(html.js) .ex-stack__rail { display: none; }
    :global(html.js) .ch__visual { display: block; }
    :global(html.js) .ch { min-height: 0; display: block; }
    :global(html.js) .ch:first-child { padding-top: 0; border-top: 0; }
    .ex-index a, .ex-index a:hover { transition: none; }
  }

  /* ---------- TABLET / MOBILE: composed inline, never a squeezed desktop ---------- */
  @media (max-width: 1099px) {
    .ex-hero__grid { grid-template-columns: minmax(0, 1fr); }
    .ex-hero__title, .ex-hero__thought { grid-column: 1; }
    .ex-hero__thought { margin-top: 1.75rem; }
    .ex-bridge__grid { grid-template-columns: minmax(0, 1fr); }
    .ex-bridge__title, .ex-bridge__line, .ex-bridge__cta { grid-column: 1; }
    .ex-bridge__line { margin-top: 1.5rem; }
  }

  @media (max-width: 860px) {
    .ex-index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ex-index a:nth-child(2) { border-right: 0; }
    .ex-index a:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
    .ch__spec li { grid-template-columns: minmax(0, 1fr); gap: .4rem; }
    .ch__states { grid-template-columns: minmax(0, 1fr); }
    .ch__states li { padding-right: 0; }
  }

  @media (max-width: 600px) {
    .ex-hero__grid { padding-top: calc(var(--header-h) + 3.5rem); }
    .ex-index { grid-template-columns: minmax(0, 1fr); }
    .ex-index a { border-right: 0; border-bottom: 1px solid var(--line); }
    .ex-index a:last-child { border-bottom: 0; }
    .ch__geometry { grid-template-columns: minmax(0, 1fr); }
    .ch__geometry > div { grid-template-columns: minmax(0, 1fr); gap: .3rem; }
  }
</style>
