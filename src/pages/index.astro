---
import SiteLayout from '../layouts/SiteLayout.astro';

const stages = [
  ['01', 'Sketch', 'The idea is tested against fabric, construction and cost before development begins.'],
  ['02', '2D Pattern', 'Geometry is drafted to the block, tolerances and seam logic the factory will use.'],
  ['03', 'Gradation', 'The full size run is engineered and checked against the measurement chart.'],
  ['04', '3D Simulation', 'Fit, balance and drape are resolved before sampling starts spending time.'],
  ['05', 'Final Garment', 'The factory receives a clear, repeatable production specification.'],
];

const brandLogos = [
  { src: '/LOGO/ZARA.png', alt: 'Zara' },
  { src: '/LOGO/Bershka.png', alt: 'Bershka' },
  { src: '/LOGO/OYSHO.png', alt: 'Oysho' },
  { src: '/LOGO/Massimo Dutti.png', alt: 'Massimo Dutti' },
  { src: '/LOGO/Mango.png', alt: 'Mango' },
  { src: '/LOGO/ASOS.png', alt: 'ASOS' },
  { src: '/LOGO/Adidas.png', alt: 'Adidas' },
  { src: '/LOGO/RI.png', alt: 'River Island' },
  { src: '/LOGO/PLT.png', alt: 'PrettyLittleThing' },
  { src: '/LOGO/MISSGUIDED.png', alt: 'Missguided' },
  { src: '/LOGO/ITS.png', alt: 'In The Style' },
  { src: '/LOGO/FN.png', alt: 'Fashion Nova' },
  { src: '/LOGO/ROMAN.png', alt: 'Roman' },
  { src: '/LOGO/Boohoo.png', alt: 'Boohoo' },
  { src: '/LOGO/ISIF.jpg', alt: 'I Saw It First' },
  { src: '/LOGO/LM.png', alt: 'Little Mistress London' },
];
---

<SiteLayout
  title="Soufiane Aberbach — Fashion Designer & Product Developer"
  description="Senior fashion designer and product developer in Tangier, focused on production-ready pattern, fit and technical development."
  marker="SA-HOME-V5"
  page="home"
>
  <!-- BUILD-MARKER: SA-HOME-V5 -->
  <section class="home-hero">
    <div class="home-hero__copy" data-reveal>
      <p class="label home-hero__hello">Hello, my name is</p>
      <div class="home-hero__title">
        <h1 class="display"><span>Soufiane</span><span>Aberbach</span></h1>
      </div>
      <p class="home-hero__role">
        <span>And I’m a</span>
        <span class="home-hero__role-window" aria-hidden="true"><strong data-role-word></strong></span>
        <span class="sr-only">Fashion Designer, Product Developer, Pattern Maker, Grading Specialist, 3D Simulation Developer, Tech Pack Author, and Production Follower.</span>
      </p>
      <a class="button button--signal" href="/contact/">Send me your sketch <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="home-hero__portrait" data-reveal>
      <img src="/soufiane-drawing.png" width="680" height="846" alt="Soufiane Aberbach seated and drawing on a tablet" fetchpriority="high" />
    </figure>
  </section>

  <section class="positioning section-shell">
    <div class="positioning__lead" data-reveal>
      <p class="eyebrow">Positioning</p>
      <h2 class="display">The expensive mistake happens <em>before</em> the sewing line.</h2>
    </div>
    <div class="positioning__copy" data-reveal>
      <p>Every extra fitting round, every point of fabric waste and every delayed sample traces back to a decision made before a single metre was cut.</p>
      <p>That decision is the work: defining the pattern, validating fit and translating intent into instructions a factory can repeat.</p>
      <a href="/expertise/" class="text-link">View expertise <span>↗</span></a>
    </div>
  </section>

  <section class="home-process section-shell section-rule">
    <div class="home-process__head" data-reveal>
      <p class="eyebrow">The production sequence</p>
      <h2 class="display">Five stages.<br />No blind spots.</h2>
      <a class="button" href="/process/">Explore the process <span>↗</span></a>
    </div>
    <ol class="home-process__list">
      {stages.map(([index, title, text]) => (
        <li data-reveal>
          <span class="index-tag">{index}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="brand-context">
    <div class="section-shell">
      <div class="brand-context__head" data-reveal>
        <p class="eyebrow">Programme exposure</p>
        <p class="label">16 brand programmes / manufacturing development</p>
      </div>
      <ul class="brand-context__logos" aria-label="Brand programme exposure">
        {brandLogos.map((logo) => (
          <li>
            <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
      <p class="brand-context__note">Project exposure through manufacturing contracts at Ava Marie — not direct employment or endorsement.</p>
    </div>
  </section>

  <section class="home-next section-shell" aria-labelledby="simulation-title">
    <div class="home-next__intro" data-reveal>
      <p class="label">CLO3D simulation / selected work</p>
      <h2 class="display" id="simulation-title">See it move.<br />Before you make it.</h2>
      <p class="home-next__lede">CLO3D turns pattern, proportion and fabric behaviour into a moving prototype—so silhouette and fit decisions happen before the first physical sample.</p>
    </div>
    <a href="/portfolio/" class="home-next__media" data-reveal aria-label="View the portfolio and CLO3D simulation work">
      <video src="/CLO3D.mp4" autoplay muted loop playsinline preload="auto" aria-label="Female and male digital fashion models presented in CLO3D"></video>
      <span class="home-next__media-meta label">Digital garment study <b>00:16</b></span>
      <i class="home-next__media-arrow" aria-hidden="true">↗</i>
    </a>
    <a href="/portfolio/" class="home-next__link" data-reveal>
      <span>Explore the complete portfolio</span><i aria-hidden="true">↗</i>
    </a>
  </section>
</SiteLayout>

<script>
  const roles = [
    'Fashion Designer',
    'Product Developer',
    'Pattern Maker',
    'Grading Specialist',
    '3D Simulation Developer',
    'Tech Pack Author',
    'Production Follower',
  ];

  const roleWord = document.querySelector('[data-role-word]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (roleWord && reduceMotion) {
    roleWord.textContent = roles[0];
  } else if (roleWord) {
    let roleIndex = 0;
    let characterIndex = 0;
    let deleting = false;

    const typeRole = () => {
      const role = roles[roleIndex];

      if (deleting) {
        characterIndex -= 1;
      } else {
        characterIndex += 1;
      }

      roleWord.textContent = role.slice(0, characterIndex);
      let delay = deleting ? 58 : 92;

      if (!deleting && characterIndex === role.length) {
        deleting = true;
        delay = 1750;
      } else if (deleting && characterIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        delay = 360;
      }

      window.setTimeout(typeRole, delay);
    };

    window.setTimeout(typeRole, 520);
  }

  const simulationVideo = document.querySelector('.home-next__media video');
  if (simulationVideo instanceof HTMLVideoElement) {
    if (reduceMotion) {
      simulationVideo.pause();
    } else if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          simulationVideo.play().catch(() => {});
        } else {
          simulationVideo.pause();
        }
      }, { threshold: .28 });
      videoObserver.observe(simulationVideo);
    }
  }
</script>

<style>
  .home-hero {
    min-height: 100svh;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(28rem, .95fr);
    gap: clamp(1.5rem, 2.5vw, 3rem);
    align-items: stretch;
    padding: calc(var(--header-h) + .75rem) var(--gutter) 0;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, transparent 0 68%, var(--line) 68% calc(68% + 1px), transparent calc(68% + 1px)),
      var(--paper);
  }
  .home-hero::before {
    content: '';
    position: absolute;
    right: -14vw;
    bottom: -31vw;
    width: min(64vw, 62rem);
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: inset 0 0 0 5vw var(--paper), inset 0 0 0 calc(5vw + 1px) var(--line);
    pointer-events: none;
  }
  .home-hero__copy {
    position: relative;
    z-index: 2;
    align-self: start;
    min-width: 0;
    padding: clamp(3rem, 6vh, 4.5rem) 0 3rem;
  }
  .home-hero__hello { margin: 0 0 clamp(1.25rem, 2.2vw, 2rem); color: var(--muted); }
  .home-hero__title { position: relative; z-index: 1; }
  .home-hero__title h1 { font-size: clamp(4.75rem, 9.3vw, 9rem); }
  .home-hero__title h1 span { display: block; }
  .home-hero__title h1 span:last-child { color: transparent; -webkit-text-stroke: 1.5px var(--ink); }
  .home-hero__role {
    display: flex;
    align-items: baseline;
    gap: .42em;
    min-height: 1.35em;
    margin: clamp(1.5rem, 2.6vw, 2.25rem) 0 0;
    font-family: var(--display);
    font-variation-settings: 'wdth' 108;
    font-size: clamp(1.45rem, 2.3vw, 2.25rem);
    font-weight: 650;
    letter-spacing: -.03em;
    line-height: 1.2;
  }
  .home-hero__role-window { display: inline-flex; align-items: center; min-width: 24ch; overflow: hidden; color: var(--signal); }
  .home-hero__role-window strong {
    display: inline-block;
    font: inherit;
  }
  .home-hero__role-window::after {
    content: '';
    width: 2px;
    height: .9em;
    margin-left: .16em;
    background: currentColor;
    animation: role-caret .9s steps(1, end) infinite;
  }
  @keyframes role-caret { 50% { opacity: 0; } }
  .home-hero__copy > .button { margin-top: clamp(1.75rem, 3vw, 2.75rem); }
  .home-hero__portrait {
    position: relative;
    z-index: 1;
    align-self: end;
    height: calc(100svh - var(--header-h) - .75rem);
    min-height: 36rem;
    margin: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    border-left: 1px solid var(--line);
    background: linear-gradient(90deg, transparent 0 9%, var(--line) 9% calc(9% + 1px), transparent calc(9% + 1px));
  }
  .home-hero__portrait::after {
    content: '';
    position: absolute;
    z-index: 0;
    left: -16%;
    right: -4%;
    bottom: -23%;
    height: 68%;
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: 0 0 0 4.5vw var(--paper), 0 0 0 calc(4.5vw + 1px) var(--line);
  }
  .home-hero__portrait img {
    position: relative;
    z-index: 1;
    width: min(108%, 49rem);
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform: translateX(2%) scale(1.035);
    transform-origin: center bottom;
  }

  .positioning { display: grid; grid-template-columns: 1.4fr .6fr; gap: 7vw; padding-block: clamp(7rem, 14vw, 14rem); }
  .positioning h2 { max-width: 68rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .positioning h2 em { color: var(--signal); font-style: normal; }
  .positioning__copy { align-self: end; max-width: 30rem; }
  .positioning__copy p { color: var(--ink-soft); line-height: 1.75; }
  .text-link { display: inline-flex; gap: 1rem; margin-top: 1.5rem; padding-bottom: .3rem; border-bottom: 1px solid; font-family: var(--mono); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
  .text-link span { color: var(--signal); }

  .home-process { display: grid; grid-template-columns: .7fr 1.3fr; gap: 8vw; padding-block: clamp(6rem, 10vw, 10rem); }
  .home-process__head { position: sticky; top: 8rem; align-self: start; }
  .home-process__head h2 { margin: 2rem 0 3rem; font-size: clamp(4rem, 7vw, 7rem); }
  .home-process__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-strong); }
  .home-process__list li { display: grid; grid-template-columns: 3rem 1fr 1.15fr; gap: 1.5rem; align-items: start; padding: 2rem 0; border-bottom: 1px solid var(--line); }
  .home-process__list h3 { margin: .2rem 0 0; font-family: var(--display); font-size: clamp(1.7rem, 3vw, 3rem); line-height: 1; }
  .home-process__list p { margin: 0; color: var(--muted); line-height: 1.65; }

  .brand-context { padding-block: clamp(4.5rem, 7vw, 7rem); background: var(--ink); color: var(--paper); }
  .brand-context__head { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .brand-context__head > .label { color: #77766f; text-align: right; }
  .brand-context__logos {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 4.5rem) clamp(1.25rem, 2.5vw, 3rem);
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    padding: clamp(2.75rem, 4vw, 4rem) 0;
    border-block: 1px solid #34342f;
    list-style: none;
  }
  .brand-context__logos li {
    min-width: 0;
    min-height: 3.5rem;
    display: grid;
    place-items: center;
  }
  .brand-context__logos img {
    display: block;
    width: 100%;
    max-width: 9.5rem;
    height: 2.65rem;
    object-fit: contain;
    filter: grayscale(1) invert(1);
    mix-blend-mode: screen;
    opacity: .74;
    transition: opacity .25s ease, transform .25s ease;
  }
  .brand-context__logos li:hover img { opacity: 1; transform: translateY(-2px); }
  .brand-context__note { max-width: 45rem; margin: 1.5rem 0 0; color: #77766f; font-size: .72rem; }

  .home-next { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(18rem, .55fr); gap: clamp(3rem, 7vw, 8rem); align-items: center; padding-block: clamp(6rem, 10vw, 10rem); }
  .home-next__intro { align-self: center; }
  .home-next h2 { margin-top: 2rem; font-size: clamp(3.8rem, 6.6vw, 7rem); }
  .home-next__lede { max-width: 32rem; margin: 2rem 0 0; color: var(--muted); line-height: 1.75; }
  .home-next__media { position: relative; width: min(100%, 36rem); aspect-ratio: 9 / 16; justify-self: end; overflow: hidden; background: var(--ink); color: var(--paper); isolation: isolate; }
  .home-next__media::after { content: ''; position: absolute; z-index: 1; inset: 0; background: linear-gradient(180deg, transparent 58%, rgba(0,0,0,.52)); pointer-events: none; }
  .home-next__media video { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .home-next__media:hover video { transform: scale(1.018); }
  .home-next__media-meta { position: absolute; z-index: 2; left: 1.25rem; bottom: 1.25rem; display: flex; gap: 1rem; align-items: center; }
  .home-next__media-meta b { color: var(--signal); font-weight: 500; }
  .home-next__media-arrow { position: absolute; z-index: 2; right: 1.25rem; bottom: 1.25rem; display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid rgba(255,255,255,.55); color: var(--signal); font-size: 1.3rem; font-style: normal; transition: border-color .25s ease, transform .25s ease; }
  .home-next__media:hover .home-next__media-arrow { border-color: var(--signal); transform: translate(.15rem, -.15rem); }
  .home-next__link { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 1.25rem 0; border-block: 1px solid var(--line-strong); font-family: var(--mono); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
  .home-next__link i { display: grid; flex: 0 0 auto; width: 2.75rem; height: 2.75rem; place-items: center; border-left: 1px solid var(--line); color: var(--signal); font-size: 1rem; font-style: normal; transition: transform .25s ease; }
  .home-next__link:hover i { transform: translate(.15rem, -.15rem); }

  @media (max-width: 1100px) and (min-width: 901px) {
    .home-hero { grid-template-columns: minmax(0, 1fr) minmax(25rem, .9fr); gap: 1.5rem; }
    .home-hero__title h1 { font-size: clamp(4.75rem, 8.6vw, 7rem); }
    .home-hero__portrait img { transform: translateX(4%) scale(1.02); }
  }
  @media (max-width: 900px) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(26rem, 1fr);
      gap: 0;
      padding-top: calc(var(--header-h) + 1.5rem);
      background: var(--paper);
    }
    .home-hero__copy { padding: .75rem 0 0; }
    .home-hero__title h1 { font-size: clamp(4rem, 15.5vw, 7.25rem); }
    .home-hero__role { margin-top: 1.35rem; }
    .home-hero__portrait {
      width: min(82%, 38rem);
      height: 50svh;
      min-height: 27rem;
      margin-left: auto;
      border-left: 0;
    }
    .positioning, .home-process, .home-next { grid-template-columns: 1fr; }
    .positioning__copy { max-width: 40rem; }
    .home-process__head { position: static; }
    .brand-context__logos { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .home-hero {
      min-height: 100svh;
      grid-template-rows: auto minmax(21rem, 1fr);
      padding-top: calc(var(--header-h) + 1.25rem);
    }
    .home-hero::before { display: none; }
    .home-hero__copy { padding-top: .5rem; }
    .home-hero__hello { margin-bottom: 1rem; }
    .home-hero__title h1 { font-size: clamp(3.5rem, 15vw, 4.5rem); }
    .home-hero__role { display: block; min-height: 3.2rem; font-size: 1.35rem; }
    .home-hero__role > span:first-child { display: block; }
    .home-hero__role-window { display: inline-flex; margin-top: .1rem; }
    .home-hero__copy > .button {
      min-height: 0;
      margin-top: 1.1rem;
      padding: .72rem 0;
      border: 0;
      border-bottom: 1px solid var(--line-strong);
      background: transparent;
      color: var(--ink);
    }
    .home-hero__copy > .button span { color: var(--signal); }
    .home-hero__copy > .button:hover { background: transparent; color: var(--ink); transform: none; }
    .home-hero__portrait {
      width: calc(100% + var(--gutter));
      height: 45svh;
      min-height: 22rem;
      margin-right: calc(var(--gutter) * -1);
    }
    .home-hero__portrait img { width: 110%; height: 105%; transform: translateX(3%) scale(1.02); }
    .home-process__list li { grid-template-columns: 2.5rem 1fr; }
    .home-process__list p { grid-column: 2; }
    .brand-context__head { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .brand-context__head > .label { text-align: left; }
    .brand-context__logos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.75rem; padding-block: 2.5rem; }
    .brand-context__logos li { min-height: 3.25rem; }
    .brand-context__logos img { max-width: 8.5rem; height: 2.35rem; }
    .home-next { gap: 2.5rem; }
    .home-next__media { width: min(100%, 28rem); aspect-ratio: 9 / 16; justify-self: center; }
    .home-next__lede { margin-top: 1.5rem; }
    .home-next__link { margin-top: -.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .home-hero__role-window::after { animation: none; } }
</style>
