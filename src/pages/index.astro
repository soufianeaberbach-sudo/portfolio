---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const stages = [
  ['01', 'Brief / Intent lock', 'Design intent, missing information and open feasibility questions are settled before anything is cut.'],
  ['02', 'Technical build', 'Pattern architecture, construction logic and initial measurements are built and tested against each other.'],
  ['03', 'Fit / Validation', 'Proportion, balance, drape and construction corrections are worked through and recorded.'],
  ['04', 'Size / Specification lock', 'Grading, points of measure and tolerances are fixed into technical documentation.'],
  ['05', 'Pre-production / Handoff', 'Production works from the approved reference, with verification at first piece and pre-production.'],
];

// 16 logos = a 4 x 4 grid. Each is painted as a CSS mask so the single
// artwork can be recoloured (white by default, --signal on hover) without
// shipping a second copy of every file.
//
// `w` is an optical max-width in rem. The marks range from 2.4:1 (ZARA) to
// 10.5:1 (Little Mistress), so a single shared box would render ZARA roughly
// three times taller than LM. Each `w` is set to the logo's own aspect ratio
// x a common target height, which lands every mark on the same visual weight.
// `mask` is only set where the source file has no usable alpha channel.
//
// `wide` marks the six wordmarks whose aspect ratio (7:1 to 10.6:1) is too
// long to reach the shared optical height inside a half-width column on a
// phone. They take a full-width row in the mobile layout instead; on desktop
// the flag is unused and the grid stays 4 x 4.
const brandLogos = [
  { src: '/LOGO/ZARA.png', alt: 'Zara', w: 6.1, mobileOrder: 1 },
  { src: '/LOGO/Bershka.png', alt: 'Bershka', w: 11.6, mobileOrder: 2 },
  { src: '/LOGO/OYSHO.png', alt: 'Oysho', w: 13.1, mobileOrder: 4 },
  { src: '/LOGO/Massimo Dutti.png', alt: 'Massimo Dutti', w: 18.4, wide: true, mobileOrder: 3 },
  { src: '/LOGO/Mango.png', alt: 'Mango', w: 15.4, mobileOrder: 5 },
  { src: '/LOGO/ASOS.png', alt: 'ASOS', w: 8.8, mobileOrder: 6 },
  { src: '/LOGO/Adidas.png', alt: 'Adidas', w: 11.0, mobileOrder: 7 },
  { src: '/LOGO/RI.png', alt: 'River Island', w: 14.5, mobileOrder: 9 },
  { src: '/LOGO/PLT.png', alt: 'PrettyLittleThing', w: 22.2, mask: '/LOGO/PLT-mask.png', wide: true, mobileOrder: 8 },
  { src: '/LOGO/MISSGUIDED.png', alt: 'Missguided', w: 10.9, mask: '/LOGO/MISSGUIDED-mask.png', mobileOrder: 10 },
  { src: '/LOGO/ITS.png', alt: 'In The Style', w: 19.2, wide: true, mobileOrder: 11 },
  { src: '/LOGO/FN.png', alt: 'Fashion Nova', w: 20.5, wide: true, mobileOrder: 12 },
  { src: '/LOGO/ROMAN.png', alt: 'Roman', w: 13.3, mobileOrder: 13 },
  { src: '/LOGO/Boohoo.png', alt: 'Boohoo', w: 10.9, mobileOrder: 14 },
  { src: '/LOGO/ISIF.jpg', alt: 'I Saw It First', w: 25.6, mask: '/LOGO/ISIF-mask.png', wide: true, mobileOrder: 15 },
  { src: '/LOGO/LM.png', alt: 'Little Mistress London', w: 26.8, wide: true, mobileOrder: 16 },
];
---

<SiteLayout
  title="Soufiane Aberbach — Fashion Designer & Product Developer"
  description="Senior fashion designer and product developer in Tangier, focused on production-ready pattern, fit and technical development."
  marker="SA-HOME-V5"
  page="home"
>
  <!-- BUILD-MARKER: SA-HOME-V5 -->
  <section class="home-hero">
    <div class="home-hero__copy" data-reveal>
      <p class="label home-hero__hello">Hello, my name is</p>
      <div class="home-hero__title">
        <h1 class="display"><span>Soufiane</span><span>Aberbach</span></h1>
      </div>
      <p class="home-hero__role">
        <span>And I’m a</span>
        <span class="home-hero__role-window" aria-hidden="true"><strong data-role-word></strong></span>
        <span class="sr-only">Fashion Designer, Product Developer, Pattern Maker, Grading Specialist, 3D Simulation Developer, Tech Pack Author, and Production Follower.</span>
      </p>
      <a class="button button--signal" href="/contact/">Start a brief <span aria-hidden="true"><Arrow /></span></a>
    </div>
    <figure class="home-hero__portrait" data-reveal>
      {/* WebP renditions generated from the same source with ffmpeg-static, so
          the composition and the cut-out transparency are unchanged. The PNG
          stays in the repo because og:image still points at it. width/height
          carry the renditions' true intrinsic ratio. */}
      <img
        class="home-hero__figure"
        src="/soufiane-drawing-800.webp"
        srcset="/soufiane-drawing-480.webp 480w, /soufiane-drawing-800.webp 800w, /soufiane-drawing-1200.webp 1200w"
        sizes="(max-width: 900px) 82vw, 46vw"
        width="1200"
        height="1486"
        alt="Soufiane Aberbach seated and drawing on a tablet"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </section>

  <section class="positioning section-shell">
    <div class="positioning__lead" data-reveal>
      <p class="eyebrow">Positioning</p>
      <h2 class="display">The expensive mistake happens <em>before</em> the sewing line.</h2>
    </div>
    <div class="positioning__copy" data-reveal>
      <p>Many expensive fitting rounds, fabric losses and sample delays begin with decisions made before the first metre is cut.</p>
      <p>That decision is the work: defining the pattern, validating fit and translating intent into instructions a factory can repeat.</p>
      <a href="/expertise/" class="button">View expertise <span><Arrow /></span></a>
    </div>
  </section>

  <section class="home-stats section-shell section-rule" aria-labelledby="production-record-title">
    <div class="home-stats__head">
      <p class="eyebrow" id="production-record-title" data-reveal>Production record</p>
      <aside class="business-ready" aria-labelledby="business-ready-title" data-reveal>
        <p class="label business-ready__tag" id="business-ready-title">Business ready</p>
        <p class="business-ready__lead">Ready for a direct professional engagement.</p>
        <p class="business-ready__facts">
          <span>Registered Moroccan <strong>Auto-Entrepreneur</strong></span>
          <span>Registered since <strong>2018</strong></span>
          <span><strong>B2B invoicing</strong> available</span>
          <span>Based in <strong>Tangier, Morocco</strong></span>
        </p>
      </aside>
    </div>
    <div class="home-stats__grid">
      <article class="home-stat" data-reveal>
        <strong data-count="12" data-suffix="+" aria-label="12 plus">12+</strong><span>Years in<br />production</span>
      </article>
      <article class="home-stat" data-reveal>
        <strong data-count="9000" data-suffix="+" data-grouped aria-label="9,000 plus">9,000+</strong><span>Garments<br />engineered</span>
      </article>
      <article class="home-stat" data-reveal>
        <strong data-count="16" data-suffix="+" aria-label="16 plus">16+</strong><span>Brand<br />programmes</span>
      </article>
      <article class="home-stat" data-reveal>
        <strong data-count="6">6</strong><span>Career<br />roles</span>
      </article>
      <article class="home-stat" data-reveal>
        <strong data-count="6">6</strong><span>Software<br />systems</span>
      </article>
    </div>
  </section>

  <section class="brand-context">
    <div class="section-shell">
      <div class="brand-context__head" data-reveal>
        <p class="eyebrow">Programme exposure</p>
        <p class="label">16+ brand programmes / manufacturing development</p>
      </div>
      <ul class="brand-context__logos" aria-label="Brand programme exposure">
        {brandLogos.map((logo) => (
          <li data-wide={logo.wide ? '' : undefined} style={`--mobile-order:${logo.mobileOrder}`}>
            <span
              class="brand-logo"
              role="img"
              aria-label={logo.alt}
              style={`--logo:url("${encodeURI(logo.mask ?? logo.src)}");--w:${logo.w}`}
            />
          </li>
        ))}
      </ul>
      <p class="brand-context__note">Programme exposure through manufacturing work across Loratex, Lariconf and Ava Marie — not direct employment or brand endorsement.</p>
    </div>
  </section>

  <section class="home-process section-shell">
    <div class="home-process__head" data-reveal>
      <p class="eyebrow">The development sequence</p>
      <h2 class="display">Five stages.<br />Every stage ends with a decision.</h2>
      <a class="button" href="/process/">Explore the process <span><Arrow /></span></a>
    </div>
    <ol class="home-process__list">
      {stages.map(([index, title, text]) => (
        <li data-reveal>
          <span class="index-tag">{index}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="home-next" aria-labelledby="simulation-title">
    <div class="section-shell home-next__grid">
      <div class="home-next__intro" data-reveal>
        <p class="label">CLO3D simulation / selected work</p>
        <h2 class="display" id="simulation-title"><em>See</em> it move.<br />Before you make it.</h2>
        <p class="home-next__lede">CLO3D turns pattern, proportion and fabric behaviour into a moving prototype—so silhouette, proportion and drape can be explored before and alongside physical sampling.</p>
        <a href="/portfolio/" class="button">View the portfolio <span><Arrow /></span></a>
      </div>
      <div class="home-next__media" data-reveal>
        <video
          class="home-next__video"
          poster="/CLO3D-poster.jpg"
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-label="Female and male digital fashion models walking, presented in CLO3D"
        >
          {/* Attached once by the observer below, so the 3.5 MB file is not
              fetched until the section is near the viewport. */}
          <source data-src="/CLO3D.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const roles = [
    'Fashion Designer',
    'Product Developer',
    'Pattern Maker',
    'Grading Specialist',
    '3D Simulation Developer',
    'Tech Pack Author',
    'Production Follower',
  ];

  const roleWord = document.querySelector('[data-role-word]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (roleWord && reduceMotion) {
    roleWord.textContent = roles[0];
  } else if (roleWord) {
    let roleIndex = 0;
    let characterIndex = 0;
    let deleting = false;

    const typeRole = () => {
      const role = roles[roleIndex];

      if (deleting) {
        characterIndex -= 1;
      } else {
        characterIndex += 1;
      }

      roleWord.textContent = role.slice(0, characterIndex);
      let delay = deleting ? 58 : 92;

      if (!deleting && characterIndex === role.length) {
        deleting = true;
        delay = 1750;
      } else if (deleting && characterIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
        delay = 360;
      }

      window.setTimeout(typeRole, delay);
    };

    window.setTimeout(typeRole, 520);
  }

  /* ------------------------------------------------------------------
     CLO3D simulation video.

     This used to run two IntersectionObservers: a "warm" one that called
     video.load() and a "play" one that called play()/pause() on scroll.
     video.load() re-runs the resource selection algorithm, which resets
     currentTime to 0 — so any time the warm observer fired after playback
     had begun, the video jumped back to the start. That is a premature
     restart caused by our own code, and it is exactly the kind of logic
     the browser already does better.

     Native autoplay + muted + loop + playsinline covers the whole
     requirement, so the element now drives itself. Nothing here ever
     touches currentTime, calls load(), or pauses on scroll.

     Two things still need JavaScript:
       1. prefers-reduced-motion — hold on the poster frame instead of
          looping motion at the user.
       2. autoplay refusal (iOS Low Power Mode, data saver) — retry once
          on the first real interaction rather than leaving a dead frame.
     ------------------------------------------------------------------ */
  const simulationVideo = document.querySelector('.home-next__video');
  if (simulationVideo instanceof HTMLVideoElement) {
    /* One-time source activation. The <source> ships with data-src, so nothing
       downloads until the section is near the viewport; the poster is available
       from the first paint either way. load() is called exactly once, before
       playback has begun, which is the one moment it cannot reset currentTime —
       the bug that used to restart the video mid-scroll. The observer
       disconnects immediately, so scrolling past again changes nothing. */
    /* Under reduced motion the video never plays, so the source is never
       attached and the 3.5 MB file is never fetched. The poster carries the
       section on its own. */
    const deferredSource = reduceMotion ? null : simulationVideo.querySelector('source[data-src]');
    if (deferredSource) {
      const attach = () => {
        deferredSource.src = deferredSource.dataset.src;
        deferredSource.removeAttribute('data-src');
        simulationVideo.load();
        simulationVideo.play().catch(() => {});
      };
      if ('IntersectionObserver' in window) {
        const warm = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          warm.disconnect();
          attach();
        }, { rootMargin: '400px 0px' });
        warm.observe(simulationVideo);
      } else {
        attach();
      }
    }

    if (reduceMotion) {
      simulationVideo.removeAttribute('autoplay');
      simulationVideo.pause();
    } else {
      // Autoplay can still be refused outright (iOS Low Power Mode, data
      // saver). Recover on the first interaction, but only once the frame
      // is actually on screen, so a browser that is deliberately holding
      // playback back until then keeps doing so.
      const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      const recover = () => {
        if (simulationVideo.paused) {
          const box = simulationVideo.getBoundingClientRect();
          if (box.top > window.innerHeight || box.bottom < 0) return;
          simulationVideo.play().catch(() => {});
        }
        events.forEach((name) => window.removeEventListener(name, recover));
      };
      events.forEach((name) => window.addEventListener(name, recover, { passive: true }));
    }
  }

  const metricNumbers = document.querySelectorAll('[data-count]');
  const formatMetric = (value, grouped) => grouped ? Math.round(value).toLocaleString('en-US') : String(Math.round(value));

  const revealMetric = (element) => {
    const target = Number(element.dataset.count || 0);
    const suffix = element.dataset.suffix || '';
    const grouped = element.hasAttribute('data-grouped');
    if (reduceMotion) {
      element.textContent = `${formatMetric(target, grouped)}${suffix}`;
      return;
    }

    const duration = 680;
    const start = performance.now();
    const tick = (now) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      element.textContent = `${formatMetric(target * eased, grouped)}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if ('IntersectionObserver' in window && !reduceMotion) {
    const metricObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        revealMetric(entry.target);
        observer.unobserve(entry.target);
      });
    }, { threshold: .45 });
    metricNumbers.forEach((metric) => metricObserver.observe(metric));
  } else {
    metricNumbers.forEach(revealMetric);
  }
</script>

<style>
  .home-hero {
    min-height: 100svh;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(28rem, .95fr);
    gap: clamp(1.5rem, 2.5vw, 3rem);
    align-items: stretch;
    padding: calc(var(--header-h) + .75rem) var(--gutter) 0;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, transparent 0 68%, var(--line) 68% calc(68% + 1px), transparent calc(68% + 1px)),
      var(--paper);
  }
  .home-hero::before {
    content: '';
    position: absolute;
    right: -14vw;
    bottom: -31vw;
    width: min(64vw, 62rem);
    aspect-ratio: 1;
    border: 1px solid var(--line);
    border-radius: 50%;
    box-shadow: inset 0 0 0 5vw var(--paper), inset 0 0 0 calc(5vw + 1px) var(--line);
    pointer-events: none;
  }
  .home-hero__copy {
    position: relative;
    z-index: 2;
    align-self: start;
    min-width: 0;
    padding: clamp(3rem, 6vh, 4.5rem) 0 3rem;
  }
  .home-hero__hello { margin: 0 0 clamp(1.25rem, 2.2vw, 2rem); color: var(--muted); }
  .home-hero__title { position: relative; z-index: 1; }
  .home-hero__title h1 { font-size: clamp(4.75rem, 9.3vw, 9rem); }
  .home-hero__title h1 span { display: block; }
  .home-hero__title h1 span:last-child { color: transparent; -webkit-text-stroke: 1.5px var(--ink); }
  .home-hero__role {
    display: flex;
    align-items: baseline;
    gap: .42em;
    min-height: 1.35em;
    margin: clamp(1.5rem, 2.6vw, 2.25rem) 0 0;
    font-family: var(--display);
    font-variation-settings: 'wdth' 108;
    font-size: clamp(1.45rem, 2.3vw, 2.25rem);
    font-weight: 650;
    letter-spacing: -.03em;
    line-height: 1.2;
  }
  .home-hero__role-window { display: inline-flex; align-items: center; min-width: 24ch; overflow: hidden; color: var(--signal); }
  .home-hero__role-window strong {
    display: inline-block;
    font: inherit;
  }
  .home-hero__role-window::after {
    content: '';
    width: 2px;
    height: .9em;
    margin-left: .16em;
    background: currentColor;
    animation: role-caret .9s steps(1, end) infinite;
  }
  @keyframes role-caret { 50% { opacity: 0; } }
  .home-hero__copy > .button { margin-top: clamp(1.75rem, 3vw, 2.75rem); }
  /* No border and no inner rule. Those two lines were the invisible rectangle:
     a cut-out sitting inside a bordered, internally-ruled column reads as a
     framed picture however transparent the PNG is. The column's structure now
     comes from the rings behind the figure and the page rule at 68%, which the
     figure is allowed to cross. */
  .home-hero__portrait {
    position: relative;
    z-index: 1;
    align-self: end;
    height: calc(100svh - var(--header-h) - .75rem);
    min-height: 36rem;
    margin: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  /* The cut-out meets one measured floor trace at the source image's actual
     contact line (the asset has 6.53% transparent padding beneath it). It is
     deliberately a tapered directional mark—not a second portrait, ellipse,
     blur, glow or theatrical shadow. The trace runs away from the name/CTA
     side, so the light logic and the figure's footing agree. */
  .home-hero__portrait::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: 1%;
    bottom: 6.35%;
    width: 72%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(17, 17, 15, .32) 22%, rgba(17, 17, 15, .14) 72%, transparent);
    transform: skewX(-18deg);
    transform-origin: left;
    pointer-events: none;
  }

  .home-hero__portrait img {
    width: min(108%, 49rem);
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .home-hero__figure {
    position: relative;
    z-index: 1;
    transform: translateX(2%) scale(1.035);
    transform-origin: center bottom;
  }

  @media (forced-colors: active) {
    .home-hero__portrait::after { display: none; }
  }

  .positioning { display: grid; grid-template-columns: 1.4fr .6fr; gap: 7vw; padding-block: clamp(5.5rem, 9vw, 9rem); }
  .positioning h2 { max-width: 68rem; font-size: clamp(4rem, 8vw, 8.5rem); }
  .positioning__copy { align-self: end; max-width: 30rem; }
  .positioning__copy p { color: var(--ink-soft); line-height: 1.75; }
  .positioning__copy .button { margin-top: 1.5rem; }

  /* PRODUCTION RECORD
     Five metrics, one row, full content width. The old composition put two
     oversized cells on row one and three on row two, which left a hole in the
     grid and made the numbers compete with each other instead of reading as a
     strip. The eyebrow moved above the row so the five cells get the whole
     measure rather than surrendering a third of it to a one-line label. */
  .home-stats { padding-block: clamp(3.5rem, 5vw, 5.5rem); }
  .home-stats__head {
    display: grid;
    grid-template-columns: minmax(13rem, .55fr) minmax(0, 1.45fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .home-stats__head > .eyebrow { margin: .45rem 0 0; }
  .home-stats__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  /* A number and its label are ONE fact. justify-content: space-between with a
     15rem min-height pinned them to opposite ends of the cell and put a void
     between them, so five metrics read as five empty boxes with text in the
     corners. They stack tight now, and the strip takes whatever height the
     content needs — the grid still equalises the cells so the rules line up. */
  .home-stat { position: relative; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; padding: clamp(1.35rem, 1.8vw, 1.8rem) clamp(1rem, 1.5vw, 1.6rem) clamp(1.55rem, 2vw, 2rem); overflow: hidden; border-right: 1px solid var(--line); }
  .home-stat:first-child { padding-left: 0; }
  .home-stat:last-child { padding-right: 0; border-right: 0; }
  .home-stat::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--signal); transform: scaleX(.12); transform-origin: left; transition: transform .42s var(--ease); }
  /* Sized so the longest value (9,000+) fits its fifth of the row without
     shrinking the others: this is a data strip, not five headlines. */
  .home-stat strong { display: block; font-family: var(--display); font-size: clamp(2.4rem, 3.9vw, 4.4rem); font-weight: 850; letter-spacing: -.06em; line-height: .82; white-space: nowrap; transition: color .32s var(--ease), transform .32s var(--ease); }
  .home-stat span { max-width: 13rem; font-family: var(--mono); font-size: clamp(.6rem, .72vw, .7rem); letter-spacing: .1em; line-height: 1.45; text-transform: uppercase; transition: transform .32s var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .home-stat:hover::after { transform: scaleX(1); }
    .home-stat:hover strong { color: var(--signal); transform: translateY(-.08em); }
    .home-stat:hover span { transform: translateX(.35rem); }
  }

  /* Procurement readiness is supporting evidence for the production record,
     so it lives in the same header rather than as a detached legal strip. */
  .business-ready { padding: 0 0 0 clamp(1.4rem, 2.5vw, 2.5rem); border-left: 3px solid var(--signal); }
  .business-ready__tag { margin: 0; color: var(--muted); }
  .business-ready__lead {
    margin: .7rem 0 1rem;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    font-weight: 750;
    letter-spacing: -.035em;
    line-height: 1.05;
  }
  .business-ready__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .5rem clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    font-family: var(--mono);
    font-size: .68rem;
    letter-spacing: .035em;
    line-height: 1.5;
  }
  .business-ready__facts span { padding-top: .45rem; border-top: 1px solid var(--line); color: var(--ink-soft); }
  .business-ready__facts strong { font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-color: var(--signal); text-decoration-thickness: 2px; text-underline-offset: 3px; }

  .home-process { display: grid; grid-template-columns: .7fr 1.3fr; gap: 8vw; padding-block: clamp(6rem, 10vw, 10rem); }
  .home-process__head { position: sticky; top: 8rem; align-self: start; }
  .home-process__head h2 { margin: 2rem 0 3rem; font-size: clamp(4rem, 7vw, 7rem); }
