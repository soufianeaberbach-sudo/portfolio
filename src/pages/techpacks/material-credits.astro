---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getLocale, localizePath } from '../../i18n/locales';
import { materialCredits } from '../../i18n/pages/material-credits';
import images from '../../../public/techpacks/materials/material-credits.json';
const locale = getLocale(Astro.url);
const t = materialCredits[locale];
const kind = (value: string) => t.kinds[value as keyof typeof t.kinds];
const change = (value: string) => t.changes[value as keyof typeof t.changes];
const source = (value: string) => t.sources[value as keyof typeof t.sources] ?? value;
const licence = (value: string) => t.licenceNames[value as keyof typeof t.licenceNames] ?? value;
---
<SiteLayout title={t.title} description={t.description} marker="SA-TECHPACK-MATERIAL-CREDITS-R2" page="techpack-credits" footerCallout={false}>
 <main class="material-credits" id="main-content">
  <a class="label" href={localizePath('/portfolio/#tech-packs', locale)}>{t.back}</a>
  <h1>{t.heading}</h1>
  <p>{t.intro}</p>
  <p>{t.components}</p>
  <p>{t.licences} <a href="/techpacks/materials/material-credits.json">{t.register}</a>.</p>
  <ol>{images.map(image=><li id={image.id}>
   <img src={image.url} alt={`${image.id}: ${kind(image.kind)}`} width="240" height="180" loading="lazy" decoding="async"/>
   <div><h2>{image.id}</h2><p><span lang="en">{image.title}</span> · {kind(image.kind)}</p><p>{image.author} · {image.licenseUrl?<a href={image.licenseUrl} target="_blank" rel="noopener">{licence(image.license)}</a>:licence(image.license)}</p><p>{change(image.changes)}</p><p>{image.source.startsWith('https://')?<a href={image.source} target="_blank" rel="noopener">{t.original}</a>:source(image.source)} · <a href={image.url} download>{t.derivative}</a></p></div>
  </li>)}</ol>
 </main>
</SiteLayout>
<style>
.material-credits{max-width:1100px;margin:auto;padding:clamp(100px,12vh,180px) 24px 80px}.material-credits>p{max-width:80ch;line-height:1.65;font-size:14px;margin:1rem 0}.material-credits h1{font-size:clamp(30px,5vw,55px);margin:2rem 0}.material-credits ol{list-style:none;padding:0;margin-top:3rem}.material-credits li{border-top:1px solid var(--line);padding:1.5rem 0;display:grid;grid-template-columns:240px 1fr;gap:2rem}.material-credits img{width:240px;height:180px;object-fit:contain;background:white}.material-credits h2{font:13px var(--mono);margin:0 0 .8rem}.material-credits li p{font-size:12px;line-height:1.6;overflow-wrap:anywhere;margin:.4rem 0}.material-credits a{text-decoration:underline;text-underline-offset:3px}@media(max-width:599px){.material-credits li{grid-template-columns:1fr;gap:1rem}}
</style>
