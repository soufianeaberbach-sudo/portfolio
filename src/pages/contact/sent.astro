---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Brief received — Soufiane Aberbach"
  description="Your development brief has been received."
  marker="SA-CONTACT-SENT-V1"
  page="contact"
  noindex={true}
>
  <section class="sent section-shell">
    <p class="eyebrow">Brief received</p>
    <h1 class="display">Your starting point<br />is now recorded.</h1>
    <p>The development brief has been saved and sent for review. Any next step will be based on the information and reference you provided.</p>
  </section>
</SiteLayout>

<style>
  .sent { min-height: min(76svh, 48rem); display: grid; align-content: center; padding-block: calc(var(--header-h) + 5rem) 7rem; }
  .sent h1 { max-width: 12ch; margin: 1.5rem 0 2rem; font-size: clamp(4rem, 9vw, 9rem); }
  .sent > p:last-child { max-width: 38rem; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  @media (max-width: 480px) { .sent h1 { font-size: clamp(3.6rem, 15vw, 5rem); } }
</style>
