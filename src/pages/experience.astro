---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const roles = [
  { company: 'Loratex', title: 'Operations & Warehouse Coordinator', dates: 'Feb 2014 – Jan 2016' },
  { company: 'Roadtex', title: 'Quality Control & Production Specialist', dates: 'Feb 2016 – Aug 2017' },
  { company: 'Loratex', title: 'Production Planning Coordinator', dates: 'Sep 2017 – Sep 2018', note: 'Return to Loratex' },
  { company: 'Loratex', title: 'CAD Development Supervisor', dates: 'Sep 2018 – May 2021', note: 'Internal progression' },
  { company: 'Lariconf', title: 'CAD Fashion Developer', dates: 'Jun 2021 – May 2022' },
  { company: 'Ava Marie', title: 'Senior Fashion Designer & Product Developer', dates: 'May 2022 – Present' },
];

const tools = ['Gerber AccuMark', 'Lectra', 'Optitex', 'Vetigraph', 'CLO3D', 'Adobe Illustrator'];
---

<SiteLayout title="Experience — Soufiane Aberbach" description="Experience and production perspective of Soufiane Aberbach, fashion designer and product developer in Tangier." marker="SA-EXPERIENCE-V4" page="experience">
  <!-- BUILD-MARKER: SA-EXPERIENCE-V4 -->
  <section class="experience-hero">
    <div class="experience-hero__title" data-reveal>
      <p class="eyebrow">Experience / 04</p>
      <h1 class="display">Built in the<br /><span>pattern room.</span></h1>
    </div>
    <figure class="experience-hero__portrait" data-reveal>
      <img
        src="/experience-figure-900.webp"
        srcset="/experience-figure-600.webp 600w, /experience-figure-900.webp 900w"
        sizes="(max-width: 900px) 78vw, 42vw"
        width="754"
        height="1517"
        alt="Soufiane Aberbach in a black suit holding an open laptop"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="label">Corporate experience / Tangier</figcaption>
    </figure>
    <div class="experience-hero__intro" data-reveal>
      <p class="label">Senior Fashion Designer &amp; Product Developer</p>
      <p>Based in Tangier, working at the point where a visual idea becomes a pattern, a specification and a production decision.</p>
    </div>
    <div class="experience-hero__measure"><i aria-hidden="true"></i><span>12+ years / 9,000+ garments engineered</span></div>
  </section>

  <section class="experience-difference section-shell" aria-labelledby="difference-title">
    <div class="experience-difference__head" data-reveal>
      <p class="eyebrow">Production perspective</p>
      <h2 class="display" id="difference-title">The whole line,<br />in <em>one</em> profile.</h2>
    </div>
    <p class="experience-difference__lead" data-reveal>Not a designer observing manufacturing from the outside. Pattern, product development and factory reality sit in the same working method.</p>
    <div class="experience-difference__proofs">
      <article data-reveal>
        <span class="label">01 / Factory intelligence</span>
        <h3>Built from the floor up.</h3>
        <p>Progression through planning, quality, warehouse, CAD and product development means production constraints are recognised before they become line problems.</p>
      </article>
      <article data-reveal>
        <span class="label">02 / Technical translation</span>
        <h3>Design intent, made repeatable.</h3>
        <p>Pattern geometry, 3D validation and technical documentation bridge the aesthetic idea to a garment a factory can cut, grade and reproduce.</p>
      </article>
      <article data-reveal>
        <span class="label">03 / Direct B2B bridge</span>
        <h3>One clear communication layer.</h3>
        <p>Arabic, French and English connect brand teams with Moroccan production, backed by registered B2B invoicing capability.</p>
      </article>
    </div>
  </section>

  <section class="roles section-shell section-rule">
    <div class="roles__head" data-reveal>
      <p class="eyebrow">Professional path</p>
      <h2 class="display">Six roles. One production trajectory.</h2>
    </div>
    <div class="roles__list">
      {roles.map((role, index) => (
        <article data-reveal>
          <span class="index-tag">{String(index + 1).padStart(2, '0')}</span>
          <div><p class="label">{role.dates}</p><h3>{role.company}</h3>{role.note && <span class="role-note">{role.note}</span>}</div>
          <p>{role.title}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="tools-band">
    <div class="section-shell tools-band__grid">
      <div data-reveal>
        <p class="eyebrow">Technical environment</p>
        <h2 class="display">Tools follow the production problem.</h2>
      </div>
      <div class="tools-band__list" data-reveal>
        {tools.map((tool, index) => <span><i>{String(index + 1).padStart(2, '0')}</i>{tool}</span>)}
      </div>
    </div>
  </section>

  <section class="experience-close section-shell">
    <div data-reveal>
      <p class="label">The working boundary</p>
      <p>Pattern, fit, gradation, 3D simulation, technical packs and production follow-through.</p>
    </div>
    <div data-reveal>
      <p class="label">Not on the list</p>
      <p>Collection design, fabric sourcing, branding or hand sample sewing.</p>
    </div>
    <a class="button button--signal" href="/contact/" data-reveal>Discuss production collaboration <span><Arrow /></span></a>
  </section>
</SiteLayout>

<style>
  /* The figure's rendered width is derived once and reused, so the headline's
     measure is defined by where the figure actually starts rather than by a
     margin that happens to look right at one viewport. */
  .experience-hero { --figure-w: clamp(15rem, 25.5vw, 29rem); --figure-h: calc(var(--figure-w) / 0.497); --figure-offset: clamp(0rem, 9vw, 11rem); position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(28rem, 1.15fr); grid-template-rows: 1fr auto auto; gap: 2rem 4vw; align-items: end; overflow: hidden; padding: calc(var(--header-h) + 3rem) var(--gutter) 3rem; background: var(--paper-bright); border-bottom: 1px solid var(--line); }
  /* The full-height rule that used to split this section at 47% is gone: it
     drew exactly the column boundary the composition is trying not to have. */
  /* The figure stands IN FRONT of the typography, not under it. With the old
     z-order the outlined line printed straight across the arm, suit and leg.
     Silhouette profile measured off the source's alpha channel: the band from
     16% to 44% of the figure's height — shoulders, chest, hands, laptop —
     spans the FULL width of its box, so there is no clear lane for type at
     headline height. The line runs to the figure and stops; only the outer
     edge of the arm may pass in front of the final glyph. */
  .experience-hero__title { position: relative; z-index: 1; grid-column: 1 / 3; grid-row: 1; align-self: center; pointer-events: none; }
  /* Hard-stopped short of the figure: the type runs to the silhouette and
     terminates there, so it can never cross the face, torso or hands. */
  .experience-hero__title h1 { max-width: calc(100% - var(--figure-w) - var(--figure-offset) - 1.25rem); font-size: clamp(3.4rem, 10vw, 11rem); line-height: .82; }
  .experience-hero__title h1 span { color: transparent; -webkit-text-stroke: 1.4px var(--ink); }
  /* The box carries the figure's own 754:1517 ratio and is driven by height, so
     `contain` has no slack to leave and --figure-w above is an exact
     prediction of where the figure starts. */
  .experience-hero__portrait { position: relative; z-index: 2; grid-column: 2; grid-row: 1 / 4; align-self: end; justify-self: end; width: var(--figure-w); aspect-ratio: 754 / 1517; height: auto; max-width: none; margin: 0 var(--figure-offset) -3rem 0; overflow: visible; }
  .experience-hero__portrait img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: right bottom; }
  /* Sits on the measure axis, clear of the figure's legs — it used to print
     straight across the trousers. */
  /* Parked immediately left of the figure at the top, which is the one area
     the composition leaves clear — it used to print across the trousers, and
     across the face once the figure moved up. */
  .experience-hero__portrait figcaption { position: absolute; right: 100%; top: 2rem; margin-right: 1.5rem; padding-top: .65rem; border-top: 1px solid var(--ink); color: var(--ink); white-space: nowrap; }
  .experience-hero__intro { position: relative; z-index: 3; grid-column: 1; grid-row: 2; padding-bottom: 0; }
  .experience-hero__intro > p:last-child { max-width: 32rem; margin-top: 1.5rem; color: var(--ink-soft); font-size: 1.15rem; line-height: 1.7; }
  .experience-hero__measure { position: relative; z-index: 3; grid-column: 1; grid-row: 3; display: flex; align-items: center; gap: 1rem; font-family: var(--mono); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .experience-hero__measure i { width: 8rem; height: 1px; background: var(--signal); }
  .experience-difference { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .55fr); gap: 3rem 8vw; padding-block: clamp(7rem, 12vw, 12rem); }
  .experience-difference__head h2 { margin-top: 2rem; font-size: clamp(4rem, 8vw, 8rem); }
  .experience-difference__lead { align-self: end; max-width: 34rem; margin: 0 0 .6rem; color: var(--ink-soft); font-size: clamp(1.1rem, 1.5vw, 1.35rem); line-height: 1.7; }
  .experience-difference__proofs { grid-column: 1 / -1; display: grid; grid-template-columns: 1.15fr .95fr .9fr; margin-top: clamp(2rem, 4vw, 4rem); border-top: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); }
  .experience-difference__proofs article { min-height: 22rem; padding: clamp(2rem, 3vw, 3rem); border-right: 1px solid var(--line); }
  .experience-difference__proofs article:first-child { padding-left: 0; }
  .experience-difference__proofs article:last-child { padding-right: 0; border-right: 0; }
  .experience-difference__proofs .label { color: var(--signal); }
  .experience-difference__proofs h3 { max-width: 23rem; margin: clamp(4rem, 7vw, 7rem) 0 1.5rem; font-family: var(--display); font-size: clamp(2.2rem, 3.7vw, 4rem); letter-spacing: -.055em; line-height: .92; }
  .experience-difference__proofs p { max-width: 29rem; margin: 0; color: var(--muted); line-height: 1.7; }
  .roles { display: grid; grid-template-columns: .6fr 1.4fr; gap: 8vw; padding-block: clamp(6rem, 10vw, 10rem); }
  .roles__head { position: sticky; top: 8rem; align-self: start; }
  .roles__head h2 { margin-top: 2rem; font-size: clamp(3.8rem, 6vw, 6.5rem); }
  .roles__list { border-top: 1px solid var(--line-strong); }
  .roles article { display: grid; grid-template-columns: 3rem 1fr 1.2fr; gap: 2rem; padding: 2.5rem 0; border-bottom: 1px solid var(--line); }
  .roles h3 { margin: .5rem 0 0; font-family: var(--display); font-size: clamp(2rem, 4vw, 4.3rem); letter-spacing: -.055em; line-height: 1; }
  .role-note { display: inline-block; margin-top: .8rem; color: var(--signal); font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .roles article > p { margin: 0; color: var(--muted); line-height: 1.7; }
  .tools-band { padding-block: clamp(7rem, 12vw, 12rem); background: var(--signal); color: #fff; }
    /* Same rule as .contact-direct: no opacity on white-over-orange, and the
     small labels carry weight instead of the band being darkened. */
  .tools-band .eyebrow, .tools-band h2, .tools-band__list span { color: #fff; }
  .tools-band .eyebrow { font-size: .8rem; font-weight: 700; }
  .tools-band__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
  .tools-band h2 { margin-top: 2rem; font-size: clamp(4rem, 7vw, 7.5rem); }
  .tools-band__list { align-self: end; border-top: 1px solid rgba(255,255,255,.45); }
  .tools-band__list span { display: flex; gap: 2rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.35); font-family: var(--display); font-size: 1.5rem; font-weight: 650; }
  .tools-band__list i { width: 2.4rem; font-family: var(--mono); font-size: .8rem; font-weight: 700; font-style: normal; }
  .experience-close { display: grid; grid-template-columns: 1fr 1fr auto; gap: 5vw; align-items: end; padding-block: clamp(6rem, 10vw, 10rem); }
  .experience-close p:last-child { max-width: 29rem; color: var(--ink-soft); line-height: 1.65; }
  @media (max-width: 900px) { .experience-hero, .experience-difference, .roles, .tools-band__grid, .experience-close { grid-template-columns: minmax(0, 1fr); } .experience-hero { grid-template-rows: auto auto auto auto; } .experience-hero::before { left: 50%; } .experience-hero__title { grid-column: 1; grid-row: 1; } .experience-hero__title h1 { max-width: none; font-size: clamp(3.4rem, 9.4vw, 7rem); } .experience-hero__portrait { grid-column: 1; grid-row: 2; width: auto; aspect-ratio: 754 / 1517; height: min(58svh, 38rem); min-height: 26rem; margin: -2rem -2vw -2rem auto; } .experience-hero__portrait figcaption { top: auto; right: 100%; bottom: 1rem; margin-right: 1.25rem; } .experience-hero__intro, .experience-hero__measure { grid-column: 1; grid-row: auto; } .experience-difference__proofs { grid-template-columns: minmax(0, 1fr); } .experience-difference__proofs article, .experience-difference__proofs article:first-child, .experience-difference__proofs article:last-child { min-height: 0; padding: 2.5rem 0; border-right: 0; border-bottom: 1px solid var(--line); } .experience-difference__proofs article:last-child { border-bottom: 0; } .experience-difference__proofs h3 { margin-top: 3rem; } .roles > *, .roles article > * { min-width: 0; } .roles__head { position: static; } }
  @media (max-width: 600px) { .experience-hero { min-height: 0; gap: 1.5rem; padding-top: calc(var(--header-h) + 4rem); } .experience-hero__title h1 { font-size: clamp(3.8rem, 16vw, 5rem); } /* The caption goes back into flow at this width, so the figure must size to
       its contents — a fixed height pushed the caption outside the box and it
       collided with the intro label underneath. The ratio moves to the img. */
    .experience-hero__portrait { width: auto; height: auto; aspect-ratio: auto; min-height: 0; margin: -1rem 0 0 auto; }
    .experience-hero__portrait img { height: auto; aspect-ratio: 754 / 1517; max-height: 26rem; width: auto; margin-left: auto; }
    .experience-hero__portrait figcaption { position: static; display: block; margin: 1.1rem 0 0; text-align: right; white-space: normal; } .experience-difference__head h2 { font-size: 3.7rem; } .roles__head h2 { font-size: 2.9rem; } .roles article { grid-template-columns: 2.5rem minmax(0, 1fr); } .roles article > p { grid-column: 2; } .roles h3 { overflow-wrap: anywhere; } .tools-band h2 { font-size: 3.4rem; } }
</style>
