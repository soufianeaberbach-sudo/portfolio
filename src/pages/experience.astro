---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';

const roles = [
  { company: 'Loratex', title: 'Operations & Warehouse Coordinator', dates: 'Feb 2014 – Jan 2016' },
  { company: 'Roadtex', title: 'Quality Control & Production Specialist', dates: 'Feb 2016 – Aug 2017' },
  { company: 'Loratex', title: 'Production Planning Coordinator', dates: 'Sep 2017 – Sep 2018', note: 'Return to Loratex' },
  { company: 'Loratex', title: 'CAD Development Supervisor', dates: 'Sep 2018 – May 2021', note: 'Internal progression' },
  { company: 'Lariconf', title: 'CAD Fashion Developer', dates: 'Jun 2021 – May 2022' },
  { company: 'Ava Marie', title: 'Senior Fashion Designer & Product Developer', dates: 'May 2022 – Present' },
];

const tools = ['Gerber AccuMark', 'Lectra', 'Optitex', 'Vetigraph', 'CLO3D', 'Adobe Illustrator'];
---

<SiteLayout title="Experience — Soufiane Aberbach" description="Experience and production perspective of Soufiane Aberbach, fashion designer and product developer in Tangier." marker="SA-EXPERIENCE-V4" page="experience">
  <!-- BUILD-MARKER: SA-EXPERIENCE-V4 -->
  <section class="experience-hero">
    <div class="experience-hero__title" data-reveal>
      <p class="eyebrow">Experience / 04</p>
      <h1 class="display">Built in the<br /><span>pattern room.</span></h1>
    </div>
    <figure class="experience-hero__portrait" data-reveal>
      <img src="/experience.png" width="1024" height="1536" alt="Soufiane Aberbach in a black suit holding an open laptop" fetchpriority="high" decoding="async" />
      <figcaption class="label">Corporate experience / Tangier</figcaption>
    </figure>
    <div class="experience-hero__intro" data-reveal>
      <p class="label">Senior Fashion Designer &amp; Product Developer</p>
      <p>Based in Tangier, working at the point where a visual idea becomes a pattern, a specification and a production decision.</p>
    </div>
    <div class="experience-hero__measure"><i aria-hidden="true"></i><span>11+ years / 9,000+ garments engineered</span></div>
  </section>

  <section class="experience-statement section-shell">
    <p class="eyebrow" data-reveal>Perspective</p>
    <blockquote class="display" data-reveal>“My job is invisible in the finished piece. It is the <em>decision</em> made before the fabric was cut.”</blockquote>
    <p class="experience-statement__note" data-reveal>Programme exposure through manufacturing work across Loratex, Lariconf and Ava Marie — not direct employment or brand endorsement.</p>
    <div class="experience-statement__evidence">
      <article data-reveal>
        <span class="label">Production proximity / 01</span>
        <h3>On the factory floor.</h3>
        <p>Based in Tangier, able to work directly with Moroccan production teams when an issue needs eyes on the garment—not another email chain.</p>
      </article>
      <article data-reveal>
        <span class="label">Production proximity / 02</span>
        <h3>Three languages. One decision.</h3>
        <p>Arabic, French and English create a direct communication layer between European brand and design teams and Moroccan production, reducing ambiguity and accelerating issue resolution.</p>
      </article>
    </div>
  </section>

  <section class="roles section-shell section-rule">
    <div class="roles__head" data-reveal>
      <p class="eyebrow">Professional path</p>
      <h2 class="display">Six roles. One production trajectory.</h2>
    </div>
    <div class="roles__list">
      {roles.map((role, index) => (
        <article data-reveal>
          <span class="index-tag">{String(index + 1).padStart(2, '0')}</span>
          <div><p class="label">{role.dates}</p><h3>{role.company}</h3>{role.note && <span class="role-note">{role.note}</span>}</div>
          <p>{role.title}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="tools-band">
    <div class="section-shell tools-band__grid">
      <div data-reveal>
        <p class="eyebrow">Technical environment</p>
        <h2 class="display">Tools follow the production problem.</h2>
      </div>
      <div class="tools-band__list" data-reveal>
        {tools.map((tool, index) => <span><i>{String(index + 1).padStart(2, '0')}</i>{tool}</span>)}
      </div>
    </div>
  </section>

  <section class="experience-close section-shell">
    <div data-reveal>
      <p class="label">The working boundary</p>
      <p>Pattern, fit, gradation, 3D simulation, technical packs and production follow-through.</p>
    </div>
    <div data-reveal>
      <p class="label">Not on the list</p>
      <p>Collection design, fabric sourcing, branding or hand sample sewing.</p>
    </div>
    <a class="button button--signal" href="/contact/" data-reveal>Discuss production collaboration <span><Arrow /></span></a>
  </section>
</SiteLayout>

<style>
  .experience-hero { position: relative; min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(28rem, 1.15fr); grid-template-rows: 1fr auto auto; gap: 2rem 4vw; align-items: end; overflow: hidden; padding: calc(var(--header-h) + 3rem) var(--gutter) 3rem; background: var(--paper-bright); border-bottom: 1px solid var(--line); }
  .experience-hero::before { content: ''; position: absolute; left: 47%; top: var(--header-h); bottom: 0; width: 1px; background: var(--line); }
  .experience-hero__title { position: relative; z-index: 2; grid-column: 1 / 3; grid-row: 1; align-self: center; pointer-events: none; }
  .experience-hero__title h1 { max-width: 88rem; font-size: clamp(5rem, 10vw, 10.6rem); line-height: .82; }
  .experience-hero__title h1 span { color: transparent; -webkit-text-stroke: 1.4px var(--ink); }
  .experience-hero__portrait { position: relative; z-index: 1; grid-column: 2; grid-row: 1 / 4; align-self: end; justify-self: end; width: min(58vw, 59rem); height: calc(100svh - var(--header-h) - 1rem); min-height: 43rem; margin: 0 -2vw -3rem 0; overflow: visible; }
  .experience-hero__portrait img { width: 100%; height: 100%; object-fit: contain; object-position: right bottom; filter: drop-shadow(0 1.5rem 2.5rem rgba(17,17,15,.08)); }
  .experience-hero__portrait figcaption { position: absolute; right: 1rem; bottom: 4rem; padding-top: .65rem; border-top: 1px solid var(--ink); color: var(--ink); }
  .experience-hero__intro { position: relative; z-index: 3; grid-column: 1; grid-row: 2; padding-bottom: 0; }
  .experience-hero__intro > p:last-child { max-width: 32rem; margin-top: 1.5rem; color: var(--ink-soft); font-size: 1.15rem; line-height: 1.7; }
  .experience-hero__measure { position: relative; z-index: 3; grid-column: 1; grid-row: 3; display: flex; align-items: center; gap: 1rem; font-family: var(--mono); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .experience-hero__measure i { width: 8rem; height: 1px; background: var(--signal); }
  .experience-statement { padding-block: clamp(7rem, 12vw, 12rem); }
  .experience-statement blockquote { max-width: 83rem; margin: 3rem 0; font-size: clamp(4rem, 8vw, 8.6rem); }
  .experience-statement__note { max-width: 48rem; margin-left: auto; color: var(--muted); line-height: 1.75; }
  .experience-statement__evidence { display: grid; grid-template-columns: 1fr 1fr; gap: 4vw; margin-top: clamp(4rem, 7vw, 7rem); border-top: 1px solid var(--line-strong); }
  .experience-statement__evidence article { display: grid; grid-template-columns: minmax(12rem, .7fr) 1fr; gap: 1rem 3rem; padding: 2.5rem 0 0; }
  .experience-statement__evidence .label { grid-column: 1 / -1; color: var(--signal-dark); }
  .experience-statement__evidence h3 { margin: 0; font-family: var(--display); font-size: clamp(2rem, 3vw, 3.2rem); letter-spacing: -.05em; line-height: .95; }
  .experience-statement__evidence p { margin: 0; color: var(--muted); line-height: 1.7; }
  .roles { display: grid; grid-template-columns: .6fr 1.4fr; gap: 8vw; padding-block: clamp(6rem, 10vw, 10rem); }
  .roles__head { position: sticky; top: 8rem; align-self: start; }
  .roles__head h2 { margin-top: 2rem; font-size: clamp(3.8rem, 6vw, 6.5rem); }
  .roles__list { border-top: 1px solid var(--line-strong); }
  .roles article { display: grid; grid-template-columns: 3rem 1fr 1.2fr; gap: 2rem; padding: 2.5rem 0; border-bottom: 1px solid var(--line); }
  .roles h3 { margin: .5rem 0 0; font-family: var(--display); font-size: clamp(2rem, 4vw, 4.3rem); letter-spacing: -.055em; line-height: 1; }
  .role-note { display: inline-block; margin-top: .8rem; color: var(--signal-dark); font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .roles article > p { margin: 0; color: var(--muted); line-height: 1.7; }
  .tools-band { padding-block: clamp(7rem, 12vw, 12rem); background: var(--signal); color: var(--paper); }
  .tools-band__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; }
  .tools-band h2 { margin-top: 2rem; font-size: clamp(4rem, 7vw, 7.5rem); }
  .tools-band__list { align-self: end; border-top: 1px solid rgba(255,255,255,.45); }
  .tools-band__list span { display: flex; gap: 2rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.35); font-family: var(--display); font-size: 1.5rem; font-weight: 650; }
  .tools-band__list i { width: 2rem; font-family: var(--mono); font-size: .65rem; font-style: normal; }
  .experience-close { display: grid; grid-template-columns: 1fr 1fr auto; gap: 5vw; align-items: end; padding-block: clamp(6rem, 10vw, 10rem); }
  .experience-close p:last-child { max-width: 29rem; color: var(--ink-soft); line-height: 1.65; }
  @media (max-width: 900px) { .experience-hero, .roles, .tools-band__grid, .experience-close { grid-template-columns: minmax(0, 1fr); } .experience-hero { grid-template-rows: auto auto auto auto; } .experience-hero::before { left: 50%; } .experience-hero__title { grid-column: 1; grid-row: 1; } .experience-hero__portrait { grid-column: 1; grid-row: 2; width: min(100%, 43rem); height: min(72svh, 48rem); min-height: 34rem; margin: -5rem -8vw -3rem auto; } .experience-hero__intro, .experience-hero__measure { grid-column: 1; grid-row: auto; } .experience-statement__evidence { grid-template-columns: minmax(0, 1fr); } .roles > *, .roles article > * { min-width: 0; } .roles__head { position: static; } }
  @media (max-width: 600px) { .experience-hero { min-height: 0; gap: 1.5rem; padding-top: calc(var(--header-h) + 4rem); } .experience-hero__title h1 { font-size: clamp(3.8rem, 16vw, 5rem); } .experience-hero__portrait { width: 118%; height: 35rem; min-height: 0; margin: -4rem -14% -2rem auto; } .experience-hero__portrait figcaption { right: 14%; bottom: 2.5rem; } .experience-statement__evidence article { grid-template-columns: minmax(0, 1fr); } .roles__head h2 { font-size: 2.9rem; } .roles article { grid-template-columns: 2.5rem minmax(0, 1fr); } .roles article > p { grid-column: 2; } .roles h3 { overflow-wrap: anywhere; } .tools-band h2 { font-size: 3.4rem; } }
</style>
