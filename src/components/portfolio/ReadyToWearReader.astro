---
import type {Subject} from '../../data/portfolio';
import ReadyToWearPhoto from './ReadyToWearPhoto.astro';
interface Props{subject:Subject;world:string;}
const{subject,world}=Astro.props;
const split=subject.cover.views===2&&subject.cover.separable!==false;
---
<article class="pf-rd__subject rtw-reader" data-rtw-reader data-subject={subject.id} data-of="rtw" data-role={subject.role} data-verified="no"
 id={`${world}/rtw/${subject.id}`} aria-labelledby={`${subject.id}-rd-title`} tabindex="-1" hidden>
 <header class="rtw-reader-head"><a class="label" href={`#${world}/rtw`} data-nav data-subject-close>← READY-TO-WEAR</a><p class="label">REFERENCE PHOTOGRAPHY</p></header>
 <section class="rtw-reader-floor" aria-label="The complete garment">
  <div class="rtw-reader-copy"><h3 id={`${subject.id}-rd-title`}>{subject.caption??subject.cover.alt}</h3><p>Final photography. No verified development history.</p></div>
  <div class="rtw-reader-image" data-rtw-target><ReadyToWearPhoto subject={subject}/></div>
  <div class="rtw-reader-controls" aria-label="Garment views">
   {split?<><button class="label" data-rtw-view="0" aria-pressed="true">FRONT</button><button class="label" data-rtw-view="1" aria-pressed="false">BACK</button></>:<span class="label">COMPLETE SOURCE / FRONT + BACK</span>}
   <button class="label" data-rd-inspect aria-pressed="false">LOOK CLOSER</button>
  </div>
  <div class="rtw-zoom-tools" data-rtw-zoom-tools hidden><button data-rtw-zoom="0.714" aria-label="Zoom out">−</button><button data-rtw-fit>FIT</button><button data-rtw-zoom="1.4" aria-label="Zoom in">+</button><a href={subject.cover.src} target="_blank" rel="noopener">ORIGINAL SOURCE ↗</a></div>
  <p class="rtw-source-status" data-rtw-source-status role="status"></p>
 </section>
 <p class="rtw-reader-truth" data-subject-pending>Reference photography only. No verified development evidence is published for this garment.</p>
</article>
