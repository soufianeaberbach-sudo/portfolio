---
/* The running order is read from the chapter sequence, never re-typed here,
   so this navigation cannot disagree with the covers about what 03 is. */
import { chapters } from '../../data/portfolio';

interface Props { current?: string }
const { current } = Astro.props;
---
<nav class="pf-continuity" aria-label="Portfolio worlds">
  <a class="pf-continuity__index" href="#portfolio-index" data-nav aria-label="Return to Portfolio index">Index <span aria-hidden="true">↗</span></a>
  {chapters.map((chapter) => (
    <a href={`#${chapter.id}`} data-nav aria-current={current === chapter.id ? 'page' : undefined}>
      <span aria-hidden="true">{chapter.number}</span>{chapter.title}
    </a>
  ))}
</nav>
