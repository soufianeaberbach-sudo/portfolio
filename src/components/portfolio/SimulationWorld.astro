---
/* Pattern & 3D Development — a library of recorded development sessions.
 *
 * Five entries, one below another, every one of them in the same 16:9 frame at
 * the same width. No hero, no film strip, no carousel: the videos are the
 * content and they are all the same kind of thing, so they are presented as
 * one column of equals.
 *
 * The exact five supplied YouTube ids are published. Titles remain neutral
 * because the source material, not an inferred marketing story, names them.
 *
 * public/CLO3D.mp4 is NOT one of the library entries. It is a vertical clip of
 * a finished simulation running — a different format and a different kind of
 * thing from a recorded working session — so standing it in as Video 01 would
 * misrepresent both. It now opens the chapter instead, where a garment that
 * actually moves is the subject rather than an entry in a list.
 *
 * When real ids arrive: the poster renders first and the <iframe> is created
 * by the click that asks for it, from youtube-nocookie.com. Nothing contacts
 * Google while the page is merely open.
 */
import type { SimulationSession } from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import WorldNavigation from './WorldNavigation.astro';

interface Props {
  sessions: SimulationSession[];
}

const { sessions } = Astro.props;

/* WHAT THE PUBLIC SEES IS WHAT EXISTS. Sessions without an id remain excluded;
 * the five supplied recordings render as equal rows, with no empty slots. */
const published = sessions.filter((session) => Boolean(session.youtubeId));
const capacity = sessions.length;
const num = (i: number) => String(i + 1).padStart(2, '0');

---

<section class="pf-world pf-world--motion" id="3d-simulation" data-world="3d-simulation" tabindex="-1" aria-labelledby="simulation-title">
  <WorldNavigation current="3d-simulation" />
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>04</b> Pattern Development</p>
    </div>

    <header class="pf-head">
      <h2 class="display" id="simulation-title">Pattern Development</h2>
      {/* One line. The five stations below say the rest of it. */}
      <p class="pf-head__descriptor">
        The part of the work a photograph cannot hold still.
      </p>
    </header>

    {/* ONE GARMENT, SIX STATES, ONE STAGE.

        What this replaces was a recording on the left and five words set
        large on the right. Five words are a caption; a chapter about
        transformation has to SHOW one thing becoming another, and a list of
        the stages it passes through is not that.

        So this is one stage holding ONE garment, and what changes as the
        chapter is read is how much of that garment exists yet:

          IDEA          one construction line, alone on the field.
          2D            it closes into panels, laid flat across the cloth.
          CONSTRUCTION  the panels gather onto the body and the recording
                        appears under them.
          3D            the recording runs — the cloth moving.
          FIT           it settles into its finished drape.
          PRODUCT       the lines are gone and the garment stands finished.

        There are no six slides, no timeline and no six labels: one word names
        the state the stage is actually in, and it changes because the stage
        has changed. Reading back up runs it backwards.

        WHAT IS REAL HERE AND WHAT IS DRAWN, because this route does not blur
        that line. The garment is a real recording from the development
        archive and it is the only imagery on the stage. The construction
        lines are DRAWN, from the same pattern geometry the rest of the route
        is cut along — they are a diagram of how a panelled garment is built,
        registered over the recording, and they are not presented as this
        garment's own pattern. The note under the stage says so.

        Nothing here depends on the motion happening: under reduced motion or
        with no script the stage resolves to its last state — the garment
        finished, at full presence, with the recording's poster frame
        standing in. */}
    <div class="pf-make" data-make>
      <div class="pf-make__track" data-make-track>
        <div class="pf-make__field" data-make-field>

          {/* THE RECORDING. Seeked, not played: the scroll position IS the
              time, so the cloth moves exactly as fast as the chapter is
              read, stops when the reader stops, and runs backwards when
              they read back up. */}
          <video
            class="pf-make__clip"
            data-make-clip
            poster="/CLO3D-poster.jpg"
            muted
            loop
            playsinline
            preload="none"
            aria-label="A garment simulating in CLO3D: the cloth settles into its finished drape."
          >
            {/* VP9 first: a third of the weight, and the only codec some
                browsers ship without a licence. H.264 behind it covers
                everything else. */}
            <source src="/CLO3D.webm" type="video/webm" />
            <source src="/CLO3D.mp4" type="video/mp4" />
          </video>

          {/* THE CONSTRUCTION LINES. Three panels with curved sides, from
              `scripts/pattern.ts`: an armhole scoop, a princess seam's waist
              suppression, a side seam's hip spring. The runtime draws them,
              closes them, and moves them from the flat onto the body. */}
          <svg class="pf-make__draw" data-make-draw viewBox="0 0 100 56"
            preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
            <g data-panel-g="0"><path data-panel-p="0" /></g>
            <g data-panel-g="1"><path data-panel-p="1" /></g>
            <g data-panel-g="2"><path data-panel-p="2" /></g>
          </svg>

          {/* ONE WORD. It names the state the stage is in, and it is legible
              at every scroll position, so the sequence can be read even if
              nothing ever moves. */}
          <p class="pf-make__state">
            <b data-make-word>Product</b>
          </p>
        </div>
      </div>

      <p class="pf-make__note">
        <span class="label">What this is</span>
        <span>
          A recording of one of Soufiane&rsquo;s own garments simulating in CLO3D.
          The construction lines over it are drawn from pattern geometry — a
          diagram of how a panelled garment is built, not this garment&rsquo;s
          own pattern.
        </span>
      </p>
    </div>

    {published.length > 0 && (
      /* Said once for the chapter rather than under each frame. */
      <p class="pf-videos__note">
        <span class="label">{published.length} supplied recordings</span>
        <span>From the pattern and 3D development archive. Playing one loads a player from YouTube.</span>
      </p>
    )}

    {published.length > 0 ? (
      <ol class="pf-videos" data-capacity={capacity}>
        {published.map((session, index) => (
          <li class="pf-video" data-video={session.id} data-youtube={session.youtubeId ?? ''}>
            <div class="pf-video__head">
              <i class="label pf-video__num">{num(index)}</i>
              <h3>{session.title}</h3>
            </div>

            <div class="pf-video__frame">
              {session.poster && (
                <img
                  class="pf-video__poster"
                  src={session.poster}
                  width="1280"
                  height="720"
                  alt={session.posterAlt ?? ''}
                  loading="lazy"
                  decoding="async"
                  onerror="this.hidden=true"
                />
              )}
              <button type="button" class="pf-play" data-play aria-label={`Play ${session.title} — recorded development session`}>
                <span class="pf-play__mark" aria-hidden="true"></span>
                <span class="pf-play__text label">Play</span>
              </button>
              {/* Where the player is inserted on demand. Empty on load. */}
              <div class="pf-video__player" data-player hidden></div>
            </div>

            {/* The per-recording description was the same sentence five times,
                and the privacy line under it made ten repeated lines on one
                screen. Both are stated once for the chapter, below. */}
          </li>
        ))}
      </ol>
    ) : (
      /* One composed state, not ten empty frames. */
      <div class="pf-soon" data-videos-empty data-capacity={capacity}>
        <p class="label pf-soon__label">Recorded development sessions</p>
        <p class="pf-soon__lead">Publishing soon.</p>
        <p class="pf-soon__note">
          The library is built for {capacity} sessions in the standard 16:9 format. Each one runs from the
          first pattern lines through 2D construction, CLO3D validation and the fit decisions that follow.
        </p>
        <span class="pf-soon__meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      </div>
    )}
  </div>
</section>
