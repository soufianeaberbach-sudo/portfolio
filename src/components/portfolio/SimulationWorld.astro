---
/* 3D Simulation — a library of recorded working sessions.
 *
 * Ten entries, one below another, every one of them in the same 16:9 frame at
 * the same width. No hero, no film strip, no carousel: the videos are the
 * content and they are all the same kind of thing, so they are presented as
 * one column of equals.
 *
 * NOTHING IS PUBLISHED YET. No youtubeId is invented, no source is attached
 * and no subject is claimed for any slot; each renders inside the real 16:9
 * frame saying what it is waiting for, so the finished layout can be judged
 * without pretending a recording exists.
 *
 * public/CLO3D.mp4 is deliberately absent. It is a vertical, self-hosted clip
 * of a finished simulation running — a different format and a different kind
 * of thing from a recorded working session — and standing it in as Video 01
 * would misrepresent both the library and the clip.
 *
 * When real ids arrive: the poster renders first and the <iframe> is created
 * by the click that asks for it, from youtube-nocookie.com. Nothing contacts
 * Google while the page is merely open.
 */
import type { SimulationSession } from '../../data/portfolio';
import Arrow from '../Arrow.astro';

interface Props {
  sessions: SimulationSession[];
}

const { sessions } = Astro.props;
const playable = (session: SimulationSession) => Boolean(session.youtubeId);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="pf-world pf-world--motion" id="3d-simulation" data-world="3d-simulation" tabindex="-1" aria-labelledby="simulation-title">
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>04</b> 3D Simulation</p>
    </div>

    <header class="pf-head">
      <h2 class="display" id="simulation-title">3D Simulation</h2>
      <p class="pf-head__descriptor">
        Pattern construction, garment simulation and fit decisions in motion — the part of the work a
        photograph cannot hold still.
      </p>
      {sessions.some((session) => !playable(session)) && (
        <p class="pf-prov" data-pending-notice>
          <b class="label">Videos pending</b>
          <span>
            The library is laid out for ten recorded working sessions. None is published yet, so every slot
            is reserved and nothing is attached to it.
          </span>
        </p>
      )}
    </header>

    <ol class="pf-videos">
      {sessions.map((session, index) => (
        <li class="pf-video" data-video={session.id} data-youtube={session.youtubeId ?? ''}>
          <p class="pf-video__head">
            <i class="label pf-video__num">{num(index)}</i>
            <h3>{session.title}</h3>
          </p>

          <div class="pf-video__frame">
            {session.poster && (
              <img
                class="pf-video__poster"
                src={session.poster}
                width="1280"
                height="720"
                alt={session.posterAlt ?? ''}
                loading="lazy"
                decoding="async"
              />
            )}

            {playable(session) ? (
              <button type="button" class="pf-play" data-play aria-label={`Play ${session.title}`}>
                <span class="pf-play__mark" aria-hidden="true"></span>
                <span class="pf-play__text label">Play</span>
              </button>
            ) : (
              /* The design state. Not a disabled play button — there is
                 nothing to play, so nothing offers to play it. */
              <p class="label pf-video__pending">YouTube video pending</p>
            )}

            {/* Where the player is inserted on demand. Empty on load. */}
            <div class="pf-video__player" data-player hidden></div>
          </div>

          <p class="pf-video__desc">{session.description}</p>
          {session.youtubeId && (
            <p class="pf-video__privacy">Playing this video loads a player from YouTube.</p>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
