---
import type { Subject } from '../../data/portfolio';
import { rtwCast } from '../../data/rtw-direction';
import CinematicPlate from './CinematicPlate.astro';
interface Props { subjects: Subject[]; world: string; }
const { subjects, world } = Astro.props;
const cast = rtwCast.map(part => ({ ...part, subject: subjects.find(s => s.id === part.id)! })).filter(p => p.subject);
const archive = subjects;
const href = (s: Subject) => `#${world}/rtw/${s.id}`;
---
<div class="rtw-prototype" data-rtw-prototype>
  <div class="rtw-orientation"><p class="rtw-running label" data-rtw-running>01 / READY-TO-WEAR</p></div>
  <div class="rtw-camera" data-rtw-camera>
    <div class="rtw-stage" data-rtw-stage aria-label="Selected Ready-to-Wear exhibition">
      <div class="rtw-title" data-rtw-title>
        <p class="label">WOMENSWEAR / <b>01</b></p>
        <p class="display">READY—<br />TO—WEAR</p>
      </div>
      <div class="rtw-details" aria-hidden="true">
        {cast.map(({role,subject}) => (
          <div class="rtw-detail" data-rtw-detail={role}><CinematicPlate subject={subject} eager sizes="1400px" /></div>
        ))}
      </div>
      <div class="rtw-cast" data-rtw-cast>
        {cast.map(({role,subject}) => (
          <a class="rtw-actor" data-rtw-actor={role} href={href(subject)} data-nav data-open-subject={subject.id}
             aria-label={`Enter reference: ${subject.cover.alt}`} draggable="false">
            <CinematicPlate subject={subject} eager sizes="1400px" />
          </a>
        ))}
      </div>
      <p class="rtw-side label" data-rtw-side aria-hidden="true">FRONT</p>
      <p class="rtw-payoff label" data-rtw-payoff>SELECTED READY-TO-WEAR / {String(cast.length).padStart(2,'0')}</p>
    </div>
  </div>
  <section class="rtw-archive" aria-label="Further Ready-to-Wear references">
    <p class="label">REFERENCE ARCHIVE / {String(archive.length).padStart(2,'0')}</p>
    <div class="rtw-rail" tabindex="0" aria-label="Ready-to-Wear archive; scroll horizontally for more">
      {archive.map(subject => (
        <a href={href(subject)} data-nav data-open-subject={subject.id} draggable="false"
           aria-label={`Enter reference: ${subject.cover.alt}`}>
          <CinematicPlate subject={subject} />
        </a>
      ))}
    </div>
    <div class="rtw-handoff" data-rtw-handoff aria-label="Ready-to-Wear opens toward Activewear">
      <div class="rtw-chapter-type display" aria-hidden="true">
        <span data-rtw-outgoing>READY—TO—WEAR</span>
        <span data-rtw-incoming>ACTIVEWEAR</span>
      </div>
      <p class="label" data-rtw-next><b>02</b> / ACTIVEWEAR</p>
    </div>
  </section>
</div>
<script>
  import '../../scripts/rtw-cinematic';
</script>
