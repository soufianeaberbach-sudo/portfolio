---
/* Tech Packs — a documentation room: a register of documents, and a reader.
 *
 * WHAT WAS WRONG. This used to be five full-size document pages stacked down
 * the page, alternating left and right with their metadata in the empty half.
 * A demo pack's fields are deliberately blank, so five of them at full size
 * was five screens of pale rules with half of each screen empty beside them.
 * It read as a broken page, not as documentation.
 *
 * THE CORRECTION. A room where documents are kept: one register, five ruled
 * rows, each with the page it opens shown at thumbnail size beside its number,
 * name, contents and status. Calm, paper-led, and readable in one screen —
 * which is what a production office actually looks like. The document itself
 * is read at full size in the reader, which is where full size belongs.
 *
 * WHAT IS ON THE PAGE. These five are DEMO PACKS, generated by
 * .devtools/gen-demo-techpacks.mjs so the interface could be designed against
 * documents that really open. Every page of every one is stamped DEMO /
 * INTERFACE PROTOTYPE / NOT CLIENT WORK and carries the section structure of a
 * pack and nothing else: no client name, no season, no measurement, no grading
 * increment, no BOM value. Selected real technical packs will replace them.
 *
 * NOTHING IS FETCHED UNTIL IT IS ASKED FOR. The previews are small WebP images
 * of page 01; the PDFs are plain links until the runtime turns a click into an
 * <iframe>, so opening the chapter costs five thumbnails, not five documents.
 */
import type { TechPack } from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import WorldNavigation from './WorldNavigation.astro';

interface Props {
  packs: TechPack[];
}

const { packs } = Astro.props;
const anyDemo = packs.some((pack) => pack.demo);
---

<section class="pf-world pf-world--docs" id="tech-packs" data-world="tech-packs" tabindex="-1" aria-labelledby="tech-packs-title">
  <WorldNavigation current="tech-packs" />
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>03</b> Tech Packs</p>
    </div>

    <header class="pf-head">
      <h2 class="display" id="tech-packs-title">Tech Packs</h2>
      {/* One line. A chapter about documents is not the place for three
          paragraphs about documents. */}
      <p class="pf-head__descriptor">
        The document a factory can build from without calling to ask what was meant.
      </p>
      {anyDemo && (
        <p class="pf-prov" data-demo-notice>
          <b class="label">Interface prototype</b>
          <span>Demo packs — stamped on every page, with no client name, measurement, grading or BOM value.</span>
        </p>
      )}
    </header>

    {packs.length > 0 ? (
      <ol class="pf-docs">
        {packs.map((pack, index) => (
          <li class="pf-doc" data-doc={pack.id}>
            <a
              class="pf-doc__page"
              id={`preview-${pack.id}`}
              href={pack.pdfUrl}
              target="_blank"
              rel="noopener"
              data-open-pdf={pack.pdfUrl ? '' : undefined}
              data-doc-title={pack.title}
              aria-label={`Open ${pack.title} — ${pack.pageCount ?? 0} pages`}
            >
              <span class="pf-notch" aria-hidden="true"></span>
              <i class="label pf-doc__num">{String(index + 1).padStart(2, '0')}</i>

              <span class="pf-doc__sheet">
                {pack.coverImage ? (
                  <img
                    src={pack.coverImage.src}
                    srcset={pack.coverImage.srcset}
                    sizes="(max-width: 767px) 40vw, 18vw"
                    width={pack.coverImage.width}
                    height={pack.coverImage.height}
                    alt={pack.coverImage.alt}
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <span class="pf-doc__blank" aria-hidden="true"></span>
                )}
              </span>

              <span class="pf-doc__meta">
                <b class="pf-doc__title">{pack.title}</b>
                <span class="pf-doc__line">
                  {pack.category} / {pack.garmentType}{pack.pageCount ? ` / ${pack.pageCount} pages` : ''}
                </span>
                {pack.scope && pack.scope.length > 0 && (
                  /* The contents of the document, which is the thing a
                     production contact actually wants to know. */
                  <span class="pf-doc__scope">{pack.scope.join(' · ')}</span>
                )}
              </span>

              <span class="pf-doc__state">
                {pack.demo && <span class="label pf-doc__stamp">Demo</span>}
                <span class="label pf-doc__open">Read <i aria-hidden="true"><Arrow /></i></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    ) : (
      <div class="pf-empty">
        <p class="pf-empty__lead">Selected technical pack examples will appear here.</p>
        <a class="button" href="/contact/">Ask about technical documentation <span><Arrow /></span></a>
      </div>
    )}
  </div>

  {/* The reader. Empty on load; the runtime builds the frame on the click that
      asks for a document and tears it down again on close. */}
  <dialog class="pf-reader" data-reader aria-label="Technical document reader" hidden>
    <div class="pf-reader__bar">
      <p class="label pf-reader__title" data-reader-title></p>
      <span class="pf-reader__tools">
        <a class="label pf-reader__tab" href="#" target="_blank" rel="noopener" data-reader-tab>Open in a new tab</a>
        <button type="button" class="pf-reader__close" data-reader-close>
          Close <span aria-hidden="true">&#215;</span>
        </button>
      </span>
    </div>
    <div class="pf-reader__mount" data-reader-mount></div>
  </dialog>
</section>
