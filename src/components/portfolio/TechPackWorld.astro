---
/* Tech Packs — five documents, one below another, and a reader.
 *
 * No folio table, no book pile, no side index: a technical pack is a document,
 * and the honest presentation of five documents is five documents in a column,
 * each showing its own first page at a size you can actually read.
 *
 * WHAT IS ON THE PAGE
 * These five are DEMO PACKS, generated by .devtools/gen-demo-techpacks.mjs so
 * the interface could be designed against documents that really open. Every
 * page of every one of them is stamped DEMO / INTERFACE PROTOTYPE / NOT CLIENT
 * WORK and carries the section structure of a pack and nothing else: no client
 * name, no season, no measurement, no grading increment, no BOM value — every
 * field is drawn as an empty rule. Selected real technical packs are intended
 * for publication here and will replace them.
 *
 * NOTHING IS FETCHED UNTIL IT IS ASKED FOR. The previews are small WebP images
 * of page 01; the PDFs themselves are plain links until the runtime turns a
 * click into an <iframe>, so opening the chapter costs five thumbnails rather
 * than five documents.
 */
import type { TechPack } from '../../data/portfolio';
import { chapters } from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import WorldNavigation from './WorldNavigation.astro';

interface Props {
  packs: TechPack[];
}

const { packs } = Astro.props;
const anyDemo = packs.some((pack) => pack.demo);
const chapter = chapters.find((item) => item.id === 'tech-packs')!;
---

<section class="pf-world pf-world--docs" id="tech-packs" data-world="tech-packs" tabindex="-1" aria-labelledby="tech-packs-title">
  <WorldNavigation current="tech-packs" />
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>03</b> Tech Packs</p>
    </div>

    <header class="pf-docroom__arrival">
      <div class="pf-docroom__copy">
        <p class="label">Documentation / production handoff</p>
        <h2 class="display" id="tech-packs-title">Tech<br />Packs</h2>
        <p>Production-ready instructions a factory can build from.</p>
      </div>
      <figure class="pf-docroom__cover">
        <img
          src={chapter.cover.image.src}
          srcset={chapter.cover.image.srcset}
          sizes="(max-width: 767px) 92vw, 58vw"
          width={chapter.cover.image.width}
          height={chapter.cover.image.height}
          alt={chapter.cover.image.alt}
          loading="eager"
          decoding="async"
        />
        <figcaption><span>Chapter cover</span><b>Technical specification / supplied reference</b></figcaption>
      </figure>
      <span class="pf-docroom__register" aria-hidden="true"></span>
    </header>

    {anyDemo && (
      <p class="pf-prov pf-docroom__notice" data-demo-notice>
        <b class="label">Interface prototype</b>
        <span>
          These are demo packs, marked DEMO on every page and carrying no client name, measurement,
          grading or bill-of-materials value. Selected real technical packs will replace them.
        </span>
      </p>
    )}

    {packs.length > 0 ? (
      <div class="pf-docroom" data-document-room>
        <nav class="pf-docroom__index" aria-label="Document index" role="tablist">
          <p class="label">Five production dossiers</p>
          <ol>
            {packs.map((pack, index) => (
              <li>
                <a
                  id={`document-tab-${pack.id}`}
                  href={`#preview-${pack.id}`}
                  role="tab"
                  aria-controls={`document-${pack.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? '0' : '-1'}
                  data-doc-select={pack.id}
                >
                  <i>{String(index + 1).padStart(2, '0')}</i>
                  <span>{pack.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <ol class="pf-docs">
          {packs.map((pack, index) => (
          <li
            class="pf-doc"
            id={`document-${pack.id}`}
            data-doc={pack.id}
            data-doc-panel
            data-active={index === 0 ? '' : undefined}
            role="tabpanel"
            aria-labelledby={`document-tab-${pack.id}`}
          >
            <a
              class="pf-doc__page"
              id={`preview-${pack.id}`}
              href={pack.pdfUrl}
              target="_blank"
              rel="noopener"
              data-open-pdf={pack.pdfUrl ? '' : undefined}
              data-doc-title={pack.title}
              aria-label={`Open ${pack.title} PDF reader`}
            >
              {pack.coverImage ? (
                <img
                  src={pack.coverImage.src}
                  srcset={pack.coverImage.srcset}
                  sizes="(max-width: 899px) 92vw, 56vw"
                  width={pack.coverImage.width}
                  height={pack.coverImage.height}
                  alt={pack.coverImage.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="pf-doc__blank" aria-hidden="true"></span>
              )}
            </a>

            <div class="pf-doc__meta">
              <p class="label pf-doc__num">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="pf-doc__title">{pack.title}</h3>
              <p class="pf-doc__line">
                {pack.category} / {pack.garmentType}{pack.pageCount ? ` / ${pack.pageCount} pages` : ''}
              </p>
              {pack.demo && <p class="label pf-doc__stamp">Demo — interface prototype</p>}
              <p class="label pf-doc__instruction">Select the document to read</p>
            </div>
          </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="pf-empty">
        <p class="pf-empty__lead">Selected technical pack examples will appear here.</p>
        <a class="button" href="/contact/">Ask about technical documentation <span><Arrow /></span></a>
      </div>
    )}
  </div>

  {/* The reader. Empty on load; the runtime builds the frame on the click that
      asks for a document and tears it down again on close. */}
  <dialog class="pf-reader" data-reader aria-label="Technical document reader" hidden>
    <div class="pf-reader__bar">
      <p class="label pf-reader__title" data-reader-title></p>
      <span class="pf-reader__tools">
        <a class="label pf-reader__tab" href="#" target="_blank" rel="noopener" data-reader-tab>Open in a new tab</a>
        <button type="button" class="pf-reader__close" data-reader-close>
          Close <span aria-hidden="true">&#215;</span>
        </button>
      </span>
    </div>
    <div class="pf-reader__mount" data-reader-mount></div>
  </dialog>
</section>

<script>
  const room = document.querySelector<HTMLElement>('[data-document-room]');
  if (room) {
    const tabs = [...room.querySelectorAll<HTMLAnchorElement>('[data-doc-select]')];
    const panels = [...room.querySelectorAll<HTMLElement>('[data-doc-panel]')];
    const select = (id: string, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab.dataset.docSelect === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel.dataset.doc === id;
        panel.hidden = !active;
        panel.toggleAttribute('data-active', active);
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(tab.dataset.docSelect ?? '');
      });
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
          : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(tabs[next]?.dataset.docSelect ?? '', true);
      });
    });
    select(tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')?.dataset.docSelect ?? '');
  }
</script>
