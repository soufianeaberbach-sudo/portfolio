---
/* Tech Packs — five documents, one below another, and a reader.
 *
 * No folio table, no book pile, no side index: a technical pack is a document,
 * and the honest presentation of five documents is five documents in a column,
 * each showing its own first page at a size you can actually read.
 *
 * Five owner-authorized Development Samples replace the earlier blank demos.
 * They demonstrate proposed construction and measurement engineering; they do
 * not claim approved factory production or client manufacture.
 *
 * NOTHING IS FETCHED UNTIL IT IS ASKED FOR. The previews are small WebP images
 * of page 01; the PDFs themselves are plain links until the runtime turns a
 * click into a page-image reader, so opening the chapter costs five thumbnails rather
 * than five documents.
 */
import pagePreviews from '../../data/techpack-page-previews.json';
import pageImages from '../../data/techpack-pages.json';
import type { TechPack } from '../../data/portfolio';
import { chapterNumber } from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import WorldNavigation from './WorldNavigation.astro';

interface Props {
  packs: TechPack[];
}

const { packs } = Astro.props;
const anyDemo = packs.some((pack) => pack.demo);
---

<section class="pf-world pf-world--docs" id="tech-packs" data-world="tech-packs" tabindex="-1" aria-labelledby="tech-packs-title">
  <WorldNavigation current="tech-packs" />
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>{chapterNumber('tech-packs')}</b> Tech Packs</p>
    </div>

    <header class="pf-head">
      <h2 class="display" id="tech-packs-title">Tech Packs</h2>
      <p class="pf-head__descriptor">
        Garment-development samples demonstrating construction, materials, measurements and factory communication.
      </p>
      {anyDemo && (
        <p class="pf-prov" data-demo-notice>
          <b class="label">Interface prototype</b>
          <span>
            These are demo packs, marked DEMO on every page and carrying no client name, measurement,
            grading or bill-of-materials value. Selected real technical packs will replace them.
          </span>
        </p>
      )}
    </header>

    {packs.length > 0 ? (
      <ol class="pf-docs">
        {packs.map((pack, index) => (
          <li class="pf-doc" data-doc={pack.id} data-style-code={pack.styleCode} data-document-status={pack.status} data-document-revision={pack.revision} data-side={index % 2 === 0 ? 'left' : 'right'}>
            <a
              class="pf-doc__page"
              id={`preview-${pack.id}`}
              href={pack.pdfUrl}
              target="_blank"
              rel="noopener"
              data-open-pdf={pack.pdfUrl ? '' : undefined}
              data-doc-title={pack.title}
              data-page-images={JSON.stringify(pageImages[pack.styleCode as keyof typeof pageImages] ?? [])}
              data-page-previews={JSON.stringify(pagePreviews[pack.styleCode as keyof typeof pagePreviews] ?? [])}
              aria-label={`Open ${pack.title} document reader`}
            >
              {pack.coverImage ? (
                <img
                  src={pack.coverImage.src}
                  srcset={pack.coverImage.srcset}
                  sizes="(max-width: 899px) 92vw, 56vw"
                  width={pack.coverImage.width}
                  height={pack.coverImage.height}
                  alt={pack.coverImage.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ) : (
                <span class="pf-doc__blank" aria-hidden="true"></span>
              )}
            </a>

            <div class="pf-doc__meta">
              <p class="label pf-doc__num">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="pf-doc__title">{pack.title}</h3>
              <p class="pf-doc__line">
                {pack.category} / {pack.garmentType}{pack.pageCount ? ` / ${pack.pageCount} pages` : ''}
              </p>
              {pack.status === 'development-sample' && <p class="label pf-doc__stamp">{pack.styleCode} / Development Sample</p>}
              {pack.description && <p class="pf-doc__line">{pack.description}</p>}
              {pack.demo && <p class="label pf-doc__stamp">Demo — interface prototype</p>}
              <p class="label pf-doc__instruction">Select the document to read</p>
              <p class="label"><a href={pack.pdfUrl} target="_blank" rel="noopener" data-doc-open-link>Open PDF</a> / <a href={pack.pdfUrl} download data-doc-download>Download PDF</a></p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="pf-empty">
        <p class="pf-empty__lead">Selected technical pack examples will appear here.</p>
        <a class="button" href="/contact/">Ask about technical documentation <span><Arrow /></span></a>
      </div>
    )}
  </div>

  <p class="label pf-material-credits"><a href="/techpacks/material-credits/">Material image credits</a></p>

  {/* The reader. Empty on load; the runtime mounts ordered page images on the click that
      asks for a document and tears it down again on close. */}
  <dialog class="pf-reader" data-reader aria-label="Technical document reader" hidden>
    <div class="pf-reader__bar">
      <p class="label pf-reader__title" data-reader-title></p>
      <span class="pf-reader__tools">
        <a class="label pf-reader__tab" href="#" target="_blank" rel="noopener" data-reader-tab>Open PDF</a>
        <a class="label pf-reader__tab" href="#" download data-reader-download>Download PDF</a>
        <button type="button" class="pf-reader__close" data-reader-close>
          Close <span aria-hidden="true">&#215;</span>
        </button>
      </span>
    </div>
    <div class="pf-reader__mount" data-reader-mount></div>
  </dialog>
</section>
