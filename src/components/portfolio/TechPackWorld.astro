---
/* Tech Packs — a technical library, deliberately not a fashion world.
 *
 * Completely separate from the garment deck: no PDF is ever mixed into that
 * carousel, and no garment photograph appears here.
 *
 * WHAT IS ON THE TABLE
 * The five documents are DEMO PACKS, generated by
 * .devtools/gen-demo-techpacks.mjs so the folio viewer could be designed and
 * judged against documents that actually open. Every page of every one of them
 * is stamped DEMO / INTERFACE PROTOTYPE / NOT CLIENT WORK and carries no client
 * name, no measurement, no grading increment and no BOM value — only the
 * section structure of a pack, with every field drawn as an empty rule. The
 * interface says that at the folio, at the index and at the open control, so a
 * demo cannot be mistaken for published work.
 *
 * Selected real technical packs ARE intended for publication here and will
 * replace these. An earlier pass said packs were client-owned and shared only
 * on request; that is not the intended policy and has been removed.
 */
import type { TechPack } from '../../data/portfolio';
import Arrow from '../Arrow.astro';

interface Props {
  packs: TechPack[];
}

const { packs } = Astro.props;
const anyDemo = packs.some((pack) => pack.demo);

/* What a production pack from this desk is made of. These are section names,
   not values — there is no fake grading increment or fabric consumption
   anywhere on this page. */
const contents = [
  { number: '01', name: 'Technical flat', note: 'Front, back and any construction detail needing its own view.' },
  { number: '02', name: 'Construction detail', note: 'Seam type, stitch class and finish, called out where it is not obvious.' },
  { number: '03', name: 'Measurement chart', note: 'Points of measure defined so the factory and the client measure the same way.' },
  { number: '04', name: 'Grading', note: 'Increments across the size range, with the rules that produced them.' },
  { number: '05', name: 'Bill of materials', note: 'Every component, placement and quantity the garment consumes.' },
  { number: '06', name: 'Label and packing', note: 'Care, content, placement and how the garment leaves the line.' },
];
---

<section class="pf-world pf-world--docs" id="tech-packs" data-world="tech-packs" tabindex="-1" aria-labelledby="tech-packs-title">
  <div class="pf-world__bar">
    <a class="pf-world__back" href="#portfolio-index" data-world-close>
      <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
    </a>
    <p class="label pf-world__tag"><b>03</b> Tech Packs</p>
  </div>

  <header class="pf-world__head">
    <div class="pf-world__headline">
      <h2 class="display" id="tech-packs-title">Tech Packs</h2>
      <p class="pf-world__descriptor">Production-ready technical documentation — the document a factory can build from without calling to ask what was meant.</p>
    </div>

    {anyDemo && (
      <aside class="pf-prov" data-demo-notice>
        <p class="label pf-prov__label">Interface prototype</p>
        <p class="pf-prov__text">
          The documents on this table are demo packs, marked DEMO on every page and carrying no client
          name, measurement, grading or bill-of-materials value. Selected real technical packs will replace them.
        </p>
      </aside>
    )}
  </header>

  {packs.length > 0 ? (
    <div class="pf-library">
      {/* ---- the folio table ------------------------------------------- */}
      <div class="pf-library__table">
        {/* The rest of the library, lying on the table behind the open
            dossier. Drawn from the same paper as the folio itself — offsets
            and hairlines, no gloss and no page curl. */}
        <span class="pf-library__pile" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>

        {packs.map((pack, index) => (
          <figure class="pf-folio" data-dossier={pack.id} hidden={index !== 0}>
            <span class="pf-folio__object">
              {/* Three page edges, so the dossier has thickness. */}
              <span class="pf-folio__edge" aria-hidden="true"></span>
              <span class="pf-folio__edge" aria-hidden="true"></span>
              <span class="pf-folio__edge" aria-hidden="true"></span>

              <span class="pf-folio__cover">
                <span class="pf-folio__spine" aria-hidden="true"></span>
                {pack.coverImage ? (
                  <img
                    class="pf-folio__scan"
                    src={pack.coverImage.src}
                    srcset={pack.coverImage.srcset}
                    sizes="(max-width: 899px) 88vw, 44vw"
                    width={pack.coverImage.width}
                    height={pack.coverImage.height}
                    alt={pack.coverImage.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : (
                  <span class="pf-folio__print">
                    <span class="pf-folio__printhead">
                      <i class="label">{pack.category} / {pack.garmentType}</i>
                      {pack.demo && <i class="label pf-folio__stamp">Demo</i>}
                    </span>
                    <span class="pf-folio__rules" aria-hidden="true">
                      <i></i><i></i><i></i><i></i><i></i>
                    </span>
                    <span class="pf-folio__printfoot label">
                      {pack.pageCount ? `${pack.pageCount} pages` : 'Technical dossier'}
                    </span>
                  </span>
                )}
              </span>
            </span>

            <figcaption class="pf-folio__meta">
              <p class="label pf-folio__kind">{pack.demo ? 'Demo pack — interface prototype' : 'Technical dossier'}</p>
              <h3>{pack.title}</h3>
              {pack.scope && pack.scope.length > 0 && (
                <p class="pf-folio__scope">{pack.scope.join(' / ')}</p>
              )}
              {/* The PDF is never fetched with the page. It is requested by
                  this control and nothing else — one document at a time. */}
              {pack.pdfUrl && (
                <a class="button button--signal pf-folio__open" href={pack.pdfUrl} target="_blank" rel="noopener" data-open-pdf>
                  Open dossier{pack.pageCount ? ` — ${pack.pageCount} pages` : ''} <span><Arrow /></span>
                </a>
              )}
            </figcaption>
          </figure>
        ))}
      </div>

      {/* ---- the side index -------------------------------------------- */}
      <aside class="pf-library__index">
        <p class="label pf-library__head">Library</p>
        <ol class="pf-library__list">
          {packs.map((pack, index) => (
            <li>
              <button type="button" class="pf-doc" data-doc={pack.id} aria-pressed={index === 0 ? 'true' : 'false'}>
                <i class="pf-doc__mark" aria-hidden="true"></i>
                <i class="label pf-doc__num">{String(index + 1).padStart(2, '0')}</i>
                <span class="pf-doc__title">{pack.title}</span>
                <small class="pf-doc__meta">{pack.garmentType}{pack.pageCount ? ` / ${pack.pageCount}pp` : ''}</small>
              </button>
            </li>
          ))}
        </ol>

        <p class="label pf-library__head pf-library__head--split">What a pack contains</p>
        <ol class="pf-contents">
          {contents.map((item) => (
            <li>
              <i class="label">{item.number}</i>
              <span>{item.name}</span>
              <small>{item.note}</small>
            </li>
          ))}
        </ol>

        <a class="button" href="/contact/">Ask about technical documentation <span><Arrow /></span></a>
      </aside>
    </div>
  ) : (
    <div class="pf-empty">
      <p class="pf-empty__lead">Selected technical pack examples will appear here.</p>
      <a class="button" href="/contact/">Ask about technical documentation <span><Arrow /></span></a>
    </div>
  )}
</section>
