---
import {getLocale} from '../../i18n/locales';
import {garmentAlt} from '../../i18n/garments';
import type{ImageAsset,SubjectView}from'../../data/portfolio';
import{photoRegion,photoSizes}from'../../data/final-photography';
interface Props{image:ImageAsset;crop?:SubjectView['crop'];eager?:boolean;sizes?:string;}
const{image,crop='whole',eager=false,sizes='(max-width:767px) 92vw, 55vw'}=Astro.props;
const[start,end]=photoRegion(image,crop),portion=end-start;
---
<span class="mw-photo" data-mw-photo data-door-source style={`--photo-aspect:${image.width*portion/image.height};--photo-offset:${-100*start/portion}%;--photo-width:${100/portion}%`}>
 <img src={image.src} srcset={image.srcset} width={image.width} height={image.height} alt={garmentAlt(image.alt,getLocale(Astro.url))} loading={eager?'eager':'lazy'} decoding="async" sizes={photoSizes(image,crop,sizes)}/>
</span>
