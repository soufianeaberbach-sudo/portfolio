---
import type { GarmentWorld, MarketCategory, ImageAsset, Subject } from '../../data/portfolio';
import { REFERENCE_DISCLAIMER, SUBJECT_STORY_PENDING, projectSubject, referenceSubject, worldPublication } from '../../data/portfolio';
import { exhibitionImage } from '../../data/womenswear-exhibition';
import Arrow from '../Arrow.astro';
import StoryPlate from './StoryPlate.astro';
import ActFigure from './ActFigure.astro';
interface Props { world: GarmentWorld; lab?: { category: string; subject: Subject }; }
const { world, lab } = Astro.props;
const publication = worldPublication(world);
const noun = publication === 'published' ? 'Project' : 'Reference';
const pool = (category: MarketCategory): Subject[] => publication === 'published'
  ? [...category.projects].sort((a,b) => Number(b.spotlight ?? false)-Number(a.spotlight ?? false)).map(p => projectSubject(p,world.id))
  : category.references.map(r => referenceSubject({...r,image:exhibitionImage(r.image)},world.id,category.id));
// Editorial selection refers to actual archive IDs, never position-dependent geometry.
const edit = [
  { id:'rtw', short:'Ready-to-Wear', hero:'rtw-ref-01', selected:['rtw-ref-07','rtw-ref-10','rtw-ref-11'] },
  { id:'activewear', short:'Activewear', hero:'activewear-ref-08', selected:['activewear-ref-01','activewear-ref-04'] },
  { id:'streetwear', short:'Streetwear', hero:'streetwear-ref-02', selected:['streetwear-ref-01'] },
  { id:'evening', short:'Occasion', hero:'evening-ref-04', selected:['evening-ref-06','evening-ref-11'] },
  { id:'swimwear', short:'Swim', hero:'swimwear-ref-06', selected:['swimwear-ref-01','swimwear-ref-04'] },
];
const territories = edit.flatMap(t => {
  const category = world.categories.find(c => c.id === t.id);
  if (!category) return [];
  const slots = pool(category);
  if(lab?.category === t.id) slots.unshift(lab.subject);
  if(!slots.length) return [];
  const hero = lab?.category === t.id ? lab.subject : slots.find(s => s.id === t.hero) ?? slots[0];
  const selected = slots.filter(s => s !== hero && (s.verified ? s.role === 'featured' : t.selected.includes(s.id)));
  const supporting = slots.filter(s => s !== hero && !selected.includes(s));
  return [{...t,category,slots,hero,selected,supporting, paired: selected.length === 1 && supporting.length === 0}];
});
const everySubject = territories.flatMap(territory => territory.slots.map((subject,index) => ({subject,territory,index})));
const door = (subject: Subject) => `#${world.id}/${subject.category}/${subject.id}`;
const geom = (image: ImageAsset) => `--front:${image.front};--aspect:${(image.width/image.height).toFixed(4)};`;
const pad = (n:number) => String(n).padStart(2,'0');
---
<section
  class="pf-world pf-act"
  id={world.id}
  data-world={world.id}
  data-act
  data-publication={publication}
  tabindex="-1"
  aria-labelledby={`${world.id}-title`}
>
  {/* No world switcher rail: the act's own bar carries the way back and the
      five territories. Menswear keeps its rail until its own act is written. */}
  <div class="pf-screen pf-act__screen" data-screen="index">
    {/* ---- THE ONE CONTROL ------------------------------------------------
        Attraction first, control second. The bar names where the visitor is
        and opens the five territories on demand — by their real names, not by
        an abstraction anybody has to decode. */}
    <div class="pf-act__bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio
      </a>
      <nav class="pf-act__where" aria-label="Womenswear territories" data-act-where>
        <button type="button" class="pf-act__now label" data-act-toggle aria-expanded="false">
          <span data-act-count>{pad(1)} / {pad(territories.length)}</span>
          <span class="pf-act__nowname" data-act-name>{territories[0]?.short}</span>
          <i class="pf-act__caret" aria-hidden="true"></i>
        </button>
        <ol class="pf-act__list" data-act-list>
          {territories.map((t, i) => (
            <li>
              <a href={`#${world.id}/${t.category.id}`} data-nav data-act-link={t.category.id}>
                <i class="pf-act__n label">{pad(i + 1)}</i>
                <span class="pf-act__label">{t.short}</span>
                <small>{t.category.label}</small>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <h2 class="pf-act__sr" id={`${world.id}-title`}>{world.title}</h2>

    {territories.map((t,index) => (
      <article class="pf-tr" id={`${world.id}-${t.id}`} data-movement={t.id} data-territory={t.id}
        data-act-title={t.short} aria-labelledby={`${world.id}-${t.id}-title`}>
        <div class="pf-edit__hero" data-paired={t.paired ? '' : undefined} data-hero>
          <header class="pf-edit__title">
            <p class="label pf-edit__chapter">Womenswear <span>{pad(index+1)}</span></p>
            <h3 class="display" id={`${world.id}-${t.id}-title`}>{t.short}</h3>
            <a class="pf-edit__enter label" href={door(t.hero)} data-nav data-open-subject={t.hero.id}>Enter the garment <Arrow /></a>
          </header>
          <ActFigure item={t.hero} href={door(t.hero)} noun={noun} crop="front" sizes="(max-width: 767px) 92vw, 55vw" class="pf-edit__lead" weight="featured" />
          {t.paired && <ActFigure item={t.selected[0]} href={door(t.selected[0])} noun={noun} crop="front" sizes="(max-width: 767px) 46vw, 32vw" class="pf-edit__companion" weight="featured" />}
        </div>
        {t.selected.length > 0 && !t.paired && (
          <div class="pf-edit__selected" aria-label={`${t.short} selected work`}>
            {t.selected.map(item => <ActFigure item={item} href={door(item)} noun={noun} crop="front" sizes="(max-width: 767px) 48vw, 36vw" weight="featured" />)}
          </div>
        )}
        {t.supporting.length > 0 && (
          <div class="pf-edit__support" role="region" aria-label={`${t.short} further garments`} tabindex="0">
            {t.supporting.map(item => <ActFigure item={item} href={door(item)} noun={noun} crop="front" sizes="(max-width: 767px) 48vw, 22vw" />)}
          </div>
        )}
      </article>
    ))}

    <div class="pf-rd" data-subject-stack aria-live="off">
      {everySubject.map(({ subject, territory, index }) => {
        /* ROLE IS PRESENTATION WEIGHT, NEVER ACCESS. Every stage a project
           supplied is rendered, whatever its role; the role decides how much
           room the story is given:
             hero        full — each movement holds the screen
             featured    compact — the same movements, closer together, no
                         return to the result
             supporting  folded — the garment first, and the story one
                         deliberate press away rather than withheld */
        const weight = subject.role === 'hero' ? 'full' : subject.role === 'featured' ? 'compact' : 'folded';
        /* THE THREE MOVEMENTS a story is told in. Each stage has a narrative
           job, so they are grouped by job rather than listed in file order. */
        const origin = subject.origin;
        const iterations = subject.build.filter((st) => st.label === 'Iteration');
        const construction = subject.build.filter((st) => st.key === 'flat' || st.key === 'pattern');
        const validation = subject.build.filter((st) => (st.key === 'clo' || st.key === 'fit') && st.label !== 'Iteration');
        const story = [...origin, ...construction, ...validation, ...iterations];
        const hasStory = story.length > 0;
        const returns = hasStory && weight === 'full';
        const front = subject.views[0];
        const pattern = construction.find((st) => st.key === 'pattern') ?? construction[0];
        const flat = construction.find((st) => st !== pattern);
        const storyId = `${subject.id}-story`;
        return (
          <article
            class="pf-rd__subject"
            id={`${world.id}-${subject.category}-${subject.id}`}
            data-subject={subject.id}
            data-of={subject.category}
            data-rd-reveal="editorial"
            data-role={subject.role}
            data-verified={subject.verified ? 'yes' : 'no'}
            data-fixture={subject.fixture ? '' : undefined}
            data-story={hasStory ? weight : undefined}
            aria-labelledby={`${subject.id}-rd-title`}
            tabindex="-1"
            hidden
          >
            {/* ---- THE HEAD. Where you are, and the way out. Deliberately
                the same furniture as the act's own bar, because entering a
                garment is not leaving the chapter. */}
            <header class="pf-rd__head">
              <a class="pf-rd__back label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                <i aria-hidden="true"><Arrow dir="left" /></i>
                <span>{territory.short}</span>
              </a>
              <p class="pf-rd__where label">
                <b>{pad(index + 1)}</b>
                <span>{territory.category.label}</span>
                {/* Where in the garment's story the visitor is, named once in
                    the bar rather than as a heading over every movement. */}
                {hasStory && <i class="pf-rd__beat" data-rd-beat aria-hidden="true"></i>}
              </p>
            </header>

            {/* ---- THE VIEWS. The garment, at the size a garment has to be
                looked at, with the same front/back access in every category. */}
            <section class="pf-rd__views" data-rd-views aria-label="The garment">
              <div class="pf-rd__type">
                {/* A verified project is named by its title. A reference is
                    named by what is actually in the frame — the alt text's own
                    description, which is a statement about the photograph and
                    not a claim about its author. Either way the visitor is
                    told WHICH garment they are looking at, which a territory
                    name repeated forty-nine times never did. */}
                <h3 class="pf-rd__title" id={`${subject.id}-rd-title`}>
                  {subject.title ?? subject.caption ?? territory.short}
                  {subject.garmentType && <i>{subject.garmentType}</i>}
                </h3>
                {subject.title && subject.caption && (
                  <p class="pf-rd__caption">{subject.caption}</p>
                )}
                {subject.decision && !hasStory && (
                  /* THE ONE PLACE a sentence may be specific about a garment,
                     and only ever in the designer's own words. A garment with a
                     story says it where it is proven — at the construction. */
                  <p class="pf-rd__decision">{subject.decision}</p>
                )}
                {/* INSPECTION. Not a gallery control — one affordance, because
                    the whole point of entering a garment is being able to look
                    at it properly. */}
                <div class="pf-rd__tools">
                  <button type="button" class="pf-rd__inspect label" data-rd-inspect aria-pressed="false">
                    Look closer
                  </button>
                  {subject.views.length > 1 && (
                    <p class="pf-rd__views-of label" data-rd-count>
                      {subject.views.map((v,vi) => <button type="button" data-rd-select={vi} aria-pressed={vi === 0 ? 'true' : 'false'}>{v.label}</button>)}
                    </p>
                  )}
                </div>
                {/* THE WAY DOWN. Desire first: the garment holds the screen,
                    and the story is offered once, quietly, after it. A folded
                    story is the same invitation, and the press unfolds it. */}
                {hasStory && (
                  <button type="button" class="pf-rd__into label" data-st-into
                          aria-controls={storyId}
                          aria-expanded={weight === 'folded' ? 'false' : undefined}>
                    <span>How it became real</span>
                    <i aria-hidden="true"><Arrow dir="down" /></i>
                  </button>
                )}
              </div>
              <div class="pf-rd__stage" data-rd-stage>
                {
                  subject.views.map((v, vi) => (
                    <figure class="pf-rd__view" data-view={v.key} data-crop={v.crop} data-index={vi}
                            style={geom(v.image)}>
                      <span class="pf-rd__window" data-rd-window>
                        <img
                          src={v.image.src} srcset={v.image.srcset}
                          sizes="(max-width: 767px) 92vw, 46vw"
                          width={v.image.width} height={v.image.height} alt={v.image.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                      <figcaption class="pf-rd__vname label">{v.label}</figcaption>
                    </figure>
                  ))
                }
              </div>
            </section>

            {/* ---- THE STORY. How the garment became real, told in the
                movements its own evidence supports — and only those. Nothing
                is rendered for a stage the project did not supply. */}
            {hasStory && (
              <div class="pf-st" id={storyId} data-st data-st-weight={weight}>
                {/* WHERE IT STARTED. The drawing is the birth of the
                    silhouette, so it is held large — and the garment it became
                    stands beside it, small, so the eye makes the connection
                    rather than a caption. */}
                {origin.length > 0 && (
                  <section class="pf-st__mv pf-st__mv--origin" data-st-beat="Where it started" aria-label="Where it started">
                    <div class="pf-st__idea">
                      <div class="pf-st__drawn" data-st-item>
                        {origin.map((st) => (
                          <StoryPlate stage={st} fixture={subject.fixture}
                                      sizes="(max-width: 767px) 92vw, 44vw" />
                        ))}
                      </div>
                      {/* What the drawing became, on the same floor as the
                          drawing — the eye reads from one to the other. */}
                      {front && (
                        <figure class="pf-st__became" data-st-item data-crop={front.crop} style={geom(front.image)}>
                          <span class="pf-st__window">
                            <img
                              src={front.image.src} srcset={front.image.srcset}
                              sizes="(max-width: 767px) 30vw, 12vw"
                              width={front.image.width} height={front.image.height} alt=""
                              loading="lazy" decoding="async"
                            />
                          </span>
                          <figcaption class="label">Became</figcaption>
                        </figure>
                      )}
                    </div>
                    {origin[0].note && (
                      <div class="pf-st__aside">
                        <p class="pf-st__words" data-st-item>{origin[0].note}</p>
                      </div>
                    )}
                  </section>
                )}

                {/* HOW IT WAS BUILT. The construction is one decision made
                    real, so the decision is said first, in the designer's
                    words, and the pattern carries it — wide, the way a pattern
                    is laid out. The flat is its key, not its equal. */}
                {construction.length > 0 && (
                  <section class="pf-st__mv pf-st__mv--build" data-st-beat="How it was built" aria-label="How it was built">
                    {subject.decision && <p class="pf-st__decision" data-st-item>{subject.decision}</p>}
                    <div class="pf-st__drawing" data-st-item>
                      {pattern && (
                        <StoryPlate stage={pattern} class="pf-st__pattern" fixture={subject.fixture}
                                    sizes="(max-width: 767px) 92vw, 62vw" />
                      )}
                      {flat && (
                        <StoryPlate stage={flat} class="pf-st__flat" fixture={subject.fixture}
                                    sizes="(max-width: 767px) 60vw, 22vw" />
                      )}
                    </div>
                    {pattern?.note && <p class="pf-st__words pf-st__words--build" data-st-item>{pattern.note}</p>}
                  </section>
                )}

                {/* HOW IT WAS PROVEN. The test and the evidence that it held,
                    side by side at one height — the 3D state against the body —
                    and the attempts it took, as a quiet run underneath. */}
                {(validation.length > 0 || iterations.length > 0) && (
                  <section class="pf-st__mv pf-st__mv--proof" data-st-beat="How it was proven" aria-label="How it was proven">
                    {validation.length > 0 && (
                      <div class="pf-st__pair" data-st-item>
                        {validation.map((st) => (
                          <StoryPlate stage={st} class="pf-st__proof" fixture={subject.fixture}
                                      sizes="(max-width: 767px) 78vw, 30vw" />
                        ))}
                      </div>
                    )}
                    {iterations.length > 0 && (
                      <ol class="pf-st__runs" data-st-item aria-label="Iterations">
                        {iterations.map((st, i) => (
                          <li>
                            <StoryPlate stage={st} caption={`Iteration ${i + 1}`} class="pf-st__run"
                                        fixture={subject.fixture} sizes="(max-width: 767px) 30vw, 10vw" />
                            {st.note && <p class="pf-st__note">{st.note}</p>}
                          </li>
                        ))}
                      </ol>
                    )}
                  </section>
                )}
              </div>
            )}

            {/* ---- THE RESULT, again. The same garment, now whole — both of
                its views at once — and now understood. Only after a full
                story: a return with nothing behind it is just a repeat. */}
            {returns && front && (
              <section class="pf-st__mv pf-st__mv--return" data-st-beat="The result" aria-label="The result">
                <div class="pf-st__result" data-st-item>
                  {subject.views.slice(0, 2).map((v) => (
                    <figure class="pf-st__final" data-crop={v.crop} style={geom(v.image)}>
                      <span class="pf-st__window">
                        <img
                          src={v.image.src} srcset={v.image.srcset}
                          sizes="(max-width: 767px) 92vw, 50vw"
                          width={v.image.width} height={v.image.height} alt={v.image.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                    </figure>
                  ))}
                </div>
                <div class="pf-st__close">
                  <p class="pf-st__name">{subject.title ?? subject.caption}</p>
                  <a class="pf-rd__out label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                    <i aria-hidden="true"><Arrow dir="left" /></i>
                    <span>Back to {territory.short}</span>
                  </a>
                </div>
              </section>
            )}

            {/* ---- WHAT IS NOT HERE, said plainly. */}
            {!subject.verified && (
              <p class="pf-rd__pending" data-subject-pending>{SUBJECT_STORY_PENDING}</p>
            )}

            {!returns && (
              <footer class="pf-rd__foot">
                <a class="pf-rd__out label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                  <i aria-hidden="true"><Arrow dir="left" /></i>
                  <span>Back to {territory.short}</span>
                </a>
              </footer>
            )}
          </article>
        );
      })}
    </div>

    {/* ---- THE CLOSE ------------------------------------------------------
        Act I resolves and hands over. The emotional movement of the whole
        Portfolio is instinct toward construction, so Womenswear ends on the
        word Menswear's cover is already built around. This is the act's one
        strong use of red. */}
    <footer class="pf-act__end">
      <p class="pf-act__endline display">
        Act I was <span>fluidity</span>.<br />Act II is <em>proportion</em>.
      </p>
      {publication === 'reference-preview' && (
        <p class="pf-prov pf-act__prov" data-reference-notice>
          <b class="label">Reference preview</b>
          <span>{REFERENCE_DISCLAIMER}</span>
        </p>
      )}
      <a class="pf-act__next label" href="#menswear" data-nav data-chapter="menswear">
        Menswear <Arrow />
      </a>
    </footer>
  </div>
</section>
