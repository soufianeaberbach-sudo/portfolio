---
/* WOMENSWEAR — ACT I.
 *
 * WHAT THIS IS
 *
 * One authored act in five territories, told in BEATS. A beat is a scene with
 * its own composition, its own pacing and its own typographic weight. The
 * score below says which beats a territory plays and in what order, and no
 * two territories play the same shape:
 *
 *   01 READY-TO-WEAR   overture ..................... sheet   (15)
 *   02 ACTIVEWEAR      slate ........................ deck    (6)
 *   03 STREETWEAR      pair
 *   04 OCCASION        slate · turn · evidence ...... rail    (8)
 *   05 SWIM            slate · approach ............. line    (8)
 *
 * THE RULE THIS FILE IS BUILT ON: THE WORK DECIDES THE PRESENTATION.
 *
 * An earlier version of this act was organised around a fact about the
 * current placeholder archive — that many of its photographs happen to hold a
 * front and a back view in one file — and turned that into the grammar of the
 * whole chapter. A temporary property of temporary images is not a creative
 * identity. So the front-to-back TURN is now one scene device among several,
 * used twice in the act and only where the back genuinely is the garment.
 *
 * HIERARCHY. Not every frame is worth the same. One frame per territory owns
 * a scene; the rest are supporting work, shown in the mechanism that territory
 * earns — a proof sheet for the broad one, a swipeable deck for the kinetic
 * one, a rack for the dramatic one, a single graphic line for the reduced one.
 * Four different mechanisms, one per territory, so depth of work reads as
 * depth rather than as a file count.
 *
 * COPY. Near-silence, on purpose. The territory's name, a true count, and one
 * pointer about what is actually in the frame. There is no line here that a
 * file cannot support: no project, no client, no construction reasoning read
 * off a photograph. The slots where a real project's own title and description
 * belong are wired and empty — see `lead()` and the hero scenes. When verified
 * work lands, the copy arrives with it and nothing about the composition has
 * to change.
 *
 * EVIDENCE. One proof beat, in Occasion, between the garment and the range —
 * garment, then a glimpse of the thinking, then garments again. It renders a
 * project's own sketch / pattern / simulation when there is one. Until then it
 * renders the STRUCTURE and says so. It is deliberately not a rail beside
 * every garment, and it is not the Development chapter moved in here.
 *
 * PRESERVED. The deck beat is the runway's own markup — `.pf-panel`,
 * `[data-stage]`, `[data-stack]`, `.pf-slot` — so drag, arrow keys, the
 * counter, the hash, focus and the server-rendered fallback keep working.
 */
import type { GarmentWorld, MarketCategory, ImageAsset, Reveal, Subject } from '../../data/portfolio';
import {
  REFERENCE_DISCLAIMER, SUBJECT_STORY_PENDING,
  projectSubject, referenceSubject, worldPublication,
} from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import StoryPlate from './StoryPlate.astro';

interface Props {
  world: GarmentWorld;
  /* The development-only story lab's test garment, which leads the named
     territory. Never passed by the public page. */
  lab?: { category: string; subject: Subject };
}

const { world, lab } = Astro.props;
const publication = worldPublication(world);

const noun = publication === 'published' ? 'Project' : 'Reference';
const unit = publication === 'published' ? 'projects' : 'frames';

/* EVERY GARMENT IN THE CHAPTER IS A SUBJECT — one shape whether the territory
   holds verified projects or, as now, reference photographs. The scenes below
   never ask which; they render the subject and the subject tells the truth
   about itself. */
const pool = (category: MarketCategory, reveal: Reveal): Subject[] =>
  publication === 'published'
    ? [...category.projects]
        /* Spotlit projects lead their territory; everything else keeps the
           order it was given. */
        .sort((a, b) => Number(b.spotlight ?? false) - Number(a.spotlight ?? false))
        .map((p) => projectSubject(p, world.id))
    : category.references.map((r) => referenceSubject(r, world.id, category.id, reveal));

/* ---- THE SCORE ---------------------------------------------------------
   `short` is the territory's name as the act says it out loud; the approved
   full category label is always printed with it. `slate` is how the name
   arrives, and it is not the same gesture twice: over the picture, led by the
   count, or set as a plain name. */
type Beat =
  | { kind: 'overture'; slot: number }
  | { kind: 'turn'; slot: number }
  | { kind: 'pair'; slots: [number, number] }
  | { kind: 'approach'; slot: number }
  | { kind: 'sheet'; from: number }
  | { kind: 'deck'; from: number }
  | { kind: 'rail'; from: number }
  | { kind: 'line'; from: number };

interface Territory {
  id: string;
  short: string;
  slate: 'over' | 'count' | 'name' | 'loud';
  /* HOW THIS TERRITORY'S GARMENTS GIVE UP THEIR VIEWS when one is entered.
     The information — front and back — is the same everywhere; the gesture is
     not, because a front/back switch repeated on every project is a shop
     control rather than art direction. A verified project may override it
     with its own. The territory's own character decides the default, which is
     also how the reader keeps the category's mood. */
  reveal: Reveal;
  /* One true sentence about what is in these frames, or nothing. Silence is
     the default: a line that cannot be supported is worse than no line. */
  pointer?: [string, string];
  beats: Beat[];
}

const score: Territory[] = [
  {
    /* THE BROAD TERRITORY. It leads with one long authored moment and then
       hands over its depth all at once, because seventeen equal hero scenes
       would be a file count rather than a body of work. */
    id: 'rtw',
    short: 'Ready-to-Wear',
    slate: 'over',
    /* The territory that introduced the move keeps it inside its garments. */
    reveal: 'turn',
    /* True of this photograph and the instruction for the move it is about to
       make. The only design-thinking line in the act, and it is about the
       frame, never about who made the garment. */
    pointer: ['Front and back, in one frame.', 'The back is where the decision shows.'],
    beats: [{ kind: 'overture', slot: 0 }, { kind: 'sheet', from: 1 }],
  },
  {
    /* THE QUICK ONE. No garment is held here at all: the territory arrives and
       the visitor is already moving through it. Its pace is the point. */
    id: 'activewear',
    short: 'Activewear',
    slate: 'count',
    /* Nothing waits here, so nothing is withheld: both views at once. */
    reveal: 'together',
    beats: [{ kind: 'deck', from: 0 }],
  },
  {
    /* THE INTERRUPTION. Two frames exist, so two frames are shown — once,
       large, unequal, and then it is over. Scarcity is the art direction. */
    id: 'streetwear',
    short: 'Streetwear',
    slate: 'loud',
    /* Attitude is control: the visitor moves between the views themselves. */
    reveal: 'drag',
    beats: [{ kind: 'pair', slots: [0, 1] }],
  },
  {
    /* THE SLOW ONE, and the only other place the turn is used: on a gown the
       back is not a second view, it is the garment. The proof beat sits here
       too — after the drama, before the range. */
    id: 'evening',
    short: 'Occasion',
    slate: 'name',
    /* Drama: the back arrives small and then takes the foreground. */
    reveal: 'foreground',
    beats: [
      { kind: 'turn', slot: 0 },
      { kind: 'rail', from: 1 },
    ],
  },
  {
    /* THE REDUCED ONE. These frames hold a single view, so there is nothing
       to turn and nothing is invented: the movement is scale, and the
       territory ends as one graphic line with the most white in the act. */
    id: 'swimwear',
    short: 'Swim',
    slate: 'name',
    /* These frames hold one view. Nothing is invented to make a second. */
    reveal: 'single',
    beats: [{ kind: 'approach', slot: 0 }, { kind: 'line', from: 1 }],
  },
];

const territories = score
  .map((t) => {
    const category = world.categories.find((c) => c.id === t.id);
    if (!category) return null;
    const slots = pool(category, t.reveal);
    return { ...t, category, slots: lab?.category === t.id ? [lab.subject, ...slots] : slots };
  })
  .filter((t): t is Territory & { category: MarketCategory; slots: Subject[] } => !!t && t.slots.length > 0);

/* Every subject in the act, in running order, so the reader can be rendered
   from the server and so one garment can be stepped to from inside another. */
const everySubject = territories.flatMap((t) =>
  t.slots.map((subject, index) => ({ subject, territory: t, index })));

/* THE DOOR. Every garment the chapter shows is one, in every mechanism: the
   contact sheet's cells, the deck's cards, the pair, the rail's hangers and
   Swim's line. A real anchor, so a subject is addressable, shareable and
   reachable with the script gone — and so the range is a way into the work
   rather than the end of it. */
const door = (subject: Subject) => `#${world.id}/${subject.category}/${subject.id}`;

/* Geometry every scene needs from a photograph: its aspect, and whether it
   holds two views. A single-view frame is never shown half at a time. */
/* What a FIGURE needs: the photograph's own aspect, and where its front view
   ends. How much of the frame is shown — one figure or the whole thing — is
   set by the `data-views` attribute in the stylesheet, so a scene can choose
   without the markup arguing with it. */
const geom = (image: ImageAsset) =>
  `--front:${image.front};--aspect:${(image.width / image.height).toFixed(4)};`;
/* What a SCENE needs when something outside the figure has to know the
   figure's width — the overture's studio field, which closes to exactly it. */
const plate = (image: ImageAsset) =>
  `${geom(image)}--half:${image.views === 2 ? '.5' : '1'};`;
const views = (image: ImageAsset) => (image.views === 2 ? '2' : '1');
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  class="pf-world pf-act"
  id={world.id}
  data-world={world.id}
  data-act
  data-publication={publication}
  tabindex="-1"
  aria-labelledby={`${world.id}-title`}
>
  {/* No world switcher rail: the act's own bar carries the way back and the
      five territories. Menswear keeps its rail until its own act is written. */}
  <div class="pf-screen pf-act__screen" data-screen="index">
    {/* ---- THE ONE CONTROL ------------------------------------------------
        Attraction first, control second. The bar names where the visitor is
        and opens the five territories on demand — by their real names, not by
        an abstraction anybody has to decode. */}
    <div class="pf-act__bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio
      </a>
      <nav class="pf-act__where" aria-label="Womenswear territories" data-act-where>
        <button type="button" class="pf-act__now label" data-act-toggle aria-expanded="false">
          <span data-act-count>{pad(1)} / {pad(territories.length)}</span>
          <span class="pf-act__nowname" data-act-name>{territories[0]?.short}</span>
          <i class="pf-act__caret" aria-hidden="true"></i>
        </button>
        <ol class="pf-act__list" data-act-list>
          {territories.map((t, i) => (
            <li>
              <a href={`#${world.id}/${t.category.id}`} data-nav data-act-link={t.category.id}>
                <i class="pf-act__n label">{pad(i + 1)}</i>
                <span class="pf-act__label">{t.short}</span>
                <small>{t.category.label}</small>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>

    <h2 class="pf-act__sr" id={`${world.id}-title`}>{world.title}</h2>

    {territories.map((t, index) => (
        <article
          class="pf-tr"
          id={`${world.id}-${t.category.id}`}
          data-movement={t.category.id}
          data-territory={t.category.id}
          data-slate={t.slate}
          data-act-title={t.short}
          data-beats={t.beats.map((b) => b.kind).join(' ')}
          aria-labelledby={`${world.id}-${t.category.id}-title`}
        >
          {/* ---- THE SLATE --------------------------------------------------
              How a territory announces itself. It is a transition the visitor
              crosses, not a menu they stop at — and the gesture is different
              each time: led by the count, set as a plain name, or set loud
              where a territory has almost nothing else to say. Ready-to-Wear
              has no slate at all: its name arrives over the opening picture,
              so the act begins in fashion rather than on a title card. */}
          {t.slate === 'over' ? (
            <h3 class="pf-act__sr" id={`${world.id}-${t.category.id}-title`}>
              {t.short} — {t.category.label}
            </h3>
          ) : (
            <header class="pf-tr__slate" data-slate-gesture={t.slate}>
              <p class="pf-tr__n label">{pad(index + 1)}</p>
              <h3 class="pf-tr__name display" id={`${world.id}-${t.category.id}-title`}>{t.short}</h3>
              <p class="pf-tr__meta label">
                <span>{t.category.label}</span>
                <i>{pad(t.slots.length)} {unit}</i>
              </p>
            </header>
          )}

          {t.beats.map((beat) => {
            /* ---- OVERTURE --------------------------------------------------
                THE FIRST THING AFTER THE COVER, and the act's opening set
                piece. Three frames out of one photograph and no new asset:
                the garment stands full height on a studio field that runs the
                whole width of the screen; the FIELD then closes in around it
                until the composition resolves and the type arrives; and only
                then does the window travel to the back. Reward, then
                composition, then reveal. */
            if (beat.kind === 'overture') {
              const item = t.slots[beat.slot];
              if (!item) return null;
              return (
                <div class="pf-sc pf-sc--overture" data-scene="overture" data-reveal data-hero
                     style={plate(item.cover)}>
                  <div class="pf-sc__frame">
                    <div class="pf-ov__field" data-ov-field></div>
                    <figure class="pf-ov__plate" data-views={views(item.cover)} style={geom(item.cover)}>
                      <span class="pf-ov__window" data-turn>
                        <img
                          src={item.cover.src}
                          srcset={item.cover.srcset}
                          sizes="(max-width: 767px) 92vw, 46vw"
                          width={item.cover.width}
                          height={item.cover.height}
                          alt={item.cover.alt}
                          loading="eager"
                          fetchpriority="high"
                          decoding="async"
                        />
                      </span>
                    </figure>
                    {/* The territory's name arrives OVER the picture as the
                        field closes, so discovery happens inside the scene
                        instead of stopping it. */}
                    <div class="pf-ov__slate" data-ov-slate>
                      <p class="pf-ov__name display">{t.short}</p>
                      <p class="pf-ov__meta label">
                        <b>{pad(index + 1)}</b>
                        <span>{t.category.label}</span>
                        <i>{pad(t.slots.length)} {unit}</i>
                      </p>
                    </div>
                    {t.pointer && (
                      <p class="pf-sc__pointer" data-ov-pointer>
                        {t.pointer[0]} <b>{t.pointer[1]}</b>
                      </p>
                    )}
                    {item.title && (
                      <p class="pf-sc__work label">{item.title}</p>
                    )}
                    {/* THE AFFORDANCE, TAUGHT ONCE. The hero garment can be
                        entered, and saying so here — quietly, in label type,
                        after the composition has resolved — is what tells the
                        visitor that every garment in the chapter can be. No
                        button is printed on any other picture. */}
                    <a class="pf-sc__enter label" href={door(item)} data-nav draggable="false" data-open-subject={item.id}>
                      <span>Enter this garment</span> <Arrow />
                    </a>
                  </div>
                </div>
              );
            }

            /* ---- TURN ------------------------------------------------------
                The lateral travel, used once more and only here: on a gown
                the back is the garment. No line — the picture is doing the
                talking and the device has already been explained once. */
            if (beat.kind === 'turn') {
              const item = t.slots[beat.slot];
              if (!item || item.cover.views !== 2) return null;
              return (
                <div class="pf-sc pf-sc--turn" data-scene="turn" data-reveal data-hero>
                  <div class="pf-sc__frame">
                    <figure class="pf-tn__plate" data-views="2" style={geom(item.cover)}>
                      <span class="pf-tn__window" data-turn>
                        <img
                          src={item.cover.src}
                          srcset={item.cover.srcset}
                          sizes="(max-width: 767px) 80vw, 34vw"
                          width={item.cover.width}
                          height={item.cover.height}
                          alt={item.cover.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                    </figure>
                    {item.title && <p class="pf-sc__work label">{item.title}</p>}
                    {/* THE AFFORDANCE, TAUGHT ONCE. The hero garment can be
                        entered, and saying so here — quietly, in label type,
                        after the composition has resolved — is what tells the
                        visitor that every garment in the chapter can be. No
                        button is printed on any other picture. */}
                    <a class="pf-sc__enter label" href={door(item)} data-nav draggable="false" data-open-subject={item.id}>
                      <span>Enter this garment</span> <Arrow />
                    </a>
                  </div>
                </div>
              );
            }

            /* ---- PAIR ------------------------------------------------------
                No motion at all. Two frames at deliberately unequal scale,
                off the centre line, sharing one ground — the act's
                interruption, and the only composition in it that does not
                move. */
            if (beat.kind === 'pair') {
              const [a, b] = beat.slots.map((i) => t.slots[i]);
              if (!a) return null;
              return (
                <div class="pf-sc pf-sc--pair" data-scene="pair" data-hero>
                  <div class="pf-sc__frame">
                    {/* The lead is the WHOLE photograph — the widest single
                        block in the act, and the reason Streetwear reads as an
                        interruption rather than a short version of everything
                        else. Nothing is revealed here; it is simply shown. */}
                    <figure class="pf-pr__plate pf-pr__plate--lead" data-views="1" style={geom(a.cover)}>
                      <a class="pf-pr__door" href={door(a)} data-nav draggable="false" data-open-subject={a.id}
                         aria-label={a.title ?? `${noun} — ${a.cover.alt}`}></a>
                      <span class="pf-pr__window" data-door-source>
                        <img
                          src={a.cover.src} srcset={a.cover.srcset}
                          sizes="(max-width: 767px) 76vw, 30vw"
                          width={a.cover.width} height={a.cover.height} alt={a.cover.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                    </figure>
                    {b && (
                      <figure class="pf-pr__plate pf-pr__plate--echo" data-views={views(b.cover)} style={geom(b.cover)}>
                        <a class="pf-pr__door" href={door(b)} data-nav draggable="false" data-open-subject={b.id}
                           aria-label={b.title ?? `${noun} — ${b.cover.alt}`}></a>
                        <span class="pf-pr__window" data-door-source>
                          <img
                            src={b.cover.src} srcset={b.cover.srcset}
                            sizes="(max-width: 767px) 40vw, 16vw"
                            width={b.cover.width} height={b.cover.height} alt={b.cover.alt}
                            loading="lazy" decoding="async"
                          />
                        </span>
                      </figure>
                    )}
                    {a.title && <p class="pf-sc__work label">{a.title}</p>}
                  </div>
                </div>
              );
            }

            /* ---- APPROACH --------------------------------------------------
                Scale, and nothing else. The figure arrives out of a field of
                white — far, then whole — and is never cropped closer than the
                complete silhouette, because a body crop is not what this
                territory is about. */
            if (beat.kind === 'approach') {
              const item = t.slots[beat.slot];
              if (!item) return null;
              return (
                <div class="pf-sc pf-sc--approach" data-scene="approach" data-reveal data-hero>
                  <div class="pf-sc__frame">
                    <figure class="pf-ap__plate" data-views={views(item.cover)} style={geom(item.cover)} data-approach>
                      <span class="pf-ap__window">
                        <img
                          src={item.cover.src} srcset={item.cover.srcset}
                          sizes="(max-width: 767px) 88vw, 42vw"
                          width={item.cover.width} height={item.cover.height} alt={item.cover.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                    </figure>
                    {item.title && <p class="pf-sc__work label">{item.title}</p>}
                    <a class="pf-sc__enter label" href={door(item)} data-nav draggable="false" data-open-subject={item.id}>
                      <span>Enter this garment</span> <Arrow />
                    </a>
                  </div>
                </div>
              );
            }

            /* ---- SHEET -----------------------------------------------------
                SUPPORTING WORK, READY-TO-WEAR. A proof sheet: the breadth of
                the territory in one gesture, uniform and small, numbered like
                a contact sheet. Depth of work without fifteen hero scenes. */
            if (beat.kind === 'sheet') {
              const items = t.slots.slice(beat.from);
              if (items.length === 0) return null;
              return (
                <div class="pf-sc pf-sc--sheet" data-scene="sheet" data-support>
                  <p class="pf-sc__head label">
                    <span>{t.short} — the range</span>
                    <i>{pad(items.length)} more</i>
                  </p>
                  <ol class="pf-sh">
                    {items.map((item, i) => (
                      <li class="pf-sh__cell" data-views={views(item.cover)} style={geom(item.cover)}>
                        {/* A CELL IS A DOOR. A contact sheet is an index of
                            work, so every frame in it can be entered and seen
                            properly — a 120px garment nobody can open is
                            decoration, not portfolio content. */}
                        <a class="pf-sh__door" href={door(item)} data-nav draggable="false" data-open-subject={item.id}
                           aria-label={`${noun} ${pad(beat.from + i + 1)} — ${item.title ?? item.cover.alt}`}>
                          <span class="pf-sh__window" data-door-source>
                            <img
                              src={item.cover.src} srcset={item.cover.srcset}
                              sizes="(max-width: 767px) 44vw, 15vw"
                              width={item.cover.width} height={item.cover.height} alt={item.cover.alt}
                              loading="lazy" decoding="async"
                            />
                          </span>
                          <i class="pf-sh__n label">{pad(beat.from + i + 1)}</i>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              );
            }

            /* ---- RAIL ------------------------------------------------------
                SUPPORTING WORK, OCCASION. A rack: the remaining gowns at full
                length in one horizontal run, scrolled or dragged, sharing one
                floor. Quiet after the drama, and nothing like a grid. */
            if (beat.kind === 'rail') {
              const items = t.slots.slice(beat.from);
              if (items.length === 0) return null;
              return (
                <div class="pf-sc pf-sc--rail" data-scene="rail" data-support>
                  <p class="pf-sc__head label">
                    <span>{t.short} — the rest of the rail</span>
                    <i>{pad(items.length)} more</i>
                  </p>
                  <ol class="pf-rl" tabindex="0" role="group"
                      aria-label={`${t.category.label}. Scroll sideways for the rest of the rail.`}>
                    {items.map((item) => (
                      <li class="pf-rl__hanger" data-views={views(item.cover)} style={geom(item.cover)}>
                        <a class="pf-rl__door" href={door(item)} data-nav draggable="false" data-open-subject={item.id}
                           aria-label={item.title ?? `${noun} — ${item.cover.alt}`}>
                          <span class="pf-rl__window" data-door-source>
                            <img
                              src={item.cover.src} srcset={item.cover.srcset}
                              sizes="(max-width: 767px) 52vw, 20vw"
                              width={item.cover.width} height={item.cover.height} alt={item.cover.alt}
                              loading="lazy" decoding="async"
                            />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              );
            }

            /* ---- LINE ------------------------------------------------------
                SUPPORTING WORK, SWIM. One row, one baseline, the smallest
                figures and the most white in the act. No frame, no number, no
                furniture — the territory's argument is reduction, so the
                presentation is reduced. */
            if (beat.kind === 'line') {
              const items = t.slots.slice(beat.from);
              if (items.length === 0) return null;
              return (
                <div class="pf-sc pf-sc--line" data-scene="line" data-support>
                  <ol class="pf-ln" tabindex="0" role="group"
                      aria-label={`${t.category.label}. Scroll sideways for the rest.`}>
                    {items.map((item) => (
                      <li class="pf-ln__fig" data-views={views(item.cover)} style={geom(item.cover)}>
                        <a class="pf-ln__door" href={door(item)} data-nav draggable="false" data-open-subject={item.id}
                           aria-label={item.title ?? `${noun} — ${item.cover.alt}`}>
                          <span data-door-source>
                            <img
                              src={item.cover.src} srcset={item.cover.srcset}
                              sizes="(max-width: 767px) 38vw, 13vw"
                              width={item.cover.width} height={item.cover.height} alt={item.cover.alt}
                              loading="lazy" decoding="async"
                            />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                  <p class="pf-sc__head pf-sc__head--foot label">
                    <span>{t.short}</span>
                    <i>{pad(items.length + 1)} {unit}, one view each</i>
                  </p>
                </div>
              );
            }

            /* ---- DECK ------------------------------------------------------
                SUPPORTING WORK, ACTIVEWEAR — and the runway's own markup,
                untouched, so drag, the arrow keys, the counter and the hash
                behave exactly as they do everywhere else on the site. This is
                the one territory with nothing held: you arrive and you are
                already moving through it. */
            if (beat.kind === 'deck') {
              const items = t.slots.slice(beat.from);
              if (items.length === 0) return null;
              return (
                <div class="pf-sc pf-sc--deck" data-scene="deck" data-support>
                  {/* `data-act-deck` is the one thing the shared runway is told
                      about this world: below 768 the act's deck carries two
                      cards rather than three, because here the deck has a
                      screen to itself and a bigger garment is worth more than
                      a third card at 390px. */}
                  <div class="pf-panel" data-panel={t.category.id} data-count={items.length}
                       data-act-deck
                       data-kind={publication === 'published' ? 'project' : 'reference'}>
                    <div class="pf-viewer">
                      <div class="pf-deck">
                        <p class="pf-sc__head label">
                          <span>{t.short} — the range</span>
                          <i>{pad(items.length)} {unit}</i>
                        </p>
                        <div class="pf-stage" data-stage tabindex="0" role="group"
                             aria-label={`${t.category.label}. Use the left and right arrow keys, or drag, to move through the looks.`}>
                          <ol class="pf-stack" data-stack>
                            {items.map((item, i) => (
                              <li class="pf-slot" data-slot={i} data-item={item.id} data-front={item.cover.front}>
                                <figure class="pf-slot__figure" data-door-source>
                                  <img
                                    src={item.cover.src} srcset={item.cover.srcset}
                                    sizes="(max-width: 1359px) 52vw, 34vw"
                                    width={item.cover.width} height={item.cover.height} alt={item.cover.alt}
                                    loading="lazy" decoding="async"
                                  />
                                  <figcaption class="label pf-slot__caption">{noun} {pad(i + 1)}</figcaption>
                                </figure>
                                {/* THE DECK'S DOOR. A card behind the leader
                                    steps forward when it is chosen; the card in
                                    front is already chosen, so choosing it
                                    enters it. One gesture, two meanings, which
                                    is how a deck is read anyway. */}
                                <a class="pf-slot__door" href={door(item)} data-nav draggable="false" data-open-subject={item.id}
                                   aria-label={item.title ?? `${noun} ${pad(i + 1)} — ${item.cover.alt}`}></a>
                              </li>
                            ))}
                          </ol>
                        </div>
                        <div class="pf-runbar">
                          <button type="button" class="pf-step" data-step="-1" aria-label={`Previous ${noun.toLowerCase()}`}>
                            <Arrow dir="left" />
                          </button>
                          <p class="label pf-runbar__count" aria-live="polite">
                            <span data-counter-current data-noun={noun}>{noun} 01</span>
                            <i>/ {pad(items.length)}</i>
                          </p>
                          <button type="button" class="pf-step" data-step="1" aria-label={`Next ${noun.toLowerCase()}`}>
                            <Arrow dir="right" />
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            }

            return null;
          })}

      </article>
    ))}


    {/* ================= THE PROJECT ==================================
        A garment is not one image among many once it has been chosen. It
        becomes THE SUBJECT, and it gets its own short film — inside the act,
        not on a page of its own: the chapter's ground, the chapter's bar and
        the territory's own reveal gesture all stay.

        WHAT A READER CONTAINS is what the subject contains, and nothing else:

          THE VIEWS      the finished garment, in every view that exists. This
                         is the part that answers the real complaint about a
                         range of small pictures — here the garment is as large
                         as the screen allows, and it can be inspected closer.
          THE ORIGIN     the sketch or illustration, where one was supplied.
          THE BUILD      flat, pattern, 3D, fit — again, only where supplied.
          THE RETURN     the final view once more. It only appears when there
                         was a process to come back FROM: seeing the garment
                         again after the pattern is the payoff, and a return
                         with nothing behind it is just a repeat.

        WHAT IT NEVER CONTAINS is a stage nobody supplied. A reference
        photograph has final views and no history, so its reader shows the
        views and then says, in one sentence, where the history will go. No
        sketch, pattern or 3D state is ever drawn, borrowed or implied.

        HOW MUCH ROOM a subject gets is the designer's decision, carried by
        `role` — and it is presentation weight, never access. Every stage a
        project supplied is in its reader: a hero tells the story at full
        scale and returns to the result, a featured one tells it closer
        together, a supporting one keeps it folded behind one invitation. The
        stages are the architecture; the weight is the art direction.

        The story is designed against the development-only lab
        (src/pages/lab/[story].astro), because no verified project in the
        archive supplies its process yet. */}
    <div class="pf-rd" data-subject-stack aria-live="off">
      {everySubject.map(({ subject, territory, index }) => {
        /* ROLE IS PRESENTATION WEIGHT, NEVER ACCESS. Every stage a project
           supplied is rendered, whatever its role; the role decides how much
           room the story is given:
             hero        full — each movement holds the screen
             featured    compact — the same movements, closer together, no
                         return to the result
             supporting  folded — the garment first, and the story one
                         deliberate press away rather than withheld */
        const weight = subject.role === 'hero' ? 'full' : subject.role === 'featured' ? 'compact' : 'folded';
        /* THE THREE MOVEMENTS a story is told in. Each stage has a narrative
           job, so they are grouped by job rather than listed in file order. */
        const origin = subject.origin;
        const iterations = subject.build.filter((st) => st.label === 'Iteration');
        const construction = subject.build.filter((st) => st.key === 'flat' || st.key === 'pattern');
        const validation = subject.build.filter((st) => (st.key === 'clo' || st.key === 'fit') && st.label !== 'Iteration');
        const story = [...origin, ...construction, ...validation, ...iterations];
        const hasStory = story.length > 0;
        const returns = hasStory && weight === 'full';
        const front = subject.views[0];
        const pattern = construction.find((st) => st.key === 'pattern') ?? construction[0];
        const flat = construction.find((st) => st !== pattern);
        const storyId = `${subject.id}-story`;
        /* Do the two views live in the SAME photograph? Then there is one
           frame to travel rather than two frames to stack — and that is a
           property of the files, asked rather than assumed, so a project
           supplying separate front and back files gets the other treatment
           without anything here changing. */
        const travel = subject.reveal === 'turn'
          && subject.views.length > 1
          && subject.views[0].image.src === subject.views[1].image.src;
        /* The gesture is carried as `data-rd-reveal`, never `data-reveal`:
           that name is the site's scroll-reveal hook, which held every reader
           at zero opacity and faded it in over the range behind it. */
        return (
          <article
            class="pf-rd__subject"
            id={`${world.id}-${subject.category}-${subject.id}`}
            data-subject={subject.id}
            data-of={subject.category}
            data-rd-reveal={subject.reveal}
            data-travel={travel ? '' : undefined}
            data-role={subject.role}
            data-verified={subject.verified ? 'yes' : 'no'}
            data-fixture={subject.fixture ? '' : undefined}
            data-story={hasStory ? weight : undefined}
            aria-labelledby={`${subject.id}-rd-title`}
            tabindex="-1"
            hidden
          >
            {/* ---- THE HEAD. Where you are, and the way out. Deliberately
                the same furniture as the act's own bar, because entering a
                garment is not leaving the chapter. */}
            <header class="pf-rd__head">
              <a class="pf-rd__back label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                <i aria-hidden="true"><Arrow dir="left" /></i>
                <span>{territory.short}</span>
              </a>
              <p class="pf-rd__where label">
                <b>{pad(index + 1)}</b>
                <span>{territory.category.label}</span>
                {/* Where in the garment's story the visitor is, named once in
                    the bar rather than as a heading over every movement. */}
                {hasStory && <i class="pf-rd__beat" data-rd-beat aria-hidden="true"></i>}
              </p>
            </header>

            {/* ---- THE VIEWS. The garment, at the size a garment has to be
                looked at, and the territory's own gesture for giving up the
                second view. */}
            <section class="pf-rd__views" data-rd-views aria-label="The garment">
              <div class="pf-rd__type">
                {/* A verified project is named by its title. A reference is
                    named by what is actually in the frame — the alt text's own
                    description, which is a statement about the photograph and
                    not a claim about its author. Either way the visitor is
                    told WHICH garment they are looking at, which a territory
                    name repeated forty-nine times never did. */}
                <h3 class="pf-rd__title" id={`${subject.id}-rd-title`}>
                  {subject.title ?? subject.caption ?? territory.short}
                  {subject.garmentType && <i>{subject.garmentType}</i>}
                </h3>
                {subject.title && subject.caption && (
                  <p class="pf-rd__caption">{subject.caption}</p>
                )}
                {subject.decision && !hasStory && (
                  /* THE ONE PLACE a sentence may be specific about a garment,
                     and only ever in the designer's own words. A garment with a
                     story says it where it is proven — at the construction. */
                  <p class="pf-rd__decision">{subject.decision}</p>
                )}
                {/* INSPECTION. Not a gallery control — one affordance, because
                    the whole point of entering a garment is being able to look
                    at it properly. */}
                <div class="pf-rd__tools">
                  <button type="button" class="pf-rd__inspect label" data-rd-inspect aria-pressed="false">
                    Look closer
                  </button>
                  {subject.views.length > 1 && (
                    <p class="pf-rd__views-of label" data-rd-count>
                      {subject.views.map((v) => v.label).join(' · ')}
                    </p>
                  )}
                </div>
                {/* THE WAY DOWN. Desire first: the garment holds the screen,
                    and the story is offered once, quietly, after it. A folded
                    story is the same invitation, and the press unfolds it. */}
                {hasStory && (
                  <button type="button" class="pf-rd__into label" data-st-into
                          aria-controls={storyId}
                          aria-expanded={weight === 'folded' ? 'false' : undefined}>
                    <span>How it became real</span>
                    <i aria-hidden="true"><Arrow dir="down" /></i>
                  </button>
                )}
              </div>
              <div class="pf-rd__stage" data-rd-stage>
                {travel ? (
                  /* ONE FRAME, TRAVELLED. Where both views live in the same
                      photograph, the honest way to move between them is to
                      move the frame — the same camera move the territory's
                      own hero scene makes, and here it is the visitor's hand
                      that makes it. The distance is the photograph's own
                      measured front fraction, not a flat half. */
                  <figure class="pf-rd__view pf-rd__view--travel" data-view="both" data-crop="front"
                          data-rd-travel style={geom(subject.views[0].image)}>
                    <span class="pf-rd__window" data-rd-window>
                      <img
                        src={subject.views[0].image.src} srcset={subject.views[0].image.srcset}
                        sizes="(max-width: 767px) 92vw, 46vw"
                        width={subject.views[0].image.width} height={subject.views[0].image.height}
                        alt={subject.views[0].image.alt}
                        loading="lazy" decoding="async"
                      />
                    </span>
                    <figcaption class="pf-rd__vname label">
                      <span data-rd-vfront>Front</span>
                      <span data-rd-vback>Back</span>
                    </figcaption>
                  </figure>
                ) : (
                  subject.views.map((v, vi) => (
                    <figure class="pf-rd__view" data-view={v.key} data-crop={v.crop} data-index={vi}
                            style={geom(v.image)}>
                      <span class="pf-rd__window" data-rd-window>
                        <img
                          src={v.image.src} srcset={v.image.srcset}
                          sizes="(max-width: 767px) 92vw, 46vw"
                          width={v.image.width} height={v.image.height} alt={v.image.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                      <figcaption class="pf-rd__vname label">{v.label}</figcaption>
                    </figure>
                  ))
                )}
              </div>
            </section>

            {/* ---- THE STORY. How the garment became real, told in the
                movements its own evidence supports — and only those. Nothing
                is rendered for a stage the project did not supply. */}
            {hasStory && (
              <div class="pf-st" id={storyId} data-st data-st-weight={weight}>
                {/* WHERE IT STARTED. The drawing is the birth of the
                    silhouette, so it is held large — and the garment it became
                    stands beside it, small, so the eye makes the connection
                    rather than a caption. */}
                {origin.length > 0 && (
                  <section class="pf-st__mv pf-st__mv--origin" data-st-beat="Where it started" aria-label="Where it started">
                    <div class="pf-st__idea">
                      <div class="pf-st__drawn" data-st-item>
                        {origin.map((st) => (
                          <StoryPlate stage={st} fixture={subject.fixture}
                                      sizes="(max-width: 767px) 92vw, 44vw" />
                        ))}
                      </div>
                      {/* What the drawing became, on the same floor as the
                          drawing — the eye reads from one to the other. */}
                      {front && (
                        <figure class="pf-st__became" data-st-item data-crop={travel ? 'front' : front.crop} style={geom(front.image)}>
                          <span class="pf-st__window">
                            <img
                              src={front.image.src} srcset={front.image.srcset}
                              sizes="(max-width: 767px) 30vw, 12vw"
                              width={front.image.width} height={front.image.height} alt=""
                              loading="lazy" decoding="async"
                            />
                          </span>
                          <figcaption class="label">Became</figcaption>
                        </figure>
                      )}
                    </div>
                    {origin[0].note && (
                      <div class="pf-st__aside">
                        <p class="pf-st__words" data-st-item>{origin[0].note}</p>
                      </div>
                    )}
                  </section>
                )}

                {/* HOW IT WAS BUILT. The construction is one decision made
                    real, so the decision is said first, in the designer's
                    words, and the pattern carries it — wide, the way a pattern
                    is laid out. The flat is its key, not its equal. */}
                {construction.length > 0 && (
                  <section class="pf-st__mv pf-st__mv--build" data-st-beat="How it was built" aria-label="How it was built">
                    {subject.decision && <p class="pf-st__decision" data-st-item>{subject.decision}</p>}
                    <div class="pf-st__drawing" data-st-item>
                      {pattern && (
                        <StoryPlate stage={pattern} class="pf-st__pattern" fixture={subject.fixture}
                                    sizes="(max-width: 767px) 92vw, 62vw" />
                      )}
                      {flat && (
                        <StoryPlate stage={flat} class="pf-st__flat" fixture={subject.fixture}
                                    sizes="(max-width: 767px) 60vw, 22vw" />
                      )}
                    </div>
                    {pattern?.note && <p class="pf-st__words pf-st__words--build" data-st-item>{pattern.note}</p>}
                  </section>
                )}

                {/* HOW IT WAS PROVEN. The test and the evidence that it held,
                    side by side at one height — the 3D state against the body —
                    and the attempts it took, as a quiet run underneath. */}
                {(validation.length > 0 || iterations.length > 0) && (
                  <section class="pf-st__mv pf-st__mv--proof" data-st-beat="How it was proven" aria-label="How it was proven">
                    {validation.length > 0 && (
                      <div class="pf-st__pair" data-st-item>
                        {validation.map((st) => (
                          <StoryPlate stage={st} class="pf-st__proof" fixture={subject.fixture}
                                      sizes="(max-width: 767px) 78vw, 30vw" />
                        ))}
                      </div>
                    )}
                    {iterations.length > 0 && (
                      <ol class="pf-st__runs" data-st-item aria-label="Iterations">
                        {iterations.map((st, i) => (
                          <li>
                            <StoryPlate stage={st} caption={`Iteration ${i + 1}`} class="pf-st__run"
                                        fixture={subject.fixture} sizes="(max-width: 767px) 30vw, 10vw" />
                            {st.note && <p class="pf-st__note">{st.note}</p>}
                          </li>
                        ))}
                      </ol>
                    )}
                  </section>
                )}
              </div>
            )}

            {/* ---- THE RESULT, again. The same garment, now whole — both of
                its views at once — and now understood. Only after a full
                story: a return with nothing behind it is just a repeat. */}
            {returns && front && (
              <section class="pf-st__mv pf-st__mv--return" data-st-beat="The result" aria-label="The result">
                <div class="pf-st__result" data-st-item>
                  {(travel
                    ? [{ ...front, crop: 'whole' as const }]
                    : subject.views.slice(0, 2)
                  ).map((v) => (
                    <figure class="pf-st__final" data-crop={v.crop} style={geom(v.image)}>
                      <span class="pf-st__window">
                        <img
                          src={v.image.src} srcset={v.image.srcset}
                          sizes="(max-width: 767px) 92vw, 50vw"
                          width={v.image.width} height={v.image.height} alt={v.image.alt}
                          loading="lazy" decoding="async"
                        />
                      </span>
                    </figure>
                  ))}
                </div>
                <div class="pf-st__close">
                  <p class="pf-st__name">{subject.title ?? subject.caption}</p>
                  <a class="pf-rd__out label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                    <i aria-hidden="true"><Arrow dir="left" /></i>
                    <span>Back to {territory.short}</span>
                  </a>
                </div>
              </section>
            )}

            {/* ---- WHAT IS NOT HERE, said plainly. */}
            {!subject.verified && (
              <p class="pf-rd__pending" data-subject-pending>{SUBJECT_STORY_PENDING}</p>
            )}

            {!returns && (
              <footer class="pf-rd__foot">
                <a class="pf-rd__out label" href={`#${world.id}/${subject.category}`} data-nav data-subject-close>
                  <i aria-hidden="true"><Arrow dir="left" /></i>
                  <span>Back to {territory.short}</span>
                </a>
              </footer>
            )}
          </article>
        );
      })}
    </div>

    {/* ---- THE CLOSE ------------------------------------------------------
        Act I resolves and hands over. The emotional movement of the whole
        Portfolio is instinct toward construction, so Womenswear ends on the
        word Menswear's cover is already built around. This is the act's one
        strong use of red. */}
    <footer class="pf-act__end">
      <p class="pf-act__endline display">
        Act I was <span>fluidity</span>.<br />Act II is <em>proportion</em>.
      </p>
      {publication === 'reference-preview' && (
        <p class="pf-prov pf-act__prov" data-reference-notice>
          <b class="label">Reference preview</b>
          <span>{REFERENCE_DISCLAIMER}</span>
        </p>
      )}
      <a class="pf-act__next label" href="#menswear" data-nav data-chapter="menswear">
        Menswear <Arrow />
      </a>
    </footer>
  </div>
</section>
