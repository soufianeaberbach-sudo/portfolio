---
import type{Subject,ImageCredit}from'../../data/portfolio';
import{finalPhotographs}from'../../data/final-photography';
import{directions}from'../../data/womenswear-direction';
import{editorialWorld}from'../../data/womenswear-collection';
import FinalPhoto from'./FinalPhoto.astro';
import{getLocale}from'../../i18n/locales';
import{pf,caps,viewLabel}from'../../i18n/portfolio';
import{categoryName}from'../../i18n/portfolio-terms';
interface Props{subject:Subject;world:string;credit?:ImageCredit;}
const{subject,world,credit}=Astro.props,photos=finalPhotographs(subject),category=directions[editorialWorld(subject.category)];
const locale=getLocale(Astro.url),t=pf[locale].reader,name=categoryName(locale,category.id);
---
<article class="pf-rd__subject ww-reader" data-ww-reader data-subject={subject.id} data-of={subject.category} data-editorial={category.id} data-role={subject.role} data-verified={subject.verified?'yes':'no'} id={`${world}/${subject.category}/${subject.id}`} aria-labelledby={`${subject.id}-rd-title`} tabindex="-1" hidden>
 <header class="ww-reader-head"><a class="label" href={`#${world}/${category.id}`} data-nav data-subject-close>{t.back} {caps(name,locale)}</a><p class="label">{subject.verified?t.final:t.reference}</p></header>
 <section class="ww-reader-floor" aria-label={t.garment}>
  <div class="ww-reader-copy"><h3 id={`${subject.id}-rd-title`}>{subject.title??subject.caption??subject.cover.alt}</h3>{credit&&<p class="ww-photo-credit">{subject.verified?t.photo:t.referencePhoto} · {credit.sourcePage?<a href={credit.sourcePage} target="_blank" rel="noopener"><bdi>{credit.photographer??credit.source}{credit.sourcePage.startsWith('https://www.pexels.com/')?' / Pexels':''}</bdi> {t.external}</a>:<bdi>{credit.photographer??credit.source}</bdi>}</p>}</div>
  <div class="ww-reader-image" data-ww-target>
   {photos.map((photo,i)=><div data-photo-view={i} hidden={i!==0}><FinalPhoto image={photo.image} crop={photo.crop} subjectId={subject.id}/></div>)}
  </div>
  <div class="ww-reader-controls" aria-label={t.controls}>
   {photos.length>1?photos.map((photo,i)=><button class="label" data-ww-view={i} aria-pressed={i===0?'true':'false'}>{caps(viewLabel(photo.label,locale),locale)}</button>):<span class="label">{caps(viewLabel(photos[0].label,locale),locale)}</span>}
   <button class="label" data-rd-inspect aria-pressed="false">{t.lookCloser}</button>
  </div>
  <div class="ww-zoom-tools" data-ww-zoom-tools hidden><button data-ww-zoom="0.714" aria-label={t.zoomOut}>−</button><button data-ww-fit>{t.fit}</button><button data-ww-zoom="1.4" aria-label={t.zoomIn}>+</button><a href={photos[0].image.src} data-original-source target="_blank" rel="noopener">{t.original}</a></div>
  <p class="ww-source-status" data-ww-source-status role="status"></p>
 </section>
</article>
