---
import type{Subject,ImageCredit}from'../../data/portfolio';
import{directions}from'../../data/womenswear-direction';
import{editorialWorld,generatedPresentation}from'../../data/womenswear-collection';
import GarmentInspection from'./GarmentInspection.astro';
interface Props{subject:Subject;world:string;credit?:ImageCredit;}
const{subject,world,credit}=Astro.props,category=directions[editorialWorld(subject.category)];
const presentation=generatedPresentation(subject.id);
const retouched=presentation?.generationType==='background-retouch';
---
<article class="pf-rd__subject ww-reader" data-ww-reader data-subject={subject.id} data-of={subject.category} data-editorial={category.id} data-role={subject.role} data-verified={subject.verified?'yes':'no'} id={`${world}/${subject.category}/${subject.id}`} aria-labelledby={`${subject.id}-rd-title`} tabindex="-1" hidden>
 <header class="ww-reader-head"><a class="label" href={`#${world}/${category.id}`} data-nav data-subject-close>← {category.name.toUpperCase()}</a><p class="label">{retouched?'AI-RETOUCHED / REFERENCE':presentation?'AI-GENERATED / PROVISIONAL':subject.verified?'FINAL PHOTOGRAPHY':'REFERENCE PHOTOGRAPHY'}</p></header>
 <section class="ww-reader-floor" aria-label="The complete garment">
  <div class="ww-reader-copy"><h3 id={`${subject.id}-rd-title`}>{subject.title??subject.caption??subject.cover.alt}</h3>{credit&&<p class="ww-photo-credit">{subject.verified?'Photograph':'Reference photograph'} · {credit.sourcePage?<a href={credit.sourcePage} target="_blank" rel="noopener">{credit.photographer??credit.source}{credit.sourcePage.startsWith('https://www.pexels.com/')?' / Pexels':''} ↗︎</a>:<span>{credit.photographer??credit.source}</span>}</p>}</div>
  <GarmentInspection subject={subject} gender="womenswear"/>
  {presentation&&<p class="ww-reader-provenance">{retouched?'Background retouch of the supplied reference photograph.':presentation.generationType==='original-concept'?('productionVersion' in presentation?'Original AI concept — provisional.':'Temporary AI fashion concept.'):'AI re-photography study of the supplied design.'} {retouched?'Garment authorship and technical construction are unverified.':presentation.backInterpreted?'Back construction is a provisional AI interpretation.':'Generated views are presentation studies, not verified technical construction.'} <a href={`#${world}/${subject.category}/${presentation.sourceIdentity}`} data-nav data-open-subject={presentation.sourceIdentity}>{'productionVersion' in presentation?'Historical slot archive':'Source reference'} ↗</a></p>}
 </section>
</article>
