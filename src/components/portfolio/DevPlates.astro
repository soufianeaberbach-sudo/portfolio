---
/* The development surfaces of ONE garment — sketch, 2D pattern, 3D simulation.
 *
 * TWO THINGS HAD TO BE TRUE AT ONCE and earlier versions each got one.
 *
 * A permanent column beside the deck showed three stamped stand-ins next to
 * every garment: a third of the best screen on the site spent on a promise,
 * and three grey duplicates of the dress the visitor was already looking at.
 * Removing it entirely was honest but gave up the thing the interface is
 * supposed to demonstrate — that the evidence belongs to the ACTIVE garment
 * and changes when the garment changes.
 *
 * So it is a LAYER THE VISITOR OPENS. Closed, it costs one line under the run
 * bar; fashion keeps the screen. Opened, the three surfaces for the garment in
 * front appear, and advancing the deck advances them. `<details>` carries the
 * state, so it works with no script, from the keyboard, and in the fallback
 * page, and the runtime only has to carry the open state across to the next
 * garment's block.
 *
 * HONESTY IS NOT NEGOTIABLE. A surface with no asset yet stands in the active
 * garment's own photograph, dimmed, and stamped TEMP PREVIEW on its face — and
 * says the same thing again in its alt text, so it is a stand-in to a screen
 * reader too. It never draws a plausible sketch: an invented sketch is
 * invented evidence. Supplying `project.evidence.sketch` turns that one
 * surface real and changes nothing here.
 */
import type { EvidenceSurface } from '../../data/portfolio';
import { EVIDENCE_PREVIEW_MARK } from '../../data/portfolio';

interface Props {
  surfaces: EvidenceSurface[];
  index: number;
  garmentLabel: string;
}

const { surfaces, index, garmentLabel } = Astro.props;
const authored = surfaces.filter((surface) => surface.kind === 'authored').length;
---

<details
  class="pf-dev"
  data-dev
  data-evidence-for={index}
  data-has-authored={authored > 0 ? '' : undefined}
  hidden={index !== 0}
>
  <summary class="pf-dev__open">
    <span class="pf-dev__open-label">Inspect development</span>
    <span class="pf-dev__open-hint">
      {authored > 0
        ? `Sketch, 2D pattern and 3D simulation — ${garmentLabel}`
        : 'Sketch, 2D pattern and 3D simulation'}
    </span>
  </summary>

  <ol class="pf-dev__plates" aria-label={`Development surfaces — ${garmentLabel}`}>
    {surfaces.map((surface) => (
      <li class="pf-plate" data-plate={surface.key} data-preview={surface.kind !== 'authored' ? '' : undefined}>
        <button
          type="button"
          class="pf-plate__art"
          data-evidence-open
          data-evidence-title={`${surface.step} / ${surface.name}`}
          data-evidence-kind={surface.kind}
          aria-label={surface.kind === 'authored'
            ? `Enlarge ${surface.name} — ${garmentLabel}`
            : `Enlarge the temporary preview standing in for the ${surface.name.toLowerCase()} — ${garmentLabel}`}
        >
          {surface.kind !== 'authored' && (
            <span class="pf-plate__stamp">{EVIDENCE_PREVIEW_MARK}</span>
          )}
          {surface.image ? (
            <img
              src={surface.image.src}
              srcset={surface.image.srcset}
              sizes="(max-width: 767px) 44vw, 22vw"
              width={surface.image.width}
              height={surface.image.height}
              alt={surface.kind === 'authored'
                ? surface.image.alt
                : `Temporary preview: the active garment shown in place of the ${surface.name.toLowerCase()} for ${garmentLabel}`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="pf-plate__blank"></span>
          )}
        </button>
        <p class="pf-plate__label">{surface.name}</p>
      </li>
    ))}
  </ol>
</details>
