---
/* The three development surfaces of ONE garment — sketch, 2D pattern, 3D
 * simulation, always in that order.
 *
 * WHAT CHANGED, AND WHY IT MATTERS.
 * These used to be rendered once per CATEGORY: three fixed plates that stayed
 * the same while the visitor advanced through seventeen garments. Evidence that
 * does not follow the garment is not evidence of anything. Now one block is
 * rendered per garment and the runtime shows the active one, so position 1 of
 * the deck and the three surfaces are always the same garment.
 *
 * THREE STATES PER SURFACE, and the visitor can tell them apart:
 *
 *   authored   a real supplied asset, shown at full strength.
 *   preview    no asset yet, so the ACTIVE GARMENT stands in — dimmed, and
 *              stamped so it can never be read as a sketch, a pattern or a
 *              simulation. This exists to prove the dynamic system works
 *              while the real assets are being prepared.
 *   empty      nothing to borrow either. A ruled blank that says so.
 *
 * A demo surface deliberately does not draw a plausible sketch or pattern.
 * Inventing one would be fabricating evidence; a dimmed garment under a
 * `Temp preview` stamp cannot be mistaken for work.
 *
 * Supplying `project.evidence.sketch` flips that one surface to `authored`.
 * Nothing in this file changes when it does.
 */
import type { EvidenceSurface } from '../../data/portfolio';
import { EVIDENCE_PREVIEW_MARK, EVIDENCE_PREVIEW_NOTE, evidenceIsAllPreview } from '../../data/portfolio';

interface Props {
  surfaces: EvidenceSurface[];
  /* Which garment these belong to — the runtime matches it against the deck's
     active index. */
  index: number;
  /* The garment's own label, so the heading names what is being inspected
     rather than saying "Development" three hundred times. */
  garmentLabel: string;
}

const { surfaces, index, garmentLabel } = Astro.props;
const allPreview = evidenceIsAllPreview(surfaces);
const hasAuthored = surfaces.some((surface) => surface.kind === 'authored');
---

<section
  class="pf-dev"
  data-dev
  data-evidence-for={index}
  data-has-authored={hasAuthored ? '' : undefined}
  aria-label={`Development surfaces — ${garmentLabel}`}
  hidden={index !== 0}
>
  <p class="pf-dev__head">
    <span class="label pf-dev__title">Development</span>
    {allPreview && (
      /* Said once, here, rather than repeated under all three at a size
         nobody reads. */
      <span class="label pf-dev__note" data-preview-note>{EVIDENCE_PREVIEW_NOTE}</span>
    )}
  </p>

  <ol class="pf-dev__plates">
    {surfaces.map((surface) => (
      <li
        class="pf-plate"
        data-plate={surface.key}
        data-preview={surface.kind === 'preview' ? '' : undefined}
        data-empty={surface.kind === 'empty' ? '' : undefined}
      >
        <button
          type="button"
          class="pf-plate__art"
          data-evidence-open
          data-evidence-title={`${surface.step} / ${surface.name}`}
          data-evidence-kind={surface.kind}
          aria-label={
            surface.kind === 'authored'
              ? `Enlarge ${surface.name} — ${garmentLabel}`
              : `Enlarge ${surface.name} temporary preview — ${garmentLabel}`
          }
        >
          <span class="pf-notch" aria-hidden="true"></span>
          {surface.kind === 'preview' && (
            <span class="pf-plate__stamp label">{EVIDENCE_PREVIEW_MARK}</span>
          )}
          {surface.kind === 'empty' && <span class="pf-plate__stamp label">Pending</span>}
          {surface.image ? (
            <img
              src={surface.image.src}
              srcset={surface.image.srcset}
              sizes="(max-width: 1023px) 30vw, 20vw"
              width={surface.image.width}
              height={surface.image.height}
              /* A stand-in describes itself as a stand-in to a screen reader
                 too. It never borrows the surface's name. */
              alt={surface.kind === 'authored'
                ? surface.image.alt
                : `Temporary preview: the active garment shown in place of the ${surface.name.toLowerCase()} for ${garmentLabel}`}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span class="pf-plate__blank"></span>
          )}
          <span class="pf-plate__inspect" aria-hidden="true">Inspect +</span>
        </button>
        <p class="pf-plate__label">
          <b class="label">Step {surface.step}</b>
          <span>{surface.name}</span>
        </p>
      </li>
    ))}
  </ol>
</section>
