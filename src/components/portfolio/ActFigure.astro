---
/* One subject, one native link. The subject role sets presentation weight;
   its image metadata sets the measured crop. Touching figures stay whole. */
import type { Subject } from '../../data/portfolio';
import Arrow from '../Arrow.astro';

interface Props {
  item: Subject;
  href: string;
  noun: string;
  /* front: the front view of a two-up; whole: the full photograph. */
  crop: 'front' | 'whole';
  sizes: string;
  class?: string;
  weight?: 'hero' | 'featured' | 'supporting';
  style?: string;
}

const { item, href, noun, crop, sizes, class: className, weight = 'supporting', style = '' } = Astro.props;
const image = item.cover;
const whole = crop === 'whole' || image.views !== 2 || image.separable === false;
const geom = `--front:${image.front};--aspect:${(image.width / image.height).toFixed(4)};`;
---
<figure class:list={['pf-fig', className]} data-weight={weight} data-crop={whole ? 'whole' : 'front'}
        data-phone-crop={weight === 'hero' && image.views === 2 && image.separable !== false ? 'front' : undefined}
        style={`${geom}${style}`}>
  <a class="pf-fig__door" href={href} data-nav draggable="false" data-open-subject={item.id}
     aria-label={`${noun} — ${item.title ?? image.alt}`}>
    <span class="pf-fig__window" data-door-source>
      <img
        src={image.src} srcset={image.srcset} sizes={sizes}
        width={image.width} height={image.height} alt={image.alt}
        loading="lazy" decoding="async"
      />
    </span>
    {weight !== 'supporting' && (
      <span class="pf-fig__entry">{item.title ?? (weight === 'hero' ? 'View garment' : 'View')} <span aria-hidden="true"><Arrow /></span></span>
    )}
  </a>
</figure>
