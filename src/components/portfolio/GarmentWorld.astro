---
/* One garment chapter (Womenswear or Menswear), in two levels.
 *
 *   SCREEN 1  the category index. Each category is an image-led editorial
 *             cover; the deeper garment runway and development evidence stay
 *             hidden until the visitor chooses one.
 *   SCREEN 2  one per category. The garment viewer for that category and its
 *             three development stages, with a back control that returns to
 *             SCREEN 1 rather than jumping out to the portfolio index.
 *
 * Three content states, derived from the data:
 *
 *   published          verified projects exist; the deck carries them.
 *   reference-preview  no verified projects, but reference photography. The
 *                      deck carries those images so the interface can be seen
 *                      working, and nothing is claimed about them. The
 *                      non-authorship note is stated once, beside that deck —
 *                      never on the index screen and never on a cover.
 *   unpublished        nothing yet. The categories are still listed so the
 *                      architecture is legible, and nothing is dressed as
 *                      evidence or given a control that leads nowhere.
 *
 * Everything is server-rendered, so a failed script leaves a readable page.
 */
import type { GarmentWorld } from '../../data/portfolio';
import { REFERENCE_DISCLAIMER, worldPublication } from '../../data/portfolio';
import Arrow from '../Arrow.astro';
import DevPlates from './DevPlates.astro';
import WorldNavigation from './WorldNavigation.astro';

interface Props {
  world: GarmentWorld;
}

const { world } = Astro.props;
const publication = worldPublication(world);
const pad = (n: number) => String(n + 1).padStart(2, '0');

/* One list drives the deck. In reference-preview the items are photographs
   with nothing claimed about them; in published they are projects. The noun
   changes with the state so the UI never calls a reference a project. */
const slotsFor = (category: GarmentWorld['categories'][number]) =>
  publication === 'published'
    ? category.projects.map((p) => ({ id: p.id, image: p.finalGarmentImage, project: p }))
    : category.references.map((r) => ({ id: r.id, image: r.image, project: null }));

const noun = publication === 'published' ? 'Project' : 'Reference';
const live = world.categories.filter((c) => slotsFor(c).length > 0);
---

<section class="pf-world" id={world.id} data-world={world.id} data-publication={publication} tabindex="-1" aria-labelledby={`${world.id}-title`}>
  <WorldNavigation current={world.id} />

  {/* ---- SCREEN 1 — the category index ------------------------------- */}
  <div class="pf-screen" data-screen="index">
    <div class="pf-bar">
      <a class="pf-back" href="#portfolio-index" data-nav data-world-close>
        <i aria-hidden="true"><Arrow dir="left" /></i> Portfolio index
      </a>
      <p class="label pf-bar__tag"><b>{world.number}</b> {world.title}</p>
    </div>

    <header class="pf-head">
      <h2 class="display" id={`${world.id}-title`}>{world.title}</h2>
      <p class="pf-head__descriptor">{world.descriptor}</p>
    </header>

    <div class="pf-category-instruction label">Silhouette index <span>Scroll to discover / Select to enter</span></div>
    <nav class={`pf-cats pf-cats--${world.id}`} aria-label={`${world.title} categories`} tabindex="0">
      <ol class="pf-cats__list">
        {world.categories.map((category, categoryIndex) => {
          const count = slotsFor(category).length;
          const open = count > 0;
          const visual = category.cover ?? category.projects[0]?.finalGarmentImage ?? category.references[0]?.image;
          const Tag = open ? 'a' : 'div';
          return (
            <li data-category-index={categoryIndex + 1}>
              <Tag
                class="pf-cat"
                data-composition={['portrait', 'margin', 'wide', 'portrait', 'wide'][categoryIndex]}
                href={open ? `#${world.id}/${category.id}` : undefined}
                data-nav={open ? '' : undefined}
                data-category={category.id}
                data-open={open ? '' : undefined}
              >
                {visual && (
                  <span class="pf-cat__media" aria-hidden="true">
                    <img
                      src={visual.src}
                      srcset={visual.srcset}
                      sizes="(max-width: 899px) 92vw, 48vw"
                      width={visual.width}
                      height={visual.height}
                      alt=""
                      loading={categoryIndex < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </span>
                )}
                <span class="pf-cat__shade" aria-hidden="true"></span>
                <span class="pf-cat__content">
                  <i class="pf-cat__num">{category.number}</i>
                  <span class="pf-cat__label">{category.label}</span>
                  <small class="pf-cat__blurb">{category.blurb}</small>
                  <b class="pf-cat__count label">
                    {open ? `${String(count).padStart(2, '0')} ${noun.toLowerCase()}s` : 'Pending'}
                  </b>
                  {open && <i class="pf-cat__go" aria-hidden="true"><Arrow /></i>}
                </span>
              </Tag>
            </li>
          );
        })}
      </ol>
    </nav>
  </div>

  {/* ---- SCREEN 2..n — one viewer per category ----------------------- */}
  {live.map((category) => {
    const slots = slotsFor(category);
    return (
      <div class="pf-screen" data-screen="category" data-category={category.id}>
        <div class="pf-bar">
          <a class="pf-back" href={`#${world.id}`} data-nav>
            <i aria-hidden="true"><Arrow dir="left" /></i> {world.title} categories
          </a>
          <p class="label pf-bar__tag"><b>{category.number}</b> {category.label}</p>
        </div>

        <header class="pf-head pf-head--category">
          <h2 class="display">{category.label}</h2>
          <p class="pf-head__descriptor">{category.blurb}</p>
        </header>

        {/* The white studio: one continuous photographic field, the full width
            of the viewport. */}
        <div class="pf-studio">
          <div class="pf-studio__inner">
            <div class="pf-panel" data-panel={category.id} data-count={slots.length}
                 data-kind={publication === 'published' ? 'project' : 'reference'}>
              <div class="pf-viewer">
                <div class="pf-deck">
                  <div class="pf-stage" data-stage tabindex="0" role="group"
                       aria-label={`${category.label}. Use the left and right arrow keys, or drag, to move through the images.`}>
                    <ol class="pf-stack" data-stack>
                      {slots.map((slot, index) => (
                        <li class="pf-slot" data-slot={index} data-item={slot.id} data-front={slot.image.front}>
                          <figure class="pf-slot__figure">
                            <img
                              src={slot.image.src}
                              srcset={slot.image.srcset}
                              sizes="(max-width: 1359px) 52vw, 34vw"
                              width={slot.image.width}
                              height={slot.image.height}
                              alt={slot.image.alt}
                              loading={index === 0 ? 'eager' : 'lazy'}
                              decoding="async"
                            />
                            <figcaption class="label pf-slot__caption">{noun} {pad(index)}</figcaption>
                          </figure>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <div class="pf-runbar">
                    <button type="button" class="pf-step" data-step="-1" aria-label={`Previous ${noun.toLowerCase()}`}>
                      <Arrow dir="left" />
                    </button>
                    <p class="label pf-runbar__count" aria-live="polite">
                      <span data-counter-current data-noun={noun}>{noun} 01</span>
                      <i>/ {String(slots.length).padStart(2, '0')}</i>
                    </p>
                    <button type="button" class="pf-step" data-step="1" aria-label={`Next ${noun.toLowerCase()}`}>
                      <Arrow dir="right" />
                    </button>
                  </div>

                  {publication === 'reference-preview' && (
                    /* Provenance, stated once, on the same block as the
                       controls it belongs to — not as a section of its own
                       under the studio. */
                    <p class="pf-prov pf-prov--inline" data-reference-notice>
                      <b class="label">Reference preview</b>
                      <span>{REFERENCE_DISCLAIMER}</span>
                    </p>
                  )}
                  {publication === 'reference-preview' && category.references.some((ref) => ref.credit) && (
                    <p class="pf-reference-sources">
                      Licensed reference photography — {category.references.map((ref, index) => ref.credit && (
                        <><a href={ref.credit.sourcePage} target="_blank" rel="noopener">Pexels {pad(index)}</a>{index < category.references.length - 1 ? ' / ' : ''}</>
                      ))}
                    </p>
                  )}
                </div>

                <div class="pf-devcol">
                  {publication === 'reference-preview' ? (
                    <div data-reference-panel><DevPlates /></div>
                  ) : (
                    slots.map((slot, index) => {
                      const project = slot.project!;
                      return (
                        <article class="pf-project" data-project-info={index} hidden={index !== 0}>
                          <p class="label pf-project__number">Project {pad(index)}</p>
                          <h3 class="pf-project__title">{project.title}</h3>
                          <dl class="pf-project__profile">
                            <div><dt>Garment</dt><dd>{project.garmentType}</dd></div>
                            {project.fabricFamily && (
                              <div><dt>Fabric family</dt><dd>{project.fabricFamily}</dd></div>
                            )}
                            {project.materials && project.materials.length > 0 && (
                              <div><dt>Materials</dt><dd>{project.materials.join(' / ')}</dd></div>
                            )}
                          </dl>
                          {project.description && <p class="pf-project__description">{project.description}</p>}
                          {project.tags && project.tags.length > 0 && (
                            <p class="pf-project__tags label">
                              {project.tags.map((tag, tagIndex) => (
                                <>{tagIndex > 0 && <i aria-hidden="true"> / </i>}<span>{tag}</span></>
                              ))}
                            </p>
                          )}
                          <DevPlates evidence={project.evidence} />
                        </article>
                      );
                    })
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  })}
</section>
