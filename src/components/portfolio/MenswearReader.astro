---
import {getLocale} from '../../i18n/locales';
import {categoryName} from '../../i18n/portfolio-terms';
import {current} from '../../i18n/portfolio-current';
import {fill} from '../../i18n/dict';
import {localizedGarmentCopy} from '../../i18n/garment-copy';
import type{Subject}from'../../data/portfolio';
import{menswearCredit,menswearConcept,menswearDisplayed}from'../../data/menswear-collection';
import type{MenswearCategory}from'../../data/menswear-collection';
import{menswearDirections}from'../../data/menswear-direction';
import GarmentProvenance from './GarmentProvenance.astro';
import GarmentInspection from'./GarmentInspection.astro';
interface Props{subject:Subject;}
const{subject}=Astro.props,credit=menswearCredit(subject.id),concept=menswearConcept(subject.id),direction=menswearDirections[subject.category as keyof typeof menswearDirections];
const locale=getLocale(Astro.url),now=current[locale];
const copy=localizedGarmentCopy(subject,locale);
const sequence=menswearDisplayed(subject.category as MenswearCategory),at=sequence.findIndex(x=>x.id===subject.id);
const neighbor=(delta:number)=>menswearConcept(sequence[(at+delta+sequence.length)%sequence.length].id);
---
<article class="pf-rd__subject mw-reader" data-mw-reader data-ai-concept={concept?'true':undefined} data-subject={subject.id} data-of={subject.category} id={`menswear/${subject.category}/${subject.id}`} data-verified={subject.verified?'yes':'no'} hidden tabindex="-1" role="dialog" aria-modal="true" aria-labelledby={`${subject.id}-title`}>
 <header class="mw-reader-head"><a href={`#menswear/${subject.category}`} data-nav data-subject-close>← {categoryName(locale,subject.category)}</a></header>
 <div class="mw-reader-floor">
  <div class="mw-reader-caption"><h3 id={`${subject.id}-title`}>{copy.title}</h3><p class="garment-description" data-garment-description>{copy.description}</p></div>
  <GarmentInspection subject={subject} gender="menswear"/>
  {concept&&at>=0&&<nav class="mw-look-nav" aria-label={fill(now.looksLabel,{name:categoryName(locale,subject.category)})}>
   <a href={`#menswear/${subject.category}/${neighbor(-1)!.id}`} data-nav data-mw-garment="previous" aria-label={fill(now.previousLabel,{name:localizedGarmentCopy(sequence[(at-1+sequence.length)%sequence.length],locale).title})}>{now.previousLook}</a>
   <span aria-label={fill(now.lookPosition,{n:at+1,total:sequence.length})}>{String(at+1).padStart(2,'0')} / {sequence.length}</span>
   <a href={`#menswear/${subject.category}/${neighbor(1)!.id}`} data-nav data-mw-garment="next" aria-label={fill(now.nextLabel,{name:localizedGarmentCopy(sequence[(at+1)%sequence.length],locale).title})}>{now.nextLook}</a>
  </nav>}
  <GarmentProvenance subject={subject} credit={credit} generated={!!concept}/>

 </div>
</article>

<style>
.mw-product{font-size:.7rem;color:#62625f;line-height:1.5;margin:0}
.mw-look-nav{display:flex;align-items:center;justify-content:center;gap:clamp(18px,4vw,48px);font:10px var(--mono);text-transform:uppercase;flex:none}
.mw-look-nav a{display:inline-flex;align-items:center;min-height:44px;min-width:44px}.mw-look-nav span{color:var(--muted)}
.mw-reader-caption h3{margin-bottom:4px}
@media(max-width:699px){.mw-look-nav{font-size:9px;gap:28px}.mw-product{font-size:10px}}
.mw-concept-notes{position:relative;max-width:55rem;margin:1rem auto 0;padding:0 1.25rem;font-size:.72rem;line-height:1.5;color:#62625f}.mw-concept-notes p{margin:.45rem 0}.mw-concept-notes summary{cursor:pointer;text-underline-offset:3px}.mw-concept-notes details[open]{max-height:24vh;overflow:auto;padding-bottom:.35rem}.mw-concept-notes summary:focus-visible{outline:1px solid currentColor;outline-offset:4px}
</style>
