---
import type{Subject}from'../../data/portfolio';
import{finalPhotographs}from'../../data/final-photography';
import{menswearCredit,menswearConcept}from'../../data/menswear-collection';
import{menswearDirections}from'../../data/menswear-direction';
import MenswearPhoto from'./MenswearPhoto.astro';
interface Props{subject:Subject;}
const{subject}=Astro.props,photos=finalPhotographs(subject),credit=menswearCredit(subject.id),concept=menswearConcept(subject.id),direction=menswearDirections[subject.category as keyof typeof menswearDirections];
---
<article class="pf-rd__subject mw-reader" data-mw-reader data-ai-concept={concept?'true':undefined} data-subject={subject.id} data-of={subject.category} id={`menswear/${subject.category}/${subject.id}`} data-verified={subject.verified?'yes':'no'} hidden tabindex="-1" role="dialog" aria-modal="true" aria-labelledby={`${subject.id}-title`}>
 <header class="mw-reader-head"><a href={`#menswear/${subject.category}`} data-nav data-subject-close>← {direction.name}</a><span class="label">{concept?'Original AI fashion concept':subject.verified?'Final photography':'Reference photograph'}</span></header>
 <div class="mw-reader-floor">
  <div class="mw-reader-caption"><h3 id={`${subject.id}-title`}>{subject.title??subject.caption}</h3>{credit&&<a href={credit.sourcePage} target="_blank" rel="noopener">{credit.photographer??(credit.sourcePage?.startsWith('https://www.pexels.com/')?'Reference source':credit.source)}{credit.sourcePage?.startsWith('https://www.pexels.com/')?' / Pexels':''} ↗</a>}</div>
  <div class="mw-reader-target" data-mw-target>{photos.map((photo,i)=><div data-mw-view-panel={i} hidden={i!==0}><MenswearPhoto image={photo.image} crop={photo.crop}/></div>)}</div>
  <nav class="mw-reader-views" aria-label="Photographic views">{photos.length>1?photos.map((p,i)=><button data-mw-view={i} aria-pressed={i===0?'true':'false'}>{p.label}</button>):<span>{photos[0].label}</span>}<button data-rd-inspect aria-pressed="false">Look closer</button></nav>
  <div class="mw-zoom" data-mw-zoom hidden><button data-mw-zoom-by="0.714" aria-label="Zoom out">−</button><button data-mw-fit>Fit / reset</button><button data-mw-zoom-by="1.4" aria-label="Zoom in">+</button><a href={photos[0].image.src} data-mw-original target="_blank" rel="noopener">{concept?'Photograph':'Original source'} ↗</a></div>
  <noscript><p>Available source photographs: {photos.map(p=><a href={p.image.src}>{p.label} ↗ </a>)}</p></noscript>
  {concept&&<div class="mw-concept-notes"><p>{concept.provenance}</p><details><summary>Materials & construction</summary><p>{concept.fabric}. Proposed composition and weight.</p><p>{concept.construction}</p><p>{concept.styling}</p></details></div>}
  <p class="mw-reader-status" data-mw-status role="status"></p>
 </div>
</article>

<style>
.mw-reader[data-ai-concept="true"] :global(.mw-photo){outline:1px solid #e6e6e3;outline-offset:-1px}
.mw-concept-notes{position:relative;max-width:55rem;margin:1rem auto 0;padding:0 1.25rem;font-size:.72rem;line-height:1.5;color:#62625f}.mw-concept-notes p{margin:.45rem 0}.mw-concept-notes summary{cursor:pointer;text-underline-offset:3px}.mw-concept-notes details[open]{max-height:24vh;overflow:auto;padding-bottom:.35rem}.mw-concept-notes summary:focus-visible{outline:1px solid currentColor;outline-offset:4px}
</style>
