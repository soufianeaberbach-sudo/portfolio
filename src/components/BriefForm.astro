---
import Arrow from './Arrow.astro';

/* The development brief form.
 *
 * This is a REAL form: method="POST" action="/api/brief", handled by
 * worker/index.ts. Without JavaScript it posts natively and the Worker
 * redirects to /contact/sent/. With JavaScript it is intercepted and posts
 * JSON so the processing, success and error states can be shown in place.
 *
 * mailto: is a fallback only. It appears on a network failure, prefilled from
 * whatever has already been typed, so nothing the visitor wrote is lost.
 *
 * No file upload in this version — an optional reference LINK field instead,
 * which avoids storage, size, privacy and failure-state complexity entirely.
 *
 * Turnstile renders only when a site key was present at build time. The Worker
 * verifies only when its secret is configured. Both halves degrade
 * independently, so the form is coherent at every stage of setup.
 */
const stages = [
  'Idea / reference',
  'In development',
  'Fit / sample',
  'Pre-production',
  'Production issue',
];

const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const email = 'soufiane.aberbach@gmail.com';
---

{turnstileKey && <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}

<div class="brief-form">
  <form
    class="bf"
    method="POST"
    action="/api/brief"
    novalidate
    data-brief-form
    data-endpoint="/api/brief"
    data-email={email}
  >
    <!-- Spam screens. Never announced, never focusable. -->
    <div class="bf__trap" aria-hidden="true">
      <label for="website">Website</label>
      <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="t" value="" data-started />

    <fieldset class="bf__group">
      <legend class="label">Who are you?</legend>
      <div class="bf__row">
        <p class="field">
          <label for="bf-name">Your name</label>
          <input id="bf-name" name="name" type="text" autocomplete="name" maxlength="120" required
                 aria-describedby="bf-name-err" />
          <span class="field__err" id="bf-name-err" data-err="name" hidden></span>
        </p>
        <p class="field">
          <label for="bf-company">Company or brand <span class="field__opt">optional</span></label>
          <input id="bf-company" name="company" type="text" autocomplete="organization" maxlength="120"
                 aria-describedby="bf-company-err" />
          <span class="field__err" id="bf-company-err" data-err="company" hidden></span>
        </p>
      </div>
    </fieldset>

    <fieldset class="bf__group">
      <legend class="label">How can I reply?</legend>
      <p class="field">
        <label for="bf-email">Email</label>
        <input id="bf-email" name="email" type="email" inputmode="email" autocomplete="email"
               maxlength="254" required aria-describedby="bf-email-err" />
        <span class="field__err" id="bf-email-err" data-err="email" hidden></span>
      </p>
    </fieldset>

    <fieldset class="bf__group bf__group--stage">
      <legend class="label">Where is the product now?</legend>
      <div class="bf__stages" aria-describedby="bf-stage-err">
        {stages.map((stage, i) => (
          <label class="stage">
            <input type="radio" name="stage" value={stage} required={i === 0} />
            <span class="stage__box" aria-hidden="true"></span>
            <span class="stage__text">{stage}</span>
          </label>
        ))}
      </div>
      <span class="field__err" id="bf-stage-err" data-err="stage" hidden></span>
    </fieldset>

    <fieldset class="bf__group">
      <legend class="label">What needs solving?</legend>
      <p class="field">
        <label for="bf-message">Describe it in your own words</label>
        <textarea id="bf-message" name="message" rows="6" maxlength="5000" required
                  aria-describedby="bf-message-err bf-message-hint"
                  placeholder="The garment, the problem, and any deadline that matters."></textarea>
        <span class="field__hint" id="bf-message-hint">A sentence or two is enough to start.</span>
        <span class="field__err" id="bf-message-err" data-err="message" hidden></span>
      </p>
    </fieldset>

    <fieldset class="bf__group">
      <legend class="label">Reference or file link <span class="field__opt">optional</span></legend>
      <p class="field">
        <label for="bf-link">Paste a link</label>
        <input id="bf-link" name="link" type="url" inputmode="url" maxlength="2000"
               placeholder="https://" aria-describedby="bf-link-err bf-link-hint" />
        <span class="field__hint" id="bf-link-hint">
          Google Drive, Dropbox, WeTransfer or a web reference. There is no upload on this
          page — and a link you paste is only as private as that link.
        </span>
        <span class="field__err" id="bf-link-err" data-err="link" hidden></span>
      </p>
    </fieldset>

    {turnstileKey && (
      <div class="bf__turnstile cf-turnstile" data-sitekey={turnstileKey} data-theme="light"></div>
    )}

    <div class="bf__submit">
      <button class="button button--signal" type="submit" data-submit>
        <span data-submit-text>Send the brief</span> <span><Arrow /></span>
      </button>
      <p class="bf__note">
        The brief is sent to Soufiane by email through his hosting and email provider.
        It is not published or shared.
      </p>
    </div>

    <p class="bf__status" data-status role="status" aria-live="polite"></p>
    <div class="bf__alert" data-alert role="alert" hidden>
      <p data-alert-text></p>
      <p class="bf__alert-fallback">
        <a href={`mailto:${email}`} data-mailto>Email the brief directly instead <span><Arrow /></span></a>
      </p>
    </div>
  </form>

  <!-- Shown in place of the form once the Worker confirms the brief is stored. -->
  <div class="bf__done" data-done hidden>
    <p class="label">Brief received</p>
    <h3 class="display" data-done-heading tabindex="-1">That’s everything needed to start.</h3>
    <p>
      The brief has been received. The reply comes back to
      <strong data-done-email></strong> in writing, with an honest scope and a
      realistic next step — not a booking link.
    </p>
    <p class="bf__done-ref">Reference <span data-done-ref></span></p>
  </div>
</div>

<style>
  .brief-form { min-width: 0; }

  .bf { display: grid; gap: clamp(1.75rem, 3vw, 2.5rem); }
  /* Off-screen rather than display:none so automated fills still reach it. */
  .bf__trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .bf__group { min-width: 0; margin: 0; padding: 0; border: 0; }
  .bf__group legend { padding: 0 0 1rem; color: var(--muted); }
  .field__opt { font-family: var(--mono); font-size: .85em; letter-spacing: .1em; opacity: .75; }

  .bf__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }

  .field { display: grid; gap: .45rem; margin: 0; min-width: 0; }
  .field label { color: var(--ink-soft); font-size: .92rem; }
  /* 16px minimum: anything smaller makes iOS Safari zoom the viewport on
     focus, which visibly breaks the page mid-form. */
  .field input,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: .8rem .9rem;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--paper-bright);
    color: var(--ink);
    font-family: var(--body);
    font-size: 16px;
    line-height: 1.5;
    transition: border-color .2s var(--ease);
  }
  .field textarea { min-height: 9rem; resize: vertical; }
  .field input:focus-visible,
  .field textarea:focus-visible { border-color: var(--ink); }
  .field input[aria-invalid='true'],
  .field textarea[aria-invalid='true'] { border-color: var(--signal); border-width: 2px; }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--muted); }

  .field__hint { color: var(--muted); font-size: .85rem; line-height: 1.55; }
  /* Errors carry text, never colour alone. */
  .field__err { color: var(--signal); font-size: .85rem; font-weight: 600; line-height: 1.5; }

  /* All five states visible without interaction — no select to open. */
  .bf__stages { display: grid; gap: .5rem; }
  .stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: .85rem;
    min-height: 3rem;
    padding: .7rem .9rem;
    border: 1px solid var(--line);
    background: var(--paper-bright);
    cursor: pointer;
    transition: border-color .2s var(--ease), background .2s var(--ease);
  }
  .stage:hover { border-color: var(--line-strong); }
  .stage input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .stage__box { width: .7rem; height: .7rem; border: 1px solid var(--line-strong); background: transparent; }
  .stage__text { font-size: 16px; line-height: 1.4; }
  .stage:has(input:checked) { border-color: var(--ink); background: var(--paper); }
  .stage:has(input:checked) .stage__box { background: var(--signal); border-color: var(--signal); }
  .stage:has(input:focus-visible) { outline: 2px solid var(--signal); outline-offset: 3px; }

  .bf__turnstile { min-height: 65px; }

  .bf__submit { display: grid; gap: 1rem; justify-items: start; }
  .bf__submit .button { min-height: 3.25rem; }
  .bf__submit .button[disabled] { opacity: .62; cursor: progress; }
  .bf__note { max-width: 34rem; margin: 0; color: var(--muted); font-size: .85rem; line-height: 1.6; }

  .bf__status { margin: 0; color: var(--muted); font-size: .9rem; }
  .bf__status:empty { display: none; }
  .bf__alert { padding: 1rem 1.1rem; border: 2px solid var(--signal); background: var(--paper-bright); }
  .bf__alert p { margin: 0; font-size: .95rem; line-height: 1.6; }
  .bf__alert-fallback { margin-top: .8rem !important; }
  .bf__alert-fallback a { display: inline-flex; align-items: center; gap: .5rem; color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }

  .bf__done { padding: clamp(1.75rem, 3.5vw, 2.75rem); border: 1px solid var(--line-strong); background: var(--paper-bright); }
  .bf__done > .label { margin: 0; color: var(--muted); }
  .bf__done h3 { margin: 1.1rem 0 1.5rem; font-size: clamp(1.8rem, 3.2vw, 2.8rem); }
  .bf__done h3:focus-visible { outline: 2px solid var(--signal); outline-offset: 6px; }
  .bf__done p { max-width: 34rem; margin: 0; color: var(--ink-soft); line-height: 1.7; }
  .bf__done-ref { margin-top: 1.5rem !important; color: var(--muted) !important; font-family: var(--mono); font-size: .72rem; }

  @media (max-width: 560px) {
    .bf__row { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-brief-form]');
    if (!form) return;

    const wrap = form.parentElement;
    const started = form.querySelector('[data-started]');
    const button = form.querySelector('[data-submit]');
    const buttonText = form.querySelector('[data-submit-text]');
    const status = form.querySelector('[data-status]');
    const alertBox = form.querySelector('[data-alert]');
    const alertText = form.querySelector('[data-alert-text]');
    const mailto = form.querySelector('[data-mailto]');
    const done = wrap.querySelector('[data-done]');
    const idleLabel = buttonText.textContent;

    /* Stamped from the client so the Worker can reject instant submissions. */
    started.value = String(Date.now());

    const errorFor = (name) => form.querySelector(`[data-err="${name}"]`);
    const controlFor = (name) => form.querySelector(`[name="${name}"]`);

    function clearErrors() {
      form.querySelectorAll('[data-err]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      alertBox.hidden = true;
      alertText.textContent = '';
    }

    function showFieldError(name, message) {
      const slot = errorFor(name);
      const control = controlFor(name);
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
      if (control && control.type !== 'radio') control.setAttribute('aria-invalid', 'true');
      return control;
    }

    /* Own messages rather than the browser's: they are calmer, and they can be
       placed in the same slot the server uses for the same field. */
    function validate() {
      const problems = [];
      const value = (n) => (controlFor(n)?.value ?? '').trim();
      if (!value('name')) problems.push(['name', 'Please add your name.']);
      const email = value('email');
      if (!email) problems.push(['email', 'Please add an email address so a reply can reach you.']);
      else if (!/^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/.test(email)) problems.push(['email', 'That email address does not look complete.']);
      if (!form.querySelector('[name="stage"]:checked')) problems.push(['stage', 'Please choose where the product is now.']);
      if (value('message').length < 10) problems.push(['message', 'A sentence or two about what needs solving is enough.']);
      const link = value('link');
      if (link && !/^https?:\/\/.+/i.test(link)) problems.push(['link', 'Links need to start with http:// or https://']);
      return problems;
    }

    function setBusy(busy) {
      button.disabled = busy;
      form.setAttribute('aria-busy', busy ? 'true' : 'false');
      buttonText.textContent = busy ? 'Sending brief…' : idleLabel;
      status.textContent = busy ? 'Sending the brief…' : '';
    }

    /* Keeps everything typed recoverable when the network is the problem. */
    function updateMailto(data) {
      const lines = [
        `Name: ${data.name || ''}`,
        `Company: ${data.company || ''}`,
        `Email: ${data.email || ''}`,
        `Stage: ${data.stage || ''}`,
        `Link: ${data.link || ''}`,
        '',
        data.message || '',
      ].join('\n');
      mailto.href =
        `mailto:${form.dataset.email}` +
        `?subject=${encodeURIComponent('Development brief')}` +
        `&body=${encodeURIComponent(lines)}`;
    }

    function fail(message, data) {
      updateMailto(data);
      alertText.textContent = message;
      alertBox.hidden = false;
      alertBox.focus?.();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const problems = validate();
      if (problems.length) {
        let first = null;
        problems.forEach(([name, message]) => {
          const control = showFieldError(name, message);
          if (!first) first = name === 'stage' ? form.querySelector('[name="stage"]') : control;
        });
        first?.focus();
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      setBusy(true);

      let res;
      try {
        res = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
      } catch {
        setBusy(false);
        fail('The brief could not be sent — the connection failed. Nothing you typed has been lost.', data);
        return;
      }

      let payload = {};
      try {
        payload = await res.json();
      } catch {
        /* non-JSON response; handled below */
      }
      setBusy(false);

      if (res.ok && payload.ok) {
        const email = String(data.email || '');
        wrap.querySelector('[data-done-email]').textContent = email;
        wrap.querySelector('[data-done-ref]').textContent = payload.id || '—';
        form.hidden = true;
        done.hidden = false;
        /* Announce the change rather than only painting it. */
        wrap.querySelector('[data-done-heading]').focus();
        return;
      }

      if (payload.field) {
        showFieldError(payload.field, payload.error || 'Please check this field.');
        const control = payload.field === 'stage' ? form.querySelector('[name="stage"]') : controlFor(payload.field);
        control?.focus();
        return;
      }

      fail(payload.error || 'The brief could not be sent. Nothing you typed has been lost.', data);
    });
  })();
</script>
