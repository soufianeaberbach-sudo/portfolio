---
interface Rating { label: string; score: number; }
interface Testimonial {
  reviewer: string;
  role: string;
  proof: string;
  quote: string;
  rating: number;
  ratings: Rating[];
  highlights: string[];
}
interface Props { items: Testimonial[]; }
const { items } = Astro.props;
const stars = [1, 2, 3, 4, 5];
---

{items.length > 0 && (
  <section class="client-feedback section-shell" aria-labelledby="client-feedback-title">
    <div class="client-feedback__head" data-reveal>
      <div>
        <p class="eyebrow">Client proof / three contexts</p>
        <h2 class="display" id="client-feedback-title">Trusted where<br /><em>precision</em> matters.</h2>
      </div>
      <p>Freelance service, factory reliability and international design-intent protection—three perspectives on the same production discipline.</p>
    </div>

    <div class="client-feedback__grid">
      {items.map((item, index) => (
        <blockquote class:list={['review', { 'review--lead': index === 0 }]} data-reveal>
          <div class="review__proof">
            <span class="label">{item.proof}</span>
            <div class="rating rating--overall" aria-label={`${item.rating} out of 5 stars`}>
              <span aria-hidden="true">{stars.map(() => <svg viewBox="0 0 24 24" focusable="false"><path d="m12 2.5 2.92 5.91 6.53.95-4.73 4.61 1.12 6.51L12 17.41l-5.84 3.07 1.12-6.51-4.73-4.61 6.53-.95L12 2.5Z" /></svg>)}</span>
              <strong>{item.rating}</strong>
            </div>
          </div>
          <header>
            <h3>{item.reviewer}</h3>
            <p>{item.role}</p>
          </header>

          <p class="review__quote">“{item.quote}”</p>

          <div class="review__ratings" aria-label="Category ratings">
            {item.ratings.map((rating) => (
              <div class="review__rating-row">
                <span>{rating.label}</span>
                <div class="rating" aria-label={`${rating.label}: ${rating.score} out of 5 stars`}>
                  <span aria-hidden="true">{stars.map(() => <svg viewBox="0 0 24 24" focusable="false"><path d="m12 2.5 2.92 5.91 6.53.95-4.73 4.61 1.12 6.51L12 17.41l-5.84 3.07 1.12-6.51-4.73-4.61 6.53-.95L12 2.5Z" /></svg>)}</span>
                  <strong>{rating.score}</strong>
                </div>
              </div>
            ))}
          </div>

          <div class="review__highlights">
            <span class="label">Things that went well</span>
            <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
          </div>
          <span class="review__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        </blockquote>
      ))}
    </div>
  </section>
)}

<style>
  .client-feedback { padding-block: clamp(7rem, 11vw, 11rem); }
  .client-feedback__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(18rem, .45fr); gap: 7vw; align-items: end; margin-bottom: clamp(4rem, 7vw, 7rem); }
  .client-feedback__head h2 { margin-top: 2rem; font-size: clamp(4rem, 7vw, 7.5rem); }
  .client-feedback__head > p { max-width: 31rem; margin: 0 0 .5rem; color: var(--muted); line-height: 1.75; }
  /* THREE REVIEWS, ONE COMPOSITION.
     Previously review 1 spanned two rows in a wide left column while 2 and 3
     stacked on the right, so nothing lined up and a tall neighbour left a
     ~840px hole under the short column. Now all three are siblings in a
     three-column grid and each review is a row subgrid over the five shared
     bands — proof line, name, quote, category ratings, tags. Every band
     therefore starts on the same baseline in all three columns no matter how
     much text sits inside it, and no column can end early. */
  .client-feedback__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto auto auto auto;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }
  .review {
    position: relative;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    margin: 0;
    padding: clamp(2rem, 2.6vw, 3rem) clamp(1.5rem, 2.2vw, 2.5rem) clamp(3rem, 4vw, 4rem);
    border-right: 1px solid var(--line);
  }
  .review:first-child { padding-left: 0; }
  .review:last-child { padding-right: 0; border-right: 0; }

  /* Fallback for engines without subgrid: equal columns still beat the old
     two-column split, they just lose the shared baselines. */
  @supports not (grid-template-rows: subgrid) {
    .review { grid-row: auto; grid-template-rows: none; }
  }

  .review__proof { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; padding-bottom: 1.25rem; }
  .review header { align-self: start; padding-bottom: 1.5rem; }
  .review .label { color: var(--signal); }
  .review h3 { margin: 0 0 .25rem; font-family: var(--display); font-size: clamp(1.75rem, 2.3vw, 2.6rem); letter-spacing: -.05em; line-height: .95; }
  .review header p { margin: 0; color: var(--muted); font-size: .8rem; }

  .rating { display: inline-flex; align-items: center; gap: .45rem; color: var(--signal); white-space: nowrap; }
  .rating > span { display: inline-flex; gap: .08rem; }
  .rating svg { display: block; width: .78rem; height: .78rem; fill: currentColor; }
  .rating strong { color: var(--ink); font-family: var(--mono); font-size: .72rem; }
  .rating--overall svg { width: .95rem; height: .95rem; }
  .rating--overall strong { font-size: .95rem; }

  /* The lead review stays typographically dominant — the three endorsements
     are different kinds of proof, not three servings of the same praise — but
     it is dominant in weight only, so the shared baselines survive. */
  .review__quote { align-self: start; margin: 0; padding-bottom: clamp(2rem, 3vw, 3rem); font-family: var(--display); font-size: clamp(1.3rem, 1.55vw, 1.7rem); font-weight: 650; letter-spacing: -.03em; line-height: 1.22; }
  .review--lead .review__quote { font-size: clamp(1.5rem, 1.95vw, 2.15rem); font-weight: 750; letter-spacing: -.04em; line-height: 1.16; }

  .review__ratings { align-self: start; border-top: 1px solid var(--line); }
  /* A fixed track for the stars: the label column takes the slack, so the
     star block starts at the same x in every column instead of being pushed
     around by how long each rating label happens to be. */
  .review__rating-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: .8rem 0; border-bottom: 1px solid var(--line); }
  .review__rating-row > span { min-width: 0; color: var(--ink-soft); font-size: .72rem; line-height: 1.35; }

  .review__highlights { align-self: start; padding-top: 2rem; }
  .review__highlights > .label { color: var(--muted); }
  .review__highlights ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .review__highlights li { flex: 0 1 auto; padding: .45rem .6rem; border: 1px solid var(--line); font-family: var(--mono); font-size: .56rem; letter-spacing: .04em; line-height: 1; text-transform: uppercase; }
  .review__index { position: absolute; right: 1rem; bottom: 1rem; color: var(--line-strong); font-family: var(--mono); font-size: .62rem; }
  .review:last-child .review__index { right: 0; }
  /* Stacked, but the alignment discipline moves inside each card: the bands
     keep their order and spacing, the rating rows keep their fixed star
     track, and the tag block keeps its wrap. */
  @media (max-width: 1000px) {
    .client-feedback__grid { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .review { grid-row: auto; grid-template-rows: none; padding: clamp(2.25rem, 5vw, 3rem) 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .review:first-child, .review:last-child { padding-inline: 0; }
    .review:last-child { border-bottom: 0; }
    .review__quote, .review--lead .review__quote { font-size: clamp(1.45rem, 3vw, 1.95rem); }
  }
  @media (max-width: 760px) {
    .client-feedback__head { grid-template-columns: minmax(0, 1fr); }
    .review__proof { align-items: flex-start; flex-direction: column; gap: .75rem; }
    .review__quote, .review--lead .review__quote { font-size: clamp(1.4rem, 5.6vw, 1.85rem); }
    /* Label above, stars below-left: at 390px a single row would either wrap
       the label to three lines or push the stars off the measure. */
    .review__rating-row { grid-template-columns: minmax(0, 1fr); gap: .4rem; padding: .7rem 0; }
    .review__rating-row .rating { justify-content: flex-start; }
    .review__highlights li { font-size: .54rem; padding: .4rem .5rem; }
  }
</style>
