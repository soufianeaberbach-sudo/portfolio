---
/* One garment, four analytical layers.
   The overlay viewBox matches the photograph's 1000x666 intrinsic size, so
   every coordinate below is in image space and every annotation stays locked
   to the construction it points at as the plate scales.
   Annotations name the KIND of control only — no measurements, no values. */
interface Props {
  mode?: 'rail' | 'static';
  layer?: 1 | 2 | 3 | 4;
}

const { mode = 'static', layer = 1 } = Astro.props;
const show = (n: number) => mode === 'rail' || layer === n;

const ALT: Record<number, string> = {
  0: 'Front and back views of a tailored stone jumpsuit developed by Soufiane Aberbach',
  1: 'Front and back views of a tailored stone jumpsuit, read as a finished silhouette',
  2: 'The same jumpsuit with its centre-front and centre-back balance axes, waist reference and grade axis marked',
  3: 'The same jumpsuit annotated at its gather set, shaped waist panel, centre-front pleat and centre-back closure',
  4: 'The same jumpsuit with its waist reference line repeated across units, one run drifting off the reference and one corrected back to it',
};
---

<figure class="plate" data-layer={mode === 'rail' ? '1' : String(layer)} data-mode={mode}>
  <img
    class="plate__photo"
    src="/evidence/development-1000.webp"
    srcset="/evidence/development-640.webp 640w, /evidence/development-1000.webp 1000w"
    sizes="(min-width: 1100px) 46vw, 92vw"
    width="1000"
    height="666"
    alt={mode === 'rail' ? ALT[0] : ALT[layer]}
    loading={layer === 1 ? 'eager' : 'lazy'}
    decoding="async"
  />

  <svg class="plate__overlay" viewBox="0 0 1000 666" aria-hidden="true" focusable="false">
    {show(1) && (
      <g class="lyr" data-g="1">
        <path class="rule" d="M10 95H86M10 300H86M10 600H86" />
        <text x="10" y="86">SHOULDER</text>
        <text x="10" y="291">WAIST</text>
        <text x="10" y="591">LENGTH</text>
        <path class="axis" d="M540 95V600M530 95H550M530 600H550" />
        <text x="500" y="348">PROPORTION</text>
      </g>
    )}

    {show(2) && (
      <g class="lyr" data-g="2">
        <path class="rule" d="M10 100H370M690 96H900" />
        <path class="rule" d="M10 268H345M672 268H872" />
        <path class="rule" d="M10 360H355M668 352H880" />
        <text x="10" y="92">BALANCE</text>
        <text x="10" y="260">WAIST REF</text>
        <text x="10" y="352">GRADE AXIS</text>
        <path class="axis" d="M258 70V666M818 70V666" />
        <text class="along" transform="rotate(-90 252 250)" x="252" y="250">CF</text>
        <text class="along" transform="rotate(-90 812 250)" x="812" y="250">CB</text>
        <g class="nest">
          <path d="M180 420Q262 405 345 420" />
          <path d="M171 433Q262 418 354 433" />
          <path class="nest-out" d="M162 446Q262 431 363 446" />
        </g>
        <text x="470" y="440">GRADE NEST</text>
      </g>
    )}

    {show(3) && (
      <g class="lyr" data-g="3">
        <path class="lead" d="M272 228H100V196" />
        <circle class="node" cx="272" cy="228" r="4" />
        <text x="10" y="188">GATHER SET</text>

        <path class="lead" d="M300 300H505" />
        <circle class="node" cx="300" cy="300" r="4" />
        <text x="470" y="292">SHAPED WAIST PANEL</text>

        <path class="lead" d="M300 400H505" />
        <circle class="node" cx="300" cy="400" r="4" />
        <text x="470" y="392">CF PLEAT DEPTH</text>

        <path class="lead" d="M818 180H950" />
        <circle class="node" cx="818" cy="180" r="4" />
        <text x="884" y="172">CB CLOSURE</text>

        <path class="lead" d="M790 300H950V342" />
        <circle class="node" cx="790" cy="300" r="4" />
        <text x="890" y="356">WAISTBAND</text>

        <path class="rule" d="M466 502V588" />
        <text x="478" y="520">POM SET</text>
        <text x="478" y="546">TOLERANCE</text>
        <text x="478" y="572">CONSTRUCTION</text>
      </g>
    )}

    {show(4) && (
      <g class="lyr" data-g="4">
        <path class="rule" d="M150 290H360M10 290H144" />
        <text x="10" y="282">REFERENCE</text>
        <path class="ghost" d="M150 310H360M150 330H360" />
        <path class="drift" d="M150 350L360 362M10 350H144" />
        <text x="10" y="342">DRIFT</text>
        <path class="drift" d="M150 385H360M10 385H144" />
        <text x="10" y="377">CORRECTED</text>

        <path class="rule" d="M480 430V630M472 455H488M472 530H488M472 605H488" />
        <text x="496" y="459">FIRST CUT</text>
        <text x="496" y="534">FIRST PIECE</text>
        <text x="496" y="609">IN-LINE</text>
      </g>
    )}
  </svg>

  {mode === 'rail' && (
    <figcaption class="plate__state label" aria-hidden="true">
      <span data-state="1">01 / Design intent</span>
      <span data-state="2">02 / Fit system</span>
      <span data-state="3">03 / Technical translation</span>
      <span data-state="4">04 / Production control</span>
    </figcaption>
  )}
</figure>

<style>
  .plate { position: relative; margin: 0; background: var(--paper-bright); border: 1px solid var(--line); }

  /* The stills are shot on pure white; multiply lets the page ground come
     through so the plate never reads as a white rectangle on cream. */
  .plate__photo { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }

  .plate__overlay { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .plate__overlay path, .plate__overlay circle { vector-effect: non-scaling-stroke; }
  .plate__overlay text {
    fill: var(--ink-soft);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: .08em;
  }
  .along { fill: var(--signal); }

  .rule, .lead { fill: none; stroke: var(--ink); stroke-width: 1; }
  .axis { fill: none; stroke: var(--signal); stroke-width: 1; }
  .ghost { fill: none; stroke: var(--ink); stroke-width: 1; opacity: .28; }
  .drift { fill: none; stroke: var(--signal); stroke-width: 1; }
  .nest { fill: none; stroke: var(--ink-soft); stroke-width: 1; opacity: .55; }
  .nest-out { stroke: var(--signal); opacity: 1; }
  .node { fill: var(--signal); stroke: none; }

  /* Rail mode cross-fades between states as the chapters pass the viewport
     centre; static mode renders one layer and needs no transition. */
  .plate[data-mode='rail'] .lyr {
    opacity: 0;
    transform: translateY(.6rem);
    transition: opacity .4s var(--ease), transform .4s var(--ease);
  }
  .plate[data-mode='rail'][data-layer='1'] [data-g='1'],
  .plate[data-mode='rail'][data-layer='2'] [data-g='2'],
  .plate[data-mode='rail'][data-layer='3'] [data-g='3'],
  .plate[data-mode='rail'][data-layer='4'] [data-g='4'] { opacity: 1; transform: none; }

  .plate__state { position: relative; display: grid; padding: .85rem 1rem; border-top: 1px solid var(--line); color: var(--muted); }
  .plate__state span { grid-area: 1 / 1; opacity: 0; transition: opacity .3s var(--ease); }
  .plate[data-layer='1'] [data-state='1'],
  .plate[data-layer='2'] [data-state='2'],
  .plate[data-layer='3'] [data-state='3'],
  .plate[data-layer='4'] [data-state='4'] { opacity: 1; }

  /* The overlay labels live in the 1000-unit image space, so below ~900px they
     would render at 3-6 CSS px — unreadable. The geometry stays (it shows
     WHERE), and each chapter's own micro-layer already names the terms, so
     nothing is lost by dropping the lettering rather than shrinking it. */
  @media (max-width: 900px) {
    .plate__overlay text { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate[data-mode='rail'] .lyr { transition: none; }
    .plate__state span { transition: none; }
  }
</style>
