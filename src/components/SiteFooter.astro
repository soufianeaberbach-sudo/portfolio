---
import SocialLinks from './SocialLinks.astro';
import Arrow from './Arrow.astro';

interface Props {
  page?: string;
  showCallout?: boolean;
}

const { page = '', showCallout = true } = Astro.props;

const footerLinks = [
  { href: '/', label: 'Home', page: 'home' },
  { href: '/expertise/', label: 'Expertise', page: 'expertise' },
  { href: '/portfolio/', label: 'Portfolio', page: 'portfolio' },
  { href: '/process/', label: 'Process', page: 'process' },
  { href: '/experience/', label: 'Experience', page: 'experience' },
  { href: '/contact/', label: 'Contact', page: 'contact' },
];

/* One closing statement for the whole site. The per-page variants ended on
   "Start with what you have." — accurate but generic for the last thing a
   visitor reads, and it repeated the Contact hero. This says what the work is
   actually for. */
const calloutEyebrow = 'Before the next round';
const calloutLines = ['Make the next decision', 'before it becomes', 'a production problem.'];
---

<footer class="site-footer">
  {showCallout && (
    <div class="footer-callout">
      <p class="label footer-callout__eyebrow">{calloutEyebrow}</p>
      <p class="footer-callout__statement">
        {calloutLines.map((line) => <span>{line}</span>)}
      </p>
      <a class="footer-callout__cta" href="/contact/">
        Start a brief
        <i aria-hidden="true"><Arrow /></i>
      </a>
    </div>
  )}
  <div class="footer-grid">
    <a class="footer-signature" href="/" aria-label="Soufiane Aberbach — Home"><span>SA</span><i aria-hidden="true"></i></a>
    <nav aria-label="Footer navigation">
      {footerLinks.map((link) => (
        <a href={link.href} aria-current={page === link.page ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="footer-profiles">
      <p class="label">Professional profiles</p>
      <SocialLinks />
    </div>
    <div class="footer-meta">
      <span>Tangier, Morocco</span>
      <a href="/privacy/">Privacy</a>
      <span>© 2026</span>
    </div>
  </div>
</footer>
