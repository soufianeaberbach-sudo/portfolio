---
import SocialLinks from './SocialLinks.astro';
import Arrow from './Arrow.astro';
import { trustRoutes } from '../data/site-routes.mjs';
import { getLocale, localizePath } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  page?: string;
  showCallout?: boolean;
}

const { page = '', showCallout = true } = Astro.props;
const locale = getLocale(Astro.url);
const t = ui[locale];
const l = (href: string) => localizePath(href, locale);

const footerLinks = [
  { href: '/', label: t.nav.home, page: 'home' },
  { href: '/expertise/', label: t.nav.expertise, page: 'expertise' },
  { href: '/portfolio/', label: t.nav.portfolio, page: 'portfolio' },
  { href: '/process/', label: t.nav.process, page: 'process' },
  { href: '/experience/', label: t.nav.experience, page: 'experience' },
  { href: '/contact/', label: t.nav.contact, page: 'contact' },
];
const trustLabel: Record<string, string> = {
  '/privacy/': t.trust.privacy,
  '/before-we-start/': t.trust.before,
  '/working-terms/': t.trust.terms,
};

/* One closing statement for the whole site. The per-page variants ended on
   "Start with what you have." — accurate but generic for the last thing a
   visitor reads, and it repeated the Contact hero. This says what the work is
   actually for. */
const calloutEyebrow = t.footer.eyebrow;
const calloutLines = t.footer.lines;
---

<footer class="site-footer">
  {showCallout && (
    <div class="footer-callout">
      <p class="label footer-callout__eyebrow">{calloutEyebrow}</p>
      <p class="footer-callout__statement">
        {calloutLines.map((line) => <span>{line}</span>)}
      </p>
      <a class="footer-callout__cta" href={l('/contact/')}>
        {t.startBrief}
        <i aria-hidden="true"><Arrow /></i>
      </a>
    </div>
  )}
  <div class="footer-grid">
    <a class="footer-signature" href={l('/')} aria-label={t.homeLabel}><span>SA</span><i aria-hidden="true"></i></a>
    <nav aria-label={t.footer.nav}>
      {footerLinks.map((link) => (
        <a href={l(link.href)} aria-current={page === link.page ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="footer-profiles">
      <p class="label">{t.footer.profiles}</p>
      <SocialLinks />
    </div>
    <div class="footer-meta">
      <span>{t.place}</span>
      <nav class="footer-trust" aria-label={t.footer.projectInfo}>
        {trustRoutes.map(({ path }) => <a href={l(path)}>{trustLabel[path]}</a>)}
      </nav>
      <span>© 2026</span>
    </div>
  </div>
</footer>

<style>
  .footer-trust { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
  .footer-trust a { line-height: 1.6; }
  @media (max-width: 640px) {
    .footer-trust { flex-basis: 100%; gap: .5rem 1.25rem; }
    .footer-trust a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
